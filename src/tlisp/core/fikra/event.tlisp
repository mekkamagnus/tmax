(defmodule fikra/event
  (export fikra-event-log-set fikra-event-log-path fikra-event-emit-batch-for fikra-event-emit
          fikra-event-set-refresh-hook
          fikra-event-turn-tools
          fikra-event-emit-batch fikra-event-replay fikra-event-events
          fikra-event-reset fikra-event-render-line fikra-event-rebuild-fikra-buffer
          fikra-event-inline-ckpt-merge fikra-event-render-fold fikra-inline-find-call fikra-inline-edit-p fikra-inline-ref-identity fikra-inline-event-identity fikra-gate-panel)

;; #212 (RFC-027 §D2) — FAEP: the Fikra Agent Event Protocol. Every backend's
;; output normalizes into ONE event vocabulary; threads are event-sourced
;; JSONL logs; the transcript is a pure replay of events.
;;
;; Event = alist of ("field" value) pairs with a mandatory "kind". Kinds:
;;   turn-start turn-end session text-delta thought tool-call tool-result
;;   permission-request permission-response file-change
;;   checkpoint-start checkpoint-ready checkpoint-error checkpoint-reverted
;;
;; Emit contract (synchronous, in order): append to the JSONL log → render
;; incrementally (buffer-append into the current buffer when it is *Fikra*;
;; buffer mutation bumps the daemon revision for the TUI poll) → record
;; in-memory. Batch emit = ONE append + ONE render pass (the per-chunk
;; coalescing adapters build on — no timers anywhere).
;;
;; Replay is crash-tolerant: a trailing partial JSONL line is dropped.

(defvar fikra-event-log nil
  "Active JSONL log path (set per-thread by fikra/thread in #213).")

(defvar fikra-event-memory (list)
  "In-memory copy of emitted events (test/inspection surface).")

;; Turn-scoped tool-call counter (modeline context, codex round 10:
;; "tool count absent"): reset at turn-start, bumped per tool-call, at
;; EMIT time only (replay never recounts). Getter below is the export.
(defvar fikra-event-turn-tools-v 0
  "Tool-calls in the current/last turn.")

(defun fikra-event-turn-tools ()
  fikra-event-turn-tools-v)

(defun fikra-event-count-tools (events)
  (dolist (e events)
    (let ((k (fikra-event-get-str e "kind")))
      (cond
        ((string= k "turn-start") (setq fikra-event-turn-tools-v 0))
        ((string= k "tool-call") (setq fikra-event-turn-tools-v (+ fikra-event-turn-tools-v 1)))))))

(defvar fikra-text-open nil
  "Whether a text-delta run is open (adjacent deltas join into one line).")

;; Per-FAEP-event refresh hook (#219 specced it; codex round 14: the
;; modeline's turn/tool segments only updated at open/send). A fn NAME
;; (string) called after each rendered emit batch; nil = off. A hook
;; error is swallowed — the hook must never kill an emit.
(defvar fikra-event-refresh-hook nil
  "Fn name called after each rendered emit batch (the modeline lighter).")

(defun fikra-event-set-refresh-hook (fn-name)
  (setq fikra-event-refresh-hook fn-name)
  fn-name)

(defun fikra-event-run-hook ()
  (if fikra-event-refresh-hook
    (condition-case nil (funcall fikra-event-refresh-hook) (error () nil))
    nil))

(defun fikra-event-log-set (path)
  "Point the FAEP log at PATH and reset in-memory state."
  (setq fikra-event-log path)
  (setq fikra-event-memory (list))
  (setq fikra-text-open nil)
  path)

(defun fikra-event-log-path ()
  (if fikra-event-log fikra-event-log nil))

(defun fikra-event-reset ()
  "Clear in-memory state (tests). Does not touch the log file."
  (setq fikra-event-memory (list))
  (setq fikra-text-open nil)
  t)

;; ── field accessors (alist of ("k" v)) ──────────────────────────────
(defun fikra-event-get (event key)
  "FIELD accessor for alist events — T-Lisp has no assoc builtin."
  (let ((found nil))
    (dolist (entry event)
      (if (and (not found)
               (listp entry)
               (= (length entry) 2)
               (string= (car entry) key))
        (setq found (car (cdr entry)))))
    found))


;; refs/fikra/<id>/<n>[-baseline] -> "<id>/<n>" (the mockup's short form).
(defun fikra-ckpt-short (ref)
  (fikra-ckpt-segments (string-split ref "/") (list)))

;; Collect the segments AFTER "fikra" (id then turn), dropping -baseline.
(defun fikra-ckpt-segments (segs acc)
  (if (null segs)
    (let ((kept acc)) ;; kept = (id turn) — already in order.
      (if (>= (length kept) 2)
        (concat (nth 1 kept) "/" (fikra-ckpt-tail (nth 0 kept)))
        (if (>= (length kept) 1) (nth 0 kept) "")))
    (fikra-ckpt-segments (cdr segs)
      (if (or (string= (car segs) "refs") (string= (car segs) "fikra"))
        acc
        (cons (car segs) acc)))))

(defun fikra-ckpt-tail (seg)
  (if (string-suffix-p "-baseline" seg)
    (substring seg 0 (- (length seg) 9))
    seg))

(defun fikra-event-get-str (event key)
  (let ((v (fikra-event-get event key)))
    (if v v "")))

;; ── semantic faces (ANSI SGR; \e is the tokenizer's ESC escape) ──────
;; The *Fikra* buffer carries ANSI; buffer-lines' ANSI-aware padding keeps
;; column math correct (codex UI verification: "plain event log" → styled).
(defvar fikra-face-reset "\e[0m")
(defun fikra-face (code s) (concat code s fikra-face-reset))

(defun fikra-event-id-tag (event)
  "Dim #XXXXXX correlation suffix (empty when the event has no id).
Number ids (the confirmation token mints numeric) are coerced — strict
string= against a number errored the permission-request render (the
round-12 approvals catch)."
  (let ((v (fikra-event-get event "id")))
    (cond
      ((and (stringp v) (> (length v) 0))
        (concat " " (fikra-face "\e[2m" (concat "#" v))))
      ((numberp v)
        (concat " " (fikra-face "\e[2m" (concat "#" (number-to-string v)))))
      (t ""))))

;; The boxed approval panel (mockup 8.3's focused presentation). Width 44 (round-21: 62 overflowed narrow panes — the wrap
;; continuation gutter shredded the border); content lines pad/truncate to
;; the inner width so the border always aligns.

;; The first word of S — the tool name for the always-row's scope label
;; (mockup: "A Always allow bash:rm in this thread").
(defun fikra-gate-first-word (s)
  (let ((parts (string-split s " ")))
    (if (> (length parts) 0) (car parts) "")))

(defun fikra-gate-panel (event)
  ;; Mockup 8.3's full row set (r70): title names the thread+turn, the
  ;; tool row carries the risk tag, the target rides its own row, the ckpt
  ;; row states the revert contract, the origin row the provenance.
  (let* ((mode (fikra-event-get-str event "mode"))
         (cp (fikra-event-get-str event "checkpoint"))
         (org (fikra-event-get-str event "origin"))
         (th (fikra-event-get-str event "thread"))
         (tn (fikra-event-get-str event "turn"))
         (tool (fikra-event-get-str event "tool"))
         (risk (fikra-event-get-str event "risk"))
         (target (fikra-event-get-str event "target"))
         (title (if (and (> (length th) 0) (> (length tn) 0))
                  (concat " APPROVE ACTION — " th ", turn " tn " ")
                  " approval required "))
         ;; Legacy logs (pre-r70) carry only "action" — fall back so old
         ;; threads still render a readable tool row.
         (tool-row (if (> (length tool) 0)
                     tool
                     (fikra-event-get-str event "action")))
         ;; The tool WORD for the always-row's scope label (mockup: "A
         ;; Always allow bash:rm in this thread").
         (tool-word (if (> (length tool) 0)
                      (fikra-gate-first-word tool)
                      (fikra-gate-first-word (fikra-event-get-str event "action"))))
         (rows (list
                 (concat tool-row
                         (if (string= risk "") "" (concat " (" risk ")")))
                 (if (string= target "") "" (concat "target  " target))
                 (concat "paused"
                         (if (string= mode "") "" (concat " (" mode ")"))
                         " — holds until you answer")
                 ;; Mockup 8.3's key labels (r80): a Allow / r Reject /
                 ;; A Always / C-g abort. y/n remain bound as aliases.
                 (concat "a Allow  r Reject  A Always allow " tool-word
                         " in this thread  C-g abort turn")
                 ;; The ckpt row in the mockup's shape — the ✓ is EARNED
                 ;; (r81, codex r80 catch 2: the emit VERIFIED the baseline
                 ;; ref exists; "" means no capture yet and the row must
                 ;; SAY so — a synthesized ✓ lied about revert availability).
                 (if (and (> (length th) 0) (> (length tn) 0))
                   (if (> (length cp) 0)
                     (concat "ckpt    " cp
                             " ✓ — revert available after execution")
                     "ckpt    none yet — revert unavailable after this action")
                   (if (string= cp "") "" (concat "ckpt " cp " · r reverts")))
                 (if (string= org "") "" (concat "origin: " org))
                 ;; The COMPLETE action (r72: the derived target/risk are
                 ;; heuristics — the reviewer must always see the full text).
                 (concat "action  " (fikra-event-get-str event "action")))))
    (concat
      (fikra-face "\e[1;33m" (fikra-box-line "┌" "─" title "┐")) "\n"
      (fikra-face "\e[1;33m"
        (apply 'concat
          (mapcar (lambda (r) (concat (fikra-gate-row r) "\n")) (fikra-gate-rows rows))))
      (fikra-face "\e[1;33m" (fikra-box-line "└" "─" "" "┘")) "\n")))

;; Rows for the panel: every row WRAPS at the 40-char inner width (r73:
;; truncating the action row could hide the decisive end of a long
;; command — a reviewer must see the whole text before answering).
(defun fikra-gate-rows (rows)
  (fikra-gate-rows-scan rows (list)))

(defun fikra-gate-rows-scan (rows out)
  (if (null rows)
    (reverse out)
    (fikra-gate-rows-scan (cdr rows)
      (fikra-gate-wrap (car rows) out))))

;; One row's text -> wrapped row strings appended to OUT (newest-first):
;; a 37-char head, then "… " + the remainder in 38-char continuation
;; chunks — the full text is ALWAYS present (r73).
(defun fikra-gate-wrap (text out)
  (if (<= (length text) 40)
    (cons text out)
    (fikra-gate-wrap-tail (substring text 37 (length text))
      (cons (concat (substring text 0 37) " …") out))))

(defun fikra-gate-wrap-tail (rest out)
  (if (<= (length rest) 38)
    (cons (concat "… " rest) out)
    (fikra-gate-wrap-tail (substring rest 38 (length rest))
      (cons (concat "… " (substring rest 0 38)) out))))

;; One bordered row: "│ content…padded │" at the panel's inner width.
(defun fikra-gate-row (content)
  ;; Overlong content TRUNCATES (…) — the border must never be overrun
  ;; (codex round-18 catch: long rows visibly overflowed the fixed box).
  (let ((c (if (> (length content) 40)
             (concat (substring content 0 37) "…")
             (fikra-pad-to content 40))))
    (concat "│ " c " │")))

(defun fikra-pad-to (s width)
  (if (>= (length s) width) s
    (concat s (fikra-repeat-str " " (- width (length s))))))

(defun fikra-repeat-str (s n)
  (if (<= n 0) "" (concat s (fikra-repeat-str s (- n 1)))))

;; "┌─ title ─────┐"-style rule to the 62-col outer width: left, title,
;; then FILL characters out to the right edge.
(defun fikra-box-line (left fill title right)
  (let ((used (+ (length left) (length title) (length right))))
    (concat left title (fikra-repeat-str fill (max 0 (- 44 used))) right)))

;; A DENIED tool-result (the backend CLI's own permission system refused —
;; the L1 reality; fikra has no gate to offer). Detected by the denial
;; signatures the CLIs actually emit. Codex round 1: "never present a
;; nonexistent approval as pending" — the old bare FAIL row forced the
;; user to guess; this renders the truthful state + the actionable next
;; step (mockup 8.3's spirit, L1-honest).
(defun fikra-event-denied-p (summary)
  (or (string-match "requested permission" summary)
      (string-match "requires approval" summary)
      (string-match "haven't granted" summary)
      (string-match "permission mode" summary)))

(defun fikra-event-render-denial (event)
  (concat (fikra-face "\e[1;33m"
              (concat "⚠ permission denied "
                      (fikra-event-get-str event "tool")
                      (fikra-event-id-tag event)))
          "\n"
          (fikra-face "\e[2m"
              (concat "  The CLI's permission system refused this action (fikra has no "
                      "approval gate in L1). SPC a m switches runtime mode "
                      "(auto-accept-edits / full-access), then re-ask."))
          "\n"))

;; ── render: one event → display text ("" = nothing) ─────────────────
;; RFC §D2 table. Adjacent text-deltas join: the first opens a "You/AI: "
;; run, followers append without re-rendering the prefix; any other event
;; closes the run.
;; Inline change evidence: the tool-call's preview lines (sign-prefixed)
;; render colored under the tool row — green +, red -, dim indent.
(defun fikra-event-render-preview (event)
  (let ((preview (fikra-event-get-str event "preview")))
    (if (or (null preview) (string= preview ""))
      ""
      (let ((out "")
            (lines (string-split preview "\n")))
        (dolist (l lines)
          (if (> (length l) 1)
            (let ((sign (substring l 0 1))
                  (body (substring l 2 (length l))))
              (setq out (concat out
                                (if (string= sign "+")
                                  (fikra-face "\e[32m" (concat "    + " body))
                                  (fikra-face "\e[31m" (concat "    - " body)))
                                "\n")))))
        out))))

(defun fikra-event-render-line (event)
  (let ((kind (fikra-event-get-str event "kind")))
    (cond
      ((string= kind "turn-start")
        (concat "\n" (fikra-face "\e[1;36m"
                    (concat "── turn " (fikra-event-get-str event "turn")
                            " · " (fikra-event-get-str event "backend")
                            (let ((m (fikra-event-get-str event "mode")))
                              (if (string= m "") "" (concat " · " m)))
                            " ──")) "\n"))
      ((string= kind "session") "")
      ((string= kind "text-delta")
        (fikra-event-get-str event "text"))
      ((string= kind "thought")
        (concat (fikra-face "\e[2m" (concat "· " (fikra-event-get-str event "text"))) "\n"))
      ((string= kind "tool-call")
        ;; Id first here too — symmetry with results, and clip-proof. The
        ;; merged ckpt rides INLINE (r62): "⚙ buffer-edit ... [ckpt id/n ✓]".
        (concat (fikra-face "\e[33m"
                    (concat "⚙ " (fikra-event-get-str event "tool")))
                (fikra-event-id-tag event)
                (fikra-face "\e[33m" (concat "  " (fikra-event-get-str event "summary")))
                (if (fikra-event-get event "ckpt")
                  (concat " " (fikra-face "\e[36m"
                    (concat "[ckpt " (fikra-ckpt-short (fikra-event-get-str event "ckpt")) " ✓]")))
                  "")
                "\n"
                (fikra-event-render-preview event)))
      ((string= kind "tool-result")
        ;; Permission-denied results render the truthful actionable block
        ;; instead of a bare FAIL the user must decode (L1 has no gate).
        (if (and (not (fikra-event-get event "ok"))
                 (fikra-event-denied-p (fikra-event-get-str event "summary")))
          (fikra-event-render-denial event)
          ;; Id BEFORE the summary: the 100-char one-line cap clips the tail,
          ;; which used to cut the correlation id off the terminal edge
          ;; (codex round-3 catch: "#86fcca appears only once").
          (concat (if (fikra-event-get event "ok")
                    (fikra-face "\e[32m" (concat "  → ok"))
                    (fikra-face "\e[1;31m" (concat "  → FAIL")))
                  (fikra-event-id-tag event) " "
                  (fikra-face (if (fikra-event-get event "ok") "\e[32m" "\e[1;31m")
                    (fikra-event-one-line (fikra-event-get-str event "summary")))
                  "\n")))
      ((string= kind "permission-request")
        ;; Mockup 8.3's gate as a FOCUSED PANEL (codex rounds 17: "inline
        ;; block rather than the mockup's focused panel"): a boxed frame —
        ;; the action + token, the paused-turn contract with the gating
        ;; mode, the checkpoint (revert target) + origin (permitted
        ;; resolver class), and the y/n/a keys. Box width is fixed; long
        ;; lines flow via wrap continuation rows.
        (fikra-gate-panel event))
      ((string= kind "permission-response")
        ;; r83: the pause path's richer wording (was a bare "= allow" —
        ;; codex r82 P3). reject says "rejected", NOT the fixture's
        ;; "turn ended" — a rejected live tool call does NOT end the turn.
        (concat (fikra-face "\e[2m"
                  (concat "  = "
                    (let ((d (fikra-event-get-str event "decision")))
                      (cond
                        ((string= d "allow") "allowed this request")
                        ((string= d "reject") "rejected")
                        ((string= d "always") "allowed (always for this tool+scope)")
                        (t d)))))
          "\n"))
      ;; #303 (gate r1 catch): the fixture backend's decision kinds
      ;; previously fell to the empty-string default — the decision lived
      ;; only in the log, never in a rendered frame.
      ((string= kind "permission-allowed")
        (concat (fikra-face "\e[32m"
                    (concat "  = allowed" (if (string= (fikra-event-get-str event "always") "true")
                                          " (always for this tool+scope)" " this request"))) "\n"))
      ((string= kind "permission-denied")
        (concat (fikra-face "\e[31m" "  = denied — the turn ended") "\n"))
      ((string= kind "file-change")
        (concat (fikra-face "\e[35m"
                    (concat "± " (fikra-event-get-str event "path")
                            " +" (fikra-event-get-str event "adds")
                            " -" (fikra-event-get-str event "dels"))) "\n"))
      ((string= kind "turn-end")
        (let ((st (fikra-event-get-str event "status")))
          (concat (if (string= st "completed")
                    (fikra-face "\e[2m" (concat "── " st " ──"))
                    (fikra-face "\e[1;31m" (concat "── " st " ──")))
                  "\n")))
      ((string= kind "checkpoint-start") "")
      ((string= kind "checkpoint-ready")
        ;; Mockup 8.1: the marker shape "[ckpt <short-ref> ✓]" — the ⌘
        ;; keeps the checkpoint identity, the ✓ + short ref match the
        ;; inline edit markers.
        (concat (fikra-face "\e[36m"
                  (concat "  ⌘ [ckpt " (fikra-ckpt-short (fikra-event-get-str event "ref")) " ✓]"))
                "\n"))
      ((string= kind "checkpoint-error")
        (concat (fikra-face "\e[1;31m" (concat "  ⌘ checkpoint-error: " (fikra-event-get-str event "reason"))) "\n"))
      ((string= kind "checkpoint-reverted")
        (concat "\n" (fikra-face "\e[1;36m"
                    (concat "── reverted to turn " (fikra-event-get-str event "target")
                            " (discarded through " (fikra-event-get-str event "revert-point") ") ──")) "\n"))
      (t ""))))

;; Collapse a summary to ONE display line: first line, hard-capped at 100
;; chars, with an elision marker when more lines existed. A raw Bash dump
;; (an ls listing) must not swamp the conversation — codex UI verification:
;; "full directory listing dominating the chat" (tool presentation 4/10).
(defun fikra-event-one-line (s)
  (let* ((lines (string-split s "\n"))
         (first (if (> (length lines) 0) (car lines) ""))
         (trimmed (if (and (> (length lines) 1) (string= (last lines) ""))
                    (reverse (cdr (reverse lines)))
                    lines))
         (extra (- (length trimmed) 1))
         (capped (if (> (length first) 100)
                   (concat (substring first 0 100) "…")
                   first)))
    (if (> extra 0) (concat capped " …+" extra "L") capped)))

;; ── emit ────────────────────────────────────────────────────────────
(defun fikra-event-emit (event)
  "Emit ONE event: append to the JSONL log, render incrementally, record.
The current buffer receives the rendered text via buffer-append when it is
*Fikra* (rendering elsewhere would corrupt user buffers); buffer mutation
bumps the revision the TUI poll consumes."
  (fikra-event-emit-batch (list event)))

;; #222 gate catch: THREAD-ROUTED emit. The single fikra-event-log pointer
;; follows FOCUS — a background turn's chunks would land in whatever thread
;; the user is looking at. Emitting FOR an id appends to id's own log and
;; renders only when id's buffer is current (switching views does not
;; misroute; it merely pauses live rendering for the background thread).
(defun fikra-event-emit-batch-for (id events)
  (require-module fikra/thread)
  (fikra-event-count-tools events)
  (let ((target-root (fikra/thread/fikra-thread-field-root-of id))
        (target-buffer (fikra/thread/fikra-thread-buffer-name-of id)))
    ;; Gate round-2: unknown id (nil root) → DROP, never guess.
    (if (or (null target-root) (null events))
      nil
      (progn
        (append-file (concat target-root "/.tmax/fikra/threads/" id "/events.jsonl")
          (apply 'concat
            (mapcar (lambda (e) (concat (json-encode e) "\n")) events)))
        (if (not (fikra-event-batch-has-tombstone-p events))
          (let ((text (fikra-event-render-batch events)))
            (if (> (length text) 0)
              ;; Round-28 STREAMING FIX (probe-verified: the daemon has ONE
              ;; editor; the filter's evalTlisp context reads buffer-current
              ;; ≠ the user's view mid-turn, so the old gate discarded all
              ;; streamed batches — 67 rendered-but-dropped in the r27
              ;; instrumentation). TEMPORARY SWITCH lands the text in the
              ;; target buffer via the proven append and restores current —
              ;; verified end-to-end: the daemon *Fikra* holds the complete
              ;; streamed reply (540 chars) after the turn.
              (condition-case nil
                (if (string= (buffer-current) target-buffer)
                  (let ((was-ro (buffer-read-only-p)))
                    (buffer-set-read-only nil)
                    (buffer-append text)
                    (buffer-set-read-only was-ro))
                  (let ((prev (buffer-current))
                        (was-ro (buffer-read-only-p)))
                    (buffer-switch target-buffer)
                    (buffer-set-read-only nil)
                    (buffer-append text)
                    (buffer-set-read-only was-ro)
                    (buffer-switch prev)))
                (error () nil)))))
        (fikra-event-run-hook)
        ;; Memory + in-memory log pointer stay FOCUS-scoped (replay reads
        ;; the log FILE, so the background thread's history is intact).
        (if (string= id (fikra/thread/fikra-thread-current))
          (progn
            (dolist (e events)
              (setq fikra-event-memory (cons e fikra-event-memory)))
            (if (fikra-event-batch-has-tombstone-p events)
              (fikra-event-rebuild-fikra-buffer))))
        t))))

(defun fikra-event-emit-batch (events)
  "Emit a BATCH with ONE log append + ONE render pass — the per-chunk
coalescing primitive (#208's serialized filters hand each chunk's events
here as one batch). Non-delta events append immediately; adjacent
text-deltas inside the batch join into the same line."
  ;; #222: per-thread buffer names live in fikra/thread — LAZY require
  ;; (thread requires event; the cycle forbids a top-level require).
  (require-module fikra/thread)
  (fikra-event-count-tools events)
  (if (null events)
    nil
    (progn
      ;; 1. Append: one JSONL line per event, single append-file call.
      (if fikra-event-log
        (append-file fikra-event-log
          (apply 'concat
            (mapcar (lambda (e) (concat (json-encode e) "\n")) events))))
      ;; 2. Render: a tombstone INVALIDATES already-rendered turns — append
      ;; would leave stale content on screen, so rebuild *Fikra* from
      ;; replay instead. Otherwise render incrementally. Read-only state is
      ;; saved/restored around the mutation (a user who made the buffer
      ;; writable keeps it writable).
      (if (fikra-event-batch-has-tombstone-p events)
        (if (string= (buffer-current) (fikra/thread/fikra-thread-buffer-name))
          (fikra-event-rebuild-fikra-buffer))
        (let ((text (fikra-event-render-batch events)))
          (if (and (> (length text) 0)
                   (string= (buffer-current) (fikra/thread/fikra-thread-buffer-name)))
            (let ((was-ro (buffer-read-only-p)))
              (buffer-set-read-only nil)
              (buffer-append text)
              (buffer-set-read-only was-ro)))))
      ;; 3. Record in memory.
      (dolist (e events)
        (setq fikra-event-memory (cons e fikra-event-memory)))
      (fikra-event-run-hook)
      t)))

(defun fikra-event-batch-has-tombstone-p (events)
  (let ((found nil))
    (dolist (e events)
      (if (string= (fikra-event-get-str e "kind") "checkpoint-reverted")
        (setq found t)))
    found))

;; Rebuild the *Fikra* buffer from the log (must be current when called).
(defun fikra-event-rebuild-fikra-buffer ()
  (require-module fikra/thread)
  (let ((was-ro (buffer-read-only-p))
        (text (fikra-event-replay)))
    (buffer-set-read-only nil)
    (let ((count (buffer-line-count)))
      ;; A 1-line empty buffer is the fresh state — nothing to delete (and
      ;; deleting from an empty buffer errors).
      (if (> count 1)
        (buffer-delete-range 0 0 (- count 1) 0)))
    (if (> (length text) 0)
      (buffer-append text))
    (buffer-set-read-only was-ro)
    t))

;; Shared render fold: events -> text with the text-run state machine
;; (adjacent text-deltas join under one "AI: " prefix; any other event
;; closes the run). OPEN-FLAG is threaded explicitly so replay can run the
;; fold with its own state without touching emit's.
(defun fikra-event-render-fold (events out open)
  (if (null events)
    out
    (let ((e (car events))
          (kind (fikra-event-get-str (car events) "kind")))
      (if (string= kind "text-delta")
        (fikra-event-render-fold (cdr events)
          (concat out
                  (if open ""
                    (if (string= (fikra-event-get-str (car events) "speaker") "user")
                      (fikra-face "\e[1;34m" "You: ")
                      (fikra-face "\e[1;35m" "AI: ")))
                  (fikra-event-get-str (car events) "text"))
          t)
        (fikra-event-render-fold (cdr events)
          (concat out (if open "\n" "") (fikra-event-render-line (car events)))
          nil)))))

;; Batch renderer for emit (threads the global run state).
(defun fikra-event-render-batch (events)
  (let ((text (fikra-event-render-fold events "" fikra-text-open)))
    ;; Keep the global run-state in step with the batch's LAST event.
    (if (> (length events) 0)
      (setq fikra-text-open
        (string= (fikra-event-get-str (last events) "kind") "text-delta")))
    text))

;; Read the log, dropping a trailing partial line (crash tolerance: the
;; last write may have been interrupted mid-line).
(defun fikra-event-read-log-lines ()
  (let ((raw (if (file-exists-p fikra-event-log)
               (read-file-content fikra-event-log)
               "")))
    (if (or (null raw) (string= raw ""))
      (list)
      (let ((lines (string-split raw "\n")))
        ;; A trailing "" from the final newline is not a partial line; a
        ;; non-empty final element IS partial (no newline) — drop it.
        (if (and (> (length lines) 0) (string= (last lines) ""))
          (setq lines (reverse (cdr (reverse lines)))))
        (if (> (length lines) 0)
          (let ((lastln (last lines)))
            (if (not (fikra-event-line-complete-p lastln))
              (setq lines (reverse (cdr (reverse lines)))))))
        lines))))

;; A complete line parses as JSON (cheap validity probe).
(defun fikra-event-line-complete-p (line)
  (if (or (null line) (string= line ""))
    nil
    (condition-case nil
      (let ((parsed (json-read-from-string line)))
        (not (null parsed)))
      (error nil))))

;; Replay: log -> full transcript. Crash-tolerant (partial trailing line
;; dropped). Tombstone-aware: checkpoint-reverted {target, revert-point}
;; invalidates the turn range (target, revert-point]; those events were
;; emitted BEFORE the tombstone, so replay PRE-SCANS for tombstones and
;; renders skipping invalidated turns. The tombstone renders ONE collapsed
;; marker; rendering CONTINUES for post-revert turns (numbers past
;; revert-point).
;; #304: dedupe turn-endings by TURN IDENTITY — a turn's ending is the
;; LAST turn-end for its id in the log prefix; earlier endings for the
;; same id drop at render regardless of what intervenes (non-consecutive
;; covered), the LAST status by log order wins (a turn that errored then
;; completed renders completed — log order is the truth), and the drops
;; are counted (replay notes "N stale endings dropped" in *Messages*).
;; Distinct ids NEVER merge (adjacent same-status turns both render).
;; Logs with NO turn ids (probe-era legacy) keep the old consecutive rule
;; (those logs are frozen history).
(defvar fikra-dedupe-dropped 0
  "Stale endings dropped by the last id-based dedupe pass (#304).")

(defun fikra-event-dedupe-markers (events)
  (setq fikra-dedupe-dropped 0)
  (if (fikra-dedupe-has-ids events)
    (fikra-dedupe-by-id (reverse events) (hashmap) (list))
    (fikra-dedupe-scan events (list) "" "")))

;; The turn id as a STRING (logs carry numbers, fixtures carry strings,
;; missing reads nil — "length requires string or list" otherwise).
(defun fikra-dedupe-turn-id (e)
  (let ((v (fikra-event-get-str e "turn")))
    (cond
      ((stringp v) v)
      ((numberp v) (number-to-string v))
      (t ""))))

;; Any turn-end carrying a turn id?
(defun fikra-dedupe-has-ids (events)
  (let ((found nil))
    (dolist (e events)
      (if (and (not found)
               (string= (fikra-event-get-str e "kind") "turn-end")
               (> (length (fikra-dedupe-turn-id e)) 0))
        (setq found t)))
    found))

;; Backward scan: the FIRST turn-end seen per id (from the end) is the
;; LAST by log order — keep it; every later sighting for the same id is a
;; stale ending (dropped + counted). MIXED logs (appended across the
;; probe→id transition) get the CONSECUTIVE rule for their ID-LESS
;; endings: the later of two adjacent identical id-less ends drops
;; (verify-gate r1 — the id arm alone never deduped them). In the
;; backward walk, the ORIGINAL-order predecessor is (cadr rev-events).
(defun fikra-dedupe-by-id (rev-events seen acc)
  ;; Iterating the REVERSED list, cons-building yields FORWARD order
  ;; already — no final reverse (the double-reverse shipped reversed
  ;; transcripts; caught by the replay regression tests).
  (if (null rev-events)
    acc
    (let* ((e (car rev-events))
           (tid (fikra-dedupe-turn-id e))
           (is-end (string= (fikra-event-get-str e "kind") "turn-end"))
           (pred (if (cdr rev-events) (car (cdr rev-events)) nil))
           (pred-endless-id (and pred
                                 (string= (fikra-event-get-str pred "kind") "turn-end")
                                 (string= (fikra-dedupe-turn-id pred) "")))
           (pred-same-status (and pred-endless-id
                                  (string= (fikra-event-get-str e "status")
                                           (fikra-event-get-str pred "status")))))
      (if (and is-end (= (length tid) 0) pred-same-status)
        (progn
          ;; This id-less end is the LATER of an adjacent identical pair —
          ;; the consecutive rule drops it.
          (setq fikra-dedupe-dropped (+ 1 fikra-dedupe-dropped))
          (fikra-dedupe-by-id (cdr rev-events) seen acc))
        (if (and is-end (> (length tid) 0))
          (if (hashmap-get seen tid)
            (progn
              (setq fikra-dedupe-dropped (+ 1 fikra-dedupe-dropped))
              (fikra-dedupe-by-id (cdr rev-events) seen acc))
            (fikra-dedupe-by-id (cdr rev-events)
              (progn (editor/keymaps/keymap-mutable-set! seen tid t) seen)
              (cons e acc)))
          (fikra-dedupe-by-id (cdr rev-events) seen (cons e acc)))))))

;; The legacy consecutive rule (no-id logs only).
(defun fikra-dedupe-scan (events acc last-kind last-status)
  (if (null events)
    (reverse acc)
    (let* ((e (car events))
           (k (fikra-event-get-str e "kind"))
           (st (fikra-event-get-str e "status")))
      (if (and (string= k "turn-end")
               (string= last-kind "turn-end")
               (string= st last-status))
        (fikra-dedupe-scan (cdr events) acc last-kind last-status)
        (fikra-dedupe-scan (cdr events) (cons e acc) k
          (if (string= k "turn-end") st last-status))))))

;; Merge checkpoint-ready markers INLINE (mockup 8.1's "[ckpt ... ✓]"
;; on the buffer-edit row). Pure list transform: a checkpoint-ready that
;; directly follows a tool-call attaches its ref to that call and is
;; dropped; anything else keeps the standalone marker row.
;; Bounded association (r63): a checkpoint attaches ONLY to an EDIT-like
;; call in its OWN turn (the turn-start boundary resets the search; reads
;; and shell calls never carry the marker — the mockup's row is ⚙
;; buffer-edit, action-level provenance, overstating it is a lie).
(defun fikra-event-inline-ckpt-merge (events out last-kind)
  (if (null events)
    (reverse out)
    (let* ((e (car events))
           (k (fikra-event-get-str e "kind")))
      (cond
        ((string= k "turn-start")
          ;; A new turn: everything before is OUT OF SCOPE for attachment.
          (fikra-event-inline-ckpt-merge (cdr events) (cons e out) 'turn))
        ((string= k "checkpoint-ready")
          ;; IDENTITY, not just proximity (r66: turn-start 1 → Edit →
          ;; turn-start 2 → Edit → checkpoint(main/1) attached turn 1's
          ;; ref to turn 2's edit — the boundary limited position, not
          ;; identity). The checkpoint's ref turn must EQUAL the turn of
          ;; the call it would attach to.
          (let* ((ckpt-id (fikra-inline-ref-identity
                         (fikra-event-get-str e "ref")))
                 (call-idx (if (eq last-kind 'turn)
                             nil
                             (fikra-inline-find-call out 0)))
                 (call-id (if call-idx
                            (fikra-inline-event-identity out call-idx)
                            nil)))
            ;; Full identity: "<thread>/<turn>" on BOTH sides, and NO
            ;; attach when either is unparseable (r67: a missing side
            ;; used to attach — no identity, no marker).
            (if (and call-idx ckpt-id call-id (string= ckpt-id call-id))
              (fikra-event-inline-ckpt-merge (cdr events)
                (fikra-inline-replace out call-idx
                  (fikra-event-with-ckpt (nth call-idx out)
                    (fikra-event-get-str e "ref")))
                last-kind)
              (fikra-event-inline-ckpt-merge (cdr events) (cons e out) last-kind))))
        (t
          (fikra-event-inline-ckpt-merge (cdr events) (cons e out) k))))))

;; "<thread>/<turn>" from refs/fikra/<id>/<n>[-baseline] — the FULL
;; identity (nil when unparseable).
(defun fikra-inline-ref-identity (ref)
  ;; Namespace-validated (r68): only refs/fikra/<id>/<n>[-baseline]
  ;; parses — anything else is nil (a "bogus/main/2" must NOT match a
  ;; real identity; the guard was lost in the r71 segment rename —
  ;; codex r74's solo-rerun catch).
  (if (not (string-prefix-p "refs/fikra/" (if ref ref "")))
    nil
    (fikra-inline-ref-id-scan (string-split ref "/") (list))))

(defun fikra-inline-ref-id-scan (segs acc)
  (if (null segs)
    (let ((kept acc)) ;; kept = (turn id) newest-first.
      (if (>= (length kept) 2)
        (concat (nth 1 kept) "/" (fikra-inline-strip-baseline (nth 0 kept)))
        nil))
    (fikra-inline-ref-id-scan (cdr segs)
      (if (or (string= (car segs) "refs") (string= (car segs) "fikra"))
        acc
        (cons (car segs) acc)))))

(defun fikra-inline-strip-baseline (seg)
  (if (and (> (length seg) 9)
           (string-suffix-p "-baseline" seg))
    (substring seg 0 (- (length seg) 9))
    seg))

;; "<thread>/<turn>" for the event at OUT index I: the current thread +
;; its turn-start's number (nil when no turn-start precedes).
;; NO substitution (r68): a missing thread id or turn is a MISSING
;; identity — the merge refuses the attach ("main" here would let a
;; main/N checkpoint attach to an unidentified event).
(defun fikra-inline-event-identity (out i)
  (if (>= i (length out))
    nil
    (let ((ev (nth i out)))
      (if (string= (fikra-event-get-str ev "kind") "turn-start")
        (let* ((tn (fikra-event-get ev "turn"))
               (tid (condition-case nil
                        (progn (require-module fikra/thread)
                               (let ((t0 (fikra/thread/fikra-thread-current)))
                                 (if (and t0 (> (length t0) 0)) t0 nil)))
                        (error () nil))))
          (if (and tn tid)
            (concat tid "/" (number-to-string tn))
            nil))
        (fikra-inline-event-identity out (+ i 1))))))

;; The index of the nearest EDIT-like tool-call in OUT, stopping at the
;; turn boundary, or nil.
(defun fikra-inline-find-call (out i)
  (if (>= i (length out))
    nil
    (let ((ev (nth i out))
          (k (fikra-event-get-str (nth i out) "kind")))
      (cond
        ((string= k "turn-start") nil)
        ;; Any intervening TOOL activity is a nearer action — an
        ;; Edit→bash→checkpoint sequence must NOT reach past the bash
        ;; (r64: the marker implies action-level association).
        ((and (string= k "tool-call")
              (not (fikra-inline-edit-p (fikra-event-get-str ev "tool"))))
          nil)
        ((and (string= k "tool-call")
              (fikra-inline-edit-p (fikra-event-get-str ev "tool")))
          i)
        (t (fikra-inline-find-call out (+ i 1)))))))

;; The mockup's edit-bearing tools (the claude CLI's Edit/Write/NotebookEdit
;; + our buffer-edit naming).
(defun fikra-inline-edit-p (tool)
  (or (string= tool "buffer-edit")
      (string= tool "Edit")
      (string= tool "Write")
      (string= tool "MultiEdit")
      (string= tool "NotebookEdit")))

;; Replace index I in the reversed accumulator OUT (rebuild the tail).
(defun fikra-inline-replace (out i new)
  (if (= i 0)
    (cons new (cdr out))
    (cons (car out) (fikra-inline-replace (cdr out) (- i 1) new))))

;; Attach the ckpt ref to EVENT (both shapes: the FAEP parse yields
;; ALISTS — cons the pair; hashmaps get a copied set).
(defun fikra-event-with-ckpt (event ref)
  (if (hashmapp event)
    (let ((copy (hashmap)))
      (dolist (k (hashmap-keys event))
        (editor/keymaps/keymap-mutable-set! copy k (hashmap-get event k)))
      (editor/keymaps/keymap-mutable-set! copy "ckpt" ref)
      copy)
    (cons (list "ckpt" ref) event)))

(defun fikra-event-replay ()
  (if (not fikra-event-log)
    ""
    (let ((events (fikra-event-parse-lines (fikra-event-read-log-lines))))
      (let ((deduped (fikra-event-dedupe-markers events)))
        ;; #304: the count notes stale endings dropped on replay.
        (if (> fikra-dedupe-dropped 0)
          (message (concat (number-to-string fikra-dedupe-dropped)
                           " stale ending" (if (= fikra-dedupe-dropped 1) "" "s")
                           " dropped")))
        ;; r62 follow-up: the mockup puts the ckpt marker INLINE on the
        ;; edit row. Merge each checkpoint-ready into the tool-call it
        ;; follows (when one does); otherwise the standalone row stands.
        (let ((merged (fikra-event-inline-ckpt-merge deduped (list) nil)))
          (fikra-event-render-skip merged
            (fikra-event-tombstone-ranges events) 0 "" nil))))))

;; JSONL lines -> parsed events (unparseable lines skipped).
(defun fikra-event-parse-lines (lines)
  (let ((out (list)))
    (dolist (line lines)
      (let ((e (condition-case nil (json-read-from-string line) (error nil))))
        (if (not (null e))
          (setq out (cons e out)))))
    (reverse out)))

;; Tombstones -> list of (from . to) turn ranges to skip:
;; from = target+1, to = revert-point (the range (target, point]).
(defun fikra-event-tombstone-ranges (events)
  (let ((out (list)))
    (dolist (e events)
      (if (string= (fikra-event-get-str e "kind") "checkpoint-reverted")
        (setq out (cons (list
                          (+ 1 (fikra-event-tombstone-turn e "target"))
                          (fikra-event-tombstone-turn e "revert-point"))
                        out))))
    out))

;; Turn field can arrive as a JSON number OR string — normalize.
(defun fikra-event-turn-num (event)
  (let ((v (fikra-event-get event "turn")))
    (cond
      ((numberp v) v)
      ((stringp v) (string-to-number v))
      (t 0))))

;; Turn field of a TOMBSTONE may be a bare number, a numeric string, or a
;; full ref name (refs/fikra/main/3-baseline) — extract the turn integer
;; from the thread/turn segment.
(defun fikra-event-tombstone-turn (event key)
  (let ((v (fikra-event-get event key)))
    (cond
      ((numberp v) v)
      ((stringp v)
        (let ((n (fikra-ref-turn-digits v)))
          (if n n 0)))
      (t 0))))

;; "refs/fikra/main/3-baseline" → 3 ; "3" → 3 ; garbage → nil.
;; Manual slicing (no regex — T-Lisp string escaping makes regex brackets
;; fragile). Algorithm: strip a trailing "-baseline"; if a "/" remains,
;; take the segment after the LAST "/"; digits-only then number, else nil.
(defun fikra-ref-turn-digits (s)
  (let ((base (if (>= (length s) 9)
                (if (string= (substring s (- (length s) 9) (length s)) "-baseline")
                  (substring s 0 (- (length s) 9))
                  s)
                s)))
    (let ((seg (fikra-segment-after-last-slash base 0 nil)))
      (if (and seg (fikra-all-digits-p seg) (> (length seg) 0))
        (string-to-number seg)
        nil))))

(defun fikra-segment-after-last-slash (s i last-slash)
  (if (>= i (length s))
    (if last-slash (substring s (+ last-slash 1) (length s)) s)
    (fikra-segment-after-last-slash s (+ i 1)
      (if (string= (substring s i (+ i 1)) "/") i last-slash))))

(defun fikra-all-digits-p (s)
  (fikra-digits-scan s 0))

(defun fikra-digits-scan (s i)
  (if (>= i (length s))
    t
    (if (string-match "^[0-9]$" (substring s i (+ i 1)))
      (fikra-digits-scan s (+ i 1))
      nil)))

(defun fikra-event-in-range-p (turn ranges)
  (if (null ranges)
    nil
    (if (and (>= turn (car (car ranges))) (<= turn (car (cdr (car ranges)))))
      t
      (fikra-event-in-range-p turn (cdr ranges)))))

;; Render with turn tracking: events inside an invalidated range are
;; swallowed; the tombstone renders its marker. Turn 0 = pre-first-turn
;; events (session etc.) always render.
(defun fikra-event-render-skip (events ranges turn out open)
  (if (null events)
    out
    (let ((kind (fikra-event-get-str (car events) "kind")))
      (cond
        ((string= kind "turn-start")
          ;; Header renders only for turns OUTSIDE invalidated ranges.
          (let ((tn (fikra-event-turn-num (car events))))
            (fikra-event-render-skip (cdr events) ranges tn
              (if (fikra-event-in-range-p tn ranges)
                out
                (concat out (if open "\n" "") (fikra-event-render-line (car events))))
              nil)))
        ((string= kind "checkpoint-reverted")
          (fikra-event-render-skip (cdr events) ranges turn
            (concat out (if open "\n" "") (fikra-event-render-line (car events))) nil))
        ((or (= turn 0) (not (fikra-event-in-range-p turn ranges)))
          (if (string= kind "text-delta")
            (fikra-event-render-skip (cdr events) ranges turn
              (concat out
                      (if open ""
                        (if (string= (fikra-event-get-str (car events) "speaker") "user")
                          (fikra-face "\e[1;34m" "You: ")
                          (fikra-face "\e[1;35m" "AI: ")))
                      (fikra-event-get-str (car events) "text"))
              t)
            (fikra-event-render-skip (cdr events) ranges turn
              (concat out (if open "\n" "") (fikra-event-render-line (car events))) nil)))
        (t
          (fikra-event-render-skip (cdr events) ranges turn out open))))))
(defun fikra-event-events ()
  "In-memory events, oldest-first."
  (reverse fikra-event-memory))

(provide "fikra-event")
)
