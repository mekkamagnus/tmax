(defmodule fikra/transient
  (export fikra-transient-start fikra-transient-stop
          fikra-transient-running-p fikra-transient-tick
          fikra-transient-revision fikra-transient-segment
          fikra-transient-active-p fikra-transient-count
          fikra-transient-note-running fikra-transient-note-terminal
          fikra-transient-note-chunks fikra-transient-chunks-of
          fikra-transient-elapsed-of fikra-transient-frozen-p
          fikra-transient-mark-rendered fikra-transient-mark-rendered-for
          fikra-any-thread-running-p fikra-thread-is-running-p
          fikra-transient-viewed-segment fikra-transient-viewed-segment-for
          fikra-transient-spinner-glyph fikra-transient-gerund
          fikra-transient-format-elapsed)

;; #318 — the DISPLAY-LAYER REPAINT CADENCE. Fikra is event-driven
;; end-to-end; the animation layer is DAEMON-SIDE TRANSIENT STATE, kept
;; OUTSIDE the buffer/event log (a display-layer hashmap — #306's
;; mutation-shared carrier). A tick bumps a revision + spinner frame; it
;; NEVER mutates a buffer or the event log (asserted by byte-compare).
;;
;; #319 — the ANIMATED WORKING INDICATOR rides the same layer:
;;   <glyph> <gerund> · <N> chunks · <elapsed>
;; The chunk counter counts the two DELTA kinds (text-delta +
;; tool-input-delta — the issue's named rule; completions — tool-call,
;; finished text — are not deltas and do not count). Elapsed starts at
;; the turn's FIRST STREAMED event (any content kind; a transient
;; timestamp, never persisted); a mid-turn attach reads the same daemon
;; state. The terminal sequence is deterministic and RENDER-GATED: the
;; frozen frame (✓, elapsed captured at the edge) rides polls until a
;; client SERVES it, the tick after that clears it, and only then does
;; the interval stop — both frames ride real poll cycles in either
;; tick/poll order (a ~10-tick headless bound clears unserved frames).
;;
;; Lifecycle: the interval runs ONLY while ≥1 thread is running OR an
;; unrendered frozen frame remains (started on the first running
;; transition; the tick settles the stop). Client connect/disconnect
;; never starts/stops it — thread state owns it.

;; thread.tlisp requires THIS module only lazily (at status-set time),
;; so this eager require is acyclic: the registry queries + the
;; buffer→thread inverse lookup resolve reliably in the daemon runtime
;; (#318 gate-final hardening; restored 2026-11-21 after the #319
;; rewrite dropped it — a first restore attempt silently no-opped and
;; codex r4 caught the message/ tree mismatch).
(require-module fikra/thread)

(defvar fikra-transient-rev 0
  "The transient revision — rides the poll response beside bufferRevision.")
(defvar fikra-transient-ticks 0
  "Total ticks since the daemon started (test surface).")
(defvar fikra-transient-active nil
  "t while the interval is running (the lifecycle flag).")
(defvar fikra-transient-now 0
  "The TS clock (ms) stamped by each tick — the elapsed reference.")

;; Per-thread indicator state (hashmap id → value).
(defvar fikra-transient-chunks (hashmap)
  "id → streamed-chunk count (the two DELTA kinds: text-delta + tool-input-delta).")
(defvar fikra-transient-starts (hashmap)
  "id → the turn's FIRST streamed event timestamp (ms; nil until then).")
(defvar fikra-transient-frozen (hashmap)
  "id → 0 none · 1 frozen PENDING-RENDER (a tick must not clear it
  before a poll serves it) · 2 frozen RENDERED (the next tick clears).")
(defvar fikra-transient-frozen-elapsed (hashmap)
  "id → the elapsed ms CAPTURED at the terminal edge (the frozen frame's
  clock stops here — later ticks must not advance it).")
(defvar fikra-transient-frozen-seg (hashmap)
  "id → the COMPLETE frozen segment STRING captured at the terminal edge
  (later ticks cannot change a word of it).")
(defvar fikra-transient-frozen-age (hashmap)
  "id → ticks since the terminal edge while the frame sits PENDING (no
  client served it). A headless turn (no attached poll) must not leak
  the interval forever: ~10 ticks (2s) unserved clears it.")

(defun fikra-transient-count () fikra-transient-ticks)

(defun fikra-transient-active-p ()
  (if fikra-transient-active t nil))

(defun fikra-transient-running-p ()
  "t when the transient layer should render (>= 1 thread running AND the
interval live)."
  (if (and fikra-transient-active (fikra-any-thread-running-p)) t nil))

(defun fikra-transient-revision ()
  "The current transient revision (the client's second comparison)."
  fikra-transient-rev)

(defun fikra-transient-start ()
  "Start the interval (idempotent). Thread-state transitions call this on
every ->running edge; the guard makes repeats no-ops."
  (if fikra-transient-active
    nil
    (progn
      (setq fikra-transient-active t)
      (editor-transient-timer-start)
      t)))

(defun fikra-transient-stop ()
  "Stop the interval. The TS shell stop is UNCONDITIONAL (idempotent
shell-side) — a module reload resets the active defvar to nil, and the
old guarded stop leaked the live interval forever (gate r2)."
  (setq fikra-transient-active nil)
  (editor-transient-timer-stop)
  t)

;; The tick body — the interval shell calls this every 200ms with the TS
;; clock (ms). Bumps the revision + tick count ONLY (no buffer/event
;; mutations).
(defun fikra-transient-tick (now-ms)
  (setq fikra-transient-now now-ms)
  (if (not fikra-transient-active)
    ;; RECONCILE a leaked interval (module reload reset the defvars):
    ;; a still-running thread RESUMES the layer; none running → KILL
    ;; the shell.
    (if (fikra-any-thread-running-p)
      (progn (setq fikra-transient-active t) (fikra-transient-tick now-ms))
      (progn (editor-transient-timer-stop) nil))
    (progn
      (setq fikra-transient-ticks (+ 1 fikra-transient-ticks))
      (setq fikra-transient-rev (+ 1 fikra-transient-rev))
      ;; #319: age every frozen frame — a PENDING one (1) waits for its
      ;; poll; a RENDERED one (2) clears on this tick.
      (fikra-transient-age-frozen (hashmap-keys fikra-transient-frozen))
      ;; Auto-stop: the interval stops one tick AFTER the last running
      ;; thread's terminal (the frozen→clear frames must ride REAL poll
      ;; cycles). The AUTHORITATIVE registry answers "any running".
      (if (and (not (fikra-any-thread-running-p))
               (fikra-transient-no-live-frozen-p))
        (fikra-transient-stop)
        t))))

(defun fikra-transient-age-frozen (ids)
  ;; RENDER-GATED clearing (codex r1 catch 4): a pending frame (1) waits
  ;; for its poll; a RENDERED frame (2) clears on this tick. Headless
  ;; bound: a pending frame unserved for ~10 ticks (2s) clears anyway —
  ;; no attached client may leak the interval forever.
  (if (null ids)
    nil
    (let ((id (car ids)) (rest (cdr ids)))
      (let ((n (hashmap-get fikra-transient-frozen id)))
        (cond
          ((= n 2)
            (editor/keymaps/keymap-mutable-set! fikra-transient-frozen id 0))
          ((= n 1)
            (let ((age (+ 1 (fikra-transient-pending-age id))))
              (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-age id age)
              (if (>= age 10)
                (editor/keymaps/keymap-mutable-set! fikra-transient-frozen id 0))))))
      (fikra-transient-age-frozen rest))))

(defun fikra-transient-pending-age (id)
  (let ((a (hashmap-get fikra-transient-frozen-age id)))
    (if a a 0)))

(defun fikra-transient-no-live-frozen-p ()
  "t when no frozen frame remains to render (all aged to 0)."
  (let ((live nil))
    (dolist (id (hashmap-keys fikra-transient-frozen))
      (if (and (not live) (> (hashmap-get fikra-transient-frozen id) 0))
        (setq live t)))
    (not live)))

;; ── the chunk/elapsed hooks (event.tlisp calls these on emit) ──────
(defun fikra-transient-note-chunks (id n streamed)
  "A batch arrived for thread ID: N COUNTED deltas (text-delta +
tool-input-delta — the named rule) bump the chunk counter; STREAMED (any
content event — deltas, thought, tool-call) stamps the elapsed start on
the turn's FIRST streamed event (codex r1 catch 2: an early thought
must start the clock even though it does not count)."
  (if (> n 0)
    (editor/keymaps/keymap-mutable-set! fikra-transient-chunks id
      (+ n (fikra-transient-chunks-of id))))
  (if (and streamed (null (hashmap-get fikra-transient-starts id)))
    (editor/keymaps/keymap-mutable-set! fikra-transient-starts id
      (editor-time-now)))
  t)

(defun fikra-transient-chunks-of (id)
  (let ((n (hashmap-get fikra-transient-chunks id)))
    (if n n 0)))

(defun fikra-transient-elapsed-of (id)
  "The thread's elapsed ms from its FIRST streamed event (0 before)."
  (let ((start (hashmap-get fikra-transient-starts id)))
    (if (or (null start) (= fikra-transient-now 0))
      0
      (max 0 (- fikra-transient-now start)))))

(defun fikra-transient-frozen-p (id)
  "t while the thread's terminal FROZEN frame is still rideable (> 0)."
  (let ((n (hashmap-get fikra-transient-frozen id)))
    (if (and n (> n 0)) t nil)))

(defun fikra-transient-format-elapsed (ms)
  "Human elapsed: 42s / 1m12s / 12m03s."
  (let ((total (floor (/ ms 1000))))
    (if (< total 60)
      (concat (number-to-string total) "s")
      (concat (number-to-string (floor (/ total 60))) "m"
              (fikra-two-digits (mod total 60)) "s"))))

(defun fikra-two-digits (n)
  (if (< n 10) (concat "0" (number-to-string n)) (number-to-string n)))

;; The transient SEGMENT for the frame: the indicator row for ONE thread
;; — running (live) or freshly terminal (frozen ✓); nil for an idle or
;; long-finished thread.
(defun fikra-transient-segment (thread-id)
  (cond
    ((fikra-transient-frozen-p thread-id)
      ;; The COMPLETE frame captured at the terminal edge — byte-stable
      ;; across any later ticks (codex r1 catch 4).
      (hashmap-get fikra-transient-frozen-seg thread-id))
    ((and fikra-transient-active (fikra-thread-is-running-p thread-id))
      (concat (fikra-transient-spinner-glyph) " " (fikra-transient-gerund) " · "
              (number-to-string (fikra-transient-chunks-of thread-id)) " chunks · "
              (fikra-transient-format-elapsed (fikra-transient-elapsed-of thread-id))))
    (t nil)))

(defun fikra-transient-frozen-ms-of (id)
  "The elapsed ms captured at the terminal edge (0 for a thread that
never streamed)."
  (let ((ms (hashmap-get fikra-transient-frozen-elapsed id)))
    (if ms ms 0)))

(defun fikra-transient-spinner-glyph ()
  ;; 4-frame rotation on the tick count.
  (let ((m (mod fikra-transient-ticks 4)))
    (cond
      ((= m 0) "|")
      ((= m 1) "/")
      ((= m 2) "—")
      (t "\\"))))

(defun fikra-transient-gerund ()
  ;; The fixed verb list cycles on the tick (independent 3-frame cycle).
  (let ((m (mod fikra-transient-ticks 3)))
    (cond
      ((= m 0) "pondering")
      ((= m 1) "reading")
      (t "editing"))))

;; ── thread-state predicates — AUTHORITATIVE: thread.tlisp's registry
;; answers (status-of / any-running-p). The transition hooks below still
;; drive the START/STOP edges eagerly, but no shadow bookkeeping exists
;; to go stale.
(defun fikra-any-thread-running-p ()
  (fikra/thread/fikra-thread-any-running-p))

(defun fikra-thread-is-running-p (id)
  (string= (fikra/thread/fikra-thread-status-of id) "running"))

;; The transition hooks (thread.tlisp's status-set calls these on the
;; display-relevant edges; id is the transitioning thread).
(defun fikra-transient-note-running (id from)
  "A ->running edge. A NEW TURN (from idle/error/interrupted) resets the
per-thread indicator state; the APPROVAL RESUME (from confirming — the
same turn continues) preserves chunks + elapsed (codex r1 catch 3).
Either way the interval must be live."
  (if (or (string= from "idle")
          (string= from "error")
          (string= from "interrupted"))
    (progn
      (editor/keymaps/keymap-mutable-set! fikra-transient-chunks id 0)
      (editor/keymaps/keymap-mutable-set! fikra-transient-starts id nil)
      (editor/keymaps/keymap-mutable-set! fikra-transient-frozen id 0)
      (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-elapsed id 0)
      (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-seg id nil)
      (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-age id 0)))
  (fikra-transient-start))

(defun fikra-transient-note-terminal (id)
  "A terminal edge (idle/error/interrupted): capture the COMPLETE frozen
frame — the segment STRING at this instant (glyph ✓, the gerund as it
stands, final chunks, elapsed captured NOW — later ticks cannot change
a word of it; codex r1 catch 4) — and mark it pending-render. The CLEAR
is render-gated: the tick clears it only after a poll has SERVED it
(fikra-transient-mark-rendered), so both frames ride real poll cycles
regardless of the tick/poll race order."
  (let ((start (hashmap-get fikra-transient-starts id)))
    (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-elapsed id
      (if start (max 0 (- (editor-time-now) start)) 0)))
  (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-seg id
    (concat "✓ " (fikra-transient-gerund) " · "
            (number-to-string (fikra-transient-chunks-of id)) " chunks · "
            (fikra-transient-format-elapsed
              (fikra-transient-frozen-ms-of id))))
  (editor/keymaps/keymap-mutable-set! fikra-transient-frozen-age id 0)
  (editor/keymaps/keymap-mutable-set! fikra-transient-frozen id 1)
  ;; The interval MUST be live to carry this frame's clear (codex r5): a
  ;; terminal FROM CONFIRMING (running→confirming lets the tick stop —
  ;; confirming is not running; confirming→interrupted then freezes)
  ;; would otherwise strand the frame forever — no ticks to age, serve-
  ;; clear, or run the headless bound. Idempotent start.
  (fikra-transient-start)
  ;; Announce: the terminal frame CHANGES the display — clients whose
  ;; only delta is this segment must repaint (codex r2: a frozen frame
  ;; the client never displays must not be served-then-cleared unseen).
  (setq fikra-transient-rev (+ 1 fikra-transient-rev)))

;; The SERVE path (serialize's withTransientRevision) calls this after a
;; frozen segment rides a response: the NEXT tick may clear it.
(defun fikra-transient-mark-rendered (id)
  (if (= (hashmap-get fikra-transient-frozen id) 1)
    (editor/keymaps/keymap-mutable-set! fikra-transient-frozen id 2))
  t)

(defun fikra-transient-mark-rendered-for (buffer-name)
  "mark-rendered via the viewed buffer name (the helper's entry)."
  (let ((id (fikra/thread/fikra-thread-id-of-buffer buffer-name)))
    (if id (fikra-transient-mark-rendered id) nil)))

;; The VIEWED thread's segment (the daemon frame builder's display row):
;; the thread whose *Fikra* buffer the CLIENT is viewing.
(defun fikra-transient-viewed-segment-for (buffer-name)
  (let ((id (fikra/thread/fikra-thread-id-of-buffer buffer-name)))
    (if id (fikra-transient-segment id) nil)))

(defun fikra-transient-viewed-segment ()
  (fikra-transient-segment (fikra/thread/fikra-thread-current)))

(provide "fikra-transient"))
