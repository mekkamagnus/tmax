(defmodule editor/modes/auto-revert
  (export auto-revert-mode global-auto-revert-mode
          auto-revert-handle auto-revert-watched-p
          auto-revert-stop-all auto-revert-buffers-get
          auto-revert-note-kill)

;; auto-revert-mode.tlisp — revert-on-external-change (#329, RFC-028's
;; want; the classic emacs auto-revert). The PRIMITIVE layer is
;; file-watch-start/file-watch-stop (node:fs.watch in TS, per API
;; context); this mode is the buffer integration: when ON (globally —
;; buffer-local scoping rides a consumer need), every file-backed
;; buffer registers a watch; a change event reverts the matching
;; buffer UNLESS it is modified (dirty buffers are never clobbered —
;; the data-destroyer guard). A no-consumer-today caveat: the mode
;; ships OFF.

(defvar auto-revert-watches nil
  "The ((path id buffer-name) ...) registry — one watch per DISTINCT
file path (multiple buffers on one file share it).")
(defvar auto-revert-buffers 0
  "A diagnostic counter: reverts performed.")

(defun auto-revert-handle (path _event)
  "The watch callback: revert EVERY registered buffer backing PATH
(unless MODIFIED — a dirty buffer is never clobbered). Registered
globally as the watch callback; the path arrives via hex-decode."
  (dolist (entry (or auto-revert-watches (list)))
    (if (string= (nth 0 entry) path)
      ;; Entry = (path id buf1 buf2 ...): revert EVERY buffer on it.
      (dolist (b (auto-revert-buffers-of entry))
        (auto-revert-revert-buffer b path))))
  nil)

(defun auto-revert-revert-buffer (bufname fn)
  "Revert BUFNAME IN PLACE unless modified (the guard). Valve r1:
revert-buffer re-FINDS the filename — buffer-create replaces
same-named buffers, so a re-find could clobber a DIFFERENT buffer;
the in-place shape clears + refills the TARGET only. Valve r2:
read-only state AND the cursor are preserved (#127: buffer-switch
RESETS point — the capture happens BEFORE the switch; a background
buffer's point is not retained by the engine at all)."
  (if (member bufname (buffer-list))
    (let ((cur (buffer-current))
          (cl0 (cursor-line))
          (cc0 (cursor-column)))
      (buffer-switch bufname)
      (if (buffer-modified-p)
        (progn
          (editor-set-status (concat "auto-revert: " bufname " modified — not reverted"))
          (auto-revert-restore-cur cur))
        (let ((bfn (buffer-filename)))
          (if (not (and (stringp bfn) (string= bfn fn)))
            (progn
              (editor-set-status (concat "auto-revert: " bufname " no longer backs " fn))
              (auto-revert-restore-cur cur))
            (if (not (file-exists-p fn))
              (progn
                (editor-set-status (concat "auto-revert: " bufname " file gone"))
                (auto-revert-restore-cur cur))
              (let ((content (read-file-content fn)))
                (if (not (stringp content))
                  (progn
                    (editor-set-status (concat "auto-revert: " bufname " unreadable"))
                    (auto-revert-restore-cur cur))
                  (let ((was-ro (buffer-read-only-p))
                        (cl (if (string= bufname cur) cl0 0))
                        (cc (if (string= bufname cur) cc0 0)))
                    (progn
                      (buffer-set-read-only nil)
                      (auto-revert-clear-in-place)
                      (buffer-insert content)
                      (set-buffer-modified-p false)
                      (cursor-move (min cl (max (- (buffer-line-count) 1) 0)) cc)
                      (if was-ro (buffer-set-read-only t))
                      (setq auto-revert-buffers (+ auto-revert-buffers 1))
                      (editor-set-status (concat "auto-revert: " bufname " reverted"))
                      (auto-revert-restore-cur cur))))))))))))

(defun auto-revert-restore-cur (cur)
  ;; #127: buffer-switch RESETS point — switching back to the SAME
  ;; buffer would destroy the just-preserved cursor.
  (if (not (string= (buffer-current) cur))
    (buffer-switch cur))
  cur)

(defun auto-revert-clear-in-place ()
  ;; All-lines delete (the stagehand clear shape, in-module).
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (buffer-delete-range 0 0 (- count 1) 0)))
  (let ((l (buffer-line 0)))
    (if (and l (> (length l) 0))
      (buffer-delete-range 0 0 0 (length l)))))

(defun stagehand-clear-buffer-329 ()
  ;; A local all-lines delete (the stagehand clear shape — no
  ;; cross-module dependency for a three-line helper).
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (buffer-delete-range 0 0 (- count 1) 0)))
  (let ((l (buffer-line 0)))
    (if (and l (> (length l) 0))
      (buffer-delete-range 0 0 0 (length l)))))

(defun auto-revert-register-1 (bufname cur)
  ;; In BUFNAME's context: read its filename, restore, register —
  ;; POINT-SAFE (#127: both switches reset point; valve r4: the
  ;; registration scan was stomping the user's cursor).
  (let ((pl (cursor-line))
        (pc (cursor-column)))
    (buffer-switch bufname)
    (let ((fn (buffer-filename)))
      (auto-revert-restore-cur cur)
      (cursor-move pl pc)
    (if (and (stringp fn) (> (length fn) 0)
             (file-exists-p fn))
      (if (auto-revert-watched-p fn)
        ;; SHARED watch: append this buffer to the existing entry's
        ;; buffer list (gate r1: only the first buffer reverted) —
        ;; DEDUPED (gate r2: re-finding a file appended the same name
        ;; unboundedly; buffer-create replaces same-named buffers, so
        ;; one file = one buffer name in practice).
        (if (not (member bufname (auto-revert-buffers-of
                                   (auto-revert-entry-of (or auto-revert-watches (list)) fn))))
          (setq auto-revert-watches
            (auto-revert-append-buffer (or auto-revert-watches (list)) fn bufname)))
        (let ((id (file-watch-start fn "editor/modes/auto-revert/auto-revert-handle")))
          (if (numberp id)
            (setq auto-revert-watches
              (append (or auto-revert-watches (list))
                (list (list fn id bufname))))
            nil)))
      nil))))


(defun auto-revert-entry-of (entries path)
  (if (null entries)
    nil
    (if (string= (nth 0 (car entries)) path)
      (car entries)
      (auto-revert-entry-of (cdr entries) path))))

(defun auto-revert-buffers-of (entry)
  ;; Entry = (path id buf1 buf2 ...) — the buffer names from index 2.
  ;; (nthcdr does NOT exist in the stdlib.)
  (auto-revert-buffers-scan (reverse entry) (- (length entry) 2) (list)))

(defun auto-revert-buffers-scan (rev n acc)
  (if (<= n 0)
    acc
    (auto-revert-buffers-scan (cdr rev) (- n 1) (cons (car rev) acc))))

(defun auto-revert-append-buffer (entries path bufname)
  (if (null entries)
    (list)
    (if (string= (nth 0 (car entries)) path)
      (cons (append (car entries) (list bufname)) (cdr entries))
      (cons (car entries) (auto-revert-append-buffer (cdr entries) path bufname)))))

(defun auto-revert-register (bufname)
  "One watch for BUFNAME's file (shared per distinct path)."
  (auto-revert-register-1 bufname (buffer-current)))

(defun auto-revert-watched-p (path)
  (auto-revert-watched-scan (or auto-revert-watches (list)) path))

(defun auto-revert-watched-scan (entries path)
  (if (null entries)
    nil
    (if (string= (nth 0 (car entries)) path)
      t
      (auto-revert-watched-scan (cdr entries) path))))

(defun auto-revert-buffers-get ()
  "A diagnostic seam: the revert counter."
  auto-revert-buffers)

(defun auto-revert-scan-buffers ()
  "Register watches for every file-backed buffer not yet watched."
  (dolist (b (buffer-list))
    (auto-revert-register b))
  nil)

(defun auto-revert-stop-all ()
  "Stop every registered watch and clear the registry (the OFF path
and the test seam)."
  (dolist (entry (or auto-revert-watches (list)))
    (file-watch-stop (nth 1 entry)))
  (setq auto-revert-watches nil)
  t)

(defun auto-revert-mode (&optional (arg nil arg-supplied-p))
  "Toggle auto-revert mode (GLOBAL in v1 — buffer-local scoping
rides a consumer need). On = scan+watch every file-backed buffer;
OFF = stop all. Dirty buffers are never clobbered."
  (interactive)
  (if (not arg-supplied-p)
    (auto-revert-mode (not (auto-revert-active-p)))
    (if (equal arg t)
      (progn
        (setq auto-revert-enabled t)
        (auto-revert-scan-buffers)
        (editor-set-status "auto-revert mode enabled"))
      (progn
        (setq auto-revert-enabled nil)
        (auto-revert-stop-all)
        (editor-set-status "auto-revert mode disabled")))))

(defun global-auto-revert-mode (&optional (arg nil arg-supplied-p))
  "The global alias (v1 IS global; kept for emacs muscle memory).
Valve r1: the alias FORWARDS the full arg shape (the old two-arg
call passed arg-supplied-p as a POSITIONAL second arg — the mode's
&optional binds it as ARG)."
  (if (not arg-supplied-p)
    (auto-revert-mode)
    (auto-revert-mode arg)))

(defvar auto-revert-enabled nil
  "Whether auto-revert mode is on.")

;; LATE buffers (gate r1: the scan ran only at mode-ON): every
;; find-file runs find-file-hook; when the mode is on, the new
;; buffer registers. (add-hook does NOT dedup — safety rests on
;; require-module loading this module once.)
;; ADR-0311's gotcha: string hook entries eval GLOBALLY as
;; (name) — module paths are invisible there. The LAMBDA closes
;; over this module's env; execEntry calls it directly.
(add-hook "find-file-hook"
  (lambda () (auto-revert-on-find-file)))

(defun auto-revert-on-find-file ()
  (if (auto-revert-active-p)
    (auto-revert-register (buffer-current)))
  nil)

(defun auto-revert-active-p ()
  (if (null auto-revert-enabled) nil t))

;; ── kill-side lifecycle (valve r2) ───────────────────────────────────
(defvar auto-revert-dying-buffer nil
  "The buffer kill-buffer is about to kill (module-scoped — the
cross-module setter is auto-revert-note-kill).")

(defun auto-revert-note-kill (bufname)
  "Record the dying buffer (called from kill-buffer — module envs
are NOT in setq's lookup chain, so the bridge is a function)."
  (setq auto-revert-dying-buffer bufname)
  (if (auto-revert-active-p)
    (setq auto-revert-watches
      (auto-revert-prune-path (or auto-revert-watches (list)) bufname (list))))
  nil)

(defun auto-revert-prune-path (entries b acc)
  ;; Retire B from every entry whose path B backs (read the filename
  ;; BEFORE the kill takes it).
  (if (null entries)
    (reverse acc)
    (let* ((e (car entries))
           (fn (nth 0 e)))
      (if (auto-revert-buffer-backs-p b fn)
        (let ((rest (auto-revert-without (auto-revert-buffers-of e) b (list))))
          (if (null rest)
            (progn
              (file-watch-stop (nth 1 e))
              (auto-revert-prune-path (cdr entries) b acc))
            (auto-revert-prune-path (cdr entries) b
              (cons (append (list fn (nth 1 e)) rest) acc))))
        (auto-revert-prune-path (cdr entries) b (cons e acc))))))

(defun auto-revert-buffer-backs-p (bufname path)
  ;; POINT-SAFE (#127: both switches reset point — valve r4).
  (if (not (member bufname (buffer-list)))
    nil
    (let ((cur (buffer-current))
          (pl (cursor-line))
          (pc (cursor-column)))
      (buffer-switch bufname)
      (let ((fn (buffer-filename)))
        (auto-revert-restore-cur cur)
        (cursor-move pl pc)
        (and (stringp fn) (string= fn path))))))

(defun auto-revert-without (lst name acc)
  (if (null lst)
    (reverse acc)
    (if (string= (car lst) name)
      (auto-revert-without (cdr lst) name acc)
      (auto-revert-without (cdr lst) name (cons (car lst) acc)))))

(provide "auto-revert-mode")
)
