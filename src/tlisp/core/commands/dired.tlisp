(defmodule editor/commands/dired
  (export dired dired-open-entry dired-up dired-mark-delete dired-unmark
          dired-execute-deletions dired-quit dired-refresh dired-rename-entry
          dired-copy-entry dired-create-directory dired-next-entry dired-prev-entry
          dired-render dired-format-entry dired-execute-accept
          dired-mkdir-accept dired-rename-accept dired-copy-accept)

;; dired.tlisp — directory editor, RFC-041 #360 PHASE 1 (minimum usable
;; dired). Vim-motion keymap (user-fixed): j/k entry motion, l descend/open,
;; h parent, RET/o alias l, q quit, + mkdir, d/u/x delete marks, R rename,
;; C copy, g refresh-keeping-cursor. Out of scope by order: sort, hiding
;; dotfiles, folders-first, mark-by-pattern, second window, preview.
;;
;; Architecture: T-Lisp owns the logic. TS contributes only display
;; mechanics (dired-insert-lines / dired-toggle-mark / dired-get-marked)
;; and the generic fs primitives (read-dir, file-remove, file-symlink-p).
;;
;; Listing format (phase 1): two-char mark field, then the name — name
;; FIRST per the order, with a trailing / for directories. ".." is the
;; first entry; hidden files are shown; read-dir order otherwise (no sort).
;;
;; Buffer policy: ONE *Dired* buffer, updated in place on navigation
;; (descend and parent re-render the same buffer); q restores the buffer
;; that was current when dired was opened.

(major-mode-register "dired" '() nil '() '())
(major-mode-doc "dired" "Directory editor (RFC-041 #360 phase 1): vim-motion file management over a read-only listing.")

(defvar dired-return-buffer nil
  "The buffer to restore on q (set when dired opens from another buffer).")

(defvar dired-rename-source nil "Entry path awaiting rename-file's destination prompt.")
(defvar dired-copy-source nil "Entry path awaiting copy-file's destination prompt.")
(defvar dired-pending-deletions nil "Marked entry names awaiting the batch delete confirm.")
(defvar dired-pending-dir nil "The listing directory captured at x-time — the accept must not be redirected by a changed buffer (coach r7 finding 2).")

;; ── helpers ───────────────────────────────────────────────────────────

(defun dired-dirname (path)
  "Directory portion of PATH; \"/\" at root. (Local copy of the
file-ops/markdown convention — cross-module bare names do not resolve.)"
  (let ((i (- (length path) 1)))
    (while (and (> i 0) (not (string= (substring path i (+ i 1)) "/")))
      (set! i (- i 1)))
    (if (> i 0)
      (substring path 0 i)
      "/")))

(defun dired-entry-name-at (text)
  "The entry name in a listing line: columns after the two-char mark
field, the display directory suffix stripped, then DECODED from the
reversible display encoding (coach r8 finding 3) — the caller gets the
exact filesystem identity."
  (let ((rest (substring text 2)))
    (dired-decode-name
      (if (dired-entry-dir-p-at text)
        (substring rest 0 (- (length rest) 1))
        rest))))

(defun dired-entry-dir-p-at (text)
  "Whether a listing line's entry is a directory (trailing /)."
  (string= (substring text (- (length text) 1)) "/"))

(defun dired-current-line-text ()
  (buffer-get-line (cursor-line)))

(defun dired-current-name ()
  (dired-entry-name-at (dired-current-line-text)))

(defun dired-current-dir-p ()
  (dired-entry-dir-p-at (dired-current-line-text)))

(defun dired-current-path ()
  "Full path of the entry under the cursor (decoded identity, no
trailing slash)."
  (concat (buffer-filename) "/" (dired-current-name)))

(defun dired-plist-get (plist key)
  "Fetch KEY's value from the (key value ...) list file-stat returns."
  (if (or (null plist) (null (cdr plist)))
    nil
    (if (equal (car plist) key)
      (car (cdr plist))
      (dired-plist-get (cdr (cdr plist)) key))))

(defun dired-entry-dir-p (dir name)
  "Whether DIR/NAME navigates into a directory — a FOLLOWING stat, so
a symlink to a directory gets a trailing / and l enters it (coach r7
finding 5; read-dir's own isDirectory is lstat-shaped and says nil for
links). nil on a failed stat (dangling links are file-shaped rows)."
  (let ((st (file-stat (concat dir "/" name))))
    (if st
      (dired-plist-get st 'isDirectory)
      nil)))

(defun dired-format-entry (dir entry)
  "One listing line: mark field + name, with a trailing / when the
entry NAVIGATES as a directory (following stat)."
  (let ((name (hashmap-get entry "name")))
    (concat "  " (dired-encode-name name)
      (if (dired-entry-dir-p dir name) "/" ""))))

(defun dired-listing-lines (dir)
  "All listing lines for DIR: \"..\" first, then every read-dir entry
(hidden files included, read-dir order — phase 1 has no sort). Rows
whose names contain a newline are dropped at the DISPLAY boundary
(dired-insert-lines) — one entry must never become multiple actionable
rows (coach r7 finding 1). nil when DIR cannot be read."
  (let ((entries (read-dir dir)))
    (if entries
      (let ((rows (list "  ..")))
        (dolist (e entries)
          (setq rows (append rows (list (dired-format-entry dir e)))))
        rows)
      nil)))

;; ── entry point ───────────────────────────────────────────────────────

(defun dired (&optional path)
  "Open a directory listing (RFC-041 #360 phase 1).
With PATH, list it; with a file visited, list the file's directory;
otherwise list the process working directory. The target is
CANONICALIZED (file-realpath): relative names resolve against the
process cwd, trailing slashes and . / .. normalize, and / stays /
(coach r7 finding 4 — a relative visited file used to derive \"/\").
The listing buffer is read-only with dired-mode active; q returns to
the previous buffer."
  (interactive)
  (let ((raw (or path (dired-initial-dir))))
    (let ((dir (file-realpath raw)))
      (if (or (string= dir "") (not (dired-real-directory-p dir)))
        (message (concat "dired: cannot read " raw))
        (progn
          (unless (string= (buffer-current) "*Dired*")
            (setq dired-return-buffer (buffer-current)))
          (dired-render dir))))))

(defun dired-initial-dir ()
  "The directory to list when no PATH was given: the visited file's
directory — the process cwd when the filename has no slash (a bare
name lives in the cwd; dired-dirname would say \"/\") — or the cwd."
  (let ((fn (buffer-filename)))
    (if fn
      (if (string-contains-p "/" fn)
        (dired-dirname fn)
        (process-cwd))
      (process-cwd))))

(defun dired-real-directory-p (path)
  "t when PATH resolves and is a directory (following stat)."
  (let ((st (file-stat path)))
    (if st
      (dired-plist-get st 'isDirectory)
      nil)))

(defun dired-render (dir)
  "Build and install the listing for DIR in the *Dired* buffer.
Returns t on success; on an unreadable directory the old listing is
left intact and the failure is messaged (coach r7 finding 3)."
  (let ((real (file-realpath dir)))
    (if (or (string= real "") (not (dired-real-directory-p real)))
      (progn
        (message (concat "dired: cannot read " dir))
        nil)
      (let ((lines (dired-listing-lines real)))
        (if lines
          (progn
            (buffer-create "*Dired*")
            (buffer-switch "*Dired*")
            (set-buffer-filename real)
        (dired-insert-lines lines)
        (cursor-move 0 0)
        (set-buffer-modified-p nil)
        (buffer-set-read-only t)
        (major-mode-set "dired")
            (dired-ensure-keymap)
            t)
          (progn
            (message (concat "dired: cannot read " real))
            nil))))))

;; ── navigation ────────────────────────────────────────────────────────

(defun dired-next-entry ()
  "Move one entry down (j)."
  (interactive)
  (line-next 1))

(defun dired-prev-entry ()
  "Move one entry up (k)."
  (interactive)
  (line-previous 1))

(defun dired-open-entry ()
  "Go into the thing under the cursor (l / RET / o): descend into a
directory, find-file a regular file, go up on \"..\"."
  (interactive)
  (let ((name (dired-current-name)))
    (cond
      ((string= name "..")
        (dired-up))
      ((dired-current-dir-p)
        (dired-render (dired-current-path)))
      (t
        (find-file-open (dired-current-path))))))

(defun dired-up ()
  "Go up to the parent directory (h)."
  (interactive)
  (let ((dir (buffer-filename)))
    (if (string= dir "/")
      (message "dired: already at root")
      (dired-render (dired-dirname dir)))))

(defun dired-quit ()
  "Close the listing and return to the previous buffer (q)."
  (interactive)
  (let ((prev dired-return-buffer))
    (setq dired-return-buffer nil)
    (if (and prev (not (string= prev "*Dired*")))
      (funcall "switch-to-buffer" prev)
      (funcall "switch-to-buffer" "*scratch*"))
    (funcall "buffer-kill" "*Dired*")))

;; ── marks and deletion ────────────────────────────────────────────────

(defun dired-mark-delete ()
  "Mark the current entry for deletion and move down (d)."
  (interactive)
  (dired-toggle-mark "D")
  (line-next 1))

(defun dired-unmark ()
  "Remove the deletion mark and move down (u)."
  (interactive)
  (dired-toggle-mark " ")
  (line-next 1))

(defun dired-destructive-p (path)
  "Refuse the protected trees (same rule as the file-ops family): /,
$HOME, and the process working directory, compared on realpath."
  (let ((real (file-realpath path)))
    (or
      (string= real "/")
      (string= real (file-realpath "~"))
      (string= real (file-realpath (process-cwd))))))

(defun dired-execute-deletions ()
  "Carry out the marked deletions (x), behind ONE yes/no confirm for
the batch (phase 1 shape; each entry still passes the protected-path
guard, and \"..\" is never deleted). The listing directory is
captured HERE so a changed buffer cannot redirect the batch."
  (interactive)
  (let ((marked (dired-get-marked)))
    (if (= (length marked) 0)
      (message "No marked entries")
      (let ((dir (buffer-filename))
            (plan (list)))
        (dolist (name marked)
          (setq plan (append plan
            (list (hashmap "name" name
                           "kind" (dired-entry-kind (concat dir "/" name)))))))
        (setq dired-pending-deletions plan)
        (setq dired-pending-dir dir)
        (let ((trees (dired-plan-count-kind plan "tree")))
          (completing-read
            (concat "Delete " (number-to-string (length marked)) " marked entries"
              (if (> trees 0)
                (concat " (" (number-to-string trees) " tree"
                  (if (> trees 1) "s" "") " recursively)")
                "")
              "? ")
            "file-ops-yes-no-table"
            nil
            t
            ""
            "file-ops-history"
            "dired-execute-accept"))))))

(defun dired-entry-kind (path)
  "The entry's kind for the deletion plan: symlink, file, empty, tree,
unreadable, or missing. A failed read-dir is NEVER treated as empty
(coach r8 finding 1)."
  (cond
    ((file-symlink-p path) "symlink")
    (t
      (let ((st (file-stat path)))
        (if st
          (if (dired-plist-get st 'isDirectory)
            (let ((entries (read-dir path)))
              (if entries
                (if (= (length entries) 0) "empty" "tree")
                "unreadable"))
            "file")
          "missing")))))

(defun dired-plan-count-kind (plan kind)
  "How many plan entries carry KIND."
  (let ((n 0))
    (dolist (e plan)
      (if (string= (hashmap-get e "kind") kind)
        (set! n (+ n 1))))
    n))

(defun dired-remove-entry (path)
  "Remove one entry by its ACTUAL type (coach r7 finding 2): symlinks
(including dangling and directory links) unlink as links; real
directories remove recursively; files unlink. t/nil."
  (if (file-symlink-p path)
    (file-remove path)
    (if (dired-real-directory-p path)
      (file-remove path t)
      (file-remove path))))

(defun dired-execute-accept (answer)
  "Batch-delete confirm accept: on \"yes\", execute the CAPTURED plan
(coach r8 finding 1) — each entry's kind is RECHECKED; a changed or
missing entry is refused, never reinterpreted (a confirmed file that
became a nonempty directory SURVIVES). Confirmed empty directories
remove non-recursively (content added during the prompt survives);
confirmed symlinks unlink; confirmed trees remove recursively. The
summary keeps refusals and failures visible."
  (let ((plan dired-pending-deletions)
        (dir dired-pending-dir))
    (setq dired-pending-deletions nil)
    (setq dired-pending-dir nil)
    (if (string= answer "yes")
      (let ((deleted 0)
            (refused 0)
            (failed 0))
        (dolist (e plan)
          (let* ((name (hashmap-get e "name"))
                 (kind (hashmap-get e "kind"))
                 (path (concat dir "/" name))
                 (now (dired-entry-kind path)))
            (cond
              ((string= name "..")
                (set! refused (+ refused 1)))
              ((dired-destructive-p path)
                (set! refused (+ refused 1)))
              ((not (string= now kind))
                (set! refused (+ refused 1)))
              (t
                (let ((ok
                        (cond
                          ((string= kind "symlink") (file-remove path))
                          ((string= kind "file") (file-remove path))
                          ((string= kind "empty") (file-rmdir path))
                          ((string= kind "tree") (file-remove path t))
                          (t nil))))
                  (if ok
                    (set! deleted (+ deleted 1))
                    (set! failed (+ failed 1))))))))
        (if (string= (buffer-current) "*Dired*")
          (dired-refresh)
          t)
        (message (concat "Deleted " (number-to-string deleted)
          " entries (" (number-to-string refused) " refused, "
          (number-to-string failed) " failed)")))
      (message "Cancelled"))))

;; ── file operations (delegate to the file-ops family) ─────────────────

(defun dired-create-directory ()
  "Create a directory inside the listed one (+ — the #359 mkdir
command, prefilled with the listing's directory)."
  (interactive)
  (completing-read
    "Make directory: "
    "file-completion-table"
    nil
    nil
    (concat (buffer-filename) "/")
    "mkdir-history"
    "dired-mkdir-accept"))

(defun dired-mkdir-accept (path)
  "mkdir accept: run the #359 worker, refresh, then show the RESULT
(the refresh must not overwrite it — coach r7 finding 3)."
  (let ((res (funcall "mkdir-do" path)))
    (if (string= (buffer-current) "*Dired*") (dired-refresh) t)
    (message (if (stringp res) res "mkdir: done"))))

(defun dired-rename-entry ()
  "Rename the entry under the cursor (R — the #361 rename-file flow,
source filled in, destination prompted, then refresh)."
  (interactive)
  (let ((src (dired-current-path)))
    (setq dired-rename-source src)
    (completing-read
      (concat "Rename " src " to: ")
      "file-completion-table"
      nil
      nil
      src
      "rename-file-history"
      "dired-rename-accept")))

(defun dired-rename-accept (dest)
  (let ((src dired-rename-source))
    (setq dired-rename-source nil)
    ;; rename-file-do returns its outcome message; show it AFTER refresh.
    (let ((res (funcall "rename-file-do" src dest)))
      (if (string= (buffer-current) "*Dired*") (dired-refresh) t)
      (message (if (stringp res) res "rename-file: done")))))

(defun dired-copy-entry ()
  "Copy the entry under the cursor (C — the #361 copy-file flow,
source filled in, destination prompted, then refresh)."
  (interactive)
  (let ((src (dired-current-path)))
    (setq dired-copy-source src)
    (completing-read
      (concat "Copy " src " to: ")
      "file-completion-table"
      nil
      nil
      src
      "copy-file-history"
      "dired-copy-accept")))

(defun dired-copy-accept (dest)
  (let ((src dired-copy-source))
    (setq dired-copy-source nil)
    (let ((res (funcall "copy-file-do" src dest)))
      (if (string= (buffer-current) "*Dired*") (dired-refresh) t)
      (message (if (stringp res) res "copy-file: done")))))

;; ── refresh ───────────────────────────────────────────────────────────

(defun dired-refresh ()
  "Re-read the listed directory and keep the cursor on the same entry
when it still exists (g); otherwise back to the top. A failed re-read
keeps the old listing and reports (coach r7 finding 3)."
  (interactive)
  (let ((name (dired-current-name))
        (dir (buffer-filename))
        (marked (dired-get-marked)))
    (if (dired-render dir)
      (progn
        (dired-mark-rows marked)
        (let ((i 0)
              (found -1))
          (while (< i (buffer-line-count))
            (if (string= (dired-entry-name-at (buffer-get-line i)) name)
              (progn
                (set! found i)
                (set! i (buffer-line-count)))
              (set! i (+ i 1))))
          (cursor-move (if (>= found 0) found 0) 0)))
      nil)))

;; ── keymap (vim-motion; BUFFER-LOCAL, the shadow tier) ────────────────
;; Major-mode-scoped key-binds resolve AFTER the normal-mode T-Lisp keymap
;; (last resort), so vim's j/k/l/h would shadow them. The buffer-local
;; keymap tier is innermost and wins — the grep-results-mode mechanism.
;; Built once per *Dired* buffer in dired-render.

(defun dired-ensure-keymap ()
  "Attach the dired keymap to the *Dired* buffer (idempotent)."
  (let ((kmap (editor/keymaps/buffer-keymap "*Dired*")))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "dired"))
        (editor/keymaps/keymap-set-key kmap "j" "(editor/commands/dired/dired-next-entry)")
        (editor/keymaps/keymap-set-key kmap "k" "(editor/commands/dired/dired-prev-entry)")
        (editor/keymaps/keymap-set-key kmap "l" "(editor/commands/dired/dired-open-entry)")
        (editor/keymaps/keymap-set-key kmap "Enter" "(editor/commands/dired/dired-open-entry)")
        (editor/keymaps/keymap-set-key kmap "o" "(editor/commands/dired/dired-open-entry)")
        (editor/keymaps/keymap-set-key kmap "h" "(editor/commands/dired/dired-up)")
        (editor/keymaps/keymap-set-key kmap "q" "(editor/commands/dired/dired-quit)")
        (editor/keymaps/keymap-set-key kmap "+" "(editor/commands/dired/dired-create-directory)")
        (editor/keymaps/keymap-set-key kmap "d" "(editor/commands/dired/dired-mark-delete)")
        (editor/keymaps/keymap-set-key kmap "u" "(editor/commands/dired/dired-unmark)")
        (editor/keymaps/keymap-set-key kmap "x" "(editor/commands/dired/dired-execute-deletions)")
        (editor/keymaps/keymap-set-key kmap "R" "(editor/commands/dired/dired-rename-entry)")
        (editor/keymaps/keymap-set-key kmap "C" "(editor/commands/dired/dired-copy-entry)")
        (editor/keymaps/keymap-set-key kmap "g" "(editor/commands/dired/dired-refresh)")
        (editor/keymaps/buffer-set-keymap "*Dired*" kmap))))
  t)

;; Global entry point (SPC d d was free in normal mode).
(key-bind "SPC d d" "(dired)" "normal")

(provide "dired")
)  ;; end of defmodule editor/commands/dired (BUG-74/#126: keep the close at EOF, not at the export clause)
