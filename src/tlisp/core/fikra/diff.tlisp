(defmodule fikra/diff
  (export fikra-turn-diff fikra-diff-next fikra-diff-prev fikra-diff-revert-turn)

;; SPC a d — the turn diff view (mockup 8.4's entry point). TURN-SCOPED
;; (codex round 6: the viewer must show THIS turn's patch, not the whole
;; working tree): the paths changed since the stored turn-begin baseline
;; drive the diff — `git diff HEAD -- <paths>` for tracked changes plus
;; full content for new untracked files — COLOR-PRESERVED (git
;; --color=always; the chat established buffers carry ANSI) in a
;; read-only *Fikra-Diff* buffer.

(defvar fikra-diff-buffer-name "*Fikra-Diff*"
  "Name of the turn-diff buffer.")

(defun fikra-turn-diff ()
  "Show the changes since the last turn's begin baseline (colored) in
*Fikra-Diff* — SPC a d."
  (interactive)
  (require-module fikra/thread)
  (let* ((state (fikra/thread/fikra-thread-field "turn-count"))
         (dir (fikra/thread/fikra-thread-working-dir))
         (rows (condition-case nil (fikra/thread/fikra-thread-compute-changes) (error () nil)))
         (paths (fikra-changed-paths-since-baseline)))
    (if (not (stringp dir))
      (editor-set-status "Fikra: no working dir for this thread")
      (if (or (null paths) (= (length paths) 0))
        (editor-set-status "Fikra: no changes in this turn")
        (let ((patch (fikra-diff-for-paths dir paths (fikra-baseline-tree))))
          (if (or (null patch) (string= patch ""))
            (editor-set-status "Fikra: no changes in this turn")
            (progn
              (fikra-diff-render
                (concat (fikra-diff-summary state rows) "\n" patch)))))))))

;; Summary table (mockup 8.4: file summary + totals) — colored header,
;; magenta ± rows with per-file counts, totals line.
(defun fikra-diff-summary (turn rows)
  (concat "\e[1;36m── turn " (if (numberp turn) (number-to-string turn) "?")
          " changes · " (number-to-string (length rows)) " file(s) · +"
          (number-to-string (fikra-diff-total rows 1)) " -"
          (number-to-string (fikra-diff-total rows 2)) " ──\e[0m\n\n"
          (fikra-diff-rows rows)
          "\n n/N: next/prev file · r revert turn · SPC a d refreshes \n\n"))

;; ROWS are ((path adds dels) ...); IDX 1 = adds column, 2 = dels.
(defun fikra-diff-total (rows idx)
  (let ((sum 0))
    (dolist (r rows)
      (let ((v (if (= idx 1) (car (cdr r)) (car (cdr (cdr r))))))
        (if (numberp v) (setq sum (+ sum v))
          (if (stringp v) (setq sum (+ sum (string-to-number v)))))))
    sum))

(defun fikra-diff-rows (rows)
  (let ((out ""))
    (dolist (r rows)
      (setq out (concat out "\e[35m± " (car r)
                        " +" (if (numberp (car (cdr r))) (number-to-string (car (cdr r))) (car (cdr r)))
                        " -" (if (numberp (car (cdr (cdr r)))) (number-to-string (car (cdr (cdr r)))) (car (cdr (cdr r))))
                        "\e[0m\n")))
    out))

;; The header + patch land in the (re)created read-only buffer.
(defun fikra-diff-render (content)
  (if (member fikra-diff-buffer-name (buffer-list))
    (progn
      (buffer-switch fikra-diff-buffer-name)
      (buffer-set-read-only nil)
      (let ((count (buffer-line-count)))
        (if (> count 1) (buffer-delete-range 0 count))))
    (buffer-create fikra-diff-buffer-name))
  (buffer-switch fikra-diff-buffer-name)
  (buffer-set-read-only nil)
  (buffer-append content)
  (buffer-set-read-only t)
  (editor-set-mode "normal")
  (fikra-diff-ensure-keymap)
  (editor-set-status "Fikra: turn diff"))

;; n/N jump between per-file patches ("diff --git" headers).
(defun fikra-diff-ensure-keymap ()
  (let ((kmap (editor/keymaps/buffer-keymap fikra-diff-buffer-name)))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "fikra-diff"))
        (editor/keymaps/keymap-set-key kmap "n" "(fikra/diff/fikra-diff-next)")
        (editor/keymaps/keymap-set-key kmap "N" "(fikra/diff/fikra-diff-prev)")
        (editor/keymaps/keymap-set-key kmap "r" "(fikra/diff/fikra-diff-revert-turn)")
        (editor/keymaps/buffer-set-keymap fikra-diff-buffer-name kmap))))
  t)

(defun fikra-diff-jump (step)
  (let ((count (buffer-line-count)))
    (fikra-diff-scan (+ (cursor-line) step) step count)))

(defun fikra-diff-scan (line step count)
  (if (or (< line 0) (>= line count))
    (editor-set-status "Fikra: no more files")
    ;; Both section shapes are navigable: tracked patches ("diff --git")
    ;; AND new-file sections ("+++ new file:"). (codex round 11: new-file
    ;; navigation gap.)
    ;; PREFIX tests, not regexes: string-match's pattern layer mangles
    ;; backslash-escapes (a source "^\\+\\+\\+" arrives at JS as ^+++
    ;; → "nothing to repeat" — codex round-15 LIVE catch; the second
    ;; T-Lisp-regex fragility incident in this file). The STRIP is needed
    ;; because git --color prefixes section headers with SGR codes — a
    ;; plain prefix test never sees "diff --git" through them (round-16
    ;; fixture catch: n skipped colored sections).
    (if (or (string-prefix-p "diff --git" (fikra-strip-ansi (buffer-line line)))
            (string-prefix-p "+++ new file:" (buffer-line line)))
      (cursor-move line 0)
      (fikra-diff-scan (+ line step) step count))))

;; Remove ANSI CSI sequences (ESC … m) — a byte scan, no regex (see the
;; fragility notes above). O(n²) concat is fine for viewer-sized lines.
(defun fikra-strip-ansi (s)
  (fikra-sa-scan s 0 ""))

(defun fikra-sa-scan (s i out)
  (if (>= i (length s))
    out
    (if (string= (substring s i (+ i 1)) "\e")
      (fikra-sa-scan s (+ (fikra-sa-skip s (+ i 1)) 1) out)
      (fikra-sa-scan s (+ i 1) (concat out (substring s i (+ i 1)))))))

(defun fikra-sa-skip (s i)
  (if (or (>= i (length s)) (string= (substring s i (+ i 1)) "m"))
    i
    (fikra-sa-skip s (+ i 1))))

(defun fikra-diff-next () (interactive) (fikra-diff-jump 1))
(defun fikra-diff-prev () (interactive) (fikra-diff-jump -1))

;; Mockup 8.4's revert control: r restores THIS turn's touched tracked
;; paths to the baseline tree (git checkout <tree> -- paths) and deletes
;; files the turn CREATED. Destructive — requires an explicit "revert"
;; confirmation in the minibuffer.
(defun fikra-diff-revert-turn ()
  (interactive)
  (require-module fikra/thread)
  (let ((dir (fikra/thread/fikra-thread-working-dir))
        (tree (fikra-baseline-tree))
        (paths (fikra-changed-paths-since-baseline)))
    (if (or (null paths) (= (length paths) 0) (not (stringp dir)))
      (editor-set-status "Fikra: nothing to revert")
      (let ((confirm (read-string "Revert this turn's changes? type revert: ")))
        (if (not (string= confirm "revert"))
          (editor-set-status "Fikra: revert cancelled")
          (progn
            (dolist (p paths)
              (if (string= (fikra-file-kind dir p) "tracked")
                (shell-command (concat "git -C '" dir "' checkout " tree " -- '" p "' 2>/dev/null"))
                (shell-command (concat "rm -f '" dir "/" p "'"))))
            (editor-set-status "Fikra: turn reverted — SPC a d to refresh")
            (fikra-turn-diff)))))))

;; Paths changed since the stored baseline — the DRY computation shared
;; with the turn-end ± rows (fikra-thread-compute-changes → ((path a d) …)).
(defun fikra-changed-paths-since-baseline ()
  (condition-case nil
    (let ((rows (fikra/thread/fikra-thread-compute-changes)))
      (if rows
        (let ((paths (list)))
          (dolist (r rows)
            (setq paths (cons (car r) paths)))
          (reverse paths))
        nil))
    (error () nil)))

;; The turn's baseline tree (stash-create snapshot at turn-begin; HEAD
;; when the tree was clean). Diffing against it isolates the turn's OWN
;; content changes, even in files dirty before the turn (codex round 7).
(defun fikra-baseline-tree ()
  (let ((t-v (fikra/thread/fikra-thread-field "change-baseline-tree")))
    (if (and (stringp t-v) (> (length t-v) 0)) t-v "HEAD")))

;; The colored patch for PATHS: tracked diff vs the BASELINE TREE +
;; untracked file contents.
(defun fikra-diff-for-paths (dir paths tree)
  (let ((tracked (list))
        (untracked (list))
        (out ""))
    ;; Split paths: tracked (appear in git diff) vs new untracked.
    (dolist (p paths)
      (if (string= (fikra-file-kind dir p) "tracked")
        (setq tracked (cons p tracked))
        (setq untracked (cons p untracked))))
    (if (> (length tracked) 0)
      (setq out (concat out (shell-command (concat "git -C '" dir "' diff " tree " --color=always -- "
                                                  (fikra-join-args (reverse tracked)) " 2>/dev/null")))))
    (dolist (p (reverse untracked))
      (setq out (concat out "\n+++ new file: " p "\n"
                        (shell-command (concat "cat '" dir "/" p "' 2>/dev/null")) "\n")))
    out))

(defun fikra-file-kind (dir path)
  (if (> (length (string-trim (shell-command (concat "git -C '" dir "' ls-files -- '" path "' 2>/dev/null")))) 0)
    "tracked" "untracked"))

(defun fikra-join-args (parts)
  (if (null parts) ""
    (concat "'" (car parts) "'" (if (cdr parts) (concat " " (fikra-join-args (cdr parts))) ""))))

(provide "fikra-diff")
)
