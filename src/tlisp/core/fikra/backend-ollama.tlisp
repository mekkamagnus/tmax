(defmodule fikra/backend-ollama
  (export fikra-backend-ollama-available-p fikra-backend-ollama-capabilities
          fikra-backend-ollama-start-turn fikra-backend-ollama-abort
          fikra-backend-ollama-model-get fikra-backend-ollama-http-filter
          fikra-backend-ollama-complete
          fikra-backend-ollama-seed fikra-ollama-history-messages
          fikra-ollama-messages-get fikra-ollama-tools-json
          fikra-backend-ollama-set-model fikra-backend-ollama-set-url
          fikra-backend-ollama-pending-p fikra-backend-ollama-decide
          fikra-ollama-parked-rest-get fikra-ollama-latest-id-get
          fikra-ollama-bash-filter fikra-ollama-bash-sentinel
          fikra-ollama-path-contained-p fikra-ollama-revert-latest-action
          fikra-ollama-action-posts-get fikra-ollama-record-action-pair
          fikra-ollama-last-action-stash-get fikra-ollama-exchanges-file-get
          fikra-ollama-tool-exchanges-reset fikra-ollama-action-state-reset
          fikra-ollama-set-streaming fikra-ollama-action-checkpoint)

;; RFC-029 §8.1's RAW-API NATIVE LOOP (r108): a fikra-owned chat turn —
;; no CLI wrapper. The adapter hands the user's message here; this module
;; drives the turn lifecycle ITSELF: turn-begin → the ASYNC /api/chat
;; request (the hex-transport http primitive; the ownership dispatcher in
;; ghost.tlisp routes the completion back here) → the reply renders as an
;; assistant text-delta → turn-end. The MODEL resolves from /api/tags at
;; first use (the first installed model; setq-free override via the
;; thread-independent defvar default is NOT possible cross-module — the
;; model-name getter exposes it, and the modeline reads it).
;;
;; Scope (r108): a pure chat turn — no tools, no mediation (the model is
;; the loop's ONLY actor; the permission gate has nothing to gate). The
;; tool-using native loop (§8.1's ⚙ rows driven by the model) is the named
;; next step.

(require-module fikra/event)
(require-module fikra/thread)
(require-module fikra/adapter)

;; The ownership registry may not exist yet (ghost.tlisp registers it at
;; ITS load; a session using only this backend never loads ghost).
;; Re-registering would RESET the map — guard on absence.
(if (not (editor/keymaps/keymap-named "fikra-http-owners"))
  (editor/keymaps/keymap-register "fikra-http-owners" (hashmap)))

(defvar fikra-ollama-url "http://localhost:11434"
  "The local ollama server (module-internal; the same default the ghost
completion source uses).")
(defvar fikra-ollama-model nil
  "The chat model. nil = resolve from /api/tags at first use.")
(defvar fikra-ollama-bodies (hashmap)
  "request-id → the accumulated response body (hex-decoded chunks).")
(defvar fikra-ollama-requests (hashmap)
  "r154 (codex re-grade): request-id → the IN-FLIGHT request's OWNERSHIP
record {thread epoch emitted open} — the thread the turn belongs to (a
late reply must land on its own thread, never whatever is focused at land
time); the turn generation it was fired under (a replaced or interrupted
turn's stream is dead the MOMENT it is superseded — not at completion);
and how much of the streamed content the transcript already took as a
contiguous PREFIX (`emitted`, while `open`) — the completion renders
exactly the rest. An entry exists from fire to completion: the map IS
the in-flight set.")
(defvar fikra-ollama-messages ""
  "The turn's accumulated messages-array body (history + user, then each
tool round's assistant tool_call + tool results — the loop's working
context; rebuilt per turn).")
(defvar fikra-ollama-round-text ""
  "r137: the round's accompanying text (scope bridge into the results
let).")
;; r153 — STREAMING (the mockup's active transcript): the chat request
;; asks ollama for NDJSON; the FILTER renders each content delta as it
;; arrives (adjacent text-deltas join — the transcript grows live); the
;; completion ends the turn.
;; r154 (codex re-grade) — the stream is OWNED: only a live request's
;; deltas render, they render for the thread that fired the request, and
;; exactly-once is ACCOUNTED (the completion renders the suffix the
;; deltas did not deliver) instead of the r153 boolean that merely
;; assumed every delta had landed.
(defvar fikra-ollama-streaming t
  "t: stream:true on /api/chat (progressive rendering); nil: one-shot.")
(defvar fikra-ollama-stream-bufs (hashmap)
  "r153: request-id → the partial (unterminated) NDJSON line buffer.")
(defvar fikra-ollama-stream-content (hashmap)
  "r153: request-id → the accumulated streamed content (the reply's
full text — plain lines and tool lines alike).")
(defvar fikra-ollama-stream-tools (hashmap)
  "r153/r154: request-id → the RAW NDJSON lines carrying tool_calls, in
arrival order (EVERY one: ollama streams ONE call per line — a last-line
wins stash dropped every call but the last of a multi-call round). The
arguments ride verbatim; the completion merges the lines into one call
list.")
(defvar fikra-ollama-tool-exchanges (hashmap)
  "r137-r139 (codex): the tool exchanges keyed THREAD/TURN/ROUND — each
completed round's tool_calls fragment + its results (the accompanying
text is NOT re-embedded: it rides text-deltas — re-embedding it
duplicated the narration). Thread-scoped so same-numbered turns in
different threads never share fragments.")
(defvar fikra-ollama-parked-thread nil
  "The thread the parked call BELONGS to (r117: the decision resolves
against the originating thread's working dir — a focus switch must not
redirect the execution).")
(defvar fikra-ollama-parked-call nil
  "The tool_call PARKED at the L2 gate awaiting the user's a/r/A (the
destructive-bash mediation; the loop resumes on the decision).")
(defvar fikra-ollama-parked-rest nil
  "The calls AFTER the parked one in its reply (r120, codex r119 P2: a
decision resumes the remainder — they were dropped).")
(defvar fikra-ollama-parked-acc ""
  "The results ALREADY collected when the park hit (r121, codex r120
P2#2: 'echo BEFOREPARK' before a parked pair was dropped — the acc must
ride too).")
(defvar fikra-ollama-epoch 0
  "r131 (codex r130 P1#3): the turn GENERATION. Bumped at every
start-turn and abort — an async bash sentinel whose spawn-time epoch
differs is SUPERSEDED: no result row, no resume, no re-fire (the turn
it belonged to is gone).")
(defvar fikra-ollama-batch-calls nil
  "r145 (#4): the FULL batch call list at park time — the reconstructed
assistant message must carry EVERY call in the reply (calls before the
parked one were dropped; their results rode without their call).")

;; The index of CALL in the batch list (0 when absent).
(defun fikra-ollama-batch-index-of (call i)
  (if (>= i (length fikra-ollama-batch-calls))
    0
    (if (equal (nth i fikra-ollama-batch-calls) call)
      i
      (fikra-ollama-batch-index-of call (+ i 1)))))
(defvar fikra-ollama-last-parked-calls nil
  "r139b: the parked call + its remainder (the exchange's TRUE assistant
message — the reject/approve-with-empty-rest path records from here).")
(defvar fikra-ollama-action-pairs (hashmap)
  "r142 (codex 9-item): post-ref → pre-ref per action (recorded when
both captures run back-to-back). The action-level revert restores an
action's touched paths from ITS pre-ref — the turn baseline is not the
pre-state when earlier actions changed the tree.")
(defvar fikra-ollama-last-action-stash nil
  "r142b: the last action revert's stash patch (the action's own
pre-to-post change — git-apply restores it).")
(defvar fikra-ollama-revert-preserved-count 0
  "r155d: staged entries a finished revert left that a COMMIT would
  record (which ones: fikra-ollama-restore-paths) — a revert NEVER
  writes the index (who staged what cannot be told apart after the
  fact: an action that ran its own `git add` for one path must not
  cost the user an entry they staged for another).")
(defvar fikra-ollama-action-posts (list)
  "r142: the action post-refs newest-first (the revert target picker).")
(defvar fikra-ollama-turn-home nil
  "r131b (codex r131 catch): the thread that OWNS the running turn —
stamped at start-turn. Async spawns stamp their HOME from THIS (the
approval path executes while another thread may be focused; stamping
the focused thread misrouted the sentinel's resume).")
(defvar fikra-ollama-async-procs (hashmap)
  "r131 (codex r130 P1#1): pid → {epoch home out cont} — the async
bash's OWNERSHIP record, stamped at spawn: the turn generation, the
ORIGINATING thread (the sentinel renders + resumes under that focus
no matter what is focused at exit), the accumulated stdout (the
filter appends per-pid — concurrent children never share output), and
the round continuation (calls i acc) when the spawn holds a round.
Entries tombstone (nil) when their sentinel fires.")
(defvar fikra-ollama-round 0
  "The current tool round (the loop cap guard).")
(defvar fikra-ollama-max-rounds 4
  "Tool rounds before the loop stops honestly (an endless tool loop must
not spin forever).")
(defvar fikra-ollama-latest-id nil
  "The LATEST fired request (r110: a replacement turn's pending must not
adopt the REPLACED request's reply — only the latest may land).")

(defun fikra-ollama-set-streaming (flag)
  ;; r153b: the test seam (a cross-module setq on a defvar fails).
  (setq fikra-ollama-streaming (if flag t nil)))

(defun fikra-backend-ollama-available-p ()
  "t when the local ollama answers /api/tags (a sync curl probe — the
availability gate must be synchronous; the turn itself is async)."
  (string-match "\"models\""
    (shell-command
      (concat "curl -s --max-time 2 " fikra-ollama-url "/api/tags 2>/dev/null"))))

(defun fikra-backend-ollama-capabilities ()
  ;; Honest: streaming is REAL (r153 — NDJSON deltas render live; the
  ;; flag toggles it), no permissions surface (a pure chat model; nothing
  ;; to mediate — the native L2 gate parks model CALLS, not the stream).
  (list (list "session-resume" nil)
        (list "interactive-approvals" nil)
        ;; r153b (codex): streaming is REAL now (r153) — the capability
        ;; reports it honestly (toggling the flag toggles the report).
        (list "streaming" (if fikra-ollama-streaming t nil))))

;; Drop ONE trailing comma (the accumulator appends separators; the
;; array close must not follow a comma — ollama 400s ',]').
(defun fikra-ollama-chomp (s)
  (if (and (> (length s) 0) (string= (substring s (- (length s) 1) (length s)) ","))
    (substring s 0 (- (length s) 1))
    s))

;; Test accessor for the message accumulator (defvars unreadable
;; cross-module).
(defun fikra-ollama-messages-get ()
  fikra-ollama-messages)

;; Test seam: pin the URL (the async sentinel re-fires REAL requests —
;; fixtures point at a dead port so seeded replies are the only
;; completions; the pending-guard discards the refused ones).
(defun fikra-backend-ollama-set-url (u)
  (setq fikra-ollama-url u))

;; Admin: pin the chat model (the auto-resolution takes the FIRST
;; installed model, which may lack tool support — the live script pins
;; a tools-capable one).
(defun fikra-backend-ollama-set-model (name)
  (setq fikra-ollama-model name))

;; Test accessor: the latest fired request id (the async sentinel's
;; re-fire creates a NEW id — tests intercept it).
(defun fikra-ollama-latest-id-get ()
  (if fikra-ollama-latest-id (number-to-string fikra-ollama-latest-id) "null"))

(defun fikra-ollama-parked-rest-get ()
  fikra-ollama-parked-rest)

(defun fikra-backend-ollama-model-get ()
  "The resolved chat model (the modeline's backend segment reads it)."
  fikra-ollama-model)

;; ── the turn ─────────────────────────────────────────────────────────
(defun fikra-backend-ollama-start-turn (message)
  "Drive one RAW-API chat turn: turn-begin, fire the ASYNC /api/chat,
  return 'pending (the completion callback renders the reply and ends
  the turn). Model unknown → the tags request resolves it and its
  completion re-fires the chat for the still-pending message."
  ;; r154: a turn still in flight — THIS thread's or another's — is
  ;; superseded HONESTLY through the interrupt path (the interrupted
  ;; turn-end marker on its own thread, the request cancelled, children
  ;; killed, the park dropped) BEFORE this turn touches any state. A send
  ;; during a run used to throw at turn-begin (running → running is an
  ;; illegal transition) after the new turn had cleared the old one's
  ;; state; a send from ANOTHER thread stranded the first one "running".
  (if fikra-ollama-pending-message
    (fikra-backend-ollama-abort))
  (setq fikra-ollama-pending-message message)
  (setq fikra-ollama-round 0)
  ;; r131: a new turn supersedes the previous one's in-flight async
  ;; children. r137 (codex re-grade): replacement also KILLS them — a
  ;; superseded command used to keep changing files with its evidence
  ;; suppressed (epoch-drop hid the result row; the mutations ran on).
  (setq fikra-ollama-epoch (+ fikra-ollama-epoch 1))
  (fikra-ollama-kill-children)
  ;; r154: the replaced turn's in-flight request is CANCELLED (not just
  ;; ignored — see fikra-ollama-cancel-requests).
  (fikra-ollama-cancel-requests)
  ;; r131b: the turn's OWNING thread (the async spawn home truth).
  (setq fikra-ollama-turn-home (fikra/thread/fikra-thread-current))
  ;; r131c (codex r131b catch): a NEW turn orphans any pending park —
  ;; a later approval must not execute the OLD call under THIS turn's
  ;; epoch/home.
  (setq fikra-ollama-parked-call nil)
  (setq fikra-ollama-parked-rest nil)
  (setq fikra-ollama-parked-acc "")
  (setq fikra-ollama-parked-thread nil)
  (fikra/thread/fikra-thread-turn-begin)
  ;; The model resolves SYNCHRONOUSLY (a light curl, like the probe) —
  ;; no tags round-trip through the async machinery.
  (if (not fikra-ollama-model)
    (fikra-ollama-resolve-model))
  (if fikra-ollama-model
    (progn
      ;; The accumulator starts as history + the user message (once per
      ;; turn; tool rounds append to it).
      (setq fikra-ollama-messages
        (concat (fikra-ollama-history-messages)
                "{\"role\":\"user\",\"content\":" (fikra-ollama-json-string message) "},"))
      (fikra-ollama-chat message))
    (progn
      (fikra/thread/fikra-thread-turn-end "error")
      (editor-set-status "Fikra-ollama: no model installed")))
  'pending)

(defvar fikra-ollama-pending-message nil
  "The message awaiting its reply (the land-time guard).")

(defun fikra-ollama-chat (message)
  ;; The messages payload: system + the ACCUMULATOR (the history built
  ;; once at the first fire, then each tool round appends its exchange —
  ;; r112: tool rounds must ride the NEXT request or the model forgets
  ;; its own tool use) + TOOLS (the model-driven loop).
  ;; r135e (codex r135d catch): the model name ESCAPES (a quote in a
  ;; configured name broke the request body).
  (let* ((body (concat "{\"model\":" (fikra-ollama-json-string fikra-ollama-model)
                       ",\"stream\":" (if fikra-ollama-streaming "true" "false") ",\"messages\":["
                       "{\"role\":\"system\",\"content\":\"You are a concise coding assistant inside the tmax editor. Reply briefly. Use the provided tools when they help.\"},"
                       (fikra-ollama-chomp fikra-ollama-messages)
                       "],\"tools\":["
                       (fikra-ollama-tools-json)
                       "],\"options\":{\"num_ctx\":4096}}")))
    ;; Content-Type matters: bun's fetch defaults a string body to
    ;; text/plain — ollama 400s it (r108 live catch; curl -d worked).
    (let ((id (http-request (concat fikra-ollama-url "/api/chat")
                            :method "POST"
                            :body body
                            :headers (list (list "Content-Type" "application/json"))
                            :filter "fikra/backend-ollama/fikra-backend-ollama-http-filter")))
      (fikra-ollama-stamp-request id)
      (setq fikra-ollama-latest-id id)
      id)))

;; r109 (codex r108 P1#1): ownership stamps AT FIRE — a connection
;; failure never delivers a body chunk, so filter-time stamping let the
;; completion drop unowned and the turn hung running. The turn's THREAD
;; identity (r109 P1#2): a late reply must land on ITS thread even if
;; focus moved. r154: both ride the request's ownership record, with the
;; turn generation and the delivered-so-far count. The real fire AND the
;; test seed stamp through here.
(defun fikra-ollama-stamp-request (id)
  (editor/keymaps/keymap-mutable-set!
    (editor/keymaps/keymap-named "fikra-http-owners")
    (number-to-string id) "fikra/backend-ollama/fikra-backend-ollama-complete")
  (let ((entry (hashmap)))
    (editor/keymaps/keymap-mutable-set! entry "thread" (fikra/thread/fikra-thread-current))
    (editor/keymaps/keymap-mutable-set! entry "epoch" fikra-ollama-epoch)
    (editor/keymaps/keymap-mutable-set! entry "emitted" 0)
    ;; t while the delivered text is still a contiguous prefix (see
    ;; fikra-ollama-deliver).
    (editor/keymaps/keymap-mutable-set! entry "open" t)
    (editor/keymaps/keymap-mutable-set! fikra-ollama-requests (number-to-string id) entry))
  id)

;; r154: a request is LIVE iff it is the latest fired request AND its
;; turn generation is current. Everything that renders from a stream —
;; the filter's deltas AND the completion's reply — consults this. (The
;; guard used to run at completion only: an interrupted turn's in-flight
;; stream kept rendering into the REPLACEMENT turn's transcript.)
(defun fikra-ollama-request-live-p (k)
  (let ((entry (hashmap-get fikra-ollama-requests k)))
    (if (not entry)
      nil
      (and (= (hashmap-get entry "epoch") fikra-ollama-epoch)
           (string= k (fikra-ollama-latest-id-get))))))

;; r154: every in-flight request dies with its turn (abort AND
;; replacement). The liveness guard drops a dead stream's DELTAS — but
;; the stream itself used to run on: the model kept generating (ollama
;; runs ONE generation per model, so the replacement turn queued behind
;; the abandoned one) and the socket stayed open to the end.
(defun fikra-ollama-cancel-requests ()
  (dolist (k (hashmap-keys fikra-ollama-requests))
    (if (hashmap-get fikra-ollama-requests k)
      (progn
        (fikra-ollama-forget-request k)
        (condition-case nil (http-cancel (string-to-number k)) (error () nil)))))
  nil)

;; Drop a request's transport + stream state (completion and cancel).
;; A late completion for a forgotten id finds no entry and discards.
(defun fikra-ollama-forget-request (k)
  (editor/keymaps/keymap-mutable-set! fikra-ollama-bodies k nil)
  (editor/keymaps/keymap-mutable-set! fikra-ollama-requests k nil)
  (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-bufs k nil)
  (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-content k nil)
  (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-tools k nil))

;; The thread's prior turns as messages-array entries (the event memory
;; in order; the memory is newest-first — reverse for array order). The
;; in-flight user message is NOT yet in memory (the caller emits it), so
;; the history ends just before it.
;; ── the tools (the model-driven loop, r112) ─────────────────────────
;; Two tools, hand-built JSON (the schema layer): bash {command} and
;; buffer_edit {path, content}. The loop is L1-honest (no mediation —
;; the L2 gate integration is the named follow-up).
(defun fikra-ollama-tools-json ()
  (concat "{\"type\":\"function\",\"function\":{"
          "\"name\":\"bash\",\"description\":\"Run a shell command in the project directory and return its output.\","
          "\"parameters\":{\"type\":\"object\",\"properties\":{"
          "\"command\":{\"type\":\"string\",\"description\":\"The command to run\"}},"
          "\"required\":[\"command\"]}}},"
          "{\"type\":\"function\",\"function\":{"
          "\"name\":\"buffer_edit\",\"description\":\"Write the full new content of a file (relative path).\","
          "\"parameters\":{\"type\":\"object\",\"properties\":{"
          "\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},"
          "\"required\":[\"path\",\"content\"]}}},"
          "{\"type\":\"function\",\"function\":{"
          "\"name\":\"buffer_read\",\"description\":\"Read a file's content (relative path) from the project directory.\","
          "\"parameters\":{\"type\":\"object\",\"properties\":{"
          "\"path\":{\"type\":\"string\"}},"
          "\"required\":[\"path\"]}}}"))

;; One tool ROUND: append the assistant tool_call message (the model's
;; own record), execute each call, append the tool results, RE-FIRE. The
;; arguments ride as a JSON STRING inside the reply's JSON — re-embed
;; verbatim (the accumulated messages keep the model's exact shape).
(defun fikra-ollama-tool-round (msg tool-calls entry)
  (setq fikra-ollama-round (+ fikra-ollama-round 1))
  ;; r135 (codex r130 P2): the model's text BESIDE its tool calls is
  ;; kept — rendered before the ⚙ rows and carried in the reconstructed
  ;; assistant message (it used to be discarded: content hardcoded "").
  (let ((text (let ((c (fikra-ollama-alist-get "content" msg)))
                (if (and c (stringp c) (> (length c) 0)) c ""))))
    (setq fikra-ollama-round-text text)
    ;; r154: only the part the stream's deltas have NOT rendered yet.
    (if (fikra-ollama-held-p (fikra-ollama-render-rest text entry))
      (editor-set-status fikra-ollama-held-status))
    (setq fikra-ollama-messages
      (concat fikra-ollama-messages
              "{\"role\":\"assistant\",\"content\":" (fikra-ollama-json-string text)
              ",\"tool_calls\":["
              (fikra-ollama-calls-json tool-calls 0 "")
              "]},")))
  (let ((results (fikra-ollama-run-calls tool-calls 0 "")))
    (if (and (symbolp results) (or (string= (symbol-name results) "parked")
                                   (string= (symbol-name results) "async")))
      nil
      (progn
        (setq fikra-ollama-messages
          (concat fikra-ollama-messages results))
        ;; r137+r138: the completed exchange persists IN ITS TURN's slot.
        (fikra-ollama-remember-exchange
          (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                  (fikra-ollama-calls-json tool-calls 0 "")
                  "]}," results))
        (if (>= fikra-ollama-round fikra-ollama-max-rounds)
          (progn
            (setq fikra-ollama-pending-message nil)
            (fikra/event/fikra-event-emit
              (list (list "kind" "text-delta")
                    (list "speaker" "assistant")
                    (list "text" "(tool round cap reached — stopping the loop)")))
            (fikra/thread/fikra-thread-turn-end "completed"))
          (fikra-ollama-chat fikra-ollama-pending-message))))))

;; The tool_calls array re-embedded as JSON (the raw arguments string
;; must survive verbatim — re-parsing loses its exact shape).
(defun fikra-ollama-calls-json (calls i acc)
  (if (>= i (length calls))
    acc
    (let* ((call (nth i calls))
           (fn (fikra-ollama-alist-get "function" call))
           (name (if fn (fikra-ollama-alist-get "name" fn) "?"))
           (args (if fn (fikra-ollama-alist-get "arguments" fn) "{}")))
      (fikra-ollama-calls-json calls (+ i 1)
        (concat acc (if (> i 0) ",")
                ;; r135d (codex r135c catch): the NAME escapes too (a
                ;; quote in a model-supplied tool name broke the array).
                "{\"function\":{\"name\":" (fikra-ollama-json-string (if name name "?"))
                ;; json-encode handles BOTH shapes (the reply's arguments
                ;; arrive as a string OR a parsed object — raw concat
                ;; stringified objects to "[object Object]", r113 live).
                ;; r135e (codex r135d catch): an EMPTY parsed object
                ;; re-embeds as {} — json-encode renders empty lists as
                ;; [] (object-ness is lost in the alist round-trip).
                ",\"arguments\":" (condition-case nil
                                    (if (and (listp args) (= (length args) 0))
                                      "{}"
                                      (json-encode args))
                                    (error () "{}"))
                "}}")))))

;; r117 (codex r116 P1#2): a PARKED call STOPS the round — later calls
;; in the same reply must not run while the first waits at the gate (the
;; adversarial rm -rf + touch sequence executed the touch).
(defun fikra-ollama-run-calls (calls i acc)
  ;; The empty-rest base returns "" — never nil (concat with nil throws
  ;; and the SENTINEL swallows it: the turn stuck 'running' live).
  (if (>= i (length calls))
    (if acc acc "")
    (let ((res (fikra-ollama-run-tool (nth i calls))))
      (cond
        ((numberp res)
          ;; r126: an async bash holds the round — the sentinel resumes
          ;; from i+1 (the tool message lands at exit). r127 (codex
          ;; catch 2): the ACC rides too (a buffer_read BEFORE the bash
          ;; vanished from the model's messages). r131: the continuation
          ;; rides the pid's OWNERSHIP entry (run-bash-now returns the
          ;; pid now) — no shared stash for concurrent children.
          (progn
            (keymap-mutable-set!
              (hashmap-get fikra-ollama-async-procs (number-to-string res))
              "cont" (list calls (+ i 1) acc))
            'async))
        ((and (symbolp res) (string= (symbol-name res) "parked"))
          ;; r120: the REMAINDER rides the park — the decision resumes
          ;; them (they were dropped). r121: the ACC rides too (results
          ;; before the park were discarded — 'echo BEFOREPARK' vanished).
          ;; r145 (#4): the FULL batch list rides too (the reconstruction
          ;; dropped calls before the parked one).
          (progn
            (setq fikra-ollama-batch-calls calls)
            (setq fikra-ollama-parked-acc acc)
            (setq fikra-ollama-parked-rest
              (condition-case nil
                (fikra-ollama-calls-rest calls (+ i 1))
                (error () nil)))
            'parked))
        (t
          (fikra-ollama-run-calls calls (+ i 1)
            (concat acc res)))))))

;; r120 catch: `cons` requires a proper list tail — (cons x nil) THROWS
;; in this dialect. Accumulate with append instead.
(defun fikra-ollama-calls-rest (calls i)
  (if (>= i (length calls))
    (list)
    (append (list (nth i calls))
            (fikra-ollama-calls-rest calls (+ i 1)))))

;; One tool_call: execute, emit the ⚙ row + the result row, return the
;; tool-result MESSAGE json fragment.
(defun fikra-ollama-run-tool (call)
  (let* ((fname (fikra-ollama-alist-get "name"
                 (fikra-ollama-alist-get "function" call)))
         (args-raw (fikra-ollama-alist-get "arguments"
                     (fikra-ollama-alist-get "function" call)))
         ;; r114 (codex r113 P1): arguments arrive as EITHER shape — a
         ;; JSON STRING (parse) or an already-parsed ALIST (the live
         ;; qwen3 object case; the string-only parse yielded empty
         ;; arguments and the tool executed NOTHING).
         (args (if (listp args-raw)
                 (if (and args-raw (> (length args-raw) 0)) args-raw ())
                 (condition-case nil (json-read-from-string (if args-raw args-raw "{}")) (error () ())))))
    (if (string= fname "bash")
      (fikra-ollama-run-bash call args)
      (if (string= fname "buffer_edit")
        (fikra-ollama-run-edit call args)
        (if (string= fname "buffer_read")
          (fikra-ollama-run-read call args)
          (fikra-ollama-tool-skip call fname))))))

;; r120 (codex r119 P2): the model can READ — the loop's blind spot.
(defun fikra-ollama-run-read (call args)
  (let* ((path (if (fikra-ollama-alist-get "path" args)
                 (fikra-ollama-alist-get "path" args) ""))
         (dir (fikra/thread/fikra-thread-working-dir))
         (abs (concat dir "/" path))
         ;; r133: reads are CONTAINED too — a symlink hop must not leak
         ;; outside files into the model's context.
         (contained (fikra-ollama-path-contained-p dir path))
         (content (if contained
                    (condition-case nil (read-file-content abs) (error () nil))
                    nil)))
    (fikra/event/fikra-event-emit
      (list (list "kind" "tool-call") (list "tool" "buffer-read")
            (list "summary" path)))
    (if (and contained (stringp content))
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" t)
                (list "summary" (concat path ": " (number-to-string (length content)) " chars"))))
        (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string content) "},"))
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" nil)
                (list "summary" (concat (if contained "not found: " "REFUSED (outside the working dir): ") path))))
        (concat "{\"role\":\"tool\",\"content\":"
                (fikra-ollama-json-string
                  (if contained
                    (concat "file not found: " path)
                    "refused: path escapes the working directory"))
                "},")))))

(defun fikra-ollama-run-bash (call args)
  (let* ((cmd (if (fikra-ollama-alist-get "command" args)
                (fikra-ollama-alist-get "command" args) ""))
         (dir (fikra/thread/fikra-thread-working-dir))
         ;; r116: the L2 gate — a DESTRUCTIVE command parks at the
         ;; approval panel (the mockup's per-action mediation); the loop
         ;; resumes on the user's a/r/A.
         (risk (condition-case nil
                  (progn (require-module fikra/approvals)
                         (fikra/approvals/fikra-approval-risk "bash" cmd))
                  (error () ""))))
    (if (string= risk "destructive")
      (fikra-ollama-park call cmd)
      (fikra-ollama-run-bash-now cmd dir))))

(defun fikra-ollama-park (call cmd)
  (setq fikra-ollama-parked-call call)
  (setq fikra-ollama-parked-thread (fikra/thread/fikra-thread-current))
  (require-module fikra/approvals)
  (fikra/event/fikra-event-emit
    (list (list "kind" "permission-request")
          (list "action" (concat "bash: " cmd))
          (list "tool" "bash")
          (list "id" "ollama-native")
          (list "target" (fikra/approvals/fikra-approval-target cmd))
          (list "thread" (fikra/thread/fikra-thread-current))
          (list "turn" (number-to-string (fikra/thread/fikra-thread-turn-count)))
          (list "risk" "destructive")
          (list "mode" (condition-case nil
                          (progn (require-module fikra/modes)
                                 (fikra/modes/fikra-effective-mode))
                          (error () "")))
          (list "checkpoint" (fikra/approvals/fikra-approval-baseline-ref))
          (list "origin" "native-loop")))
  (fikra/thread/fikra-thread-status-set "confirming")
  (editor-set-status "Fikra: approve bash? a Allow · r Reject · A Always")
  'parked)

;; The un-gated execution (the r113 path).
;; r126 (the codex-named responsiveness gap): bash runs ASYNC —
;; make-process with a filter/sentinel; the daemon NEVER blocks on a
;; long command. The r113 exit-status contract is preserved (the
;; command's own $? rides the output tail).
(defvar fikra-ollama-last-pre-name nil
  "r142: the mediated action's PRE ref name — the sentinel pairs it
with its post-exit capture.")
(defvar fikra-ollama-next-mediated nil
  "r134: set around a DECISION-executed spawn — the child was MEDIATED
(the user allowed it); its exit lands a per-action checkpoint.")

;; r155: the command's OUTPUT CONTRACT — captured, capped at 30 lines
;; with a TRUNCATED:n notice, the command's own $? on a trailing EXIT:N
;; line (the r113 exit-status contract; a pipe to head would report
;; head's 0).
(defun fikra-ollama-bash-body (cmd)
  (concat "__o=\"$( (" cmd ") 2>&1 )\"; __e=$?; echo \"$__o\" | head -30; __t=$(echo \"$__o\" | tail -n +31 | wc -l); [ \"$__t\" -gt 0 ] && echo TRUNCATED:$__t; echo EXIT:$__e"))

;; r155 (the codex gate's named 9-bar — "a checkpoint for each mutating
;; action"): an ORDINARY bash call is bracketed with worktree snapshots
;; taken IN THE CHILD, so the editor's thread never waits for git. Each
;; snapshot is `git add -A` + `write-tree` through the thread's
;; PERSISTENT index (a warm index makes the add a re-stat: ~60 ms on a
;; 2k-file repo; a fresh one rehashes everything). GIT_INDEX_FILE is
;; scoped to these commands ONLY — the model's own git runs see the
;; user's index. `.tmax` DIRECTORIES are excluded at any depth (the
;; thread's state is not the user's tree, and its logs change while the
;; command runs) — a regular FILE named .tmax is the user's and stays. The trees go to a marker FILE, never stdout —
;; the model's tool result stays exactly the command's output.
;; r155c (codex gate): the snapshot is ATOMIC — a failed `git add` must
;; not let `write-tree` name a tree the add never produced.
;; r155d (codex gate): `':(exclude,glob)**/.tmax'` matched the directory
;; ENTRY but not its contents. The contents glob alone is the form that
;; holds everywhere: it never names `.tmax` itself, so a repo whose
;; ignore rule says `.tmax` does not make git refuse the add ("paths are
;; ignored by one of your .gitignore files", exit 1 — the literal
;; exclude did, whenever the rule was spelled without the slash).
(defun fikra-ollama-snapshot-cmd (idx var)
  (concat var "=$(GIT_INDEX_FILE=" idx " git add -A -- . ':(exclude,glob)**/.tmax/**' >/dev/null 2>&1 && "
          "GIT_INDEX_FILE=" idx " git write-tree 2>/dev/null); "))

;; The IGNORED entries git knows about (files listed one by one, ignored
;; directories collapsed): listed before and after the command, the two
;; listings' difference names ignored entries that appeared or vanished —
;; a write the modification-time scan cannot see when a command keeps
;; the old timestamp (`cp -p`).
(defun fikra-ollama-ignored-listing-cmd (out)
  (concat "git ls-files -o -i --exclude-standard --directory | sort > " out " ; "))

;; r156: "inode mode uid gid" for every file the snapshot's view holds —
;; and NO NAME in it. The first two cuts listed "mode…<TAB>path" and
;; compared lines: a name containing a newline arrives in pieces, and a
;; piece can be the name of another, real file (codex gate round 2). Keyed
;; by inode, nothing here can be cut, split or mistaken for another path.
;; The table is taken before the command; after it the same tuple is read
;; for the paths the stamp scan listed, and an inode whose tuple differs
;; is a permission or ownership change — the one kind of change a git tree
;; cannot record (it keeps the executable bit and nothing else). A RECORD,
;; not an inference from timestamps: `touch` cannot move it and a chmod
;; that changes nothing cannot appear in it. (The first cut inferred the
;; change from ctime. That floods on Linux — `chmod` moves a file's ctime
;; even when the mode is unchanged there — and misses a chmod after a
;; touch on every platform.)
;; GNU stat and BSD stat spell the format differently; `-c` is refused by
;; the latter (and its %t is NOT a tab in GNU — the second cut's records
;; were glued on Linux). `--` ends the options: a name may begin with a
;; dash (without it the whole batch fails). Verified on both: GNU
;; coreutils 9.1 on Linux 6.12, and macOS.
(defun fikra-ollama-mode-table-cmd (out)
  (concat "if stat -c %a / >/dev/null 2>&1; then "
          "git ls-files -z --cached --others --exclude-standard -- . ':(exclude,glob)**/.tmax/**' "
          "| xargs -0 stat -c '%i %a %u %g' -- 2>/dev/null > " out " ; "
          "else "
          "git ls-files -z --cached --others --exclude-standard -- . ':(exclude,glob)**/.tmax/**' "
          "| xargs -0 stat -f '%i %Lp %u %g' -- 2>/dev/null > " out " ; "
          ;; The caller concatenates its next statement straight onto
          ;; this: `fi` needs its own separator.
          "fi ; "))

;; The same tuple for the paths the stamp scan listed (NUL-separated) —
;; the only files whose mode can have changed.
(defun fikra-ollama-mode-candidates-cmd (scan out)
  (concat "if stat -c %a / >/dev/null 2>&1; then "
          "xargs -0 stat -c '%i %a %u %g' -- 2>/dev/null < " scan " > " out " ; "
          "else "
          "xargs -0 stat -f '%i %Lp %u %g' -- 2>/dev/null < " scan " > " out " ; "
          "fi ; "))

(defun fikra-ollama-snapshot-wrap (cmd dir)
  (let* ((d (concat dir "/.tmax/fikra"))
         (tid (fikra/thread/fikra-thread-current))
         (dq (fikra/thread/fikra-thread-shq d))
         (idx (fikra/thread/fikra-thread-shq (concat d "/ckpt-index-" tid)))
         (f (fikra/thread/fikra-thread-shq (concat d "/ckpt-trees-" tid)))
         (stamp (fikra/thread/fikra-thread-shq (concat d "/ckpt-stamp-" tid)))
         (changed (fikra/thread/fikra-thread-shq (concat d "/ckpt-changed-" tid)))
         (meta (fikra/thread/fikra-thread-shq (concat d "/ckpt-meta-" tid)))
         (modes (fikra/thread/fikra-thread-shq (concat d "/ckpt-modes-" tid)))
         (cand (fikra/thread/fikra-thread-shq (concat d "/ckpt-cand-" tid)))
         (inodes (fikra/thread/fikra-thread-shq (concat d "/ckpt-inodes-" tid)))
         (ignored (fikra/thread/fikra-thread-shq (concat d "/ckpt-ignored-" tid)))
         (ign-a (fikra/thread/fikra-thread-shq (concat d "/ckpt-ign-" tid)))
         (ign-b (fikra/thread/fikra-thread-shq (concat d "/ckpt-ign-after-" tid))))
    ;; The caller has cd'ed into the working dir.
    (concat "mkdir -p " dq " ; rm -f " f " " changed " " meta " " modes " " cand " " inodes " " ignored " ; "
            (fikra-ollama-ignored-listing-cmd ign-a)
            (fikra-ollama-snapshot-cmd idx "__p")
            ;; r156: what each file's mode and owner are BEFORE the
            ;; command (the candidates and the join follow the scan).
            (fikra-ollama-mode-table-cmd modes)
            ;; r155c: everything the command modifies is listed — the
            ;; snapshot's view excludes ignored paths, so a write to one
            ;; is reported instead of vanishing.
            "touch " stamp " ; "
            (fikra-ollama-bash-body cmd)
            " ; " (fikra-ollama-snapshot-cmd idx "__q")
            ;; r155e (codex gate): by STATUS-CHANGE time, not
            ;; modification time — `cp -p` and `touch -d` keep the old
            ;; mtime but cannot keep a file's ctime (a new inode, or any
            ;; write, sets it to now). NUL-separated: a name may contain
            ;; a newline.
            ;; r155f: EVERY .git directory is git's own state, a nested
            ;; repository's included — the snapshot's own `git add -A`
            ;; rewrites a nested repo's index, which the scan then listed
            ;; as a path it could not hold.
            ;; r156 (codex gate round 6, P2): every NON-DIRECTORY entry — a
            ;; symlink is one. A retargeted ignored link changed nothing a
            ;; `-type f` scan could see, and the ignored-entry listing
            ;; names it before and after.
            "find . -cnewer " stamp " -not -type d -not -path '*/.git/*' -not -path './.tmax/*' -print0 | head -c 60000 > " changed " ; "
            ;; r156: the candidates' tuples, the inodes whose tuple differs
            ;; from the table, and their paths — NUL-separated by find, so
            ;; a name with a newline or a leading dash comes through WHOLE.
            ;; (The cap is on the inode list, never on the paths: a byte cap
            ;; could cut a name in half.) A permission or ownership change
            ;; always moves the file's ctime, so when the scan above found
            ;; nothing there is nothing to compare: a call that wrote no
            ;; file pays for ONE table. (On a coarse-timestamp filesystem a
            ;; change in the same tick as the stamp is missed by the scan
            ;; — as before.)
            ;; The marker is removed AFTER the command and written only
            ;; here (codex gate round 2): a command that plants it has
            ;; written a file nobody reads.
            "rm -f " meta " ; if [ -s " changed " ] ; then "
            (fikra-ollama-mode-candidates-cmd changed cand)
            "awk 'NR==FNR {b[$1]=$0; next} ($1 in b) && b[$1]!=$0 {print $1}' " modes " " cand " | head -100 > " inodes " ; "
            "if [ -s " inodes " ] ; then "
            "find . -not -type d -not -path '*/.git/*' -not -path './.tmax/*' "
            (hex-decode "5c") "( $(sed -e 's/^/-inum /' -e '$!s/$/ -o/' " inodes " | xargs) " (hex-decode "5c") ") -print0 > " meta " ; "
            "fi ; fi ; rm -f " modes " " cand " " inodes " ; "
            ;; r155d: ignored entries that appeared or vanished (the scan
            ;; above cannot see a deletion).
            (fikra-ollama-ignored-listing-cmd ign-b)
            "diff " ign-a " " ign-b " | grep '^[<>]' | cut -c3- | head -100 > " ignored " ; "
            "echo \"$__p $__q\" > " f)))

(defun fikra-ollama-run-bash-now (cmd dir)
  (fikra/event/fikra-event-emit
    (list (list "kind" "tool-call") (list "tool" "bash")
          (list "summary" cmd)))
  (let ((mediated fikra-ollama-next-mediated))
    (setq fikra-ollama-next-mediated nil)
    ;; r155: ordinary calls are snapshotted (a mediated one already gets
    ;; its pre-capture before it runs and its post-capture at exit).
    (let ((snap (and (not mediated) (stringp (fikra/thread/fikra-thread-current)))))
      (let ((pid (condition-case nil
                  (make-process
                    :command (list "sh" "-c"
                                   (concat "cd " (fikra/thread/fikra-thread-shq dir)
                                           " && " (if snap
                                                    (fikra-ollama-snapshot-wrap cmd dir)
                                                    (fikra-ollama-bash-body cmd))))
                    :cwd dir
                    :filter "fikra/backend-ollama/fikra-ollama-bash-filter"
                    :sentinel "fikra/backend-ollama/fikra-ollama-bash-sentinel")
                  (error () nil))))
      (if pid
        ;; r131: stamp the OWNERSHIP entry (spawn-time epoch + home) and
        ;; return the PID — callers detect async by numberp; the round's
        ;; continuation (if any) is stashed into this entry by run-calls.
        ;; r134: MEDIATED children land an action checkpoint at exit.
        ;; r155: SNAP children wrote their before/after trees to the
        ;; marker file — the sentinel turns a difference into a pair.
        (progn
          (keymap-mutable-set! fikra-ollama-async-procs (number-to-string pid)
            (hashmap "epoch" fikra-ollama-epoch
                     "home" (if fikra-ollama-turn-home
                              fikra-ollama-turn-home
                              (fikra/thread/fikra-thread-current))
                     "out" ""
                     "cont" nil
                     "mediated" mediated
                     "snap" (if snap t nil)))
          pid)
      ;; r127 (codex catch 4): a FAILED spawn reports an honest FAIL
      ;; row — never a pid (the turn would strand).
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" nil)
                (list "summary" "spawn failed")))
        "{\"role\":\"tool\",\"content\":\"spawn failed\"},"))))))

;; A 40-character lowercase-hex object name — and nothing else passes
;; into a shell command (the marker file is writable by the very command
;; it describes).
(defun fikra-ollama-hex40-p (s)
  (and (stringp s)
       (= (length s) 40)
       (fikra-ollama-hex40-scan s 0)))

(defun fikra-ollama-hex40-scan (s i)
  (if (>= i (length s))
    t
    (and (string-match "^[0-9a-f]$" (substring s i (+ i 1)))
         (fikra-ollama-hex40-scan s (+ i 1)))))

;; r155b (codex gate): a mutation WITHOUT its checkpoint is said out
;; loud. The status says so and a red row joins the transcript — the
;; mockup's contract is a checkpoint per mutating action, so a snapshot
;; that could not run or a pair that could not be sealed must never pass
;; for a quiet success.
(defun fikra-ollama-checkpoint-failed (reason)
  (condition-case nil
    (fikra/event/fikra-event-emit-batch-for (fikra/thread/fikra-thread-current)
      (list (list (list "kind" "checkpoint-error")
                  (list "reason" (concat "action checkpoint failed (" reason ") — this change is not revertable on its own")))))
    (error () nil))
  (editor-set-status
    (concat "Fikra: action checkpoint FAILED — this change is not revertable on its own ("
            reason ")"))
  nil)

;; r155: the ordinary-bash ACTION checkpoint. Runs in the sentinel under
;; the HOME focus. The child wrote "<pre-tree> <post-tree>" to the
;; marker file and the entries it touched (by modification time, plus
;; ignored entries that appeared or vanished) to a list beside it.
;; DIFFERENT trees mean the command changed the worktree: both are sealed
;; as refs (post → pre) exactly like a mediated action, so SPC a C-r
;; reverts it. Identical trees mean nothing to hold: a read-only call
;; carries no checkpoint — and says so. r155b: with checkpointing
;; enabled for this root, a marker that yields no pair is a FAILURE and
;; is reported. r155c: an entry the command changed that the snapshot
;; cannot see (an ignored path, a nested .tmax) is REPORTED too — a
;; mutation without its checkpoint is never silent. Disabled roots (not
;; a git dir, an unborn HEAD) stay silent: nothing is promised there.
(defun fikra-ollama-action-checkpoint ()
  ;; The module may not be loaded yet (no turn has run in this editor).
  (condition-case nil (require-module fikra/checkpoint) (error () nil))
  (condition-case nil
    (let* ((base (concat (fikra/thread/fikra-thread-working-dir)
                         "/.tmax/fikra/ckpt-"))
           (tid (fikra/thread/fikra-thread-current))
           (f (concat base "trees-" tid))
           (changed (concat base "changed-" tid))
           (meta (concat base "meta-" tid))
           (ignored (concat base "ignored-" tid))
           (toks (fikra-ollama-marker-tokens
                   (if (file-exists-p f) (string-trim (read-file-content f)) "")))
           (pre (if (> (length toks) 0) (nth 0 toks) ""))
           (post (if (> (length toks) 1) (nth 1 toks) ""))
           (usable (and (fikra-ollama-hex40-p pre) (fikra-ollama-hex40-p post)))
           (changed-lines
             (append
               ;; The scan's list is NUL-separated (a name may contain a
               ;; newline — r155e, codex gate); the ignored-entry diff is
               ;; newline-separated (git's own listing).
               (if (file-exists-p changed)
                 (fikra-ollama-split-paths (read-file-content changed))
                 (list))
               (if (file-exists-p ignored)
                 (string-split (string-trim (read-file-content ignored)) (hex-decode "0a"))
                 (list))))
           ;; r156: the paths whose mode or owner changed — NUL-separated
           ;; by find, exactly like the scan's list (a name may contain a
           ;; newline, or begin with a dash).
           (meta-lines
             (if (file-exists-p meta)
               (fikra-ollama-split-paths (read-file-content meta))
               (list))))
      ;; The markers are consumed whatever they held — a stale or useless
      ;; one must not be reported again by an unrelated later call.
      (if (file-exists-p f)
        (shell-command (concat "rm -f " (fikra/thread/fikra-thread-shq f)))
        nil)
      (if (file-exists-p changed)
        (shell-command (concat "rm -f " (fikra/thread/fikra-thread-shq changed)))
        nil)
      (if (file-exists-p meta)
        (shell-command (concat "rm -f " (fikra/thread/fikra-thread-shq meta)))
        nil)
      (if (file-exists-p ignored)
        (shell-command (concat "rm -f " (fikra/thread/fikra-thread-shq ignored)))
        nil)
      (cond
        ((fikra/checkpoint/fikra-checkpoint-disable-p) nil)
        ((not usable) (fikra-ollama-checkpoint-failed "snapshot"))
        (t
          (progn
          ;; r155c: what the command touched that the trees cannot hold.
          ;; r156: …and what changed on a path they DO hold, in a way they
          ;; cannot record.
          (fikra-ollama-report-outside-checkpoint changed-lines meta-lines pre post)
          (if (string= pre post)
            nil
            ;; r134e: this runs in the SENTINEL's eval context — the event
            ;; emits through the explicit-path owner emitter (set here,
            ;; cleared on every path: a leaked owner misrouted later sync
            ;; captures).
            (condition-case nil
              (progn
                (fikra/checkpoint/fikra-checkpoint-set-emit-owner (fikra/thread/fikra-thread-current))
                (let ((names (fikra/checkpoint/fikra-checkpoint-pair-trees pre post)))
                  (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                  (if names
                    (progn
                      (setq fikra-ollama-last-pre-name (car names))
                      (fikra-ollama-record-action-pair (car names)))
                    (fikra-ollama-checkpoint-failed "seal"))))
              (error (m)
                (condition-case nil (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil) (error () nil))
                (fikra-ollama-checkpoint-failed (if (stringp m) m "error")))))))))
    (error (m)
      (fikra-ollama-checkpoint-failed (if (stringp m) m "error")))))

;; The marker's space-separated fields (empty ones dropped).
(defun fikra-ollama-marker-tokens (raw)
  (if (or (not (stringp raw)) (= (length raw) 0))
    (list)
    (let ((out (list)))
      (dolist (tok (string-split raw " "))
        (if (> (length tok) 0) (setq out (cons tok out)) nil))
      (reverse out))))

;; r155c: a file the command changed that the checkpoint's view cannot
;; hold is named in the transcript: it is a real mutation a revert will
;; not undo.
;; r155f (codex gate): OUTSIDE means exactly that — the path is in
;; NEITHER snapshot's tree (ignored by git, under a nested .tmax, inside
;; a nested repository). It used to be "changed but absent from the
;; pre→post diff", which also caught every file the command merely
;; TOUCHED: `touch base.txt` was reported as "cannot hold" although its
;; tracked content and mode were unchanged. (The diff is read
;; NUL-separated: git quotes paths with spaces or quotes in its line
;; output.)
;; r156 (codex gate round 6, P2): "neither tree" had gone silent on a
;; change the trees hold the PATH of but cannot RECORD — a permission or
;; owner change (git keeps the executable bit and nothing else). Those
;; arrive in META: the paths whose "inode mode uid gid" differs between
;; the child's before-table and the candidates (fikra-ollama-mode-table-cmd,
;; then the inode join and `find -inum … -print0` in the wrap).
;; A META entry is reported when the tree diff does not already cover it
;; — an executable bit, a link's target, a new or deleted file are
;; covered and stay silent.
(defun fikra-ollama-report-outside-checkpoint (changed meta pre post)
  (let* ((root (fikra/thread/fikra-thread-working-dir))
         (rq (fikra/thread/fikra-thread-shq root))
         ;; Nothing scanned (a command that wrote no file the scan can
         ;; see — the common read-only call): nothing to compare, so no
         ;; git runs at all (the sentinel blocks the editor meanwhile).
         (none (and (or (null changed) (= (length changed) 0))
                    (or (null meta) (= (length meta) 0))))
         (covered (if none
                   (list)
                   (fikra-ollama-split-paths
                     (shell-command
                       (concat "git -C " rq " diff --name-only -z " pre " " post)))))
         ;; Every path either tree holds — what the checkpoint CAN revert.
         ;; (Identical trees name the same paths: one listing.)
         (held (if none
                 (list)
                 (append
                   (fikra-ollama-split-paths
                     (shell-command (concat "git -C " rq " ls-tree -r -z --name-only " pre)))
                   (if (string= pre post)
                     (list)
                     (fikra-ollama-split-paths
                       (shell-command (concat "git -C " rq " ls-tree -r -z --name-only " post)))))))
         ;; In NEITHER tree: ignored, under a nested .tmax, inside a nested
         ;; repository.
         (unsighted (fikra-ollama-outside-scan changed (list) covered held 0))
         ;; …then the mode/owner changes the tree diff does not cover. The
         ;; path IS in the trees; what they cannot hold is the change, so
         ;; HELD is empty here on purpose; the already-reported paths are
         ;; the exclusions. A separate list, appended after the first —
         ;; the report's order must not depend on the second pass having
         ;; found anything (codex gate round 1, NIT).
         (uncovered (fikra-ollama-outside-scan meta (list) covered unsighted 0))
         (outside (append unsighted uncovered)))
    (if (> (length outside) 0)
      (let ((n (length outside)))
        (condition-case nil
          (fikra/event/fikra-event-emit-batch-for (fikra/thread/fikra-thread-current)
            (list (list (list "kind" "checkpoint-error")
                        (list "reason"
                          (concat (number-to-string n) " path(s) the checkpoint cannot hold changed — not revertable: "
                                  (fikra-ollama-join-take outside 3 ", ")
                                  (if (> n 3) " …" ""))))))
          (error () nil))
        (if (string= pre post)
          (editor-set-status
            (concat "Fikra: " (number-to-string n)
                    " path(s) changed outside the checkpoint — not revertable"))
          nil))
      nil)))

;; Changed entries (the scan's ./x, the listing's git names) minus the
;; covered ones and the ones the trees hold; empty entries dropped, "./"
;; stripped; the first 400 (the list's own cap — exactly 400: the bound
;; used to admit a 401st entry, codex gate r156 round 1).
(defun fikra-ollama-outside-scan (lines acc covered held i)
  (if (or (null lines) (>= i 400))
    (reverse acc)
    (let ((l (car lines)))
      (let ((p (if (and (stringp l) (> (length l) 2) (string= (substring l 0 2) "./"))
                  (substring l 2 (length l))
                  (if (stringp l) l ""))))
        ;; r155d: the time scan and the ignored-entry listing can both
        ;; name one path — it is reported once.
        (fikra-ollama-outside-scan (cdr lines)
          (if (and (> (length p) 0) (not (member p covered)) (not (member p held))
                   (not (member p acc)))
            (cons p acc)
            acc)
          covered held (+ i 1))))))

;; NUL-separated path list (git -z) → its paths, verbatim: no trimming
;; (a path may begin or end with a space), no newline splitting (a path
;; may contain one — r155d, codex gate), empty entries dropped.
(defun fikra-ollama-split-paths (text)
  (if (or (not (stringp text)) (= (length text) 0))
    (list)
    (let ((out (list)))
      (dolist (l (string-split text (hex-decode "00")))
        (if (> (length l) 0) (setq out (cons l out)) nil))
      (reverse out))))

;; The first N of a list, joined by SEP.
;; r155f: "another element?" is asked with NULL — the tail past the last
;; element is an empty-list VALUE, which is truthy to `if`/`and` (only
;; `null` sees it as empty). A bare `(cdr items)` recursed once past the
;; end and left a trailing separator on every "cannot hold" row.
(defun fikra-ollama-join-take (items n sep)
  (if (or (null items) (<= n 0))
    ""
    (concat (car items)
            (if (and (not (null (cdr items))) (> n 1))
              (concat sep (fikra-ollama-join-take (cdr items) (- n 1) sep))
              ""))))

(defun fikra-ollama-bash-filter (pid output)
  ;; r131: the output accumulates on the PID's own entry (concurrent
  ;; children never share a buffer).
  (let ((entry (hashmap-get fikra-ollama-async-procs (number-to-string pid))))
    (if entry
      (keymap-mutable-set! entry "out"
        (concat (hashmap-get entry "out") output))))
  t)

;; r131: the turn is still awaiting this async chain (a sentinel that
;; fires after the turn ended renders its evidence but resumes nothing).
(defun fikra-ollama-turn-live-p ()
  (and fikra-ollama-pending-message
       (string= (fikra/thread/fikra-thread-status) "running")))

;; r131 (codex r130 P1#1/P1#3): the sentinel is TURN- and THREAD-bound.
;; The per-pid entry carries the spawn-time epoch + HOME thread. A
;; sentinel whose turn was aborted/replaced (epoch mismatch) drops
;; everything — no result row, no resume, no re-fire (abort also KILLED
;; the child). A live sentinel renders and resumes under the HOME focus
;; (a mid-run focus switch must not reroute evidence or the next
;; request), and only continues the round while the turn still runs.
(defun fikra-ollama-bash-sentinel (pid exit-code)
  (let* ((key (number-to-string pid))
         (entry (hashmap-get fikra-ollama-async-procs key))
         (home (if entry (hashmap-get entry "home") nil))
         (cont (if entry (hashmap-get entry "cont") nil))
         (same-epoch (and entry
                        (string= (number-to-string (hashmap-get entry "epoch"))
                                 (number-to-string fikra-ollama-epoch))))
         (prev (fikra/thread/fikra-thread-current)))
    ;; The entry dies with this sentinel (tombstone).
    (keymap-mutable-set! fikra-ollama-async-procs key nil)
    (if (not same-epoch)
      'superseded
      (progn
        ;; r145 (codex #7): the focus call itself is guarded — a throw
        ;; here bypassed the settle/restore logic below entirely.
        (let ((focused (if (and home (not (string= home prev)))
                         (condition-case nil
                           (progn (fikra/thread/fikra-thread-focus home) t)
                           (error () nil))
                         t)))
          (if (not focused)
            (progn
              (setq fikra-ollama-pending-message nil)
              (editor-set-status "Fikra-ollama: sentinel home focus failed")
              ;; r145b (codex r145 catch): SETTLE by the home thread's id
              ;; (focus-by-id inside its own condition-case, end,
              ;; restore — the failed focus left an arbitrary current).
              (condition-case nil
                (progn
                  (fikra/thread/fikra-thread-focus (if home home prev))
                  (if (string= (fikra/thread/fikra-thread-status) "running")
                    (fikra/thread/fikra-thread-turn-end "error"))
                  (fikra/thread/fikra-thread-focus prev))
                (error () nil))
              'focus-failed)
            (progn
        ;; The HOME focus for everything this sentinel does.
        ;; r131c (codex r131b catches): EVERYTHING after the focus
        ;; switch lives inside the handler — a throw anywhere restores
        ;; the focus — AND a thrown body SETTLES the turn honestly (the
        ;; entry is already tombstoned; an unsurfaced error would leave
        ;; the turn "running" with no continuation — the r125/r129
        ;; stuck-turn class).
        (let ((r (condition-case nil
                  (let* ((raw (if entry (hashmap-get entry "out") ""))
                         (raw-code (fikra-ollama-exit-code raw))
                         ;; r128 (codex r127 catch 3): a MISSING EXIT:
                         ;; marker defaulted to success — the child's own
                         ;; exit-code is the truth when the marker never
                         ;; printed (a kill, a crash).
                         (code (if (fikra-ollama-has-exit-p raw)
                                 raw-code
                                 (number-to-string exit-code)))
                         (ok (string= code "0"))
                         (out (string-trim (fikra-ollama-strip-exit raw)))
                         (msg (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string
                                       (concat out (if ok "" (concat "\nexit code: " code)))) "},")))
                    (fikra/event/fikra-event-emit
                      (list (list "kind" "tool-result") (list "ok" ok)
                            (list "summary" (concat out (if ok "" (concat "\nexit " code))))))
                    ;; r155: the result row first, then the action's
                    ;; checkpoint marker (when the command changed the
                    ;; worktree) — whatever becomes of the turn.
                    (if (and entry (hashmap-get entry "snap"))
                      (fikra-ollama-action-checkpoint)
                      nil)
                    (if (not (fikra-ollama-turn-live-p))
                      ;; The turn ENDED while this child ran (e.g. the
                      ;; allow-path race): the evidence renders, nothing
                      ;; resumes — there is no turn to continue.
                      'turn-over
                      (progn
                        ;; r134 (codex r130 P1#4): a MEDIATED bash (the
                        ;; user allowed a mutation) lands its own action
                        ;; ref at exit — the snapshot pins exactly what
                        ;; the approved command changed.
                        (if (and entry (hashmap-get entry "mediated"))
                          (condition-case nil
                            (progn (require-module fikra/checkpoint)
                                   ;; r134c (codex r134b catch): SYNC — the
                                   ;; snapshot completes BEFORE the
                                   ;; continuation resumes (an async capture's
                                   ;; git add -A could stage a LATER edit into
                                   ;; this action's ref). r134e: this runs in
                                   ;; the SENTINEL context — the event emits
                                   ;; owner-bound (the pointer reads nil here).
                                   (fikra/checkpoint/fikra-checkpoint-set-emit-owner
                                     (if home home (fikra/thread/fikra-thread-current)))
                                   (fikra/checkpoint/fikra-checkpoint-capture "action")
                                   (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                                   ;; r142: the post→pre pair.
                                   (fikra-ollama-record-action-pair fikra-ollama-last-pre-name)
                                   (setq fikra-ollama-last-pre-name nil))
                            (error () nil)))
                        (if (not cont)
                          (progn
                            (setq fikra-ollama-messages
                              (concat fikra-ollama-messages msg))
                            (fikra-ollama-chat fikra-ollama-pending-message))
                          (fikra-ollama-resume-from cont msg)))))
                  (error (m)
                    ;; r131d (codex r131c catch): the handler itself
                    ;; must not throw — a failing turn-end (an
                    ;; unwritable event log) skipped the focus restore
                    ;; below and stranded the turn. Best effort, then
                    ;; restore regardless.
                    (condition-case nil
                      (progn
                        (editor-set-status (concat "Fikra-ollama: async resume failed — " m))
                        (if (fikra-ollama-turn-live-p)
                          (fikra/thread/fikra-thread-turn-end "error")))
                      (error () nil))
                    'sentinel-error))))
          (condition-case nil
            (if (and home (not (string= home prev)))
              (fikra/thread/fikra-thread-focus prev))
            (error () nil))
          r))))))))

;; Resume run-calls from the stash's index (the message already
;; appended).
;; r129: the t-clause body MUST be a single progn — a multi-expression
;; cond clause throws ("cond clause must have exactly 2 elements") and
;; the dispatcher's condition-case swallowed it, sticking live turns
;; "running" after the async tool round (unit-green because the async
;; tests never asserted the post-refire settle).
(defun fikra-ollama-resume-from (cont msg)
  (let ((calls (car cont))
        (i (car (cdr cont)))
        (acc (car (cdr (cdr cont)))))
    ;; The pre-async results (r127) + the completed message land at
    ;; their positions; the remaining calls' results append after.
    (setq fikra-ollama-messages
      (concat fikra-ollama-messages (if acc acc "") msg))
    (let ((results (fikra-ollama-run-calls calls i nil)))
      (cond
        ((and (symbolp results) (string= (symbol-name results) "parked")) nil)
        ((and (symbolp results) (string= (symbol-name results) "async")) nil)
        (t (progn
          (setq fikra-ollama-messages
            (concat fikra-ollama-messages "" results))
          ;; r137+r138: the async round's exchange persists in its turn's
          ;; slot (the sync branch lives in tool-round).
          (fikra-ollama-remember-exchange
            (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                    (fikra-ollama-calls-json calls 0 "")
                    "]}," (if acc acc "") msg results))
          (if (>= fikra-ollama-round fikra-ollama-max-rounds)
            (progn
              (setq fikra-ollama-pending-message nil)
              (fikra/event/fikra-event-emit
                (list (list "kind" "text-delta")
                      (list "speaker" "assistant")
                      (list "text" "(tool round cap reached — stopping the loop)")))
              (fikra/thread/fikra-thread-turn-end "completed"))
            (fikra-ollama-chat fikra-ollama-pending-message))))))))

;; The trailing EXIT:N line's N.
;; Does RAW's last line carry the EXIT:N marker?
(defun fikra-ollama-has-exit-p (raw)
  (let* ((lines (string-split (string-trim raw) "\n"))
         (last (if (> (length lines) 0) (nth (- (length lines) 1) lines) "")))
    (string-prefix-p "EXIT:" last)))

(defun fikra-ollama-exit-code (raw)
  (let* ((lines (string-split (string-trim raw) "\n"))
         (last (if (> (length lines) 0) (nth (- (length lines) 1) lines) "")))
    (if (string-prefix-p "EXIT:" last)
      (substring last 5 (length last))
      "0")))

;; Everything before the trailing EXIT line.
(defun fikra-ollama-strip-exit (raw)
  (let* ((lines (string-split (string-trim raw) "\n"))
         (kept (if (and (> (length lines) 0)
                        (string-prefix-p "EXIT:" (nth (- (length lines) 1) lines)))
                 (reverse (cdr (reverse lines)))
                 lines)))
    (fikra-ollama-join-lines kept "")))

(defun fikra-ollama-join-lines (lines acc)
  (if (null lines)
    acc
    (fikra-ollama-join-lines (cdr lines)
      (concat acc (if (> (length acc) 0) "\n") (car lines)))))

;; r133 (codex r130 P1#5): resolve SYMLINKS before the containment
;; verdict — a relative path through an in-tree symlink pointing
;; OUTSIDE wrote/read outside the tree while passing the ../ check.
;; Resolves the deepest EXISTING ancestor of DIR/PATH (the file itself
;; when it exists — a symlinked target is caught), then requires it to
;; sit under the RESOLVED working dir.
;; r133 catch: the old (string-match "\.\./" path) was a REGEX whose
;; stripped dots are WILDCARDS — any path with a directory component
;; matched (a latent over-refusal). A literal ".." byte scan instead.
(defun fikra-ollama-has-dotdot-p (s)
  (fikra-ollama-dotdot-scan s 0))

(defun fikra-ollama-dotdot-scan (s i)
  (if (> (+ i 1) (- (length s) 1))
    nil
    (if (and (string= (substring s i (+ i 1)) ".")
             (string= (substring s (+ i 1) (+ i 2)) "."))
      t
      (fikra-ollama-dotdot-scan s (+ i 1)))))

(defun fikra-ollama-path-contained-p (dir path)
  (if (or (<= (length path) 0)
          (string-prefix-p "/" path)
          (fikra-ollama-has-dotdot-p path))
    nil
    (let ((real-dir (condition-case nil
                      (string-trim (shell-command
                        (concat "realpath " (fikra/thread/fikra-thread-shq dir))))
                      (error () dir)))
          ;; The skeleton is HEX-BUILT (the reader leaves backslash
          ;; escapes intact in .tlisp literals). r133b (codex catch): a
          ;; DANGLING symlink escapes -e (the test follows links) — the
          ;; walk now stops at the link itself (-L) and readlink reveals
          ;; its outside target when realpath fails.
          (resolved (condition-case nil
                      (string-trim (shell-command
                        (concat "p=" (fikra/thread/fikra-thread-shq (concat dir "/" path))
                                (hex-decode "3b207768696c65205b2021202d652022247022205d202626205b2021202d4c2022247022205d3b20646f20703d24286469726e616d652022247022293b20646f6e653b207265616c70617468202224702220323e2f6465762f6e756c6c207c7c20726561646c696e6b2022247022"))))
                      (error () (concat dir "/" path)))))
      ;; resolved walks up to dir ITSELF for a not-yet-existing path
      ;; (no trailing slash) — the exact dir is contained too.
      ;; r133d (codex r133c catch): the readlink FALLBACK (a dangling
      ;; link) returns the RAW target — a lexical ".." hop inside it
      ;; passed the prefix compare; unresolvable hops refuse.
      (if (fikra-ollama-has-dotdot-p resolved)
        nil
        (if (string= resolved real-dir)
          t
          (string-prefix-p (concat real-dir "/") resolved))))))

;; r135 (codex r130 P2): up to 3 sign-prefixed lines + a counted tail
;; (the r106 evidence shape; the claude backend's preview builder is
;; module-scoped — a local twin).
;; r138 (codex r137 finding): a CHANGE-FOCUSED preview — the common
;; prefix/suffix lines trim away; only the CHANGED middles show (the
;; first-3-of-each shape displayed unchanged opening lines while a
;; change below them hid).
(defun fikra-ollama-diff-preview (old-text new-text)
  (let* ((a (string-split old-text (hex-decode "0a")))
         (b (string-split new-text (hex-decode "0a")))
         (p (fikra-ollama-diff-prefix a b 0))
         (s (fikra-ollama-diff-suffix a b 1 p))
         (removed (fikra-ollama-join-slice a p (- (length a) s)))
         (added (fikra-ollama-join-slice b p (- (length b) s))))
    (concat (if (> (length removed) 0) (fikra-ollama-preview-lines "-" removed) "")
            (if (> (length added) 0) (fikra-ollama-preview-lines "+" added) ""))))

;; The first index where the lines differ.
(defun fikra-ollama-diff-prefix (a b i)
  (if (or (>= i (length a)) (>= i (length b))
          (not (string= (nth i a) (nth i b))))
    i
    (fikra-ollama-diff-prefix a b (+ i 1))))

;; The count of MATCHING TAIL lines (bounded so it never overlaps the
;; prefix; stops at the first mismatch from the end).
(defun fikra-ollama-diff-suffix (a b i p)
  (if (or (>= i (length a)) (>= i (length b))
          (< (- (length a) i) p) (< (- (length b) i) p))
    (- i 1)
    (if (string= (nth (- (length a) i) a) (nth (- (length b) i) b))
      (fikra-ollama-diff-suffix a b (+ i 1) p)
      (- i 1))))

(defun fikra-ollama-join-slice (lines from to)
  (if (>= from to)
    ""
    (concat (nth from lines)
            (if (< (+ from 1) to) (hex-decode "0a") "")
            (fikra-ollama-join-slice lines (+ from 1) to))))

(defun fikra-ollama-preview-lines (sign text)
  (let ((lines (string-split text "\n"))
        (out ""))
    (fikra-ollama-preview-scan sign lines 0 (length lines) out)))

(defun fikra-ollama-preview-scan (sign lines i n out)
  (if (>= i n)
    (if (> n 3)
      (concat out sign " … " (number-to-string (- n 3)) " more
")
      out)
    (if (< i 3)
      (fikra-ollama-preview-scan sign lines (+ i 1) n
        (concat out sign " " (nth i lines) "
"))
      ;; skip the middle — the tail marker lands at the end
      (fikra-ollama-preview-scan sign lines (+ i 1) n out))))

(defun fikra-ollama-run-edit (call args)
  (let* ((path (if (fikra-ollama-alist-get "path" args)
                 (fikra-ollama-alist-get "path" args) ""))
         (content (if (fikra-ollama-alist-get "content" args)
                    (fikra-ollama-alist-get "content" args) ""))
         (dir (fikra/thread/fikra-thread-working-dir))
         ;; r117 (codex r116 P1#4) + r133: CONTAINMENT — a model edit
         ;; may not escape the working dir (absolute paths, .. escapes,
         ;; and — r133 — SYMLINK hops all refuse).
         (contained (fikra-ollama-path-contained-p dir path))
         (abs (concat dir "/" path))
         ;; r135: the OLD content for the INLINE diff evidence.
         (old-content (if contained
                        (condition-case nil (read-file-content abs) (error () nil))
                        nil)))
    (if (not contained)
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-call") (list "tool" "buffer-edit")
                (list "summary" (concat path " @" (number-to-string (length content))))))
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" nil)
                (list "summary" (concat "REFUSED: path escapes the working dir: " path))))
        (concat "{\"role\":\"tool\",\"content\":\"refused: path escapes the working directory\"},"))
      (progn
        (shell-command (concat "mkdir -p " (fikra/thread/fikra-thread-shq
                                             (fikra/thread/fikra-thread-dirname abs))))
        ;; r137+r139: the PRE-state ref (BEFORE the write — the revert
        ;; target). r142: its NAME is kept for the post→pre pair.
        (let ((pre-name nil))
          (condition-case nil
            (let ((sha (progn (require-module fikra/checkpoint)
                              (fikra/checkpoint/fikra-checkpoint-capture "action")))
                  (n (fikra/checkpoint/fikra-checkpoint-last-ref-name-get)))
              (setq pre-name n)
              (if (not sha)
                (editor-set-status "Fikra: action checkpoint FAILED — the edit proceeds without a revert ref")))
            (error (m)
              (editor-set-status
                (concat "Fikra: action checkpoint FAILED — the edit proceeds without a revert ref ("
                        (if (stringp m) m "capture error") ")"))))
          (let ((written (condition-case nil
                          (progn (write-file-content abs content) t)
                          (error () nil))))
            ;; r135c: the GEAR row + preview emit AFTER the verified
            ;; write (a failed write shows nothing it didn't do).
            (fikra/event/fikra-event-emit
              (list (list "kind" "tool-call") (list "tool" "buffer-edit")
                    (list "summary" (concat path " @" (number-to-string (length content))))
                    (list "preview"
                      (if written
                        (fikra-ollama-diff-preview
                          (if (and old-content (stringp old-content)) old-content "")
                          content)
                        ""))))
            (if (not written)
              (progn
                (fikra/event/fikra-event-emit
                  (list (list "kind" "tool-result") (list "ok" nil)
                        (list "summary" (concat "WRITE FAILED: " path))))
                (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string (concat "write failed: " path)) "},"))
              (progn
                ;; The POST-write ref (evidence + inline marker). r142:
                ;; the post→pre pair (the action-level revert).
                (condition-case nil
                  (progn (require-module fikra/checkpoint)
                         (fikra/checkpoint/fikra-checkpoint-capture "action")
                         (fikra-ollama-record-action-pair pre-name))
                  (error () nil))
                (fikra/event/fikra-event-emit
                  (list (list "kind" "tool-result") (list "ok" t)
                        (list "summary" (concat "wrote " path))))
                (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string (concat "wrote " path)) "},")))))))))

;; r135c (codex catch): the fragment must be VALID JSON — the content
;; string was never closed, and the tool name rode in unescaped.
(defun fikra-ollama-tool-skip (call fname)
  (concat "{\"role\":\"tool\",\"content\":"
          (fikra-ollama-json-string (concat "unknown tool: " (if fname fname "?")))
          "},"))

;; Events arrive OLDEST-FIRST; the history is every COMPLETED turn —
;; everything up to and including the LAST turn-end (the in-flight
;; user message is emitted BEFORE its turn-start — a turn-start cut
;; would double it; the turn-end boundary excludes the whole open turn).
;; r142b: the last action-revert stash accessor.
(defun fikra-ollama-last-action-stash-get ()
  (if fikra-ollama-last-action-stash fikra-ollama-last-action-stash nil))

;; r142: the action post-refs (newest-first) as a NEWLINE-joined string
;; (list values stringify as [object Object] across the eval boundary).
(defun fikra-ollama-action-posts-get ()
  (fikra-ollama-join-strings fikra-ollama-action-posts ""))

(defun fikra-ollama-join-strings (items acc)
  (if (or (not items) (= (length items) 0))
    acc
    (fikra-ollama-join-strings (cdr items)
      (concat acc (if (> (length acc) 0) (hex-decode "0a") "") (car items)))))

;; r150 (codex): the action pairs are DURABLE — each pair appends a
;; line to the thread's actions.jsonl (post-ref SPACE pre-ref); the
;; revert reloads the stack from it when memory is empty (a restart kept
;; the refs but lost the pairs — the command reported "no action").
(defun fikra-ollama-actions-file ()
  (concat (fikra/thread/fikra-thread-field "root")
          "/.tmax/fikra/threads/" (fikra/thread/fikra-thread-current)
          "/actions.jsonl"))

(defun fikra-ollama-load-action-pairs ()
  (condition-case nil
    (let ((text (condition-case nil
                  (read-file-content (fikra-ollama-actions-file))
                  (error () nil))))
      (if (and text (stringp text) (> (length text) 0))
        (fikra-ollama-load-action-lines (reverse (string-split text (hex-decode "0a"))))
        nil))
    (error () nil)))

;; r150: the restart-simulation accessor (pairs + stack wiped).
(defun fikra-ollama-action-state-reset ()
  (setq fikra-ollama-action-pairs (hashmap))
  (setq fikra-ollama-action-posts (list)))

;; r152: drop other threads' entries (newest-first preserved).
(defun fikra-ollama-posts-for-thread (posts)
  (if (or (not posts) (= (length posts) 0))
    (list)
    (let ((keep (string= (fikra-ollama-ref-thread (car posts))
                         (fikra/thread/fikra-thread-current))))
      (if keep
        (append (list (car posts)) (fikra-ollama-posts-for-thread (cdr posts)))
        (fikra-ollama-posts-for-thread (cdr posts))))))

;; r152: the OWNER's actions file (a cross-thread revert must tombstone
;; in the owner's history, not the focused thread's).
(defun fikra-ollama-actions-file-for (thread)
  (concat (fikra/thread/fikra-thread-field-root-of thread)
          "/.tmax/fikra/threads/" thread "/actions.jsonl"))

(defun fikra-ollama-tombstone-action (post)
  ;; r152 (codex #3): a failed tombstone write is VISIBLE — a restart
  ;; could resurrect the reverted action.
  (let ((out (condition-case nil
                (progn
                  (append-file (fikra-ollama-actions-file-for
                                 (fikra-ollama-ref-thread post))
                    (concat post " REVERTED" (hex-decode "0a")))
                  "ok")
                (error () "failed"))))
    (if (string= out "failed")
      (progn
        ;; r152b (codex): DURABLE — the status line is ephemeral (the
        ;; revert's own success status overwrote the warning); the
        ;; transcript row survives.
        (fikra/event/fikra-event-emit
          (list (list "kind" "checkpoint-error")
                (list "reason" "revert bookkeeping failed to persist — a restart may re-offer this action")))
        (editor-set-status
          "Fikra: revert bookkeeping FAILED to persist — a restart may re-offer this action"))
      nil)))

;; Newest-last in the file; reversed = newest-first = the stack order.
;; Memory wins per key; the stack rebuilds newest-first.
(defun fikra-ollama-load-action-lines (lines)
  (if (or (not lines) (= (length lines) 0))
    nil
    (progn
      (condition-case nil
        (let* ((line (car lines))
               (sp (string-match " " line)))
          (if (and sp (numberp sp) (> sp 0))
            (let* ((post (substring line 0 sp))
                   ;; r155e (codex gate): a never-landed build wrote an
                   ;; optional " ix" token after the pre-ref — read as part
                   ;; of the ref it made every such pair unloadable.
                   (pre0 (substring line (+ sp 1) (length line)))
                   (pre (if (and (> (length pre0) 3)
                                 (string= (substring pre0 (- (length pre0) 3) (length pre0)) " ix"))
                          (substring pre0 0 (- (length pre0) 3))
                          pre0))
                   (have (hashmap-get fikra-ollama-action-pairs post)))
              ;; r150: a REVERTED tombstone (newest line for the post)
              ;; stays reverted — the loader never resurrects it.
              (cond
                ;; r150: the tombstone MARKS the post (newest line wins) —
                ;; older pair lines for the same post then skip.
                ((and (not have) (string= pre "REVERTED"))
                  (keymap-mutable-set! fikra-ollama-action-pairs post "REVERTED"))
                ((not have)
                  (progn
                    (keymap-mutable-set! fikra-ollama-action-pairs post pre)
                    ;; r150b: newest-first iteration + APPEND keeps the
                    ;; NEWEST at the head (prepend reversed the order).
                    (setq fikra-ollama-action-posts
                      (append fikra-ollama-action-posts (list post)))))))))
        (error () nil))
      (fikra-ollama-load-action-lines (cdr lines)))))

;; r142: pair an action's post-ref with its pre-ref (called right
;; after the post capture; both names read from the checkpoint module's
;; last-ref-name stash).
(defun fikra-ollama-record-action-pair (pre)
  (let* ((post (fikra/checkpoint/fikra-checkpoint-last-ref-name-get))
         (pre-ref (if pre pre nil)))
    (if (and post pre-ref)
      (progn
        (keymap-mutable-set! fikra-ollama-action-pairs post pre-ref)
        (setq fikra-ollama-action-posts (append (list post) fikra-ollama-action-posts))
        ;; r150/r152: the durable line — a failure is VISIBLE (a
        ;; restart would lose this revertable action).
        (let ((out (condition-case nil
                      (progn
                        (append-file (fikra-ollama-actions-file)
                          (concat post " " pre-ref (hex-decode "0a")))
                        "ok")
                      (error () "failed"))))
          (if (string= out "failed")
            (progn
              (fikra/event/fikra-event-emit
                (list (list "kind" "checkpoint-error")
                      (list "reason" "action bookkeeping failed to persist — a restart may lose this revert")))
              (editor-set-status
                "Fikra: action bookkeeping FAILED to persist — a restart may lose this revert"))
            nil)))
      nil)))

;; r142: THE ACTION-LEVEL REVERT — restore the LATEST action's touched
;; paths from ITS pre-ref (checkout when the pre-ref has the path,
;; remove when the action ADDED it). A verified stash patch lands first
;; (the turn-revert discipline).
;; The THREAD id embedded in a refs/fikra/<thread>/<turn>-aN ref.
;; The THREAD id embedded in a refs/fikra/<thread>/<turn>-aN ref.
(defun fikra-ollama-ref-thread (ref)
  (let* ((rest (substring ref (length "refs/fikra/") (length ref)))
         (slash (string-match "/" rest)))
    (if (and slash (numberp slash) (> slash 0))
      (substring rest 0 slash)
      (fikra/thread/fikra-thread-current))))

;; r146: does the CURRENT state match the PRE-ref (the revert's end
;; state) on the paths? EXACT per-path check — git diff <ref> is blind
;; to UNTRACKED files (an added-but-never-staged path looked CLEAN).
;; r149: each path may legitimately match the POST-ref content (not
;; yet restored) OR the PRE-ref content (already restored by a partial
;; retry) — anything else is user divergence. (Comparing against the
;; pre-ref ALONE refused every ADDED-file revert: the action's own
;; post-content read as divergence.)
(defun fikra-ollama-state-diverged-p (root pre post paths)
  (fikra-ollama-state-diverged-scan root pre post paths))

;; A tree entry's MODE at a ref (git ls-tree's first field), nil when
;; the ref lacks the path.
(defun fikra-ollama-ref-mode (root ref p)
  (let ((out (shell-command
               (concat "git -C " (fikra/thread/fikra-thread-shq root)
                       " ls-tree " ref " -- " (fikra/thread/fikra-thread-shq p) " 2>/dev/null"))))
    (if (and (stringp out) (> (length out) 7) (string= (substring out 6 7) " "))
      (substring out 0 6)
      nil)))

;; r149d: TWO commands — an exit-status probe (content-independent) and
;; the raw content. A content equal to any marker string can never
;; collide; no newline stripping (byte-exact both sides).
;; r155c (codex gate): a state is "<mode> NEWLINE <content>" — the KIND
;; (file / symlink) and the executable bit are part of it. Content alone
;; let a symlink replaced by a file holding its target text pass for
;; untouched, and a later chmod +x be reset by the restore.
(defun fikra-ollama-path-state (root ref p)
  (let ((mode (fikra-ollama-ref-mode root ref p)))
    (if mode
      (concat mode "\n"
              (shell-command (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                      " show " ref ":" (fikra/thread/fikra-thread-shq p) " 2>/dev/null")))
      nil)))

;; r155b (codex gate): a SYMLINK's state is its TARGET TEXT (what the
;; tree stores), not the content it points at — `cat` followed the
;; link, so a link-creating action read as "changed since the action"
;; and could never be reverted (a dangling link read as absent).
;; r155c: the state is "<mode> NEWLINE <content>" (120000 for a link,
;; 100755 when the file is executable, else 100644).
(defun fikra-ollama-worktree-state (root p)
  (let ((abs (fikra/thread/fikra-thread-shq (concat root "/" p))))
    (let ((kind (string-trim (shell-command
               (concat "if [ -L " abs " ]; then echo LINK; elif [ -e " abs " ]; then "
                       "if [ -x " abs " ]; then echo XFILE; else echo FILE; fi; else echo MISS; fi")))))
      (cond
        ;; readlink ends its output with a newline the tree does not
        ;; store — command substitution drops it, printf adds none.
        ((string= kind "LINK")
          (concat "120000\n"
                  (shell-command (concat "__l=$(readlink " abs " 2>/dev/null) && printf %s \"$__l\""))))
        ;; r155d (codex gate): with core.fileMode=false git records every
        ;; file as non-executable — the worktree must read the same way,
        ;; or a pre-existing executable bit reads as divergence forever.
        ((string= kind "XFILE")
          (concat (if (fikra-ollama-file-mode-off-p root) "100644" "100755")
                  "\n" (shell-command (concat "cat " abs " 2>/dev/null"))))
        ((string= kind "FILE")
          (concat "100644\n" (shell-command (concat "cat " abs " 2>/dev/null"))))
        (t nil)))))
;; Whether git ignores the executable bit in this repository.
(defun fikra-ollama-file-mode-off-p (root)
  (string= (string-trim (shell-command
            (concat "git -C " (fikra/thread/fikra-thread-shq root)
                    " config core.fileMode 2>/dev/null")))
            "false"))


;; r149: the INDEX content of a path (a staged-only change with a
;; matching worktree file must still refuse — the r146 staged catch).
;; r155c: the staged entry's MODE rides along (git ls-files -s's first
;; field) — the same "<mode> NEWLINE <content>" shape as every other side.
(defun fikra-ollama-index-state (root p)
  (let* ((out (shell-command
                (concat "git -C " (fikra/thread/fikra-thread-shq root)
                        " ls-files -s -- " (fikra/thread/fikra-thread-shq p) " 2>/dev/null")))
         (mode (if (and (stringp out) (> (length out) 6)) (substring out 0 6) nil)))
    (if mode
      (concat mode "\n"
              (shell-command (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                      " show :" (fikra/thread/fikra-thread-shq p) " 2>/dev/null")))
      nil)))

(defun fikra-ollama-state-diverged-scan (root pre post paths)
  (if (or (not paths) (= (length paths) 0))
    nil
    (let* ((p (car paths))
           (cur (fikra-ollama-worktree-state root p))
           (ix (fikra-ollama-index-state root p))
           (want-post (fikra-ollama-path-state root post p))
           (want-pre (fikra-ollama-path-state root pre p)))
      ;; r149d: nil-aware — nil (absent/unstaged) equals only nil; strings
      ;; compare byte-exactly. A non-string sentinel cannot collide with
      ;; ANY content (the string markers did — bare and newline forms).
      ;; r152 (codex #1): a NIL index is only legitimate for a path
      ;; UNTRACKED in both refs — a tracked path with no index entry is
      ;; a STAGED DELETION the revert would silently undo.
      (if (not (and (or (fikra-ollama-state-eq cur want-post)
                        (fikra-ollama-state-eq cur want-pre))
                    (if (null ix)
                      ;; A nil index diverges only for a path TRACKED AT
                      ;; HEAD (a staged deletion); a never-committed new
                      ;; file legitimately has no index entry.
                      (not (fikra-ollama-tracked-at-head-p root p))
                      (or (fikra-ollama-state-eq ix want-post)
                          (fikra-ollama-state-eq ix want-pre)
                          ;; r155b (codex gate): an index that still holds
                          ;; HEAD's version is not divergence — it is work
                          ;; the user never staged (the refs are WORKTREE
                          ;; snapshots, so an unstaged edit made every
                          ;; touched path refuse). The restore writes the
                          ;; worktree only, so the index cannot be harmed.
                          (fikra-ollama-state-eq ix (fikra-ollama-path-state root "HEAD" p))))))
        t
        (fikra-ollama-state-diverged-scan root pre post (cdr paths))))))

;; r152: is the path in HEAD's tree? (a nil index for a HEAD-tracked
;; path = a staged deletion the revert would silently undo.)
(defun fikra-ollama-tracked-at-head-p (root p)
  (string= (string-trim (shell-command
    (concat "git -C " (fikra/thread/fikra-thread-shq root)
            " cat-file -e HEAD:" (fikra/thread/fikra-thread-shq p)
            " 2>/dev/null && echo YES || echo NO"))) "YES"))

;; nil=nil; string=string byte-exact; nil vs string = false.
(defun fikra-ollama-state-eq (a b)
  (if (null a)
    (null b)
    (if (null b)
      nil
      (string= a b))))

(defun fikra-ollama-revert-latest-action ()
  (require-module fikra/checkpoint)
  ;; r150: a restart kept the refs but lost the pairs — reload first.
  (if (or (not fikra-ollama-action-posts) (= (length fikra-ollama-action-posts) 0))
    (fikra-ollama-load-action-pairs)
    nil)
  ;; r152 (codex #2): the revert is SCOPED to the focused thread — the
  ;; stack is global, so skip other threads' entries (a focused fix-1
  ;; reverted main's action before).
  (setq fikra-ollama-action-posts
    (fikra-ollama-posts-for-thread fikra-ollama-action-posts))
  (if (or (not fikra-ollama-action-posts) (= (length fikra-ollama-action-posts) 0))
    (editor-set-status "Fikra: no action to revert in this thread")
    (let* ((post (car fikra-ollama-action-posts))
           (pre (hashmap-get fikra-ollama-action-pairs post))
           (owner (fikra-ollama-ref-thread post))
           (root (or (fikra/thread/fikra-thread-working-dir-of owner)
                     (fikra/thread/fikra-thread-working-dir))))
      (if (not pre)
        (editor-set-status (concat "Fikra: no pre-ref recorded for " post))
        (let* ((stash (concat root "/.tmax/fikra/stash/action-"
                              (number-to-string (current-time)) ".patch"))
               ;; r155c (codex gate): the paths are read NUL-separated —
               ;; git C-quotes names with spaces or quotes in its line
               ;; output, and the quoted text was passed as a filename.
               (paths (fikra-ollama-split-paths
                        (shell-command
                          (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                  " diff --name-only -z " pre " " post)))))
          (cond
            ((= (length paths) 0)
              ;; r146 (codex): a no-change action SKIPS (pops) — it
              ;; blocked every older action's revert forever.
              (progn
                (setq fikra-ollama-action-posts (cdr fikra-ollama-action-posts))
                (keymap-mutable-set! fikra-ollama-action-pairs post nil)
                (fikra-ollama-tombstone-action post)
                (editor-set-status "Fikra: the action changed nothing — skipped")
                'skipped))
            ;; r146 (codex): the divergence compares the CURRENT state
            ;; against the EXPECTED END state (the pre-ref) — user
            ;; changes still refuse, but paths already restored by a
            ;; partial retry PASS.
            ((fikra-ollama-state-diverged-p root pre post paths)
              (editor-set-status
                (concat "Fikra: action revert REFUSED — the working tree "
                        "changed since the action (commit or stash first)")))
            (t (progn
              (shell-command (concat "mkdir -p " (fikra/thread/fikra-thread-shq
                               (concat root "/.tmax/fikra/stash"))))
              (let* ((stash-q (fikra/thread/fikra-thread-shq stash))
                     (patch-out (shell-command
                                  (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                          " diff --binary " pre " " post " -- "
                                          (fikra-ollama-paths-args paths)
                                          " > " stash-q " 2>/dev/null"
                                          " && test -s " stash-q " && echo STASH-OK"
                                          " || echo STASH-FAILED"))))
                (if (not (string= (string-trim patch-out) "STASH-OK"))
                  (progn
                    (editor-set-status
                      (concat "Fikra: action revert ABORTED — the stash patch "
                              "could not be written; nothing was changed"))
                    'stash-failed)
                  (progn
                    (setq fikra-ollama-last-action-stash stash)
                    (setq fikra-ollama-revert-preserved-count 0)
                    (let ((fails (fikra-ollama-restore-paths root pre post paths (list))))
                      (if (> (length fails) 0)
                        (progn
                          (editor-set-status
                            (concat "Fikra: action revert INCOMPLETE — "
                                    (number-to-string (length fails))
                                    " path(s) failed; the action remains revertable"))
                          fails)
                        (progn
                          (setq fikra-ollama-action-posts (cdr fikra-ollama-action-posts))
                          (keymap-mutable-set! fikra-ollama-action-pairs post nil)
                          (fikra-ollama-tombstone-action post)
                          ;; r155d/r155e: staged entries left in place are
                          ;; said out loud, in the status AND in the
                          ;; transcript — a commit would record them. Which
                          ;; entries qualify: fikra-ollama-restore-paths.
                          ;; r155f (codex gate): the note states the
                          ;; consequence and the review command — never
                          ;; what to do about it (the staged content may
                          ;; be the user's own earlier work: unstaging it
                          ;; would lose that, and nothing is "gone").
                          (if (> fikra-ollama-revert-preserved-count 0)
                            (condition-case nil
                              (fikra/event/fikra-event-emit-batch-for (fikra/thread/fikra-thread-current)
                                (list (list (list "kind" "checkpoint-error")
                                            (list "reason" (concat "note: "
                                                                    (number-to-string fikra-ollama-revert-preserved-count)
                                                                    " path(s) still staged with the content the action left — a commit would record that content, not what the revert restored (review: git diff --cached)")))))
                              (error () nil))
                            nil)
                          (editor-set-status
                            (concat "Fikra: action reverted to " pre
                                    (if (> fikra-ollama-revert-preserved-count 0)
                                      (concat " — "
                                              (number-to-string fikra-ollama-revert-preserved-count)
                                              " path(s) still staged: a commit would record the action's content (review: git diff --cached)")
                                      "")))
                          'ok))))))))))))))

;; Paths as sh-quoted argv text.
(defun fikra-ollama-paths-args (paths)
  (if (or (not paths) (= (length paths) 0))
    ""
    (concat (fikra/thread/fikra-thread-shq (car paths))
            (if (> (length paths) 1) (concat " " (fikra-ollama-paths-args (cdr paths))) ""))))

;; Restore each PATH from REF (checkout when REF has it; remove when
;; REF lacks it — the action ADDED it). Returns the failure list.
;; r146 (codex re-grade): the restore is RETRY-SAFE and index-clean —
;; a removed path also leaves the INDEX (a staged addition outlived the
;; worktree rm); removal is VERIFIED (rm -f ...; true reported success
;; on failure); a failed checkout records the path. A partial restore
;; leaves the action on the stack, and the retry's divergence check
;; passes because restored paths now match the PRE-ref... which the
;; post-ref check would flag — so the retry compares against the
;; EXPECTED end-state (pre-ref content) per path, not the post-ref.
(defun fikra-ollama-restore-paths (root ref post paths fails)
  (if (or (not paths) (= (length paths) 0))
    fails
    (let* ((p (car paths))
           (has (string= (string-trim (shell-command
                          (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                  " cat-file -e " ref ":" (fikra/thread/fikra-thread-shq p)
                                  " 2>/dev/null && echo YES || echo NO"))) "YES"))
           ;; r155b (codex gate P0): the WORKTREE is restored — never the
           ;; index. `git checkout <ref> -- <path>` writes both: it
           ;; overwrote a version the user had STAGED (and staged work the
           ;; user had left unstaged). `git restore --worktree` leaves the
           ;; index exactly as the user left it. (A command's own
           ;; `git add` therefore stays staged after a revert — declared.)
           ;; r155d (codex gate): a repository with core.fileMode=false
           ;; cannot carry the executable bit through a restore (git
           ;; writes its default mode there) — the bit the file had is
           ;; put back when the action itself did not change it.
           (keep-x (and (fikra-ollama-file-mode-off-p root)
                        (string= (fikra-ollama-ref-mode root ref p)
                                 (fikra-ollama-ref-mode root post p))))
           (was-x (string= (string-trim (shell-command
                        (concat "test -x " (fikra/thread/fikra-thread-shq (concat root "/" p))
                                " && echo X || echo N"))) "X"))
           (ok (if has
                 (string= (string-trim (shell-command
                   (concat "git -C " (fikra/thread/fikra-thread-shq root)
                           " restore --source=" ref " --worktree -- " (fikra/thread/fikra-thread-shq p)
                           " 2>/dev/null && echo RESTORED || echo FAILED"))) "RESTORED")
                 ;; Removal (a path the action ADDED): the WORKTREE file
                 ;; goes; the removal is verified (the path must be gone).
                 ;; r155d (codex gate P0): the index is never written — a
                 ;; staged entry stays (it is announced below).
                 (string= (string-trim (shell-command
                   (concat "rm -f " (fikra/thread/fikra-thread-shq (concat root "/" p)) " 2>/dev/null; "
                           "test ! -e " (fikra/thread/fikra-thread-shq (concat root "/" p))
                           " && echo RESTORED || echo FAILED"))) "RESTORED"))))
      (if (and ok has keep-x was-x)
        (shell-command (concat "chmod +x "
                      (fikra/thread/fikra-thread-shq (concat root "/" p))))
        nil)
      ;; r155e (codex gate P0): a staged entry can outlive the revert
      ;; holding the ACTION's result — the worktree went back to the
      ;; pre-action content, the index still holds what the action wrote,
      ;; and a later commit would silently bring it back.
      ;; r155f (codex gate): ONE rule, for a restored and a removed path
      ;; alike. An entry is announced when it holds the action's result
      ;; (index state == post state) AND differs from HEAD — only then
      ;; would a commit record something other than the pre-action state.
      ;; Not announced: an entry at HEAD (nothing is staged — an action
      ;; that ran `git restore`), and the user's own staging that equals
      ;; the restored file (index and worktree agree again).
      ;; WHO staged an announced entry cannot be known — the content may
      ;; be the user's own earlier staging — so the note states the
      ;; consequence and the review command, never what to do about it.
      (let ((__ix (if ok (fikra-ollama-index-state root p) nil)))
        (if (and __ix
                 (fikra-ollama-state-eq __ix (fikra-ollama-path-state root post p))
                 (not (fikra-ollama-state-eq __ix (fikra-ollama-path-state root "HEAD" p))))
          (setq fikra-ollama-revert-preserved-count
            (+ 1 fikra-ollama-revert-preserved-count))
          nil))
      (fikra-ollama-restore-paths root ref post (cdr paths)
        (if ok fails (append fails (list p)))))))

;; r138: append FRAGMENT into the CURRENT turn's exchange slot.
;; r139: the slot key is THREAD/TURN/ROUND — every round flushes in
;; event order (the walker appends them at the turn's end in key
;; order), and no fragment re-embeds the narration text.
;; r143 (codex 9-item): the exchanges are DURABLE — every remember also
;; appends a hex-encoded line to the thread's exchanges.jsonl (hex is
;; reader-safe both directions; JSON round-trips hit the escape gaps),
;; and history-build reloads missing keys from it. A daemon restart
;; loses nothing.
(defun fikra-ollama-exchanges-file ()
  (concat (fikra/thread/fikra-thread-field "root")
          "/.tmax/fikra/threads/" (fikra/thread/fikra-thread-current)
          "/exchanges.jsonl"))

(defun fikra-ollama-remember-exchange (fragment)
  (let* ((key (concat (fikra/thread/fikra-thread-current) "/"
                      (number-to-string (fikra/thread/fikra-thread-turn-count))
                      "/" (number-to-string fikra-ollama-round)))
         (prior (hashmap-get fikra-ollama-tool-exchanges key)))
    (let ((full (concat (if prior prior "") fragment)))
      (keymap-mutable-set! fikra-ollama-tool-exchanges key full)
      ;; r143b: the durable append writes the FULL accumulated value (a
      ;; snapshot per line); reload takes the LAST line per key — the
      ;; incremental-lines + concatenate model DOUBLE-LOADED overlapping
      ;; content (the rejection rode twice).
      ;; r145 (#5): a write failure is VISIBLE — the in-memory map
      ;; serves the session, but a restart would silently lose this
      ;; exchange; the status says so (once per failure, not per turn).
      (let ((out (condition-case nil
                  (progn
                    (append-file (fikra-ollama-exchanges-file)
                      (concat (hex-encode key) " " (hex-encode full) (hex-decode "0a")))
                    "ok")
                  (error () "failed"))))
        (if (string= out "failed")
          (editor-set-status
            "Fikra: exchange persistence FAILED — a restart may lose recent tool context")
          nil)))))

;; r143: accessors for the durability regression.
(defun fikra-ollama-exchanges-file-get ()
  (fikra-ollama-exchanges-file))

(defun fikra-ollama-tool-exchanges-reset ()
  (setq fikra-ollama-tool-exchanges (hashmap)))

;; r143: reload file entries the in-memory map lacks (idempotent; the
;; map wins for in-flight turns).
(defun fikra-ollama-load-exchanges ()
  (condition-case nil
    (let ((text (condition-case nil
                  (read-file-content (fikra-ollama-exchanges-file))
                  (error () nil))))
      (if (and text (stringp text) (> (length text) 0))
        ;; r150: REVERSE order + set-if-absent = memory wins, else the
        ;; NEWEST file line wins (r143b's last-wins preserved).
        (fikra-ollama-load-exchange-lines
          (reverse (string-split text (hex-decode "0a"))))
        nil))
    (error () nil)))

(defun fikra-ollama-load-exchange-lines (lines)
  (if (or (not lines) (= (length lines) 0))
    nil
    (progn
      (condition-case nil
        (let* ((line (car lines))
               (sp (string-match " " line)))
          (if (and sp (numberp sp) (> sp 0))
            (let* ((k (hex-decode (substring line 0 sp)))
                   (frag (hex-decode (substring line (+ sp 1) (length line))))
                   (have (hashmap-get fikra-ollama-tool-exchanges k)))
              ;; r143b: LAST snapshot wins (each line is the full
              ;; accumulated value at write time). r150 (codex): the
              ;; IN-MEMORY value wins over the FILE — a failed append left
              ;; the disk stale; reloading clobbered the newer memory.
              (if have
                nil
                (keymap-mutable-set! fikra-ollama-tool-exchanges k frag)))))
        (error () nil))
      (fikra-ollama-load-exchange-lines (cdr lines)))))

(defun fikra-ollama-history-messages ()
  ;; r154 (codex re-grade): the source is the thread's DURABLE log, not
  ;; the in-memory copy — that one is FOCUS-scoped (a focus switch resets
  ;; it; a background turn never enters it), so a conversation continued
  ;; after a thread switch carried NO history. Adjacent streamed deltas
  ;; merge into one message BEFORE the cut is located (the cut indexes
  ;; the list the scan walks).
  ;; r143: durable reload FIRST — a restart rebuilt the map empty; the
  ;; file is the durable record. r154b (codex gate P1): FIRST means
  ;; before the budget picks its turns: a cold start sized them without
  ;; their durable tool exchanges, then the scan included those anyway
  ;; (14181 chars of history against the 6000 budget on the first prompt
  ;; after a restart).
  (fikra-ollama-load-exchanges)
  (let* ((merged (fikra-ollama-merge-deltas
                   (fikra-ollama-completed-events
                     (fikra/event/fikra-event-events-of
                       (fikra/thread/fikra-thread-current) fikra-ollama-history-window))))
         (cutoff (+ (fikra-ollama-last-turn-end merged 0 -1) 1))
         ;; r154: the most recent WHOLE turns within the budget.
         (start (fikra-ollama-history-start merged cutoff)))
    ;; r139: rounds flush one-by-one as the turn's narrations arrive
    ;; (narration1, tools1, narration2, tools2, final reply).
    (fikra-ollama-history-scan merged start cutoff "" nil nil 1)))

;; r154 (codex re-grade): ADJACENT same-speaker text-deltas are ONE
;; message. Streaming delivers a reply token by token — every delta used
;; to serialize as its own assistant message ("hello" + " world" went to
;; the model as two), reshaping its own prior turns. A run ends at a
;; speaker change, a tool event or a turn boundary; markers (checkpoints,
;; file changes, permission requests…) ride through without breaking it.
;; Only conversational events survive the merge (the scan reads no other).
(defun fikra-ollama-merge-deltas (events)
  (reverse (fikra-ollama-merge-scan events (list) "" "")))

(defun fikra-ollama-merge-scan (events out speaker text)
  (if (null events)
    (fikra-ollama-merge-flush out speaker text)
    (let* ((e (car events))
           (k (fikra/event/fikra-event-get-str e "kind")))
      (cond
        ((string= k "text-delta")
          (let ((sp (if (string= (fikra/event/fikra-event-get-str e "speaker") "user")
                        "user" "assistant"))
                (tx (fikra-ollama-event-text e)))
            (cond
              ((= (length tx) 0)
                (fikra-ollama-merge-scan (cdr events) out speaker text))
              ((string= sp speaker)
                (fikra-ollama-merge-scan (cdr events) out speaker (concat text tx)))
              (t
                (fikra-ollama-merge-scan (cdr events)
                  (fikra-ollama-merge-flush out speaker text) sp tx)))))
        ((or (string= k "tool-call") (string= k "tool-result")
             (string= k "permission-denied") (string= k "permission-allowed")
             (string= k "turn-start") (string= k "turn-end"))
          (fikra-ollama-merge-scan (cdr events)
            (cons e (fikra-ollama-merge-flush out speaker text)) "" ""))
        (t (fikra-ollama-merge-scan (cdr events) out speaker text))))))

;; The open run as one text-delta event, consed onto OUT (newest-first).
(defun fikra-ollama-merge-flush (out speaker text)
  (if (> (length text) 0)
    (cons (list (list "kind" "text-delta")
                (list "speaker" speaker)
                (list "text" text))
          out)
    out))

;; An event's text ("" unless it is a string — a malformed field must
;; never throw inside the history build, which runs inside start-turn).
(defun fikra-ollama-event-text (e)
  (let ((tx (fikra/event/fikra-event-get-str e "text")))
    (if (stringp tx) tx "")))

;; r154c (codex gate P1): only COMPLETED turns are history. A turn whose
;; turn-end never arrived (a crash mid-turn) is dropped whole — with its
;; question and its partial reply. The budget already refused to SIZE
;; such a turn, but the scan serialized everything from the chosen start,
;; so a crashed turn between two completed ones leaked into the prompt.
;; (The in-flight turn is such an open group too: its question is logged
;; before its turn-start, before this build runs.)
;; Runs on the RAW events, BEFORE the delta merge: a question abandoned
;; before its turn started would otherwise merge into the next question
;; (codex gate round 3: history showed "abandonednew" as the question).
(defun fikra-ollama-completed-events (events)
  ;; r154e (codex gate round 4): a turn the user REVERTED is not history
  ;; either. Replay hides the tombstoned range (target, revert-point];
  ;; the model was still told about it — for as long as the thread lives,
  ;; now that history is durable.
  (fikra-ollama-completed-scan events nil (list) (list) nil
    (fikra/event/fikra-event-tombstone-ranges events)))

;; Groups open at a question and close at their OWN turn-end; only closed
;; ones survive, and none that lie in a reverted range. CUR is the open
;; group newest-first; GROUPS the closed ones; TURN-N the number of the
;; group's turn-start (nil until seen). (List accumulators seed as
;; (list) — this dialect's cons refuses a nil tail.)
(defun fikra-ollama-completed-scan (rest open-p cur groups turn-n ranges)
  (if (null rest)
    (apply 'append (reverse groups))
    (let ((e (car rest)))
      (let ((k (fikra/event/fikra-event-get-str e "kind")))
        (cond
          ((and (string= k "text-delta")
                (string= (fikra/event/fikra-event-get-str e "speaker") "user"))
            ;; A question opens the next turn; a group still open here
            ;; never ended.
            (fikra-ollama-completed-scan (cdr rest) t (list e) groups nil ranges))
          ((and open-p (string= k "turn-start"))
            (fikra-ollama-completed-scan (cdr rest) open-p (cons e cur) groups
              (fikra-ollama-turn-number e) ranges))
          ((and open-p (string= k "turn-end"))
            (cond
              ;; An ending of an EARLIER turn (the replay's stale-ending
              ;; class) must not close THIS group — it used to leave the
              ;; question in history and drop its answer (codex gate r3).
              ((fikra-ollama-stale-ending-p turn-n e)
                (fikra-ollama-completed-scan (cdr rest) open-p cur groups turn-n ranges))
              ;; Reverted: the whole turn goes, as it does on screen.
              ((fikra-ollama-reverted-p turn-n ranges)
                (fikra-ollama-completed-scan (cdr rest) nil (list) groups nil ranges))
              (t
                (fikra-ollama-completed-scan (cdr rest) nil (list)
                  (cons (reverse (cons e cur)) groups) nil ranges))))
          (open-p
            (fikra-ollama-completed-scan (cdr rest) open-p (cons e cur) groups turn-n ranges))
          (t
            (fikra-ollama-completed-scan (cdr rest) open-p cur groups turn-n ranges)))))))

;; Whether a completed turn lies in a REVERTED range — replay's own rule
;; (checkpoint-reverted {target revert-point} hides (target, revert-point]).
;; Named limit: a turn-start with no usable turn id ("?") cannot be
;; placed in a range and stays (no production writer emits one).
(defun fikra-ollama-reverted-p (turn-n ranges)
  (and (stringp turn-n)
       (not (string= turn-n "?"))
       (fikra/event/fikra-event-in-range-p (string-to-number turn-n) ranges)))

;; A turn's number from its turn-start/turn-end ("?" when unparseable).
(defun fikra-ollama-turn-number (e)
  (let ((v (fikra/event/fikra-event-get e "turn")))
    (cond
      ((numberp v) (number-to-string v))
      ((stringp v) v)
      (t "?"))))

;; Whether a turn-end can only belong to an EARLIER turn than the open
;; group's: the group's turn-start has not been seen (a turn logs it
;; before anything of it can end), or both numbers are known and differ.
(defun fikra-ollama-stale-ending-p (turn-n e)
  (if turn-n
    (let ((en (fikra-ollama-turn-number e)))
      (and (not (string= turn-n "?"))
           (not (string= en "?"))
           (not (string= en turn-n))))
    t))

(defvar fikra-ollama-history-budget 6000
  "Characters of recent history kept for the model (whole turns).")

;; Only the log's last WINDOW characters are read for it: parsing a
;; whole long-lived log cost ~55µs per event plus ~200µs more per event
;; in the T-Lisp scans — 3.8s at every send for a 100-turn thread with
;; token-level streams. 8x the budget: plenty of whole turns to fill it.
(defvar fikra-ollama-history-window 49152
  "Characters of the thread log's TAIL read for the history.")

;; The index where the budgeted history begins (a question; the cut when
;; the log has none). No whole completed turn in the window (a single
;; turn larger than the window) → no history: a history never opens on a
;; reply without its question, never half a turn.
(defun fikra-ollama-history-start (merged cutoff)
  (fikra-ollama-budget-scan
    (fikra-ollama-turn-costs merged 0 cutoff nil 0 0 nil (list))
    0 nil cutoff))

;; (start-index size) per COMPLETED turn, NEWEST first. A turn's group
;; opens at its QUESTION — the user's message is logged BEFORE the
;; turn-start line (the chat seam emits it, then the backend begins the
;; turn) — and closes at its turn-end; a group that never ends (a crash
;; mid-turn) is dropped. Its size is the message text, 300 per tool event
;; (the rows its exchange carries) and its recorded exchange fragments,
;; keyed by the number of the turn-start inside the group. Opening on a
;; question is also what keeps a WINDOWED read honest: a turn whose
;; question fell outside the window never opens a group. Walks the list
;; head-first with an index counter — `nth` per event made this quadratic
;; in the log length.
(defun fikra-ollama-turn-costs (rest i limit start text tools turn-n out)
  (if (or (null rest) (>= i limit))
    out
    (let* ((e (car rest))
           (k (fikra/event/fikra-event-get-str e "kind")))
      (cond
        ((string= k "turn-end")
          (fikra-ollama-turn-costs (cdr rest) (+ i 1) limit nil 0 0 nil
            (if start
              (cons (list start (fikra-ollama-turn-size text tools turn-n)) out)
              out)))
        ((and (string= k "text-delta")
              (string= (fikra/event/fikra-event-get-str e "speaker") "user"))
          (fikra-ollama-turn-costs (cdr rest) (+ i 1) limit i
            (length (fikra-ollama-event-text e)) 0 nil out))
        ((and start (string= k "turn-start"))
          (fikra-ollama-turn-costs (cdr rest) (+ i 1) limit start text tools
            (let ((n (fikra/event/fikra-event-get e "turn")))
              (if (numberp n) (number-to-string n) n))
            out))
        ((and start (string= k "text-delta"))
          (fikra-ollama-turn-costs (cdr rest) (+ i 1) limit start
            (+ text (length (fikra-ollama-event-text e))) tools turn-n out))
        ((and start
              (or (string= k "tool-call") (string= k "tool-result")
                  (string= k "permission-denied") (string= k "permission-allowed")))
          (fikra-ollama-turn-costs (cdr rest) (+ i 1) limit start text (+ tools 1) turn-n out))
        (t
          (fikra-ollama-turn-costs (cdr rest) (+ i 1) limit start text tools turn-n out))))))

(defun fikra-ollama-turn-size (text tools turn-n)
  (+ text (* 300 tools) (fikra-ollama-rounds-size turn-n 1 0)))

;; The recorded exchange fragments' size for a turn (round by round).
(defun fikra-ollama-rounds-size (turn-n round n)
  (if (or (not turn-n) (> round fikra-ollama-max-rounds))
    n
    (let ((frag (condition-case nil (fikra-ollama-round-frag turn-n round) (error () nil))))
      (fikra-ollama-rounds-size turn-n (+ round 1)
        (+ n (if (stringp frag) (length frag) 0))))))

;; Walk the turns NEWEST first: the newest completed turn always rides;
;; older whole turns join while the budget holds. FALLBACK is where an
;; empty history begins (the cut — nothing before it rides).
(defun fikra-ollama-budget-scan (costs used kept fallback)
  (if (null costs)
    (if kept kept fallback)
    (let ((start (car (car costs)))
          (size (car (cdr (car costs)))))
      (cond
        ((null kept) (fikra-ollama-budget-scan (cdr costs) size start fallback))
        ((> (+ used size) fikra-ollama-history-budget) kept)
        (t (fikra-ollama-budget-scan (cdr costs) (+ used size) start fallback))))))

;; The index of the LAST turn-end (-1 when none — a first turn has no
;; history).
(defun fikra-ollama-last-turn-end (events i best)
  (if (>= i (length events))
    best
    (if (string= (fikra/event/fikra-event-get-str (nth i events) "kind") "turn-end")
      (fikra-ollama-last-turn-end events (+ i 1) i)
      (fikra-ollama-last-turn-end events (+ i 1) best))))

;; r138: TOOLS-SEEN tracks whether the current turn already ran tools;
;; the turn's exchange flushes BEFORE the first assistant text that
;; follows them (the true intra-turn order — the tools ran BEFORE the
;; final reply), and any remainder flushes at the turn's end.
;; The next unflushed ROUND's slot for the current thread+turn ("" when
;; none pending). The events belong to the CURRENT thread's log.
(defun fikra-ollama-round-frag (turn-n round)
  (if turn-n
    (let ((k (concat (fikra/thread/fikra-thread-current) "/" turn-n "/"
                     (number-to-string round))))
      (hashmap-get fikra-ollama-tool-exchanges k))
    nil))

(defun fikra-ollama-history-scan (events i cutoff acc tools-seen turn-n next-round)
  ;; r138: TOOLS-SEEN tracks whether the current turn already ran tools;
  ;; the turn's exchange flushes BEFORE the first ASSISTANT text that
  ;; follows them (the true intra-turn order — the tools ran before the
  ;; final reply); any remainder flushes at the turn's end.
  (if (or (>= i (length events)) (>= i cutoff))
    acc
    (let* ((e (nth i events))
           (k (fikra/event/fikra-event-get-str e "kind"))
           (raw-turn (fikra/event/fikra-event-get e "turn"))
           (this-turn (if (numberp raw-turn)
                        (number-to-string raw-turn)
                        (if raw-turn raw-turn turn-n))))
      (cond
        ((string= k "turn-start")
          (fikra-ollama-history-scan events (+ i 1) cutoff acc nil this-turn 1))
        ((or (string= k "tool-call") (string= k "tool-result")
             (string= k "permission-denied") (string= k "permission-allowed"))
          ;; r139b (codex round-2 catch): decision events mark the turn
          ;; as having run tools — the flush must precede the reply even
          ;; without an intervening narration.
          (fikra-ollama-history-scan events (+ i 1) cutoff acc t this-turn next-round))
        ((string= k "text-delta")
          (let* ((sp (fikra/event/fikra-event-get-str e "speaker"))
                 (tx (fikra/event/fikra-event-get-str e "text"))
                 ;; r139: flush ONE pending round slot before an
                 ;; assistant narration (the round's tools preceded it).
                 (frag (if (and tools-seen turn-n (string= sp "assistant"))
                         (fikra-ollama-round-frag turn-n next-round)
                         nil)))
            (if (> (length tx) 0)
              (fikra-ollama-history-scan events (+ i 1) cutoff
                (concat acc (if frag frag "") "{\"role\":\""
                        (if (string= sp "user") "user" "assistant")
                        "\",\"content\":" (fikra-ollama-json-string tx) "},")
                tools-seen this-turn (if frag (+ next-round 1) next-round))
              (fikra-ollama-history-scan events (+ i 1) cutoff acc tools-seen this-turn next-round))))
        ((string= k "turn-end")
          (let ((rest (fikra-ollama-rounds-rest turn-n next-round)))
            (fikra-ollama-history-scan events (+ i 1) cutoff
              (concat acc rest) tools-seen this-turn (+ next-round
                (fikra-ollama-rounds-count turn-n next-round)))))
        (t
          (fikra-ollama-history-scan events (+ i 1) cutoff acc tools-seen this-turn next-round))))))

;; The concatenation of turn's round slots from ROUND on (bounded — a
;; runaway model cannot loop this past the cap).
(defun fikra-ollama-rounds-rest (turn-n round)
  (if (or (not turn-n) (> round fikra-ollama-max-rounds))
    ""
    (let ((frag (fikra-ollama-round-frag turn-n round)))
      (concat (if frag frag "")
              (fikra-ollama-rounds-rest turn-n (+ round 1))))))

(defun fikra-ollama-rounds-count (turn-n round)
  (if (or (not turn-n) (> round fikra-ollama-max-rounds))
    0
    (let ((frag (fikra-ollama-round-frag turn-n round)))
      (+ (if frag 1 0) (fikra-ollama-rounds-count turn-n (+ round 1))))))

;; A string as a JSON string literal. r154: the BUILTIN encoder — a
;; string round-trips through it (quotes, backslashes, every control
;; character, non-ASCII: verified against the r135 cases). The
;; hand-written per-character scanner it replaces cost ~50µs PER CHARACTER
;; in T-Lisp: a 55KB conversation history took 2.7s to build at EVERY turn
;; start, and with the history durable now (below) long threads reached
;; that as a matter of course.
(defun fikra-ollama-json-string (s)
  (json-encode s))

;; The http filter: stamp ownership + accumulate the body. A TAGS request
;; is recognizable by its marker entry ("tags-<id>"); a chat request by a
;; plain id.
(defun fikra-backend-ollama-http-filter (id chunk-hex)
  (let ((k (number-to-string id)))
    (editor/keymaps/keymap-mutable-set!
      (editor/keymaps/keymap-named "fikra-http-owners") k
      "fikra/backend-ollama/fikra-backend-ollama-complete")
    (editor/keymaps/keymap-mutable-set! fikra-ollama-bodies k
      (concat (hashmap-get fikra-ollama-bodies k) (hex-decode chunk-hex)))
    ;; r153: STREAM — render every complete NDJSON line's content delta.
    ;; r154: only a LIVE request's stream renders (the guard lived at
    ;; completion alone — a replaced turn's in-flight stream rendered
    ;; straight into its successor's transcript).
    (if (and fikra-ollama-streaming (fikra-ollama-request-live-p k))
      (fikra-ollama-stream-pump k (hex-decode chunk-hex) nil))
    t))

;; r154: consume the buffer + CHUNK's COMPLETE lines and stash the
;; unterminated tail; FINAL (the completion) also takes that tail — a
;; server may close without the last newline, and the final content line
;; used to be dropped. Blank lines are skipped (a LEADING newline used to
;; stall the scan: the offset had to be > 0, so nothing after it was ever
;; consumed). The chunk's content deltas render as ONE batch.
(defun fikra-ollama-stream-pump (k chunk final)
  (let ((deltas (fikra-ollama-stream-scan k
                   (concat (or (hashmap-get fikra-ollama-stream-bufs k) "") chunk)
                   final (list))))
    (if (> (length deltas) 0)
      (fikra-ollama-deliver k deltas)
      nil)))

(defun fikra-ollama-stream-scan (k buf final acc)
  (let ((nl (string-match (hex-decode "0a") buf)))
    (if (and nl (numberp nl))
      (fikra-ollama-stream-scan k (substring buf (+ nl 1) (length buf)) final
        (fikra-ollama-stream-take k (substring buf 0 nl) acc))
      (if (and final (> (length (string-trim buf)) 0))
        (progn
          (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-bufs k nil)
          (fikra-ollama-stream-take k buf acc))
        (progn
          (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-bufs k buf)
          acc)))))

;; One NDJSON line → its content delta (if any) joins ACC; a tool_calls
;; line is kept RAW (verbatim arguments). Classified by the PARSED shape
;; (r153b: a raw substring match on "tool_calls" misfiled ordinary text
;; mentioning the field). An unparseable line changes nothing.
(defun fikra-ollama-stream-take (k line acc)
  (condition-case nil
    (let* ((m (fikra-ollama-alist-get "message" (json-read-from-string line)))
           (tc (if m (fikra-ollama-alist-get "tool_calls" m) nil))
           (c (if m (fikra-ollama-alist-get "content" m) nil))
           (text (if (and c (stringp c)) c "")))
      (progn
        ;; r154: EVERY tool line is kept (see fikra-ollama-stream-tools).
        (if (and tc (listp tc) (> (length tc) 0))
          (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-tools k
            (append (or (hashmap-get fikra-ollama-stream-tools k) (list)) (list line)))
          nil)
        (if (> (length text) 0)
          (progn
            (editor/keymaps/keymap-mutable-set! fikra-ollama-stream-content k
              (concat (or (hashmap-get fikra-ollama-stream-content k) "") text))
            (append acc (list text)))
          acc)))
    (error () acc)))

;; Render a chunk's deltas for the thread that OWNS the request — the
;; thread-routed emitter. r154: the focused-thread emitter put a
;; switched-away turn's text into whatever the user was looking at, and
;; the completion then settled the real thread with no reply. Only a
;; batch the transcript TOOK counts as delivered (`emitted`) — and only
;; while the delivered text is a contiguous PREFIX of the stream: the
;; first batch that fails to land closes the stream for good (open → nil)
;; and everything after it is WITHHELD for the completion to render as
;; one remainder. r154b (codex gate P0): counting delivered characters
;; across a gap made the completion treat the count as a prefix offset —
;; "FIRST" (undeliverable) was lost and a misplaced "ECOND" rendered
;; twice over.
(defun fikra-ollama-deliver (k deltas)
  (let* ((entry (hashmap-get fikra-ollama-requests k))
         (thread (if entry (hashmap-get entry "thread") nil))
         (landed (if (and entry (hashmap-get entry "open"))
                     (condition-case nil
                       ;; Anything held for this thread goes out FIRST —
                       ;; a thread's log never takes a newer event ahead
                       ;; of an older held one.
                       (and thread
                            (fikra/event/fikra-event-flush-undelivered thread)
                            (fikra/event/fikra-event-emit-batch-for thread
                              (mapcar (lambda (d)
                                        (list (list "kind" "text-delta")
                                              (list "speaker" "assistant")
                                              (list "text" d)))
                                deltas)))
                       (error () nil))
                     nil)))
    (if (not entry)
      nil
      (if landed
        (editor/keymaps/keymap-mutable-set! entry "emitted"
          (+ (hashmap-get entry "emitted") (fikra-ollama-deltas-length deltas 0)))
        (editor/keymaps/keymap-mutable-set! entry "open" nil)))
    landed))

(defun fikra-ollama-deltas-length (deltas n)
  (if (null deltas)
    n
    (fikra-ollama-deltas-length (cdr deltas) (+ n (length (car deltas))))))

;; r154: render exactly the content the stream has NOT delivered (the
;; ownership record's `emitted` count) — exactly-once by ACCOUNTING. The
;; r153 boolean assumed every delta had rendered; one the transcript
;; failed to take was lost for good.
;; r154c (codex gate P0): written for the request's OWNING thread through
;; the HOLDING emitter — a write the transcript refuses keeps the text
;; (it used to throw past the cleanup, and the reply was discarded for
;; good); it is written at the next send on that thread. Returns 'held
;; while the text waits.
(defun fikra-ollama-render-rest (content entry)
  (let* ((shown (if (and entry (numberp (hashmap-get entry "emitted")))
                   (hashmap-get entry "emitted")
                   0))
         (owner (if (and entry (stringp (hashmap-get entry "thread")))
                  (hashmap-get entry "thread")
                  (fikra/thread/fikra-thread-current))))
    (if (> (length content) shown)
      (if (fikra/event/fikra-event-emit-held-for owner
            (list (list (list "kind" "text-delta")
                        (list "speaker" "assistant")
                        (list "text" (substring content shown (length content)))))
            ;; Nothing of this reply reached the transcript → the text
            ;; opens a message of its own; else it continues the line.
            (= shown 0))
        nil
        'held)
      nil)))

(defvar fikra-ollama-held-status
  "Fikra-ollama: reply HELD — the transcript was not writable; it is written at the next send"
  "r154c: the status shown when a reply waits in the undelivered stash.")

(defun fikra-ollama-held-p (r)
  (and (symbolp r) (string= (symbol-name r) "held")))

;; r153: the completion's reply body, built from the stream — the tool
;; lines merged into ONE call list beside the full streamed content, else
;; the content alone. r154: the tool lines are MERGED (the r153 stash kept
;; only the last line — ollama streams one call per line, so a two-call
;; round lost its first call, live).
(defun fikra-ollama-stream-body (k raw)
  (let ((tools (hashmap-get fikra-ollama-stream-tools k))
        (content (hashmap-get fikra-ollama-stream-content k)))
    (cond
      ((and tools (> (length tools) 0))
        (concat "{\"message\":{\"role\":\"assistant\",\"content\":"
                (fikra-ollama-json-string (if (stringp content) content ""))
                ",\"tool_calls\":["
                (fikra-ollama-calls-json
                  (condition-case nil (fikra-ollama-merge-tool-lines tools (list)) (error () (list)))
                  0 "")
                "]}}"))
      ((and content (stringp content) (> (length content) 0))
        (concat "{\"message\":{\"role\":\"assistant\",\"content\":"
                (fikra-ollama-json-string content) "}}"))
      (t raw))))

;; The tool lines → one call list (the shape json-read gives a
;; tool_calls array). Ground truth (ollama 0.12.3, captured live): ONE
;; call per line, a single-element array, every call after the first
;; stamped with its index INSIDE `function`; arguments are complete
;; objects. Incremental servers stream a call's argument JSON in pieces
;; under the same index (OpenAI-style: index on the call, a string).
;; Contract: an indexed entry merges into its slot; an index-less entry
;; of a multi-call line merges by position; an index-less single-call
;; line NAMES a new call, or continues the last one when nameless.
(defun fikra-ollama-merge-tool-lines (lines slots)
  (if (null lines)
    ;; The slots are already in call order (appends put the newest last).
    (fikra-ollama-slots-to-calls slots)
    (fikra-ollama-merge-tool-lines (cdr lines)
      (fikra-ollama-merge-line-calls (fikra-ollama-line-tool-calls (car lines)) 0 slots))))

(defun fikra-ollama-slots-to-calls (slots)
  (if (null slots)
    (list)
    (append (list (fikra-ollama-slot-call (car slots)))
            (fikra-ollama-slots-to-calls (cdr slots)))))

;; A raw line's tool_calls array (nil when the line does not parse).
(defun fikra-ollama-line-tool-calls (line)
  (condition-case nil
    (let ((m (fikra-ollama-alist-get "message" (json-read-from-string line))))
      (if m (fikra-ollama-alist-get "tool_calls" m) nil))
    (error () nil)))

(defun fikra-ollama-merge-line-calls (calls p slots)
  (if (or (not (listp calls)) (null calls) (>= p (length calls)))
    slots
    (fikra-ollama-merge-line-calls calls (+ p 1)
      (fikra-ollama-merge-call (nth p calls) calls p slots))))

;; Slots are (name arguments) pairs, newest last.
(defun fikra-ollama-merge-call (entry siblings p slots)
  (condition-case nil
    (let* ((fn (fikra-ollama-alist-get "function" entry))
           (name (if fn (fikra-ollama-alist-get "name" fn) nil))
           (args (if fn (fikra-ollama-alist-get "arguments" fn) nil))
           (n (length slots))
           (idx (fikra-ollama-call-index entry fn siblings p))
           (named (and (stringp name) (> (length name) 0)))
           (slot (cond
                   ((numberp idx) idx)
                   (named n)
                   (t (- n 1)))))
      (cond
        ((or (< slot 0) (>= slot n))
          (append slots (list (list (if named name "") args))))
        (t (fikra-ollama-merge-slot-at slots slot name args 0))))
    (error () slots)))

;; The entry's slot: its own index, else its function's index, else the
;; position inside a multi-call array (nil for an index-less single call).
(defun fikra-ollama-call-index (entry fn siblings p)
  (let ((own (fikra-ollama-alist-get "index" entry))
        (inner (if fn (fikra-ollama-alist-get "index" fn) nil)))
    (cond
      ((numberp own) own)
      ((numberp inner) inner)
      ((> (length siblings) 1) p)
      (t nil))))

(defun fikra-ollama-merge-slot-at (slots i name args j)
  (if (null slots)
    (list)
    (append (list (if (= i j)
                      (fikra-ollama-slot-merge (car slots) name args)
                      (car slots)))
            (fikra-ollama-merge-slot-at (cdr slots) i name args (+ j 1)))))

;; A fragment joins its call: a carried name replaces, arguments merge.
(defun fikra-ollama-slot-merge (slot name args)
  (list (if (and (stringp name) (> (length name) 0)) name (car slot))
        (fikra-ollama-merge-args (car (cdr slot)) args)))

(defun fikra-ollama-slot-call (slot)
  (list (list "function"
              (append (list (list "name" (if (car slot) (car slot) "")))
                      (if (car (cdr slot))
                        (list (list "arguments" (car (cdr slot))))
                        (list))))))

;; Arguments merge: string fragments CONCATENATE (an incremental server
;; streams a call's argument JSON in pieces); object fragments UNION
;; (the newer fragment's keys win); an empty side yields to the other.
(defun fikra-ollama-merge-args (old new)
  (cond
    ((fikra-ollama-args-empty-p new) old)
    ((fikra-ollama-args-empty-p old) new)
    ((and (stringp old) (stringp new)) (concat old new))
    ((and (listp old) (listp new)) (fikra-ollama-alist-union old new))
    (t new)))

(defun fikra-ollama-args-empty-p (a)
  (or (null a)
      (and (stringp a) (= (length a) 0))
      (and (not (stringp a)) (listp a) (= (length a) 0))))

;; alist UNION: NEW's keys win; garbage pairs pass through untouched.
(defun fikra-ollama-alist-union (old new)
  (if (null new)
    old
    (fikra-ollama-alist-union (fikra-ollama-alist-put old (car new)) (cdr new))))

(defun fikra-ollama-alist-put (alist pair)
  (if (or (not (listp pair)) (not (= (length pair) 2)) (not (stringp (car pair))))
    alist
    (append (fikra-ollama-alist-without alist (car pair)) (list pair))))

(defun fikra-ollama-alist-without (alist key)
  (if (null alist)
    (list)
    (let ((e (car alist)))
      (append (if (and (listp e) (= (length e) 2) (stringp (car e)) (string= (car e) key))
                (list)
                (list e))
              (fikra-ollama-alist-without (cdr alist) key)))))

;; The completion handler (ownership-routed): a tags reply adopts the
;; model and re-fires; a chat reply renders the assistant turn + ENDS it.
(defun fikra-backend-ollama-complete (id status data-hex)
  (let* ((k (number-to-string id))
         (entry (hashmap-get fikra-ollama-requests k))
         (thread-id (if entry (hashmap-get entry "thread") nil))
         ;; r109-r110: only the LATEST fired request may land; a gone
         ;; turn discards. r154: "gone" is the ownership record's verdict
         ;; — no entry, or a superseded turn generation.
         (live (and entry thread-id fikra-ollama-pending-message
                    (fikra-ollama-request-live-p k)))
         ;; r153: STREAMING — the reply's body is built from the stream.
         ;; r154: a live request's final UNTERMINATED line joins it
         ;; first (guarded — a throw here would skip the cleanup below
         ;; and strand the turn). NOTHING streamed (a non-NDJSON body —
         ;; the one-shot server shape): the raw accumulated body IS the
         ;; reply.
         (body (if (and live fikra-ollama-streaming (= status 200))
                   (progn
                     (condition-case nil (fikra-ollama-stream-pump k "" t) (error () nil))
                     (fikra-ollama-stream-body k (hashmap-get fikra-ollama-bodies k)))
                   (hashmap-get fikra-ollama-bodies k))))
    (fikra-ollama-forget-request k)
    (if (not live)
      nil
    ;; r111 (codex r110 P2): a SWITCHED-AWAY thread no longer
    ;; discards — the reply SETTLES ITS OWN THREAD via the bg-settle
    ;; pattern (focus the firing thread, work, restore).
    (if (string= thread-id (fikra/thread/fikra-thread-current))
      (condition-case nil
        (fikra-ollama-handle-reply status body entry)
        (error (m)
          (condition-case nil
            (progn
              (editor-set-status (concat "Fikra-ollama: reply failed — " m))
              (setq fikra-ollama-pending-message nil)
              (if (string= (fikra/thread/fikra-thread-status) "running")
                (fikra/thread/fikra-thread-turn-end "error")))
            (error () nil))
          'reply-error))
      ;; r136 (codex re-grade P2): the bg-settle dance is THROW-SAFE
      ;; (a reply-handling error used to leak the focus and strand the
      ;; turn) and settles honestly — the bash sentinel's pattern.
      (let ((prev (fikra/thread/fikra-thread-current)))
        ;; r136b (codex catch): the focus call itself is guarded; and the
        ;; settle keys on the thread STATUS (the success path clears the
        ;; pending marker BEFORE its render — a throw there left the
        ;; turn "running" with nothing pending to key on).
        (let ((focused (condition-case nil
                        (progn (fikra/thread/fikra-thread-focus thread-id) t)
                        (error () nil))))
          ;; r137 (codex re-grade): a FAILED focus switch must not handle
          ;; the reply under an inconsistent context — settle honestly.
          (if (not focused)
            (progn
              (setq fikra-ollama-pending-message nil)
              (editor-set-status "Fikra-ollama: reply thread focus failed")
              ;; r145 (#7): settle the ORIGINATING thread — focus it by
              ;; id inside the guard (the current thread after a failed
              ;; focus is arbitrary), end the turn, restore.
              (condition-case nil
                (progn
                  (fikra/thread/fikra-thread-focus thread-id)
                  (if (string= (fikra/thread/fikra-thread-status) "running")
                    (fikra/thread/fikra-thread-turn-end "error"))
                  (fikra/thread/fikra-thread-focus prev))
                (error () nil))
              'focus-failed)
          (let ((r (condition-case nil
                    (fikra-ollama-handle-reply status body entry)
                    (error (m)
                      (condition-case nil
                        (progn
                          (editor-set-status (concat "Fikra-ollama: reply failed — " m))
                          (setq fikra-ollama-pending-message nil)
                          (if (string= (fikra/thread/fikra-thread-status) "running")
                            (fikra/thread/fikra-thread-turn-end "error")))
                        (error () nil))
                      'reply-error))))
            (if focused
              (condition-case nil
                (fikra/thread/fikra-thread-focus prev)
                (error () nil)))
            r))))))))

;; The reply handling, thread-local (runs with the FIRING thread
;; focused; the guards already ran). ENTRY is the request's ownership
;; record (its `emitted` count decides what still needs rendering).
(defun fikra-ollama-handle-reply (status body entry)
  (if (not (= status 200))
      (progn
        ;; The turn dies honestly: an error turn-end, a visible status.
        (setq fikra-ollama-pending-message nil)
        (fikra/thread/fikra-thread-turn-end "error")
        (editor-set-status
          (concat "Fikra-ollama: server unreachable (" (number-to-string status)
                  ") " (substring (if body body "") 0 120))))
      ;; The chat reply: tool_calls → the ROUND (execute, append,
      ;; re-fire); plain content → render + end (the existing path).
      (let* ((msg (condition-case nil
                     (fikra-ollama-alist-get "message"
                       (json-read-from-string body))
                     (error () nil)))
             (content (if msg (fikra-ollama-alist-get "content" msg) nil))
             (tool-calls (if msg (fikra-ollama-alist-get "tool_calls" msg) nil)))
        (if (and tool-calls (listp tool-calls) (> (length tool-calls) 0)
                 (< fikra-ollama-round fikra-ollama-max-rounds))
          (fikra-ollama-tool-round msg tool-calls entry)
          (progn
            (setq fikra-ollama-pending-message nil)
            (if (and content (stringp content) (> (length content) 0))
              (progn
                ;; r153/r154: under streaming the deltas already rendered
                ;; — this renders exactly what they did NOT (a non-streamed
                ;; reply: everything).
                (let ((held (fikra-ollama-held-p (fikra-ollama-render-rest content entry))))
                  ;; The thread state machine settles the turn (emits turn-end).
                  (fikra/thread/fikra-thread-turn-end "completed")
                  (editor-set-status
                    (if held
                      fikra-ollama-held-status
                      (concat "Fikra: ollama (" fikra-ollama-model ") turn completed")))))
              (progn
                (fikra/thread/fikra-thread-turn-end "error")
                (editor-set-status "Fikra-ollama: empty reply"))))))))

;; Model resolution: the tags body is small — the filter DID accumulate
;; nothing for tags (marker-shaped); resolve via one sync curl instead
;; (the availability probe already proved curl works).
(defun fikra-ollama-resolve-model ()
  (if fikra-ollama-model
    fikra-ollama-model
    (let ((name (condition-case nil
                   (fikra-ollama-first-model-of
                     (shell-command
                       (concat "curl -s --max-time 3 " fikra-ollama-url "/api/tags 2>/dev/null")))
                   (error () nil))))
      (if (and name (stringp name) (> (length name) 0))
        (setq fikra-ollama-model name))
      fikra-ollama-model)))

;; Parse the tags JSON for the first model name (a line scan — the
;; transport is a runtime string; json-read-from-string handles it).
(defun fikra-ollama-first-model-of (raw)
  (let* ((parsed (json-read-from-string raw))
         (models (fikra-ollama-alist-get "models" parsed)))
    (if models
      (fikra-ollama-alist-get "name" (car models))
      nil)))

(defun fikra-ollama-alist-get (key alist)
  (let ((found nil))
    (dolist (e alist)
      (if (and (not found) (listp e) (= (length e) 2)
               (string= (car e) key))
        (setq found (car (cdr e)))))
    found))

;; The L2 decide seam (the adapter contract): the parked tool resumes on
;; the user's a/r/A. y → execute + continue the round; n → the denial
;; rides the accumulator (the model learns); a → y (a persistent native
;; allow-list is the follow-up).
(defun fikra-backend-ollama-pending-p ()
  (if fikra-ollama-parked-call t nil))

(defun fikra-backend-ollama-decide (decision)
  ;; r117 (codex r116 P1#1): the SAME interactive resolve-guard as every
  ;; other decide seam — a direct eval of this exported fn must not
  ;; self-approve.
  (require-module fikra/approvals)
  (if (not (fikra/approvals/fikra-approval-resolve-guard))
    nil
    (fikra-backend-ollama-decide-inner decision)))

;; r119 (codex r118 P1): the decision settles the ORIGINATING thread —
;; reading the FOCUSED status left the home thread 'confirming' forever
;; after a focus switch.
(defun fikra-ollama-settle-home (home-thread)
  (if (and home-thread (string= home-thread (fikra/thread/fikra-thread-current)))
    (if (string= (fikra/thread/fikra-thread-status) "confirming")
      (fikra/thread/fikra-thread-status-set "running"))
    (let ((prev (fikra/thread/fikra-thread-current)))
      (fikra/thread/fikra-thread-focus home-thread)
      (if (string= (fikra/thread/fikra-thread-status) "confirming")
        (fikra/thread/fikra-thread-status-set "running"))
      (fikra/thread/fikra-thread-focus prev)
      t)))

(defun fikra-backend-ollama-decide-inner (decision)
  (let* ((call fikra-ollama-parked-call)
         (home-thread fikra-ollama-parked-thread))
    ;; r139b/r145 (#4): the exchange fragment's TRUE call list — the
    ;; FULL batch when known (calls before the parked one included);
    ;; the parked call + remainder otherwise.
    (if call
      (setq fikra-ollama-last-parked-calls
        (if (and fikra-ollama-batch-calls (> (length fikra-ollama-batch-calls) 0))
          fikra-ollama-batch-calls
          (append (list call) fikra-ollama-parked-rest))))
    (setq fikra-ollama-parked-call nil)
    (setq fikra-ollama-parked-thread nil)
    (if (not call)
      nil
      (if (string= decision "n")
        (progn
          (fikra/event/fikra-event-emit
            (list (list "kind" "permission-denied")))
          ;; r122: ORDER — the lesson joins the SAVED acc at the
          ;; rejected call's position (the decision never appends to
          ;; messages out of order).
          (setq fikra-ollama-parked-acc
            (concat fikra-ollama-parked-acc
                    "{\"role\":\"tool\",\"content\":\"user rejected this command; do not retry it\"},"))
          ;; r139b (codex round-2 catch): the rejection rides via
          ;; resume-rest's ONE complete exchange (recording here too
          ;; duplicated the pre-park acc in the round's slot).
          (fikra-ollama-settle-home home-thread)
          (fikra-ollama-continue-home home-thread))
        (progn
          (fikra/event/fikra-event-emit
            (list (list "kind" "permission-allowed")))
          (fikra-ollama-settle-home home-thread)
          (let* ((fn (fikra-ollama-alist-get "function" call))
                 (args-raw (fikra-ollama-alist-get "arguments" fn))
                 (args (if (listp args-raw) args-raw
                         (condition-case nil (json-read-from-string (if args-raw args-raw "{}")) (error () ()))))
                 (cmd (if (fikra-ollama-alist-get "command" args)
                        (fikra-ollama-alist-get "command" args) "")))
            ;; r117: execute against the ORIGINATING thread (a focus
            ;; switch must not redirect the command).
            (let ((dir (if (and home-thread
                                (string= home-thread (fikra/thread/fikra-thread-current)))
                        (fikra/thread/fikra-thread-working-dir)
                        (if home-thread
                          (or (fikra/thread/fikra-thread-working-dir-of home-thread)
                              (fikra/thread/fikra-thread-working-dir))
                          (fikra/thread/fikra-thread-working-dir)))))
              ;; r122 (codex r121 P1): ORDER — the approved call's
              ;; result joins the SAVED acc (its position in the reply),
              ;; then the remainder appends; the decision never appends
              ;; out of order again.
              ;; r141 (codex 9-item): the PRE-state ref captures BEFORE
              ;; the command runs — an earlier action in the turn may
              ;; have changed the tree since the baseline; the ref a
              ;; revert restores to is the state immediately before THIS
              ;; mutation. The post-exit capture (evidence) remains.
              ;; r141b (codex r141 catch): the capture's RETURN is
              ;; checked — nil (disabled or failed) triggers the honest
              ;; status, not just exceptions.
              ;; r144 (codex re-grade #3): the capture runs under the
              ;; HOME focus — settle-home restored the away focus before
              ;; this point, so the pre-ref belonged to the WRONG thread
              ;; and tree while the command ran in the home tree.
              (let ((capture-prev (fikra/thread/fikra-thread-current)))
                (if (and home-thread (not (string= home-thread capture-prev)))
                  (fikra/thread/fikra-thread-focus home-thread))
              (condition-case nil
                (let ((sha (progn (require-module fikra/checkpoint)
                                  (fikra/checkpoint/fikra-checkpoint-set-emit-owner
                                    (if home-thread home-thread (fikra/thread/fikra-thread-current)))
                                  (let ((r (fikra/checkpoint/fikra-checkpoint-capture "action")))
                                    (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                                    r))))
                  (if (not sha)
                    (editor-set-status
                      "Fikra: pre-action checkpoint FAILED — the command proceeds without a revert ref")))
                (error (m)
                  ;; r141c (codex r141b catch): the owner flag clears on
                  ;; the THROW path too (a leaked owner routed later sync
                  ;; captures through the stale owner emitter).
                  (condition-case nil
                    (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                    (error () nil))
                  (editor-set-status
                    (concat "Fikra: pre-action checkpoint FAILED — the command proceeds without a revert ref ("
                            (if (stringp m) m "capture error") ")"))))
              ;; r144: restore the away focus (the capture borrowed HOME).
              (if (and home-thread (not (string= home-thread capture-prev)))
                (condition-case nil (fikra/thread/fikra-thread-focus capture-prev) (error () nil)))
              ;; r142: the pre-name for the sentinel's pair record.
              (setq fikra-ollama-last-pre-name
                (condition-case nil
                  (progn (fikra/checkpoint/fikra-checkpoint-last-ref-name-get))
                  (error () nil)))
              (setq fikra-ollama-next-mediated t)
              (let ((approved (fikra-ollama-run-bash-now cmd dir)))
                ;; r131: an async spawn returns the PID — the result
                ;; arrives via the sentinel (appending the pid would
                ;; corrupt the acc; 'async used to append junk).
                (if (numberp approved)
                  ;; r132 (codex r130 P1#2): an async approved command
                  ;; HOLDS the continuation — the remainder + the
                  ;; pre-park acc + the re-fire ride the pid's ownership
                  ;; entry; the SENTINEL resumes them at exit (the model's
                  ;; next request must carry the approved result — before,
                  ;; the round continued immediately and re-fired without
                  ;; it, racing a second re-fire through the no-cont
                  ;; branch).
                  (let ((entry (hashmap-get fikra-ollama-async-procs
                                  (number-to-string approved))))
                    ;; r139+r145b (codex r145 catch): the stash carries
                    ;; the FULL BATCH list with the parked call's INDEX —
                    ;; the approved call's message arrives as the
                    ;; sentinel's msg; calls BEFORE the parked one
                    ;; (parked-call + rest stashes dropped them) must
                    ;; ride too.
                    (if entry
                      (keymap-mutable-set! entry "cont"
                        (list (if (and fikra-ollama-batch-calls
                                       (> (length fikra-ollama-batch-calls) 0))
                                fikra-ollama-batch-calls
                                (append (list call) fikra-ollama-parked-rest))
                              (+ (fikra-ollama-batch-index-of call 0) 1)
                              fikra-ollama-parked-acc))
                      nil)
                    (setq fikra-ollama-parked-rest nil)
                    (setq fikra-ollama-parked-acc "")
                    'held)
                  (progn
                    (setq fikra-ollama-parked-acc
                      (concat fikra-ollama-parked-acc approved))
                    ;; r120-r121: the remainder resumes; a RE-PARK holds
                    ;; the next model request until ITS decision.
                    (fikra-ollama-continue-home home-thread))))))))))))

;; r120: run the parked reply's remaining calls (their results append;
;; a SECOND destructive call parks again — the rest re-rides).
;; Returns 'done or 'reparked (r121, codex r120 P1: the decision paths
;; must NOT re-fire the model while a second action still parks).
;; r123 (codex r122 P1): the resumed remainder runs with the HOME
;; thread focused when focus moved — every resumed call (bash, read,
;; edit) resolves the ORIGINATING dir, not the focused one.
(defun fikra-ollama-resume-rest-for (home-thread)
  (if (and home-thread (not (string= home-thread (fikra/thread/fikra-thread-current))))
    (let ((prev (fikra/thread/fikra-thread-current)))
      (fikra/thread/fikra-thread-focus home-thread)
      (let ((r (fikra-ollama-resume-rest)))
        (fikra/thread/fikra-thread-focus prev)
        r))
    (fikra-ollama-resume-rest)))

;; r124 (codex r123 P1): the CONTINUATION — the resumption AND the next
;; model request — runs home-bound (the re-fire stamps the request with
;; the focused thread; a switched-away decision would route the
;; continuing turn to the wrong thread).
(defun fikra-ollama-continue-home (home-thread)
  (let ((moved (and home-thread
                    (not (string= home-thread (fikra/thread/fikra-thread-current))))))
    (if moved
      (let ((prev (fikra/thread/fikra-thread-current)))
        (fikra/thread/fikra-thread-focus home-thread)
        (let ((r (fikra-ollama-continue)))
          (fikra/thread/fikra-thread-focus prev)
          r))
      (fikra-ollama-continue))))

(defun fikra-ollama-continue ()
  (if (string= (symbol-name (fikra-ollama-resume-rest)) "done")
    ;; r135b (codex catch): the cap guards EVERY re-fire (a park in the
    ;; last round continued without it — an extra model request past
    ;; the cap).
    (if (>= fikra-ollama-round fikra-ollama-max-rounds)
      (progn
        (setq fikra-ollama-pending-message nil)
        (fikra/event/fikra-event-emit
          (list (list "kind" "text-delta")
                (list "speaker" "assistant")
                (list "text" "(tool round cap reached — stopping the loop)")))
        (fikra/thread/fikra-thread-turn-end "completed")
        'capped)
      (progn (fikra-ollama-chat fikra-ollama-pending-message) 'fired))
    'held))

(defun fikra-ollama-resume-rest ()
  (let* ((rest fikra-ollama-parked-rest)
         (acc fikra-ollama-parked-acc))
    (setq fikra-ollama-parked-rest nil)
    (setq fikra-ollama-parked-acc "")
    ;; r140 ROOT CAUSE: (list) is TRUTHY in this dialect — a single-call
    ;; park (empty proper-list rest) took the NON-empty branch, whose
    ;; remember serialized the empty rest as the assistant's calls
    ;; ("tool_calls":[]). The branch test is LENGTH-based now.
    (if (or (not rest) (= (length rest) 0))
      (progn
        ;; Nothing to resume — the pre-park results still count.
        (if (> (length acc) 0)
          (setq fikra-ollama-messages
            (concat fikra-ollama-messages acc)))
        ;; r139b: a single-call park (rejection or approval) records its
        ;; exchange HERE (the refusal/pre-park acc + the decision result).
        (if fikra-ollama-last-parked-calls
          (fikra-ollama-remember-exchange
            (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                    (fikra-ollama-calls-json fikra-ollama-last-parked-calls 0 "")
                    "]}," acc)))
        'done)
      (let ((results (fikra-ollama-run-calls rest 0 acc)))
        ;; r139 (codex catch): the DECISION continuations flow through
        ;; here — their exchanges must persist for future turns (the
        ;; full call list lives in the parked continuation's stash).
        ;; r140: the fragment carries the STASH's full call list (the
        ;; parked call + remainder — rest-only fragments showed the
        ;; remainder as the whole assistant message).
        (if (stringp results)
          (fikra-ollama-remember-exchange
            (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                    (fikra-ollama-calls-json
                      (if (and fikra-ollama-last-parked-calls
                               (> (length fikra-ollama-last-parked-calls) 0))
                        fikra-ollama-last-parked-calls
                        rest)
                      0 "")
                    "]}," results)))
        (cond
          ((and (symbolp results) (string= (symbol-name results) "parked"))
            'reparked)
          ;; r132b (codex r132 P1): an async remainder call HOLDS the
          ;; round — its continuation rides the pid's ownership entry
          ;; and the SENTINEL resumes + re-fires at exit. Appending the
          ;; 'async marker re-fired immediately without the result (and
          ;; the sentinel's own resume re-fired AGAIN).
          ((and (symbolp results) (string= (symbol-name results) "async"))
            'held)
          (t
            (progn
              (setq fikra-ollama-messages
                (concat fikra-ollama-messages results))
              'done)))))))

;; r137: SIGKILL every live async child (shared by abort AND turn
;; replacement — the epoch bump alone suppressed their evidence while
;; the commands kept running).
(defun fikra-ollama-kill-children ()
  (dolist (k (hashmap-keys fikra-ollama-async-procs))
    (if (hashmap-get fikra-ollama-async-procs k)
      (condition-case nil
        (signal (string-to-number k) "SIGKILL")
        (error () nil)))))

;; The interrupt entry (the adapter contract). r154: the in-flight turn
;; is ended on ITS OWN thread — the turn's home, whatever is focused. It
;; used to end whatever thread was FOCUSED: an interrupt pressed in
;; another thread wrote a stray ending there and left the running one
;; "running" forever.
(defun fikra-backend-ollama-abort ()
  (let* ((home (if fikra-ollama-turn-home
                  fikra-ollama-turn-home
                  (fikra/thread/fikra-thread-current)))
         (prev (fikra/thread/fikra-thread-current))
         (moved (not (string= home prev))))
    (if moved
      (condition-case nil (fikra/thread/fikra-thread-focus home) (error () nil)))
    (let ((r (condition-case nil (fikra-ollama-abort-turn) (error () nil))))
      ;; Throw-safe restore: a focus that failed leaves `moved` true but
      ;; focusing prev is still the right repair.
      (if moved
        (condition-case nil (fikra/thread/fikra-thread-focus prev) (error () nil)))
      r)))

(defun fikra-ollama-abort-turn ()
  ;; r131 (codex r130 P1#3): the interrupt also INVALIDATES the turn's
  ;; async children — the epoch bump makes their sentinels drop, and
  ;; the children are KILLED (the model's command stops running).
  (setq fikra-ollama-epoch (+ fikra-ollama-epoch 1))
  (fikra-ollama-kill-children)
  ;; r154: the in-flight request is cancelled too — its stream stops at
  ;; the transport (a late reply is dead twice over: no entry, no epoch).
  (fikra-ollama-cancel-requests)
  ;; r131c: the interrupted turn's pending park dies with it.
  (setq fikra-ollama-parked-call nil)
  (setq fikra-ollama-parked-rest nil)
  (setq fikra-ollama-parked-acc "")
  (setq fikra-ollama-parked-thread nil)
  (dolist (k (hashmap-keys fikra-ollama-async-procs))
    (if (hashmap-get fikra-ollama-async-procs k)
      (condition-case nil
        (signal (string-to-number k) "SIGKILL")
        (error () nil))))
  ;; r154: a parked approval dies with the turn (the gate's pending
  ;; MEDIATE settles as rejected — on the home thread, under this dance).
  (condition-case nil
    (progn (require-module fikra/approvals)
           (fikra/approvals/fikra-approval-abort-pending))
    (error () nil))
  (if fikra-ollama-pending-message
    (progn
      (setq fikra-ollama-pending-message nil)
      (fikra/thread/fikra-thread-turn-end "interrupted")
      t)
    nil))

;; Test seam: drive the callbacks synthetically (no live server).
;; URL "dead": point the module at an unreachable port AND mark the
;; pending message (the connection-failure path). Anything else: live.
(defun fikra-backend-ollama-seed (id url)
  (if (string= url "dead")
    (progn
      (setq fikra-ollama-url "http://127.0.0.1:1")
      (setq fikra-ollama-pending-message "seeded")
      ;; The fired turn's state (a real fire ran turn-begin; the error
      ;; turn-end is only a legal transition FROM running).
      (fikra/thread/fikra-thread-status-set "running")))
  ;; The ownership record + the latest-request stamp the real fire
  ;; carries (r110's guard reads it — the seed simulates the fire fully).
  (fikra-ollama-stamp-request id)
  (setq fikra-ollama-latest-id id)
  id)

(defun fikra-backend-ollama-seed-unused (id)
  (fikra-ollama-stamp-request id)
  (setq fikra-ollama-latest-id id)
  id)

;; Self-register
(fikra/adapter/fikra-register-backend "ollama")

(provide "fikra-backend-ollama")
)
