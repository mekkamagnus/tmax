(defmodule editor/commands/execute-extended-command
  (export command-detail-candidate command-detail-interactive-p command-completion-refresh command-completion-table execute-extended-command-accept execute-extended-command execute-extended-command-maybe clear-leader-indicator)

;; execute-extended-command.tlisp --- M-x through generic completion

(defvar command-completion-candidates (list))
;; BUG-78: the candidate-build (callable-command-details + filter + mapcar)
;; only changes when a module loads. Cache it for the session, keyed on
;; module-registry-generation (bumps on every register/load). The build cost
;; ~280ms at BUG-78 time (1,164 candidates); post-#234 it is ~8ms (median,
;; 234 candidates) — still worth caching, but no longer user-perceptible
;; (#238 / ADR-0268 re-profile; the cache stays).
(defvar command-completion-cache nil)
(defvar command-completion-cache-gen -1)

(defun command-detail-candidate (details)
  (hashmap
    "value" (hashmap-get details "name")
    "display" (hashmap-get details "name")
    "annotation" ""
    "metadata" details))

(defun command-detail-interactive-p (details)
  "Return non-nil for commands exposed through the interactive M-x source.
callable-command-details restricts the table to declared-interactive command
candidates (#249; the key-bound arm is gone — Emacs parity); this predicate
is the secondary guard: it requires the exposed \"interactive\" flag
(defense in depth) and excludes test-infrastructure commands (trt-*,
should-*) which must never appear in M-x (#148)."
  (let ((name (hashmap-get details "name")))
    (and (hashmap-get details "interactive")
         (not (or (string-prefix-p "trt-" name)
                  (string-prefix-p "should-" name))))))

(defun command-completion-refresh ()
  "Refresh the M-x candidate snapshot, caching across the session (BUG-78).
The candidate-build (callable-command-details + filter + mapcar) only changes
when a module loads, so it is cached and recomputed only when
module-registry-generation bumps. It was ~280ms at BUG-78 time and is ~8ms
post-#234 (#238 re-profile), so the cache is a cheap win, not a latency fix.
Sources only M-x command candidates (interactive-only, SPEC-115) and strips
test-infrastructure names."
  (let ((gen (module-registry-generation)))
    (if (and command-completion-cache (= gen command-completion-cache-gen))
      (set! command-completion-candidates command-completion-cache)
      (progn
        (set! command-completion-candidates
          (mapcar "command-detail-candidate"
            (filter "command-detail-interactive-p" (callable-command-details t))))
        (set! command-completion-cache command-completion-candidates)
        (set! command-completion-cache-gen gen)))))

(defun command-completion-table (input action)
  "Completion table for callable T-Lisp commands."
  (if (string= action "metadata")
    (hashmap "category" "command")
    command-completion-candidates))

(defun execute-extended-command-accept (name)
  "Invoke named command NAME."
  (progn
    (log-message :debug (concat "M-x " name))
    (invoke-command name)))

(defun execute-extended-command ()
  "Read and invoke a named command using generic completion."
  (interactive)
  (progn
    (command-completion-refresh)
    (completing-read
      "M-x "
      "command-completion-table"
      nil
      t
      ""
      "command-history"
      "execute-extended-command-accept")))

(defun execute-extended-command-maybe ()
  "Run M-x only after the configured SPC prefix."
  (if (editor-space-prefix-active-p)
    (execute-extended-command)
    (progn
      (editor-reset-space-prefix)
      (editor-set-status "Unbound key: ;"))))
)

(defun clear-leader-indicator ()
  "Clear the transient SPC- leader indicator if it is still showing (#247).
editor-handle-space sets status \"SPC-\"; the indicator must die when the
leader sequence resolves (normal-handler calls this from both lookup
branches, mirroring the #125 spacePressed clearing) instead of staying in
the status message and resurfacing after an M-x/switch-buffer minibuffer
closes. Guarded to the bare indicator: a real status message set in the
meantime (an async command's feedback landing between keystrokes) must win."
  (if (string= (editor-status) "SPC-")
    (editor-set-status "")
    nil))
