(defmodule editor/commands/markdown/knowledge
  (export markdown-frontmatter-get markdown-frontmatter-set markdown-frontmatter-show
    markdown-skip-front-matter markdown-generate-toc
    markdown-expand-template-variables markdown-new-from-template
    markdown-scan-wiki-links markdown-next-wiki-link markdown-prev-wiki-link
    markdown-wiki-link-at-point markdown-follow-wiki-link
    markdown-wiki-link-range-at-point markdown-rank-note-names
    markdown-note-name markdown-note-rank markdown-note-names-of
    markdown-bucket-names markdown-cons-names-onto
    markdown-note-candidate markdown-note-candidates-of
    markdown-note-create-candidate markdown-note-path
    markdown-note-completion-table markdown-resolve-prepare markdown-resolve-or-create
    markdown-resolve-accept markdown-resolve-dispatch markdown-create-note-for
    markdown-write-note-template
    markdown-complete-prepare markdown-complete-table markdown-complete-accept
    markdown-complete-path markdown-complete-candidate markdown-complete-candidates-of
    markdown-complete-at-point
    markdown-find-unlinked-mentions markdown-backlinks
    markdown-daily-note markdown-rename-note
    markdown-sparse-tree-regex markdown-sparse-tree-level markdown-sparse-tree-tag)

;; markdown/knowledge.tlisp — frontmatter, wiki links, backlinks, templates,
;; daily notes, renaming, and sparse-tree filtering.
;; CHORE-44 Change 11: split from markdown.tlisp (move only — no logic changes).
;; Cross-module calls (markdown-open-anchor, markdown-dirname, markdown-push-position,
;; markdown-scan-tags, find-heading-ranges) resolve via the unique-export fallback.

(defun markdown-skip-front-matter ()
  "Return the line number after YAML front matter, or 0 if none."
  (interactive)
  (if (and (> (buffer-line-count) 0) (string= (buffer-get-line 0) "---"))
      (let ((i 1)
            (total (buffer-line-count)))
        (while (and (< i total) (not (string= (buffer-get-line i) "---")))
          (set! i (+ i 1)))
        (if (< i total)
            (+ i 1)
            0))
      0))

(defun markdown-generate-toc ()
  "Generate a table of contents from all headings."
  (interactive)
  (let ((toc-lines '())
        (total (buffer-line-count))
        (i 0))
    (while (< i total)
      (let ((text (buffer-get-line i)))
        (if (string-match "^\(#+\)\\\\s+\(.*\)" text)
            (let* ((level (length (match-string 1 text)))
                   (title (match-string 2 text))
                   (anchor (downcase (replace-regexp-in-string "[^a-z0-9]+" "-" (string-trim title))))
                   (indent (make-string (* (- level 1) 2) 32))
                   (link (format "%s- [%s](#%s)" indent title anchor)))
              (set! toc-lines (cons link toc-lines)))))
      (set! i (+ i 1)))
    (if (> (length toc-lines) 0)
        (let ((insert-line (markdown-skip-front-matter)))
          (cursor-move insert-line 0)
          (buffer-insert (string-join "\n" (reverse toc-lines)))
          (buffer-insert "\n")
          (message "Generated TOC with %d entries" (length toc-lines)))
        (message "No headings found"))))

;;; ── Sparse tree filtering ─────────────────────────────────────────────

(defun markdown-sparse-tree-regex (regex)
  "Fold all headings, then open only those matching REGEX."
  (fold-close-all)
  (let ((ranges (find-heading-ranges))
        (i 0))
    (while (< i (length ranges))
      (let ((r (nth i ranges)))
        (let ((heading-line (buffer-get-line (nth 0 r))))
          (if (string-match regex heading-line)
              (fold-open (nth 0 r)))))
      (set! i (+ i 1)))
    (message "Sparse tree: matching %s" regex)))

(defun markdown-sparse-tree-level (max-level)
  "Show headings up to MAX-LEVEL, fold deeper ones."
  (fold-by-level max-level)
  (message "Showing headings up to level %d" max-level))

(defun markdown-sparse-tree-tag (tag)
  "Show sparse tree filtered by TAG."
  (markdown-sparse-tree-regex (concat "#" tag)))

;;; ── YAML frontmatter ──────────────────────────────────────────────────

(defun markdown-frontmatter-get (key)
  "Get a value from YAML frontmatter by KEY."
  (if (and (> (buffer-line-count) 0) (string= (buffer-get-line 0) "---"))
      (let ((i 1)
            (total (buffer-line-count))
            (found nil))
        (while (and (< i total) (not found))
          (let ((text (buffer-get-line i)))
            (if (string= text "---")
                (set! found 'done)
                (if (string-match (concat "^" key ":\\\\s+\(.*\)") text)
                    (set! found (match-string 1 text)))))
          (set! i (+ i 1)))
        (if (and found (not (equal found 'done)))
            found
            nil))
      nil))

(defun markdown-frontmatter-set (key value)
  "Set a KEY to VALUE in YAML frontmatter. Creates frontmatter if needed."
  (if (not (string= (buffer-get-line 0) "---"))
      (progn
        (buffer-insert-at-position 0 0 (concat "---\n" key ": " value "\n---\n"))
        (message "Created frontmatter with %s" key))
      (let ((i 1)
            (updated nil)
            (close-line nil))
        (while (and (< i (buffer-line-count)) (not close-line))
          (let ((text (buffer-get-line i)))
            (if (string= text "---")
                (set! close-line i)
                (if (string-match (concat "^" key ":\\\\s+.*") text)
                    (progn
                      (cursor-move i 0)
                      (buffer-delete (length text))
                      (buffer-insert (concat key ": " value))
                      (set! updated t)
                      (set! i (+ i 1))))))
          (set! i (+ i 1)))
        (if (not updated)
            (if close-line
                (progn
                  (cursor-move close-line 0)
                  (buffer-insert (concat key ": " value "\n")))
                (message "No closing frontmatter delimiter found"))
            (message "Updated %s" key)))))

(defun markdown-frontmatter-show ()
  "Display all frontmatter key-value pairs."
  (interactive)
  (if (not (string= (buffer-get-line 0) "---"))
      (message "No frontmatter")
      (let ((i 1)
            (total (buffer-line-count))
            (pairs '()))
        (while (and (< i total) (not (string= (buffer-get-line i) "---")))
          (let ((text (buffer-get-line i)))
            (if (string-match "^\([a-zA-Z_-]+\):\\\\s+\(.*\)" text)
                (set! pairs (cons (concat (match-string 1 text) ": " (match-string 2 text)) pairs))))
          (set! i (+ i 1)))
        (if (> (length pairs) 0)
            (message "Frontmatter: %s" (string-join " | " (reverse pairs)))
            (message "Empty frontmatter")))))

;;; ── Wiki-links and Zettelkasten ───────────────────────────────────────

(defun markdown-wiki-link-at-point ()
  "Find [[target]] at cursor position. Return target or nil.
BUG-74: match offsets are relative to the truncated search-text, so track a
cumulative offset and compare against ABSOLUTE positions — without it, any
link preceded by another link on the same line is undetectable."
  (interactive)
  (let* ((line (buffer-get-line (cursor-line)))
         (col (cursor-column))
         (result nil)
         (search-text line)
         (offset 0))
    (while (and (string-match "\\\\[\\\\[\([^\\\\]]+\)\\\\]\\\\]" search-text) (not result))
      (let ((start (+ offset (match-beginning 0)))
            (end (+ offset (match-end 0)))
            (target (match-string 1 search-text)))
        (if (and (>= col start) (<= col end))
            (set! result target)
            (progn
              (set! offset (+ offset (match-end 0)))
              (set! search-text (substring search-text (match-end 0)))))))
    result))

(defun markdown-scan-wiki-links ()
  "Scan all lines for [[link]] patterns. Return list of (line col target)."
  (interactive)
  (let ((total (buffer-line-count))
        (links '())
        (i 0))
    (while (< i total)
      (let ((text (buffer-get-line i))
            (col 0))
        (while (string-match "\\\\[\\\\[\([^\\\\]]+\)\\\\]\\\\]" text)
          (let ((target (match-string 1 text))
                (link-col (+ col (match-beginning 0) 2)))
            (set! links (cons (list i link-col target) links))
            (set! text (substring text (match-end 0)))
            (set! col (+ col (match-end 0))))))
      (set! i (+ i 1)))
    (reverse links)))

(defun markdown-next-wiki-link ()
  "Move cursor to next [[wiki-link]] after current position."
  (interactive)
  (let ((links (markdown-scan-wiki-links))
        (cur-line (cursor-line))
        (cur-col (cursor-column))
        (found nil)
        (i 0))
    (while (and (< i (length links)) (not found))
      (let ((l-line (nth 0 (nth i links)))
            (l-col (nth 1 (nth i links))))
        (if (or (> l-line cur-line)
                (and (= l-line cur-line) (> l-col cur-col)))
            (set! found (nth i links))))
      (set! i (+ i 1)))
    (if found
        (progn
          (cursor-move (nth 0 found) (nth 1 found))
          (message "Link: [[%s]]" (nth 2 found)))
        (message "No next wiki-link"))))

(defun markdown-prev-wiki-link ()
  "Move cursor to previous [[wiki-link]] before current position."
  (interactive)
  (let ((links (markdown-scan-wiki-links))
        (cur-line (cursor-line))
        (cur-col (cursor-column))
        (found nil)
        (i 0))
    (set! i (- (length links) 1))
    (while (and (>= i 0) (not found))
      (let ((l-line (nth 0 (nth i links)))
            (l-col (nth 1 (nth i links))))
        (if (or (< l-line cur-line)
                (and (= l-line cur-line) (< l-col cur-col)))
            (set! found (nth i links))))
      (set! i (- i 1)))
    (if found
        (progn
          (cursor-move (nth 0 found) (nth 1 found))
          (message "Link: [[%s]]" (nth 2 found)))
        (message "No previous wiki-link"))))

(defun markdown-follow-wiki-link ()
  "Follow [[wiki-link]] at point."
  (interactive)
  (let ((target (markdown-wiki-link-at-point)))
    (if (not target)
        (message "No wiki link at point")
        (let ((heading nil)
              (block-ref nil)
              (file-path target))
          (if (string-match "^\([^#]+\)#\\^\(.*\)" target)
              (progn
                (set! file-path (match-string 1 target))
                (set! block-ref (match-string 2 target)))
              (if (string-match "^\([^#]+\)#\(.*\)" target)
                  (progn
                    (set! file-path (match-string 1 target))
                    (set! heading (match-string 2 target)))
                  (if (string-match "^#\(.*\)" target)
                      (progn
                        (set! file-path nil)
                        (set! heading (match-string 1 target))))))
          (if file-path
              (let ((resolved file-path))
                ;; Found via SPEC-116: the old (not (string-match ...)) guards
                ;; failed EMPIRICALLY (an instrumented run showed resolved
                ;; without .md appended, so extension-less [[wiki-file]] links
                ;; hit the miss branch). The exact mechanism is subtle
                ;; (string-match itself returns nil on no-match per
                ;; tlisp-api.ts:1157); boolean predicates are unambiguous.
                (if (not (string-contains-p "." file-path))
                    (set! resolved (concat file-path ".md")))
                (if (not (string-prefix-p "/" resolved))
                    (let ((dir (markdown-dirname (or (buffer-filename) "."))))
                      (set! resolved (concat dir "/" resolved))))
                (if (file-exists-p resolved)
                    (progn
                      (markdown-push-position)
                      (find-file-open resolved)
                      (if heading
                          (markdown-open-anchor (concat "#" heading))))
                    ;; SPEC-116: dangling target — follow-or-create prompt
                    ;; (dedup-ranked existing notes + explicit create),
                    ;; never a dead-end.
                    (markdown-resolve-or-create file-path heading)))
              (if heading
                  (markdown-open-anchor (concat "#" heading))
                  (message "Invalid wiki link: %s" target)))))))

;; ── Follow-or-create (SPEC-116) ───────────────────────────────────────
;; Prompt state (the completing-read table + accept run async, mirroring
;; ADR-0168: prepare state, prompt, dispatch in the accept handler).
;; All list work uses explicit loops — string-name higher-order calls
;; (mapcar/stable-sort predicates) do not resolve in every interpreter path.
(defvar markdown-resolve-notes '())
(defvar markdown-resolve-heading nil)
(defvar markdown-resolve-target nil)

(defun markdown-note-rank (name target)
  "Similarity score of NAME for a dangling TARGET: 2 substring, 1 prefix, 0 else.
Uses string-contains-p (a plain substring test) — NEVER string-match-spans-all
on the target: that compiles it as a JS RegExp, so a metacharacter target
([[note(v2]]) errors and a dotted one mis-matches (verify-gate #185 gap 1)."
  (if (string-contains-p target name)
    2
    (if (string-prefix-p target name) 1 0)))

(defun markdown-note-name (note)
  "Name field of a vault-note hashmap."
  (hashmap-get note "name"))

(defun markdown-note-names-of (notes)
  "Note NAME strings from a vault-notes list, in order."
  (let ((out '()) (i 0))
    (while (< i (length notes))
      (set! out (cons (markdown-note-name (nth i notes)) out))
      (set! i (+ i 1)))
    (reverse out)))

(defun markdown-note-path (name)
  "Vault path for note NAME from the cached resolve state, or nil.
Duplicate names in different directories resolve to the FIRST (alphabetically
first path — the scan is sorted) match, not an arbitrary last one."
  (let ((result nil) (i 0) (notes markdown-resolve-notes))
    (while (and (< i (length notes)) (not result))
      (if (string= (markdown-note-name (nth i notes)) name)
        (set! result (hashmap-get (nth i notes) "path")))
      (set! i (+ i 1)))
    result))

(defun markdown-bucket-names (names target rank)
  "Names scoring exactly RANK for TARGET, preserving input order."
  (let ((out '()) (i 0))
    (while (< i (length names))
      (if (= (markdown-note-rank (nth i names) target) rank)
        (set! out (cons (nth i names) out)))
      (set! i (+ i 1)))
    (reverse out)))

(defun markdown-cons-names-onto (names acc)
  "Cons each of NAMES (forward order) onto ACC — helper for ordered concat."
  (let ((out acc) (i 0))
    (while (< i (length names))
      (set! out (cons (nth i names) out))
      (set! i (+ i 1)))
    out))

(defun markdown-rank-note-names (names target)
  "Rank note NAMES by similarity to TARGET: substring matches first, then
prefix matches, then the rest — each bucket preserving the input's
alphabetical order (the vault scan returns sorted names). Pure: sets no
prompt state, unit-testable standalone (SPEC-116 Task 2)."
  (let ((b0 (markdown-bucket-names names target 0))
        (b1 (markdown-bucket-names names target 1))
        (b2 (markdown-bucket-names names target 2)))
    (reverse
      (markdown-cons-names-onto b0
        (markdown-cons-names-onto b1
          (markdown-cons-names-onto b2 '()))))))

(defun markdown-note-candidate (name)
  "Build a completion-candidate hashmap for note NAME (the completion
machinery hashmap-sets spans on candidates, so raw strings are not valid)."
  (let ((path (markdown-note-path name)))
    (hashmap
      "value" name
      "display" name
      "annotation" (if path path "")
      "spans" (list)
      "metadata" (hashmap "path" (if path path "")))))

(defun markdown-note-create-candidate (target)
  "The explicit create candidate. Listed FIRST in SPEC-116's resolve table
(the gx follow-or-create prompt); listed LAST in SPEC-120's finder (where
Enter-on-non-exact must pick the fuzzy best match). Creation is never
inferred from a non-match — typos cannot mint junk notes."
  (hashmap
    "value" (concat "+ Create: " target)
    "display" (concat "+ Create: " target)
    "annotation" "new note"
    "spans" (list)
    "metadata" (hashmap "create" target)))

(defun markdown-note-candidates-of (names)
  "Wrap each NAME as a completion candidate, in order."
  (let ((out '()) (i 0))
    (while (< i (length names))
      (set! out (cons (markdown-note-candidate (nth i names)) out))
      (set! i (+ i 1)))
    (reverse out)))

(defun markdown-note-completion-table (input action)
  "Completion table for the follow-or-create prompt (SPEC-116).
Candidates: the explicit + Create entry first, then the vault notes ranked
by similarity to the dangling target (substring > prefix > alphabetical)."
  (if (string= action "metadata")
    (hashmap "category" "tmax-note")
    (let ((ranked (markdown-rank-note-names
                    (markdown-note-names-of markdown-resolve-notes)
                    markdown-resolve-target)))
      (cons (markdown-note-create-candidate markdown-resolve-target)
            (markdown-note-candidates-of ranked)))))

(defun markdown-wiki-link-range-at-point ()
  "Find the [[...]] range at cursor. Return (line start-col end-col) or nil."
  (interactive)
  (let* ((line (buffer-get-line (cursor-line)))
         (col (cursor-column))
         (result nil)
         (search-text line)
         (offset 0))
    (while (and (string-match "\\\\[\\\\[\([^\\\\]]+\)\\\\]\\\\]" search-text) (not result))
      (let ((start (+ offset (match-beginning 0)))
            (end (+ offset (match-end 0))))
        (if (and (>= col start) (<= col end))
          (set! result (list (cursor-line) start end))
          (progn
            (set! offset (+ offset (match-end 0)))
            (set! search-text (substring search-text (match-end 0)))))))
    result))

(defun markdown-resolve-prepare (target heading)
  "Prime the resolve state for TARGET (vault scan + heading to replay).
Split out of markdown-resolve-or-create so a future completion-at-point
layer (RFC-026) — and tests — can drive the dispatch without the prompt."
  (set! markdown-resolve-notes (markdown-vault-notes))
  (set! markdown-resolve-heading heading)
  (set! markdown-resolve-target target))

(defun markdown-resolve-or-create (target heading)
  "Prompt to resolve a dangling wiki-link TARGET (SPEC-116).
Existing notes ranked by similarity + an explicit + Create candidate.
HEADING (#sec / #^block suffix) is replayed on the opened note."
  (markdown-resolve-prepare target heading)
  ;; "markdown-note-history" is DELIBERATELY shared with the SPEC-120 finder
  ;; (markdown-complete-at-point): one note-selection history across both.
  (completing-read
    (concat "Follow or create [" target "]: ")
    "markdown-note-completion-table"
    nil nil "" "markdown-note-history" "markdown-resolve-accept"))

(defun markdown-resolve-accept (choice)
  "Minibuffer accept handler: dispatch the prompt CHOICE."
  (markdown-resolve-dispatch markdown-resolve-target choice))

(defun markdown-write-note-template (name)
  "Write note NAME.md from the blank template (no open) — SPEC-120 split out
of markdown-create-note-for so completion-at-point can create WITHOUT
yanking the user out of the note they are writing. mkdirs the FULL dirname
(recursive) — [[sub/new-note]] with a missing sub/ must create it, not fail
silently (verify-gate #185 gap 2). Returns the written path."
  (let* ((dir (markdown-dirname (or (buffer-filename) ".")))
         (path (concat dir "/" name ".md"))
         (template-file (read-file-content "~/.config/tmax/templates/blank.md"))
         (content nil))
    (file-mkdir (markdown-dirname path))
    (if template-file
      (set! content (markdown-expand-template-variables template-file name))
      (set! content (format "# %s\n\n" name)))
    ;; Write the file first: find-file-open is a no-op for missing files
    ;; (read-file-content returns nil), so creation must persist then open.
    (write-file-content path content)
    path))

(defun markdown-create-note-for (name)
  "Create a new note NAME.md from the blank template and open it (SPEC-116)."
  (let ((path (markdown-write-note-template name)))
    (find-file-open path)
    (message "Created note: %s" path)))

(defun markdown-resolve-dispatch (target choice)
  "Dispatch a follow-or-create CHOICE for dangling TARGET — the unit-testable
core (no prompt; call markdown-resolve-prepare first). '+ Create: TARGET'
creates from template + opens; an existing note name opens it AND rewrites
the [[...]] at point to the canonical name (the dedup payoff). Replays the
#heading suffix on open."
  (if (string= choice (hashmap-get (markdown-note-create-candidate target) "value"))
    (progn
      (markdown-create-note-for target)
      (if markdown-resolve-heading
        (markdown-open-anchor (concat "#" markdown-resolve-heading))))
    (let ((path (markdown-note-path choice)))
      (if path
        (progn
          (let ((link (markdown-wiki-link-range-at-point)))
            (if link
              (buffer-replace-range
                (nth 0 link) (nth 1 link) (nth 0 link) (nth 2 link)
                (concat "[[" choice
                        (if markdown-resolve-heading
                          (concat "#" markdown-resolve-heading)
                          "")
                        "]]"))))
          (markdown-push-position)
          (find-file-open path)
          (if markdown-resolve-heading
            (markdown-open-anchor (concat "#" markdown-resolve-heading))))
        (message "No such note: %s" choice)))))


;; ── Completion-at-point (SPEC-120) ────────────────────────────────────
;; Prompt state in the SPEC-116 shape (ADR-0168): module defvars are NOT
;; set!-able from outside → exported prepare; accept runs in the minibuffer
;; accept handler. The recorded line/col is where the typed "[[" ENDS, so
;; intermediate minibuffer interaction cannot skew the insert target.
(defvar markdown-complete-notes '())
(defvar markdown-complete-line 0)
(defvar markdown-complete-col 0)

(defun markdown-complete-prepare ()
  "Prime the completion-at-point state: vault scan + the [[ position.
The cursor sits right after the just-typed second [ — record it."
  (interactive)
  (set! markdown-complete-notes (markdown-vault-notes))
  (set! markdown-complete-line (cursor-line))
  (set! markdown-complete-col (cursor-column)))

(defun markdown-complete-path (name)
  "Vault path for note NAME from the FINDER's scan (markdown-complete-notes).
Deliberately does NOT read markdown-resolve-notes (SPEC-116's gx-prompt
state) — cross-priming the two defvar sets gave stale path annotations."
  (let ((result nil) (i 0) (notes markdown-complete-notes))
    (while (and (< i (length notes)) (not result))
      (if (string= (markdown-note-name (nth i notes)) name)
        (set! result (hashmap-get (nth i notes) "path")))
      (set! i (+ i 1)))
    result))

(defun markdown-complete-candidate (name)
  "Finder candidate for note NAME, annotated from the FINDER's scan."
  (let ((path (markdown-complete-path name)))
    (hashmap
      "value" name
      "display" name
      "annotation" (if path path "")
      "spans" (list)
      "metadata" (hashmap "path" (if path path "")))))

(defun markdown-complete-candidates-of (names)
  "Wrap each NAME as a finder candidate, in order."
  (let ((out '()) (i 0))
    (while (< i (length names))
      (set! out (cons (markdown-complete-candidate (nth i names)) out))
      (set! i (+ i 1)))
    (reverse out)))

(defun markdown-complete-table (input action)
  "Completion table for the [[ finder (SPEC-120): EVERY vault note first,
then '+ Create: <input>' LAST — and only when INPUT is non-blank.
Ordering matters: Enter on a non-exact input accepts the FIRST listed
candidate, so notes-first means a typo ('goal') completes to the fuzzy
best match ('goals'), and + Create takes a deliberate Down — or, for a
genuinely-new name, is the ONLY match left, so plain Enter creates.
(SPEC-116's 'typos cannot mint junk notes' philosophy preserved.)
No re-ranking: the minibuffer's input filtering is the fuzzy match —
the input IS the query."
  (if (string= action "metadata")
    (hashmap "category" "tmax-note-complete")
    (let ((notes (markdown-complete-candidates-of
                   (markdown-note-names-of markdown-complete-notes))))
      (if (string= (string-trim input) "")
        notes
        (append notes (list (markdown-note-create-candidate input)))))))

(defun markdown-complete-accept (choice)
  "Accept handler: complete the [[ at the recorded position, in place.
Existing note → '<choice>]]'; '+ Create: X' → 'X]]' plus the note file
written from template WITHOUT opening it (creating must not yank the user
out of the note being written). The file EXISTS by the next render, so the
fresh link renders RESOLVED immediately (SPEC-118), not dangling.
Cursor lands after ']]', back in insert mode."
  (let ((name (if (string-prefix-p "+ Create: " choice)
                (string-trim (substring choice 10))
                choice)))
    (cursor-move markdown-complete-line markdown-complete-col)
    (buffer-insert (concat name "]]"))
    (if (string-prefix-p "+ Create: " choice)
      (progn
        (markdown-write-note-template name)
        (message "Created note: %s" name))
      (message "Linked: %s" name))
    (editor-set-mode "insert")))

(defun markdown-complete-at-point ()
  "Open the fuzzy vault-note finder for the [[ just typed (SPEC-120).
Called by insert-char on the second consecutive [ in a markdown buffer."
  (markdown-complete-prepare)
  ;; require-match t: Enter only accepts a listed candidate — the
  ;; + Create entry (present for any non-empty input) keeps creation
  ;; reachable, and raw unmatched text can never silently link nothing.
  ;; "markdown-note-history" is DELIBERATELY shared with SPEC-116's
  ;; follow-or-create prompt (markdown-resolve-or-create): one
  ;; note-selection history across both.
  (completing-read
    "Link to: "
    "markdown-complete-table"
    nil t "" "markdown-note-history" "markdown-complete-accept"))

(defun markdown-find-unlinked-mentions (title texts)
  "Find texts that mention TITLE in plain text but NOT as [[TITLE]] links.
Bug #6: unlinked mentions. Returns a message listing matching texts."
  (let ((matches '())
        (i 0))
    (while (< i (length texts))
      (let ((text (nth i texts)))
        ;; First check: does the title appear at all?
        (if (string-match title text)
            ;; Second check: strip ALL [[...]] links, see if title still appears.
            (let ((stripped text))
              ;; Remove [[target]] patterns by splitting on [[ and taking
              ;; only the text before each link.
              (let ((parts (string-split text "[["))
                    (outside ""))
                (let ((p 0))
                  (while (< p (length parts))
                    (let ((part (nth p parts)))
                      ;; If this part has no ]], it is outside a link.
                      (if (not (string-match "]" part))
                          (set! outside (concat outside " " part))))
                    (set! p (+ p 1))))
                (if (string-match title outside)
                    (set! matches (cons i matches)))))))
      (set! i (+ i 1)))
    (set! matches (reverse matches))
    (if (= (length matches) 0)
        (message "No unlinked mentions of %s" title)
        (message "Unlinked mentions of %s in %d text(s)" title (length matches)))))

(defun markdown-backlinks ()
  "Find all files that link to the current file."
  (interactive)
  (let ((filename (buffer-filename)))
    (if (not filename)
        (message "No file associated with buffer")
        (let* ((basename (buffer-filename))
               (name-no-ext (replace-regexp-in-string "\\.md$" "" basename))
               (short-name nil)
               (i (- (length name-no-ext) 1)))
          (while (and (> i 0) (not (string= (substring name-no-ext i (+ i 1)) "/")))
            (set! i (- i 1)))
          (set! short-name (substring name-no-ext (+ i 1)))
          (let ((files (file-glob "*.md"))
                (backlinks '())
                (j 0))
            (while (< j (length files))
              (let* ((fpath (nth j files))
                     (content (read-file-content fpath)))
                (if (and content (string-match (concat "\\\\[\\\\[" short-name) content))
                    (set! backlinks (cons fpath backlinks))))
              (set! j (+ j 1)))
            (if (> (length backlinks) 0)
                (message "Backlinks: %s" (string-join ", " (reverse backlinks)))
                (message "No backlinks found")))))))

(defun markdown-daily-note ()
  "Create or open today's daily note."
  (interactive)
  (let ((date-result (shell-command "date +%Y-%m-%d")))
    (let ((date-str (string-trim date-result)))
      (let ((path (concat "daily/" date-str ".md")))
        (find-file-open path)
        (message "Daily note: %s" path)))))

(defun markdown-expand-template-variables (content title)
  "Substitute {{date}} and {{title}} placeholders in CONTENT.
TITLE is the note title (filename without extension). Used by
markdown-new-from-template after loading a template file."
  (let ((date-result (shell-command "date +%Y-%m-%d")))
    (let ((date-str (string-trim date-result))
          (s content))
      (set! s (replace-regexp-in-string "{{date}}" date-str s))
      (set! s (replace-regexp-in-string "{{title}}" title s))
      s)))

(defun markdown-new-from-template (&optional (template "blank" template-supplied-p))
  "Create a new note from a template.
SPEC note (audit P2.6): read-string is a sync stub, so the template name is
passed via the prefix key: , N for blank, , N d for daily, , N m for meeting.
Reads ~/.config/tmax/templates/<name>.md if present, else falls back to
built-in templates. Substitutes {{date}} and {{title}}."
  (if (not template-supplied-p) (set! template "blank"))
  (let ((date-result (shell-command "date +%Y-%m-%d")))
      (let* ((date-str (string-trim date-result))
            (name date-str)
            (content nil)
            (template-file (read-file-content (concat "~/.config/tmax/templates/" template ".md"))))
        (if template-file
            ;; User-provided template file wins; expand its variables.
            (set! content (markdown-expand-template-variables template-file name))
            ;; Built-in fallbacks.
            (if (string= template "daily")
                (set! content (format "# %s\n\n## Tasks\n\n## Notes\n" date-str))
                (if (string= template "meeting")
                    (set! content (format "# Meeting: %s\n\n## Attendees\n\n## Agenda\n\n## Notes\n\n## Action Items\n" name))
                    (set! content (format "# %s\n\n" name)))))
        (let ((path (concat name ".md")))
          (find-file-open path)
          (buffer-insert content)
          (cursor-move 0 0)
          (message "Created note: %s" path)))))

(defun markdown-rename-note ()
  "Rename current note and update all wiki links."
  (interactive)
  (let ((old-name (buffer-filename)))
    (if (not old-name)
        (message "No file associated with buffer")
        (let ((new-name (read-string "New name: ")))
          (if (> (length new-name) 0)
              (let* ((old-no-ext (replace-regexp-in-string "\\.md$" "" old-name))
                     (old-short nil)
                     (slash-idx (- (length old-no-ext) 1)))
                (while (and (> slash-idx 0) (not (string= (substring old-no-ext slash-idx (+ slash-idx 1)) "/")))
                  (set! slash-idx (- slash-idx 1)))
                (set! old-short (substring old-no-ext (+ slash-idx 1)))
                (let ((files (file-glob "*.md"))
                      (i 0))
                  (while (< i (length files))
                    (let* ((fpath (nth i files))
                           (content (read-file-content fpath)))
                      (if content
                          (let ((new-content (replace-regexp-in-string
                                              (concat "\\\\[\\\\[" old-short "\\\\]\\\\]")
                                              (concat "[[" new-name "]]")
                                              content)))
                            (if (not (string= content new-content))
                                (write-file-content fpath new-content)))))
                    (set! i (+ i 1))))
                (let ((new-path (concat new-name ".md")))
                  (file-rename old-name new-path)
                  (message "Renamed to %s" new-path)))
              (message "Cancelled"))))))

(provide "markdown-commands/knowledge")
)
