(defmodule editor/commands/insert-entries
  (export vim-line-length insert-newline insert-tab insert-backspace insert-append insert-append-line insert-line-start open-line-below open-line-above set-expand-tabs set-tab-width insert-char)

;; insert-entries.tlisp -- Vim insert entry commands composed in T-Lisp

;; #144: expandtab support — when expand-tabs is non-nil, Tab inserts spaces.
;; These defvars are module-local, so cross-module setters (:set et in
;; command-line.tlisp) must go through set-expand-tabs / set-tab-width below
;; rather than (setq expand-tabs ...) from another module env.
(defvar expand-tabs nil
  "If non-nil, Tab inserts spaces instead of a literal tab (vim expandtab).")
(defvar tab-width 4
  "Number of columns per tab stop (vim tabstop).")

(defun set-expand-tabs (flag)
  "Enable/disable expandtab (#144). Non-nil FLAG makes Tab insert spaces."
  (setq expand-tabs flag))

(defun set-tab-width (n)
  "Set the tab stop width in columns (#144, vim tabstop)."
  (setq tab-width n))

(defun electric-pair--close-for (key)
  "Return the matching close delimiter for an open KEY, else nil (#149)."
  (cond
    ((string= key "(") ")")
    ((string= key "[") "]")
    ((string= key "{") "}")
    ((string= key "\"") "\"")
    ((string= key "'") "'")
    (t nil)))

(defun insert-char (key)
  "Insert KEY at point, honoring overwrite-mode and electric-pair-mode (#149).
Defaults to a plain buffer-insert when both modes are off (the common case), so
default insert behavior is unchanged. overwrite-mode replaces the next char
when the cursor is before EOL; electric-pair-mode inserts the matching close
delimiter and leaves the cursor between."
  (if (minor-mode-active-p "overwrite")
    (if (< (cursor-column) (vim-line-length (cursor-line)))
      (buffer-delete-range (cursor-line) (cursor-column) (cursor-line) (+ (cursor-column) 1))
      nil)
    nil)
  (buffer-insert key)
  (if (minor-mode-active-p "electric-pair")
    (let ((close (electric-pair--close-for key)))
      (if close
        (progn (buffer-insert close) (cursor-move (cursor-line) (- (cursor-column) 1)))
        nil))
    nil)
  t)

(defun vim-line-length (line)
  "Return the length of LINE."
  (length (buffer-line line)))

(defun insert-newline ()
  "Insert a newline at point."
  (progn
    (buffer-insert "\n")
    t))

(defun insert-tab ()
  "Insert a tab at point (or spaces if expand-tabs is non-nil, #144)."
  (if expand-tabs
    (let ((col (cursor-column)))
      (let ((n (- tab-width (mod col tab-width))))
        (while (> n 0)
          (buffer-insert " ")
          (setq n (- n 1)))))
    (buffer-insert "\t"))
  t)

(defun insert-backspace ()
  "Delete the character before point, joining lines at column zero."
  (let ((line (cursor-line)))
    (let ((column (cursor-column)))
      (cond
        ((> column 0)
          (progn
            (buffer-delete-range line (- column 1) line column)
            t))
        ((> line 0)
          (progn
            (buffer-delete-range (- line 1) (vim-line-length (- line 1)) line 0)
            t))
        (t t)))))

(defun insert-append ()
  "Vim a: enter insert mode after the cursor."
  (progn
    (cursor-move (cursor-line) (min (+ (cursor-column) 1) (vim-line-length (cursor-line))))
    (editor-set-mode "insert")
    t))

(defun insert-append-line ()
  "Vim A: enter insert mode at end of current line."
  (progn
    (cursor-move (cursor-line) (vim-line-length (cursor-line)))
    (editor-set-mode "insert")
    t))

(defun insert-line-start ()
  "Vim I: enter insert mode at first non-blank column."
  (progn
    (line-first-non-blank)
    (editor-set-mode "insert")
    t))

(defun open-line-below ()
  "Vim o: open a blank line below current line and enter insert mode."
  (let ((line (cursor-line)))
    (progn
      (undo-begin)
      (cursor-move line (vim-line-length line))
      (buffer-insert "\n")
      (undo-commit "o")
      (editor-set-mode "insert")
      t)))

(defun open-line-above ()
  "Vim O: open a blank line above current line and enter insert mode."
  (let ((line (cursor-line)))
    (progn
      (undo-begin)
      (cursor-move line 0)
      (buffer-insert "\n")
      (cursor-move line 0)
      (undo-commit "O")
      (editor-set-mode "insert")
      t)))
)

(defun insert-delete-to-bol ()
  "Delete from cursor to beginning of line (vim insert C-u, #143)."
  (let ((col (cursor-column)))
    (if (> col 0)
      (buffer-delete-range (cursor-line) 0 (cursor-line) col))))
