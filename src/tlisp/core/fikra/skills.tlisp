(defmodule fikra/skills
  (export fikra-skills-list fikra-skills-rows fikra-skills-refresh
          fikra-skills-dir fikra-skill-prompt fikra-skill-accept
          fikra-skill-table fikra-skill-annotator fikra-skill-name-of
          fikra-skill-visibility fikra-skill-fm-value fikra-skills-model-roster fikra-skills-any-rows-p)

;; RFC-029 section 8.7 (P3, built round-29): .fikra/skills/*/SKILL.md discovery,
;; surfaced to model and user. Skills from
;; <thread-root>/.fikra/skills/<name>/SKILL.md — the frontmatter's
;; visibility tag decides model-visible vs user-only (default
;; model-visible). Coexists with pure T-Lisp defworkflows (section 9 Q3
;; composition deferred).

;; A discovered skill row: hashmap id/path/visibility/description.
(defvar fikra-skills-cache (list))
;; The cache is ROOT-SCOPED (codex r26 fix 3): skills live under
;; <root>/.fikra/skills — a thread-root switch invalidates the cache.
(defvar fikra-skills-cache-root nil)

(defun fikra-skills-dir ()
  ;; #298: the thread's PERSISTED root (the legacy resolver follows the
  ;; daemon cwd — wrong once client context differs).
  (concat (progn (require-module fikra/thread) (fikra/thread/fikra-thread-field "root")) "/.fikra/skills"))

(defun fikra-skills-refresh ()
  "Rescan .fikra/skills/*/SKILL.md. Skills with SKILL.md files whose
frontmatter carries 'visibility: user' are user-only; everything else
is model-visible."
  (let ((dir (fikra-skills-dir)))
    (setq fikra-skills-cache-root dir)
    (setq fikra-skills-cache (fikra-skills-scan dir))
    (setq fikra-skills-cache-stamp
      (fikra-skills-dir-stamp dir (fikra-skills-dir-names dir)))
    (length fikra-skills-cache)))

(defun fikra-skills-scan (dir)
  (if (not (file-exists-p dir))
    (list)
    (let ((names (string-split
                   (shell-command (concat "ls -1 " (fikra/thread/fikra-thread-shq dir) " 2>/dev/null || true"))
                   "\n"))
          (out (list)))
      (dolist (name names)
        (if (> (length name) 0)
          (let ((md (concat dir "/" name "/SKILL.md")))
            (if (file-exists-p md)
              (let ((body (read-file-content md)))
                (setq out (cons
                  (hashmap
                    "id" (concat "fikra-skill " name)
                    "path" (concat ".fikra/skills/" name)
                    "visibility" (fikra-skill-visibility body)
                    "description" (fikra-skills-first-line body))
                  out)))))))
      (reverse out))))

;; Description: the frontmatter "description:" field (codex r25 — the raw
;; first line is "---" for every frontmatter skill); fall back to the first
;; body line after the closing delimiter, then the raw first line.
(defun fikra-skills-first-line (body)
  (let ((fm (fikra-skill-fm-field body "description")))
    (if (> (length fm) 0)
      fm
      (fikra-skill-first-body-line (string-split body "\n") 0))))

(defun fikra-skill-fm-field (body field)
  (fikra-skill-fm-field-scan (string-split body "\n") field 0))

;; One frontmatter LINE as a field value: anchored "field: value" (codex
;; r26 fix 2 — an unanchored substring let "notes on visibility: user"
;; misclassify). Nil when the line is not that exact field.
(defun fikra-skill-fm-value (line field)
  (if (string= (substring line 0 (min (length line) (+ (length field) 1)))
               (concat field ":"))
    ;; +1 (after the colon); trim absorbs the optional space — the old +2
    ;; slice read "visibility:user" as "ser" (codex r27).
    (let ((v (string-trim (substring line (+ (length field) 1) (length line)))))
      (if (> (length v) 0) v nil))
    nil))

(defun fikra-skill-fm-field-scan (lines field phase)
  (if (null lines)
    ""
    (let ((line (string-trim (car lines))))
      (if (= phase 0)
        (if (string= line "---")
          (fikra-skill-fm-field-scan (cdr lines) field 1)
          "")
        (if (string= line "---")
          ""
          (let ((v (fikra-skill-fm-value line field)))
            (if v
              v
              (fikra-skill-fm-field-scan (cdr lines) field 1))))))))

(defun fikra-skill-first-body-line (lines phase)
  (if (null lines)
    ""
    (let ((line (string-trim (car lines))))
      (if (= phase 0)
        (if (string= line "---")
          (fikra-skill-first-body-line (cdr lines) 1)
          (car lines))
        (if (string= line "---")
          (fikra-skill-first-body-line (cdr lines) 2)
          (if (= phase 2)
            (if (> (length line) 0)
              line
              (fikra-skill-first-body-line (cdr lines) 2))
            (fikra-skill-first-body-line (cdr lines) 1)))))))

;; Visibility is a FRONTMATTER field (codex r25: matching the whole body
;; lets an instruction line mislabel the skill). user-only only when the
;; leading --- block carries "visibility: user"; anything else (or no
;; frontmatter at all) is model-visible per the RFC default.
(defun fikra-skill-visibility (body)
  (if (fikra-skill-fm-scan (string-split body "\n") 0 nil)
    "user-only"
    "model-visible"))

;; phase 0 = before the leading delimiter, 1 = inside frontmatter.
(defun fikra-skill-fm-scan (lines phase hit)
  (if (null lines)
    hit
    (let ((line (string-trim (car lines))))
      (if (= phase 0)
        (if (string= line "---")
          (fikra-skill-fm-scan (cdr lines) 1 hit)
          nil)
        (if (string= line "---")
          hit
          (fikra-skill-fm-scan (cdr lines) 1
            (if hit
              hit
              (let ((v (fikra-skill-fm-value line "visibility"))) (if v (string= v "user") nil)))))))))

(defvar fikra-skills-cache-stamp nil
  "Modtime stamp of the scanned skills at cache time (codex r27: edits
within a root invalidate the cache too, not just root switches).")

(defun fikra-skills-dir-stamp (dir names)
  "Concatenated name+modtime of every skill directory's SKILL.md —
changes when a skill is added, removed, or edited."
  (if (null names)
    ""
    (concat (car names) ":"
            ;; file-modtime: ISO string, nil when missing.
            (let ((m (file-modtime (concat dir "/" (car names) "/SKILL.md"))))
              (if m m "-"))
            ";"
            (fikra-skills-dir-stamp dir (cdr names)))))

(defun fikra-skills-dir-names (dir)
  ;; Non-empty names only — ls's trailing newline yields a phantom "".
  (fikra-skills-dir-names-filter
    (if (not (file-exists-p dir))
      (list)
      ;; shq like the scanner (codex r28: literal quotes broke/injected
      ;; on roots containing apostrophes).
      (string-split (shell-command (concat "ls -1 " (fikra/thread/fikra-thread-shq dir) " 2>/dev/null || true")) "\n"))
    (list)))

(defun fikra-skills-dir-names-filter (names out)
  (if (null names)
    (reverse out)
    (fikra-skills-dir-names-filter (cdr names)
      (if (> (length (car names)) 0) (cons (car names) out) out))))

(defun fikra-skills-cache-stale-p ()
  ;; Empty cache, root moved, OR any SKILL.md changed on disk (codex r27).
  (if (= (length fikra-skills-cache) 0)
    t
    (let ((dir (fikra-skills-dir)))
      (if (not (string= (if fikra-skills-cache-root fikra-skills-cache-root "")
                        (if dir dir "")))
        t
        (not (string= (if fikra-skills-cache-stamp fikra-skills-cache-stamp "")
                      (fikra-skills-dir-stamp dir (fikra-skills-dir-names dir))))))))

(defun fikra-skills-list ()
  (if (fikra-skills-cache-stale-p)
    (fikra-skills-refresh))
  fikra-skills-cache)

(defun fikra-skills-workflow-names ()
  "Registered defworkflow names (empty when the workflow module has none)."
  (condition-case nil
    (progn (require-module fikra/workflow)
           (fikra/workflow/fikra-registered-workflows))
    (error () (list))))

(defun fikra-skills-any-rows-p ()
  "t when the picker has anything to show: skills OR registered
defworkflows (refreshes first, so it reflects current disk state)."
  (fikra-skills-refresh)
  (if (> (length fikra-skills-cache) 0)
    t
    (> (length (fikra-skills-workflow-names)) 0)))

(defun fikra-skills-rows ()
  "Rows for the completion table (display + metadata for the annotator):
.fikra skills AND registered defworkflows (codex r25 / mockup 8.7)."
  (append
    (mapcar
      (lambda (s)
        (hashmap "value" (hashmap-get s "id")
                 "display" (hashmap-get s "id")
                 "metadata" (hashmap "path" (hashmap-get s "path")
                                     "visibility" (hashmap-get s "visibility"))))
      (fikra-skills-list))
    (mapcar
      (lambda (w)
        (hashmap "value" (concat "defworkflow " w)
                 "display" (concat "defworkflow " w)
                 "metadata" (hashmap "path" "init.tlisp"
                                     "visibility" "T-Lisp program")))
      (fikra-skills-workflow-names))))

;; The roster fed to the MODEL each turn: model-visible skills only —
;; user-only skills stay unlisted until the user invokes them (mockup
;; 8.7 "fed to the model as available workflows"; codex r25 fix 1).
(defun fikra-skills-model-roster ()
  (fikra-skills-roster-join (fikra-skills-list) ""))

(defun fikra-skills-roster-join (skills acc)
  (if (null skills)
    acc
    (let ((s (car skills)))
      (fikra-skills-roster-join (cdr skills)
        (if (string= (hashmap-get s "visibility") "model-visible")
          (concat acc (if (> (length acc) 0) "\n" "")
                  "- " (hashmap-get s "id") ": " (hashmap-get s "description"))
          acc)))))

;; The completion table (FUNCTION contract — input action). The custom
;; "fikra-skill" category routes marginalia to our annotator below (the
;; built-in "command" annotator overwrites the row annotation with blanks).
(defun fikra-skill-table (input action)
  (if (string= action "metadata")
    (hashmap "category" "fikra-skill")
    (fikra-skills-rows)))

(defun fikra-skill-annotator (candidate)
  "Marginalia: the skill's path and visibility tag."
  (let ((details (hashmap-get candidate "metadata")))
    (concat "  " (hashmap-get details "path")
            " · " (hashmap-get details "visibility"))))

(defun fikra-skill-accept (choice)
  "Accept: run the chosen row — a .fikra skill starts a chat turn whose
instruction is the SKILL.md body; a defworkflow row runs the registered
T-Lisp workflow by name (mockup 8.7; composition is section 9 Q3)."
  (if (fikra-choice-defworkflow-p choice)
    (fikra-skill-accept-defworkflow (fikra-skill-name-of choice))
    (fikra-skill-accept-skill choice)))

(defun fikra-choice-defworkflow-p (choice)
  ;; "defworkflow " is 12 characters (11 + the space).
  (if (< (length choice) 12)
    nil
    (string= (substring choice 0 12) "defworkflow ")))

(defun fikra-skill-accept-defworkflow (name)
  (if (not name)
    (editor-set-status "Fikra: unknown workflow")
    (progn
      (require-module fikra/workflow)
      (fikra/workflow/fikra-run-named-workflow name))))

(defun fikra-skill-accept-skill (choice)
  (let ((name (fikra-skill-name-of choice)))
    (if (not name)
      (editor-set-status "Fikra: unknown skill")
      (progn
        (let ((body (read-file-content
                      (concat (fikra-skills-dir) "/" name "/SKILL.md"))))
          (require-module fikra/chat)
          (fikra/chat/fikra-turn-send
            (concat "Follow the skill at .fikra/skills/" name
                    "/SKILL.md (re-read it from disk):\n\n" body))
          (editor-set-status (concat "Fikra: skill " name " → thread")))))))

(defun fikra-skill-name-of (choice)
  ;; choice = "fikra-skill <name>" — take everything after the space.
  (fikra-skill-name-scan choice 0 nil))

(defun fikra-skill-name-scan (s i acc)
  (if (>= i (length s))
    (if acc (fikra-skill-name-strip acc) nil)
    (fikra-skill-name-scan s (+ i 1)
      (if (and (not acc) (string= (substring s i (+ i 1)) " "))
        " "
        (if acc (concat acc (substring s i (+ i 1))) nil)))))

(defun fikra-skill-name-strip (s)
  (substring s 1 (length s)))

(defun fikra-skill-prompt ()
  "M-x fikra-skill: pick a skill (completes over .fikra/skills)."
  (interactive)
  (fikra-skills-refresh)
  ;; codex r26 fix 1: registered defworkflows count too — a workflow-only
  ;; project still opens the picker (the gate is fikra-skills-any-rows-p,
  ;; unit-testable headless).
  (if (not (fikra-skills-any-rows-p))
    (editor-set-status "Fikra: no skills in .fikra/skills/ and no registered workflows")
    (progn
      (require-module fikra/thread)
      (completing-read "fikra-skill "
                       "fikra/skills/fikra-skill-table"
                       nil nil ""
                       "fikra-skill-history"
                       "fikra/skills/fikra-skill-accept"))))

(defvar fikra-skill-history nil)

(require-module editor/completion/marginalia)
(marginalia-register-annotator "fikra-skill" "fikra/skills/fikra-skill-annotator")

(provide "fikra-skills")
)
