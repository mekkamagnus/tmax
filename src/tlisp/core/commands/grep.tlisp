(defmodule editor/commands/grep
  (export grep-rg-handle grep-search grep-rg-run grep-rg-filter grep-rg-sentinel grep-backend-available-p grep-backend-get grep-rg-dump grep-backend-set! grep-rg-detected-set! grep-rg-rollback-after-register grep-exact-keys-p grep-coord-p grep-test-producer-last grep-buffer-register grep-buffer-append-hit
          grep-buffer-complete grep-buffer-rollback
          grep-test-producer grep-hits-get grep-generation-get
          grep-current-gen-get grep-status-get
          grep-rg-replay-pending grep-rg-kill-prior grep-rg-stderr-filter
          grep-rg-run-files
          grep-completion-hook-set!
          grep-rg-executable-set! grep-rg-test-state!
          grep-ret grep-next grep-prev grep-rerun grep-quit)

;; #307 — the *grep* HIT-BUFFER subsystem (RFC-031 §2.1; SPEC-291).
;; The generic cross-file hit buffer every search backend feeds:
;; a GENERATION-SCOPED producer interface (register → append-hit* →
;; complete; rollback restores), structured hits (display text is
;; never parsed), streaming selection stability, RET landing with
;; clamps, and recency-based q restoration. Ships with a TEST
;; PRODUCER so the subsystem completes independently of #308/#309.

;; ── state ───────────────────────────────────────────────────────────
(defvar grep-generation-counter 0 "The last issued generation id.")
(defvar grep-current-gen nil "The ACTIVE generation (nil before any register).")
(defvar grep-completed nil "t once the active generation completed.")
(defvar grep-status nil "The active generation's completion status.")
(defvar grep-message nil "The error message / diagnostic suffix.")
(defvar grep-hits (list) "((file line col text) ...) — newest LAST.")
(defvar grep-meta nil "The active generation's registered metadata (hashmap).")
(defvar grep-retired (list) "The RETIRED generation ids (no callbacks).")
(defvar grep-producer-last nil "The producer's last register result (tests poll).")
(defvar grep-saved-content nil "The pre-register buffer content (rollback of the only generation).")
(defvar grep-stack (list) "((gen meta hits completed status) ...) — the generation snapshots, newest LAST.")

(defun grep-buffer-name () "*grep*")
(defun grep-hits-get () grep-hits)
(defun grep-generation-get () grep-generation-counter)
(defun grep-current-gen-get () grep-current-gen)
(defun grep-status-get () grep-status)

;; ── validation (BEFORE any generation test — the spec's precedence) ─
(defun grep-error (msg)
  (error (concat "grep: " msg)))

(defun grep-exact-keys-p (hmap keys)
  ;; EXACTLY the given keys (unknown OR missing keys fail); returns
  ;; the list of OFFENDERS (empty when exact).
  (let ((have (hashmap-keys hmap))
        (missing (list))
        (unknown (list)))
    (dolist (k keys)
      (if (not (member k have))
        (setq missing (cons k missing))))
    (dolist (k have)
      (if (not (member k keys))
        (setq unknown (cons k unknown))))
    (append missing unknown)))

(defun grep-coord-p (x)
  ;; An integer >= 1 (gate r1: numberp alone let 1.5 through). No
  ;; floor builtin — the printed form carries no decimal point.
  (and (numberp x) (>= x 1)
    (not (string-contains-p "." (number-to-string x)))))

(defun grep-name-offenders (offenders kind)
  (if (null offenders) ""
    (concat kind ": " (string-join ", " offenders) "; ")))

;; ── the producer interface ──────────────────────────────────────────
(defun grep-buffer-register (regmap)
  "Register a search generation. MAP: EXACTLY backend/pattern/scope/
rerun. Returns the generation id."
  (let ((offenders (grep-exact-keys-p regmap (list "backend" "pattern" "scope" "rerun"))))
    (if (> (length offenders) 0)
      (grep-error (concat "register: bad fields — "
                    (grep-name-offenders offenders "unknown/missing"))))
    (if (not (and (stringp (hashmap-get regmap "backend"))
                  (> (length (hashmap-get regmap "backend")) 0)))
      (grep-error "register: backend must be a non-empty string"))
    (if (not (stringp (hashmap-get regmap "pattern")))
      (grep-error "register: pattern must be a string (may be empty)"))
    (if (not (and (stringp (hashmap-get regmap "scope"))
                  (> (length (hashmap-get regmap "scope")) 0)))
      (grep-error "register: scope must be a non-empty string"))
    (if (not (functionp (hashmap-get regmap "rerun")))
      (grep-error "register: rerun must be a function")))
  ;; Snapshot the prior generation — INCLUDING its saved-content
  ;; (gate r2 P3: the single saved-content slot was overwritten at
  ;; every register, so bottoming-out restored the LAST register's
  ;; snapshot instead of the true pre-register content).
  (if grep-current-gen
    (setq grep-stack
      (append grep-stack
        (list (list grep-current-gen grep-meta grep-hits
                grep-completed grep-status grep-saved-content
                grep-message (grep-buffer-content))))))
  (setq grep-saved-content (grep-buffer-content))
  (setq grep-generation-counter (+ grep-generation-counter 1))
  (setq grep-current-gen grep-generation-counter)
  (setq grep-completed nil)
  (setq grep-status nil)
  (setq grep-message nil)
  (setq grep-hits (list))
  (setq grep-meta regmap)
  (grep-render-open)
  grep-generation-counter)

(defun grep-buffer-append-hit (gen hitmap)
  "Append one structural hit to generation GEN."
  ;; Validation FIRST (even on stale generations).
  (if (not (grep-coord-p gen))
    (grep-error "append-hit: gen must be an integer"))
  (let ((offenders (grep-exact-keys-p hitmap (list "file" "line" "col" "text"))))
    (if (> (length offenders) 0)
      (grep-error (concat "append-hit: bad fields — "
                    (grep-name-offenders offenders "unknown/missing"))))
    (if (not (and (stringp (hashmap-get hitmap "file"))
                  (> (length (hashmap-get hitmap "file")) 0)))
      (grep-error "append-hit: file must be a non-empty string"))
    (if (not (stringp (hashmap-get hitmap "text")))
      (grep-error "append-hit: text must be a string (may be empty)"))
    (if (not (grep-coord-p (hashmap-get hitmap "line")))
      (grep-error "append-hit: line must be an integer >= 1"))
    (if (not (grep-coord-p (hashmap-get hitmap "col")))
      (grep-error "append-hit: col must be an integer >= 1")))
  ;; Well-formed + stale/completed/retired → SILENT drop.
  (if (grep-live-gen-p gen)
    (progn
      (setq grep-hits
        (append grep-hits
          (list (list (hashmap-get hitmap "file")
                      (hashmap-get hitmap "line")
                      (hashmap-get hitmap "col")
                      (hashmap-get hitmap "text")))))
      (grep-render-append (length grep-hits)))
    nil))

(defvar grep-completion-hook nil
  "A post-completion callback (#311): funcalls (status) after the
render — the consult layer's completedSnapshot discipline.")

(defun grep-completion-hook-set! (fn)
  (setq grep-completion-hook fn)
  fn)

(defun grep-buffer-complete (gen status message)
  "Complete generation GEN: done | error | no-matches."
  (if (not (grep-coord-p gen))
    (grep-error "complete: gen must be an integer"))
  (if (not (member status (list "done" "error" "no-matches")))
    (grep-error (concat "complete: unknown status '" status "'")))
  (if (and (string= status "error")
           (not (and (stringp message) (> (length message) 0))))
    (grep-error "complete: status 'error' requires a non-empty message"))
  (if (grep-live-gen-p gen)
    ;; gate r2 P4: the RENDER runs against the passed status first;
      ;; the state commits only after it succeeds (a post-q throw
      ;; used to half-apply the transition).
    (progn
      (grep-render-complete-with status
        (if (stringp message) message nil))
      (setq grep-completed t)
      (setq grep-status status)
      (setq grep-message
        (if (stringp message) message nil))
      (condition-case nil
        (if grep-completion-hook (funcall grep-completion-hook status))
        (error () nil))))
  nil)

(defun grep-buffer-rollback (gen)
  "Roll back generation GEN — ONLY the newest; restores the previous
generation's content. A restored generation's id RETIRES."
  (if (not (grep-coord-p gen))
    (grep-error "rollback: gen must be an integer"))
  (cond
    ((not (= gen grep-current-gen))
      (grep-error "rollback: not the latest generation"))
    (grep-completed
      (grep-error "rollback: generation already complete"))
    (t
      (progn
        ;; gate r1: POP the snapshot the rolled-back gen pushed and
        ;; restore THE POPPED one (peek-only made consecutive
        ;; rollbacks re-restore the same generation). The rolled-back
        ;; id retires explicitly; the popped gen becomes current.
        (setq grep-retired (cons gen grep-retired))
        (let ((snap (grep-stack-pop)))
          ;; valve r2: EVERY restored id retires (SPEC-291: a restored
          ;; generation accepts NO further callbacks — re-searching
          ;; requires a fresh register).
          (if snap
            (setq grep-retired (cons (nth 0 snap) grep-retired)))
          (setq grep-current-gen (if snap (nth 0 snap) nil))
          (setq grep-meta (if snap (nth 1 snap) nil))
          (setq grep-hits (if snap (nth 2 snap) (list)))
          (setq grep-completed (if snap (nth 3 snap) nil))
          (setq grep-status (if snap (nth 4 snap) nil))
          (setq grep-saved-content
            (if snap (nth 5 snap) grep-saved-content))
          (setq grep-message
            (if snap (nth 6 snap) nil))
          ;; valve r2: restore the generation's EXACT rendered content
          ;; (the placeholder / zero-hit result / completion or error
          ;; message — rebuilding from hits lost them).
          (if snap
            (grep-restore-content (nth 7 snap))
            (grep-restore-content grep-saved-content)))
        (editor-set-status "grep: rolled back")))))

(defun grep-stack-pop ()
  (if (= (length grep-stack) 0)
    nil
    (let ((last (nth (- (length grep-stack) 1) grep-stack)))
      (setq grep-stack (reverse (cdr (reverse grep-stack))))
      last)))

(defun grep-rerender-hits ()
  (if (not (member (grep-buffer-name) (buffer-list)))
    nil
    (progn
  (grep-switch-in)
  (buffer-set-read-only nil)
  (grep-clear-buffer)
  ;; APPEND-style join: no trailing newline (gate r1: the mismatch
  ;; desynced hit indices after a rollback + append).
  (grep-rerender-scan grep-hits 0)
  (buffer-set-read-only t)
  (grep-switch-out))))

(defun grep-rerender-scan (hits i)
  (if (< i (length hits))
    (progn
      (buffer-append
        (concat (if (= i 0) "" "\n") (grep-hit-line (nth i hits))))
      (grep-rerender-scan hits (+ i 1)))))

(defun grep-live-gen-p (gen)
  ;; Well-formed gen is LIVE only when current, uncompleted, unretired.
  (and (= gen grep-current-gen)
       (not grep-completed)
       (not (member gen grep-retired))))

;; ── the buffer ──────────────────────────────────────────────────────
(defun grep-buffer-content ()
  ;; gate valve r1: capture *grep*'s content FROM *grep* (the bare
  ;; buffer-text read the CURRENT buffer — another buffer's text
  ;; became the snapshot).
  (if (not (member (grep-buffer-name) (buffer-list)))
    ""
    (if (string= (buffer-current) (grep-buffer-name))
      (buffer-text)
      (progn
        (grep-switch-in)
        (let ((text (buffer-text)))
          (grep-switch-out)
          text)))))

(defun grep-restore-content (text)
  ;; gate r2 P1 (the r1-missed DATA DESTROYER): switch + restore
  ;; like every other render path.
  (if (member (grep-buffer-name) (buffer-list))
    (progn
      (grep-switch-in)
      (buffer-set-read-only nil)
      (grep-clear-buffer)
      (if (> (length text) 0)
        (buffer-append text))
      (buffer-set-read-only t)
      (grep-switch-out))))

(defvar grep-prev-buffer nil
  "The render's saved current buffer (gate r1 DATA DESTROYER: the
buffer primitives are NAMELESS — every async render switches to
*grep* then RESTORES the user's buffer; without this, a completion
landing while the user edited elsewhere appended into THEIR buffer
and flipped it read-only).")

(defvar grep-prev-line 0 "The render's saved point (line).")
(defvar grep-prev-col 0 "The render's saved point (col).")

(defun grep-switch-in ()
  ;; gate r2: SKIP when *grep* is already current (buffer-switch
  ;; resets the cursor — #127 — clobbering an n/p traversal), else
  ;; save the user's buffer AND point. Guarded: after q the buffer
  ;; is GONE (a late callback must not throw).
  (if (string= (buffer-current) (grep-buffer-name))
    nil
    (progn
      (setq grep-prev-buffer (buffer-current))
      (setq grep-prev-line (cursor-line))
      (setq grep-prev-col (cursor-column))
      (if (member (grep-buffer-name) (buffer-list))
        (buffer-switch (grep-buffer-name))
        (setq grep-prev-buffer nil)))))

(defvar grep-own-line 0 "*grep*'s own cursor (line) across renders.")
(defvar grep-away-rendered nil "t after a render ran while another buffer was current (the cursor reset on return).")

(defun grep-nav-target-line () grep-own-line)
(defvar grep-own-col 0 "*grep*'s own cursor (col) across renders.")

(defun grep-switch-out ()
  ;; Restore the user's buffer AND point (gate r2 P5/P6: the
  ;; buffer-switch cursor reset). *grep*'s OWN selection is saved on
  ;; the way in and restored when the user RETURNS (valve r4: the
  ;; away-render round-trip reset it).
  (if (and grep-prev-buffer
           (member grep-prev-buffer (buffer-list)))
    (progn
      (setq grep-away-rendered t)
      (buffer-switch grep-prev-buffer)
      (cursor-move grep-prev-line grep-prev-col)))
  (setq grep-prev-buffer nil))

(defun grep-restore-own-point ()
  (if (string= (buffer-current) (grep-buffer-name))
    (cursor-move grep-own-line grep-own-col)))

(defun grep-render-open ()
  (if (not (member (grep-buffer-name) (buffer-list)))
    (buffer-create (grep-buffer-name)))
  ;; render-open intentionally LEAVES *grep* current (register is a
  ;; user-facing open); the async renders below restore.
  (buffer-switch (grep-buffer-name))
  (major-mode-set "grep")
  (editor-set-mode "normal")
  (buffer-set-read-only nil)
  (grep-clear-buffer)
  (buffer-append (concat "grep " (grep-pattern-display) " — searching…\n"))
  (buffer-set-read-only t)
  (grep-ensure-keymap)
  (cursor-move 0 0))

(defun grep-pattern-display ()
  (let ((p (hashmap-get grep-meta "pattern")))
    (if (= (length p) 0) "<glob-only>" p)))

(defun grep-render-append (n)
  ;; Stream the newest hit; the POINT never moves (selection stable);
  ;; the USER'S current buffer is restored (gate r1).
  (if (member (grep-buffer-name) (buffer-list))
    (progn
      (grep-switch-in)
      (buffer-set-read-only nil)
      ;; First hit replaces the placeholder; later hits append.
      (if (= n 1)
        (progn
          (grep-clear-buffer)
          (buffer-append (grep-hit-line (nth 0 grep-hits))))
        (buffer-append (concat "\n" (grep-hit-line (nth (- n 1) grep-hits)))))
      (buffer-set-read-only t)
      (grep-switch-out))))

(defun grep-hit-line (hit)
  (concat (nth 0 hit) ":" (number-to-string (nth 1 hit)) ":"
    (number-to-string (nth 2 hit)) ":" (nth 3 hit)))

(defun grep-render-complete ()
  (grep-render-complete-with grep-status grep-message))

(defun grep-render-complete-with (rstatus rmessage)
  ;; valve r1: a killed *grep* (post-q) — NO render at all (the
  ;; body would otherwise run against the user's CURRENT buffer).
  (if (not (member (grep-buffer-name) (buffer-list)))
    nil
  (let ((grep-status rstatus)
        (grep-message rmessage))
  (grep-switch-in)
  (buffer-set-read-only nil)
  (cond
    ((and (string= grep-status "no-matches")
          (> (length grep-hits) 0))
      ;; valve r3: no-matches completing a generation that ALREADY
      ;; streamed hits — the structured list is the truth; keep the
      ;; hits displayed (consistency), note the status.
      (buffer-append (concat "\n— no further matches")))
    ((and (stringp grep-message) (> (length grep-message) 0)
          (not (string= grep-status "error"))
          (= (length grep-hits) 0))
      ;; done/no-matches + message + NO hits: the suffix (gate r2
      ;; P2: without the hits guard this wiped displayed hits with
      ;; a FALSE 'no matches' line).
      (progn
        (grep-clear-buffer)
        (buffer-append (concat "no matches for " (grep-pattern-display)
                           " — " grep-message "\n"))))
    ((and (string= grep-status "done") (= (length grep-hits) 0))
      (progn
        ;; done with zero hits → the no-matches state.
        (grep-clear-buffer)
        (buffer-append (concat "no matches for " (grep-pattern-display) "\n"))))
    ((string= grep-status "no-matches")
      (progn
        (grep-clear-buffer)
        (buffer-append (concat "no matches for " (grep-pattern-display) "\n"))))
    ((string= grep-status "error")
      (if (= (length grep-hits) 0)
        (progn
          (grep-clear-buffer)
          (buffer-append (concat "grep error: " grep-message "\n")))
        ;; Hits landed before the error: the message rides as a suffix.
        (buffer-append (concat "\n— error: " grep-message))))
    (t
      (if (and (stringp grep-message) (> (length grep-message) 0)
               (> (length grep-hits) 0)
               (not (string= grep-status "error")))
        (buffer-append (concat "\n— " grep-message)))))
  (buffer-set-read-only t)
  (editor-set-status
    (concat "grep: "
      (cond
        ((string= grep-status "error") "error")
        ((= (length grep-hits) 0) "no matches")
        (t (concat (number-to-string (length grep-hits)) " hits")))))
  (grep-switch-out))))

(defun grep-clear-buffer ()
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (buffer-delete-range 0 0 (- count 1) 0)))
  (let ((l (buffer-line 0)))
    (if (and l (> (length l) 0))
      (buffer-delete-range 0 0 0 (length l)))))

;; ── keymap: RET / n / p / g / q ─────────────────────────────────────
(defun grep-hit-at-cursor ()
  ;; The hit INDEX at the cursor line (nil elsewhere).
  (let ((i (- (cursor-line) 0)))
    (if (and (>= i 0) (< i (length grep-hits))) i nil)))

(defun grep-ret ()
  "RET — open the hit at point (file at line/col; both clamps)."
  (let ((i (grep-hit-at-cursor)))
    (cond
      ((null i) (editor-set-status "grep: no hit on this line"))
      ((= (length grep-hits) 0) (editor-set-status "grep: no hits"))
      (t
        (let* ((hit (nth i grep-hits))
               (path (grep-resolve-path (nth 0 hit))))
          (if (not (file-exists-p path))
            (editor-set-status (concat "grep: file gone: " (nth 0 hit)))
            (progn
              (find-file path)
              (grep-land (nth 1 hit) (nth 2 hit)))))))))

(defun grep-scope-normalize (scope)
  "Strip TRAILING slashes — rg NORMALIZES its emitted paths (scope
\"sub/\" emits \"sub/inner.txt\"), so the prefix check and the join
must use the normalized form or the path doubles (gate r8's
live-reproduced residual). \"/\" itself is preserved (absolute root)."
  (if (not (stringp scope)) ""
    (if (and (> (length scope) 1)
             (string= (substring scope (- (length scope) 1) (length scope)) "/"))
      (grep-scope-normalize (substring scope 0 (- (length scope) 1)))
      scope)))

(defun grep-resolve-path (path)
  "Absolute paths pass through. Relative hit paths resolve against
the registered SCOPE (normalized) — UNLESS rg already emitted the
scope prefix (rg --json paths are cwd-relative and CARRY the scope:
joining again doubled it into sub/sub — valve r3's reproduced
finding; synthetic producer hits without the prefix still join)."
  (if (string-prefix-p "/" path)
    path
    (let ((scope (grep-scope-normalize (hashmap-get grep-meta "scope"))))
      (if (and (stringp scope) (> (length scope) 0)
               (not (string-prefix-p (concat scope "/") path)))
        (concat scope "/" path)
        path))))

(defun grep-land (line col)
  ;; Line beyond EOF → clamp to the LAST CONTENT line + a status
  ;; note; col beyond EOL → silent clamp.
  (let ((count (grep-last-content-line))
        (target line)
        (note ""))
    (if (> line count)
      (progn (setq target count) (setq note " (clamped to last line)")))
    (cursor-move (- target 1) 0)
    (let ((l (buffer-line (- target 1))))
      (if (and l (>= (length l) col))
        (cursor-move (- target 1) (- col 1))
        (cursor-move (- target 1) (max 0 (- (length l) 1)))))
    (editor-set-status (concat "grep: landed at "
      (number-to-string target) note))))

(defun grep-last-content-line ()
  ;; valve r2: the ACTUAL last line — buffer-line-count counts a
  ;; PHANTOM final row when the text ends with a newline; drop only
  ;; that one artifact, PRESERVING legitimate trailing blank lines.
  (let* ((count (buffer-line-count))
         (text (buffer-text))
         (drop (if (and (> count 1)
                        (> (length text) 0)
                        (string-suffix-p "\n" text))
                 1 0)))
    (max 1 (- count drop))))

(defun grep-next ()
  "n — next hit (wrap; count prefix = stride)."
  (grep-nav 1))

(defun grep-prev ()
  "p — previous hit (wrap)."
  (grep-nav -1))

(defun grep-nav (dir)
  (if (= (length grep-hits) 0)
    (editor-set-status "grep: no hits")
    (let* ((at (if grep-away-rendered nil (grep-hit-at-cursor)))
           ;; valve r4: after an away-render round-trip the cursor
           ;; resets to 0 (indistinguishable from hit 1) — the
           ;; recorded selection wins until the user interacts.
           (i (if at at grep-own-line))
           (stride (let ((c (count-get)))
                     (count-reset)
                     (if (and (numberp c) (> c 0)) c 1)))
           (n (length grep-hits))
           ;; Wrap arithmetic (floor-mod by additions — T-Lisp has no mod).
           (j (grep-wrap (+ i (* dir stride)) n)))
      (cursor-move j 0)
      (setq grep-own-line j)
      (setq grep-own-col 0)
      (setq grep-away-rendered nil)
      (editor-set-status
        (concat "grep: hit " (number-to-string (+ j 1)) " of "
          (number-to-string n))))))

(defun grep-wrap (i n)
  (if (< i 0) (grep-wrap (+ i n) n)
    (if (>= i n) (grep-wrap (- i n) n)
      i)))

(defun grep-rerun ()
  "g — call the registered rerun function."
  (let ((rerun (hashmap-get grep-meta "rerun")))
    (if (functionp rerun)
      (funcall rerun)
      (editor-set-status "grep: no rerun registered"))))

(defun grep-quit ()
  "q — kill the process AND the results buffer (the normative
kill-on-quit; gate r1: q used to leave rg running). The Editor's
buffer-kill already picks the recency-correct survivor (gate r1: an
explicit switch OVERRIDES it, and buffer-list is INSERTION order,
not recency); *scratch* only if the survivor is somehow still
*grep*. No windows are ever deleted."
  (grep-rg-kill-prior)
  (buffer-kill (grep-buffer-name))
  (if (string= (buffer-current) (grep-buffer-name))
    (buffer-switch "*scratch*"))
  (editor-set-status "grep: closed"))

;; ── the test producer (drives the interface; #307's own harness) ────
(defun grep-test-producer (script)
  "Drive the producer interface from a SCRIPT alist — the test
surface: ((op arg ...) ...) with ops register/append/complete/
rollback. Returns the LAST register's generation id (the dolist
form returns nil; callers poll the ids they need)."
  (setq grep-producer-last nil)
  (dolist (step script)
    (let ((op (nth 0 step)))
      (cond
        ((string= op "register")
          (setq grep-producer-last (grep-buffer-register (nth 1 step))))
        ((string= op "append")
          (grep-buffer-append-hit (nth 1 step) (nth 2 step)))
        ((string= op "complete")
          (grep-buffer-complete (nth 1 step) (nth 2 step) (nth 3 step)))
        ((string= op "rollback")
          (grep-buffer-rollback (nth 1 step))))))
  grep-producer-last)

;; ── mode + keymap registration ──────────────────────────────────────
(major-mode-register "grep" '() nil)
(major-mode-doc "grep" "grep results — RET opens the hit, n/p navigate (wrap), g re-runs, q closes")

(defun grep-ensure-keymap ()
  (let ((kmap (editor/keymaps/buffer-keymap (grep-buffer-name))))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "grep-results"))
        (editor/keymaps/keymap-set-key kmap "Enter" "(editor/commands/grep/grep-ret)")
        (editor/keymaps/keymap-set-key kmap "n" "(editor/commands/grep/grep-next)")
        (editor/keymaps/keymap-set-key kmap "p" "(editor/commands/grep/grep-prev)")
        (editor/keymaps/keymap-set-key kmap "g" "(editor/commands/grep/grep-rerun)")
        (editor/keymaps/keymap-set-key kmap "q" "(editor/commands/grep/grep-quit)")
        (editor/keymaps/buffer-set-keymap (grep-buffer-name) kmap))))
  t)

(defun grep-backend-get () grep-backend)
(defun grep-rg-dump ()
  (concat "gen=" (if (numberp grep-rg-gen) (number-to-string grep-rg-gen) "nil")
    " pid=" (if (numberp grep-rg-pid) (number-to-string grep-rg-pid) "nil")
    " partial=" (number-to-string (length grep-rg-partial))
    " malformed=" (number-to-string grep-rg-malformed)
    " exit=" (number-to-string grep-rg-last-exit)
    " fcalls=" (number-to-string grep-rg-filter-calls)
    " pendlen=" (number-to-string (length (grep-rg-pending-as-list)))
    " lastflag=" grep-rg-last-flag
    " lastline=" (substring grep-rg-last-line 0 40)
    " appends=" (number-to-string grep-rg-append-calls)))
(defun grep-backend-set! (v) (setq grep-backend v) v)
(defun grep-rg-rollback-after-register ()
  "A test hook: register then immediately rollback (the spawn-failure
shape without a real spawn)."
  (setq grep-rg-gen
    (grep-buffer-register
      (hashmap "backend" "rg" "pattern" "x" "scope" "."
        "rerun" (lambda () nil))))
  (grep-buffer-rollback grep-rg-gen))
(defun grep-rg-detected-set! (v)
  (setq grep-rg-detected v)
  ;; The detection DONE flag rides along: nil forces a fresh lookup,
  ;; t marks a cached (positive) result.
  (setq grep-rg-detection-done (if v t nil))
  v)
(defun grep-rg-executable-set! (v) (setq grep-rg-executable v) v)
(defun grep-rg-test-state! (gen pid stderr und malformed)
  "A test hook: set the sentinel/stash input state directly (module
defvars are not setq-able from outside — the module boundary)."
  (setq grep-rg-gen gen)
  (setq grep-rg-pid pid)
  (setq grep-rg-stderr stderr)
  (setq grep-rg-undecodable und)
  (setq grep-rg-malformed malformed)
  t)

(defvar grep-backend "auto"
  "The search backend: auto | rg | grep (#309).")
(defvar grep-rg-detected nil
  "The cached auto-detection result (t/nil; per session).")
(defvar grep-rg-detection-done nil
  "Whether detection has RUN (negative results cache too — valve r1:
  a missing rg re-looked-up on every call; per session by spec).")
(defvar grep-rg-executable "rg"
  "The rg binary (test seam: a vanished-executable spawn failure).")
(defvar grep-rg-gen nil "The RUNNING rg search's generation.")
(defvar grep-rg-pid nil "The running rg process id.")
(defvar grep-rg-partial "" "The trailing incomplete JSON line.")
(defvar grep-rg-stderr "" "The run's buffered stderr.")
(defvar grep-rg-undecodable 0 "The run's undecodable-path count.")
(defvar grep-rg-malformed 0 "The run's malformed-line count.")
(defvar grep-rg-last-exit -99 "The last sentinel exit (diagnostics).")
(defvar grep-rg-filter-calls 0 "Filter invocation count (diagnostics).")
(defvar grep-rg-pending nil "PID-ATTRIBUTED chunks from a not-yet-registered
pid — ((pid chunk) ...) in arrival order (the spawn→setq race; the
kill→register window). Replayed on registration; strangers drop.")
(defvar grep-rg-stderr-pending nil "PID-ATTRIBUTED stderr chunks from a
not-yet-registered pid (the same race, stderr side; valve r1 — they
used to be DROPPED).")
(defvar grep-rg-append-calls 0 "append-hit invocation count (diagnostics).")
(defvar grep-rg-last-flag "??" "The last handled flag (diagnostics).")
(defvar grep-rg-last-line "??" "The last handled line (diagnostics).")

(defun grep-backend-available-p ()
  ;; The matrix: auto → rg (cached); rg → explicit; grep → #309. A
  ;; non-string backend (nil) coalesces to auto — string= on nil
  ;; THROWS (the same hazard class grep-rg-handle hit; gate r1).
  (let ((b (if (stringp grep-backend) grep-backend "auto")))
    (cond
      ((string= b "rg")
        (if (exec-lookup grep-rg-executable) t
          (progn (editor-set-status
                   "grep: grep-backend is rg but rg is not on PATH") nil)))
      ((string= b "grep")
        (progn
          (editor-set-status "grep: grep backend pending (#309)") nil))
      (t
        ;; auto: detect (cached per session — positive AND negative)
        ;; then dispatch.
        (progn
          (if (null grep-rg-detection-done)
            (progn
              (setq grep-rg-detected (exec-lookup grep-rg-executable))
              (setq grep-rg-detection-done t)))
          (if grep-rg-detected t
            (progn
              (editor-set-status
                "grep: no search backend: rg missing (grep fallback pending #309)")
              nil)))))))

(defun grep-rg-kill-prior ()
  "Kill the prior rg process (re-runs, quits and new searches all
call this BEFORE the next spawn — the normative kill-first rule).
SIGTERM; the full name is required by the signal op."
  (if (numberp grep-rg-pid)
    (progn (signal grep-rg-pid "SIGTERM") (setq grep-rg-pid nil)))
  nil)

(defun grep-rg-pending-as-list ()
  "nil and the empty list are DISTINCT in T-Lisp — reverse/cons
throw on nil. Coalesce."
  (if (null grep-rg-pending) (list) grep-rg-pending))

(defun grep-rg-stderr-pending-as-list ()
  (if (null grep-rg-stderr-pending) (list) grep-rg-stderr-pending))

(defun grep-rg-replay-pending ()
  "Replay the stash: OUR pid's chunks (in arrival order) re-enter
the filter. STRANGER pids' chunks DROP — every spawn has a fresh
pid, so a killed predecessor's straggler can never belong to this
run (gate r1: the old un-attributed concat stash replayed strangers
as ours). The STDERR stash replays the same way (valve r1)."
  (if (numberp grep-rg-pid)
    (let ((ours "")
          (errs "")
          (pairs (reverse (grep-rg-pending-as-list)))
          (epairs (reverse (grep-rg-stderr-pending-as-list))))
      (dolist (pair pairs)
        (if (and (listp pair) (= (length pair) 2) (= (nth 0 pair) grep-rg-pid))
          (setq ours (concat ours (nth 1 pair)))))
      (dolist (pair epairs)
        (if (and (listp pair) (= (length pair) 2) (= (nth 0 pair) grep-rg-pid))
          (setq errs (concat errs (nth 1 pair)))))
      (setq grep-rg-pending nil)
      (setq grep-rg-stderr-pending nil)
      (if (> (length errs) 0)
        (setq grep-rg-stderr (concat grep-rg-stderr errs)))
      (if (> (length ours) 0)
        (grep-rg-filter grep-rg-pid ours))))
  nil)

(defun grep-rg-run (pattern scope)
  "The rg search: provisional registration, spawn, streaming."
  (if (not (grep-backend-available-p))
    nil
    (progn
      ;; 0. Kill the prior process FIRST (re-runs and new searches
      ;;    alike), and close the pid guard BEFORE the new register:
      ;;    an old chunk arriving in the register→spawn window now
      ;;    STASHES (pid-attributed) instead of landing in the new
      ;;    generation.
      (grep-rg-kill-prior)
      ;; 1. PROVISIONAL registration (callbacks guarded from here).
      (let ((gen (grep-buffer-register
                   (hashmap "backend" "rg" "pattern" pattern "scope" scope
                     "rerun" (lambda () (grep-rg-run pattern scope))))))
        (setq grep-rg-gen gen)
        ;; 2. FULL per-run state reset (the dump reflects the current
        ;;    run only — gate r1: the diagnostics counters used to
        ;;    accumulate across runs).
        (setq grep-rg-partial "")
        (setq grep-rg-pending nil)
        (setq grep-rg-stderr-pending nil)
        (setq grep-rg-stderr "")
        (setq grep-rg-undecodable 0)
        (setq grep-rg-malformed 0)
        (setq grep-rg-filter-calls 0)
        (setq grep-rg-append-calls 0)
        (setq grep-rg-last-exit -99)
        (setq grep-rg-last-flag "??")
        (setq grep-rg-last-line "??")
        ;; 3. The spawn (argv; -- terminates options — dash-prefixed
        ;;    patterns/dirs are structural). CONDITION-CASE: a
        ;;    vanished executable THROWS from the evaluator (a
        ;;    builtin's Either.left propagates as an error, never as
        ;;    a value) — without the catch the rollback below was
        ;;    dead code and the search stayed half-registered on
        ;;    'searching…' (gate r1's critical finding).
        (let ((pid (condition-case nil
                      (make-process
                        :command (list grep-rg-executable "--json" "--smart-case" "--"
                                       pattern scope)
                        :cwd "."
                        :filter "editor/commands/grep/grep-rg-filter"
                        :stderr-filter "editor/commands/grep/grep-rg-stderr-filter"
                        :sentinel "editor/commands/grep/grep-rg-sentinel")
                    (error (m) (concat "spawn error: " m)))))
          (cond
            ((numberp pid)
              (progn
                (setq grep-rg-pid pid)
                (grep-rg-replay-pending)))
            (t
              ;; 4. Spawn failure → ROLLBACK (the prior generation's
              ;;    content restored; nothing half-registered).
              (progn
                (setq grep-rg-gen nil)
                (grep-buffer-rollback gen)
                (editor-set-status
                  (concat "grep: rg spawn failed — "
                    (if (stringp pid) pid "unknown error")))))))))))

(defun grep-rg-stderr-filter (pid output)
  "Buffer the run's stderr (routed via make-process :stderr-filter —
exit ≥2 errors carry rg's actual message, not '(no stderr)'). Early
chunks (the spawn→setq race) stash PID-ATTRIBUTED and replay on
registration (valve r1: they used to drop)."
  (if (and (numberp grep-rg-pid) (= pid grep-rg-pid))
    (setq grep-rg-stderr (concat grep-rg-stderr output))
    (setq grep-rg-stderr-pending
      (cons (list pid output) (grep-rg-stderr-pending-as-list))))
  nil)

(defun grep-rg-run-files (pattern files scope)
  "The FILE-LIST variant of grep-rg-run (#311): the glob-filtered
files REPLACE the scope argument in the rg argv (-- still
terminates options). Zero-file callers are refused upstream (an
empty list would read stdin)."
  (if (= (length files) 0)
    (progn
      (editor-set-status "grep: no files match glob filters")
      nil)
    (progn
      (grep-rg-kill-prior)
      (let ((gen (grep-buffer-register
                   (hashmap "backend" "rg" "pattern" pattern "scope" scope
                     "rerun" (lambda () nil)))))
        (setq grep-rg-gen gen)
        (setq grep-rg-partial "")
        (setq grep-rg-pending nil)
        (setq grep-rg-stderr-pending nil)
        (setq grep-rg-stderr "")
        (setq grep-rg-undecodable 0)
        (setq grep-rg-malformed 0)
        (setq grep-rg-filter-calls 0)
        (setq grep-rg-append-calls 0)
        (setq grep-rg-last-exit -99)
        (setq grep-rg-last-flag "??")
        (setq grep-rg-last-line "??")
        (let ((pid (condition-case nil
                      (make-process
                        :command (append (list grep-rg-executable "--json" "--smart-case" "--" pattern) files)
                        :cwd "."
                        :filter "editor/commands/grep/grep-rg-filter"
                        :stderr-filter "editor/commands/grep/grep-rg-stderr-filter"
                        :sentinel "editor/commands/grep/grep-rg-sentinel")
                    (error (m) (concat "spawn error: " m)))))
          (cond
            ((numberp pid)
              (progn
                (setq grep-rg-pid pid)
                (grep-rg-replay-pending)))
            (t
              (progn
                (setq grep-rg-gen nil)
                (grep-buffer-rollback gen)
                (editor-set-status
                  (concat "grep: rg spawn failed — "
                    (if (stringp pid) pid "unknown error")))))))))))

(defun grep-rg-filter (pid output)
  (setq grep-rg-filter-calls (+ grep-rg-filter-calls 1))
  "Streaming: chunk→line buffering; complete lines through
rg-event->hit; flagged non-hits COUNTED (not appended). Chunks from
a not-yet-registered pid are STASHED PID-ATTRIBUTED (the spawn→setq
race: rg's first chunk can beat the setq of grep-rg-pid; replayed on
registration; strangers drop at replay)."
  (if (and (numberp grep-rg-gen)
           (numberp grep-rg-pid)
           (= pid grep-rg-pid))
    (progn
      (let* ((joined (concat grep-rg-partial output))
             (lines (string-split joined "\n"))
             (complete (grep-butlast lines))
             (rest (if (null lines) "" (car (reverse lines)))))
        (setq grep-rg-partial rest)
        (dolist (ln complete)
          (grep-rg-handle ln))))
    ;; An unregistered pid (the race) — stash PID-ATTRIBUTED for
    ;; replay (strangers drop at replay).
    (setq grep-rg-pending
      (cons (list pid output) (grep-rg-pending-as-list))))
  nil)

(defun grep-rg-handle (ln)
  (if (> (length ln) 0)
    (let* ((r (rg-event->hit ln))
           (hit (hashmap-get r "hit"))
           (flag (hashmap-get r "flag")))
      (let ((fl (if (stringp flag) flag "")))
        (setq grep-rg-last-line ln)
        (setq grep-rg-last-flag (if (stringp flag) flag "NOTASTRING"))
        (cond
        ((string= fl "undecodable-path")
          (setq grep-rg-undecodable (+ grep-rg-undecodable 1)))
        ((string= fl "malformed")
          (setq grep-rg-malformed (+ grep-rg-malformed 1)))
        ((string= fl "degraded-text")
          (progn
            (setq grep-rg-malformed (+ grep-rg-malformed 1))
            (grep-buffer-append-hit grep-rg-gen hit)))
        ((and hit (not (null hit)))
          (progn
            (setq grep-rg-append-calls (+ grep-rg-append-calls 1))
            (grep-buffer-append-hit grep-rg-gen hit)))
        (t nil))))))

(defun grep-chomp (s)
  "The COMPLETE stderr message, minus ONE trailing newline (valve
  r1: first-line-only was a deliberate truncation — a multi-line
  error lost its continuation lines)."
  (if (not (stringp s)) ""
    (if (and (> (length s) 1)
             (string= (substring s (- (length s) 1) (length s)) "\n"))
      (substring s 0 (- (length s) 1))
      s)))

(defun grep-rg-sentinel (pid exit-code)
  "The exit mapping (0 done / 1 no-matches / ≥2 error — 128+N means
signal-killed) + the diagnostics aggregation (on EVERY completion
status, gate r1: done/no-matches used to drop it)."
  (setq grep-rg-last-exit exit-code)
  (if (and (numberp grep-rg-gen)
           (= pid (or grep-rg-pid -1)))
    (progn
      ;; Flush any trailing partial line (rg newline-terminates its
      ;; JSON, but a vanished process may not).
      (if (> (length grep-rg-partial) 0)
        (grep-rg-handle grep-rg-partial))
      (setq grep-rg-partial "")
      (setq grep-rg-pid nil)
      (let ((diag
              (concat
                (if (> grep-rg-undecodable 0)
                  (concat " (" (number-to-string grep-rg-undecodable)
                    " undecodable paths") "")
                (if (> grep-rg-malformed 0)
                  (concat (if (> grep-rg-undecodable 0) ", " " (")
                    (number-to-string grep-rg-malformed)
                    " unparseable lines") "")
                (if (or (> grep-rg-undecodable 0) (> grep-rg-malformed 0))
                  ")" "")))
            (errtext (grep-chomp grep-rg-stderr)))
        (cond
          ((and (numberp exit-code) (= exit-code 0))
            (grep-buffer-complete grep-rg-gen "done"
              (if (> (length diag) 0) diag nil)))
          ((and (numberp exit-code) (= exit-code 1))
            (grep-buffer-complete grep-rg-gen "no-matches"
              (if (> (length diag) 0) diag nil)))
          ((> (length errtext) 0)
            ;; Diagnostics FOLLOW the stderr message on error.
            (grep-buffer-complete grep-rg-gen "error"
              (concat errtext diag)))
          (t
            (grep-buffer-complete grep-rg-gen "error"
              (concat "rg exited "
                (if (numberp exit-code) (number-to-string exit-code) "?")
                " (no stderr)" diag))))))))

(defun grep-butlast (lines)
  (reverse (cdr (reverse lines))))

(defun grep-search (pattern &optional (scope "."))
  "The search entry (SPC s s / M-x): run the backend. grep-rg-run
itself kills the prior process BEFORE spawning (the kill-first rule
covers new searches AND g-reruns through one choke point)."
  (interactive)
  (grep-rg-run pattern scope))

(provide "editor/commands/grep")
)
