(defmodule editor/modes/snippet
  (export snippet-mode global-snippet-mode)

;; snippet-mode.tlisp — YASnippet-style template expansion (#167, SPEC-101)
;; Tab-triggered expansion: type abbreviation + Tab → template with $1/$2/$0 placeholders.
(define-minor-mode "snippet" "Snippet expansion" "Snip")

(defun snippet-mode (&optional (arg nil arg-supplied-p))
  "Toggle snippet mode. No arg = toggle; t/positive = on; nil/0 = off."
  (if (not arg-supplied-p)
    (minor-mode-toggle "snippet")
    (if (equal arg t)
      (minor-mode-set "snippet" t)
      (if (numberp arg)
        (minor-mode-set "snippet" (> arg 0))
        (minor-mode-set "snippet" nil)))))

(defun global-snippet-mode (&optional (arg nil arg-supplied-p))
  "Toggle snippet mode globally."
  (if (not arg-supplied-p)
    (global-minor-mode-set "snippet" (not (global-minor-mode-active-p "snippet")))
    (if (equal arg t)
      (global-minor-mode-set "snippet" t)
      (if (numberp arg)
        (global-minor-mode-set "snippet" (> arg 0))
        (global-minor-mode-set "snippet" nil)))))

(provide "snippet-mode")
)
