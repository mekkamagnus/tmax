(defmodule editor/commands/capture
  (export capture-daily capture-commit capture-abort
          capture-entry capture-strip-skeleton capture-body
          capture-refocus-origin capture-focus-popup-pane
          capture-canonical)

;; capture.tlisp -- #278/#285: direct capture to today's daily note,
;; org-roam-dailies-capture-today parity (the user's most-used Emacs chord,
;; SPC r d), in the org-parity POPUP shape (verified against Emacs 30.1
;; org-capture + org-roam source; hardened through codex review):
;;
;;   - single window  -> split-window-below, compose in the lower pane (50/50,
;;     Emacs's exact ratio; Emacs ADAPTS direction by frame width -- tmax
;;     fixes ALWAYS bottom, the preferred shape)
;;   - split already exists -> move to the BOTTOM pane and compose there
;;     (the pane's buffer is restored afterwards, focus returns to the
;;     window the chord was pressed in)
;;   - skeleton in the buffer: header "capture -> <path>" + the seeded
;;     "- [ts] " prefix with the cursor after it (Emacs %? placement)
;;   - the TARGET PATH and the timestamp are stamped at OPEN (%U / codex
;;     r1: a capture left open across midnight files exactly where the
;;     header says) and reused at commit
;;   - a capture in progress is never discarded: SPC r d again focuses the
;;     open compose buffer instead of resetting it (codex r1)
;;   - commit STRIPS the skeleton (the exact "capture -> " header line is
;;     dropped; the untouched seeded prefix is removed -- bare-prefix and
;;     trim-eaten-space cases matched explicitly; an edited "- [" prefix
;;     passes through) -- the skeleton never reaches the file
;;   - C-c C-c / C-c C-k / C-g close the popup and restore buffer/mode/
;;     point/focus exactly
;;
;; Compose-then-commit contract (#277): buffer-local keymap front-end (the
;; fikra-chat #206 pattern; insert-mode chord routing landed with #278).

(defvar capture-return-buffer nil
  "Buffer name to restore after the capture ends.")
(defvar capture-return-mode "normal"
  "Editor mode to restore after the capture ends.")
(defvar capture-return-line 0)
(defvar capture-return-col 0)
(defvar capture-opened-ts nil
  "Timestamp stamped at open (Emacs %U: the entry keeps its open time).")
(defvar capture-target-path nil
  "Path stamped at OPEN — commit files exactly where the header says.")
(defvar capture-target-date nil
  "Date string for capture-target-path (feeds markdown-daily-note-init).")
(defvar capture-active-p nil
  "t while a compose buffer is open — SPC r d re-focuses instead of
discarding the draft.")
(defvar capture-popup-window nil
  "t when this capture created the popup window (it is closed on restore).")
(defvar capture-pane-restore nil
  "Buffer the reused bottom pane showed before *Capture* took it.")
(defvar capture-focus-window nil
  "Window index the chord was pressed in — focus returns there on restore.")
(defvar capture-recovery-buffer nil
  "Buffer the recovery pane showed before *Capture* was popped into it
(hidden-popup case) — restore switches it back instead of deleting the
user's pane (codex r5).")

(defun capture-timestamp ()
  "Current timestamp as YYYY-MM-DD HH:MM (org-log entry style)."
  (string-trim (shell-command "date '+%Y-%m-%d %H:%M'")))

(defun capture-today ()
  "Today as YYYY-MM-DD."
  (string-trim (shell-command "date +%Y-%m-%d")))

(defun capture-ensure-keymap ()
  "Attach the *Capture* buffer-local keymap (idempotent)."
  (let ((kmap (editor/keymaps/buffer-keymap "*Capture*")))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "capture"))
        (editor/keymaps/keymap-set-key kmap "C-c C-c" "(capture-commit)")
        (editor/keymaps/keymap-set-key kmap "C-c C-k" "(capture-abort)")
        (editor/keymaps/keymap-set-key kmap "C-g" "(capture-abort)")
        (editor/keymaps/buffer-set-keymap "*Capture*" kmap))))
  t)

(defun capture-goto-bottom-pane ()
  "Move focus to the bottom-most pane (windmove-down until it stops
moving). Returns the window index landed on."
  (let ((cur (window-current)))
    (while (progn
             (window-move-focus "down")
             (not (= (window-current) cur)))
      (set! cur (window-current)))
    (window-current)))

(defun capture-refocus (idx)
  "Cycle window-next until focus lands on window index IDX (bounded)."
  (let ((guard 0))
    (while (and (< guard 10) (not (= (window-current) idx)))
      (window-next)
      (set! guard (+ guard 1)))
    t))

(defun capture-popup-position ()
  "Position of the pane showing *Capture* in window-list order (nil when
gone). Found by BUFFER, not a saved index — window indices shift when
panes close or open (codex r3)."
  (let ((wins (window-list)) (pos nil) (i 0))
    (while (and (< i (length wins)) (not pos))
      (if (string= (nth 2 (nth i wins)) "*Capture*")
        (set! pos i)
        (set! i (+ i 1))))
    pos))

(defun capture-refocus-origin ()
  "Return focus to the ORIGIN pane — located by its BUFFER when unique
(window indices shift when the popup split inserts a pane; codex r6
side-by-side repro left focus on the neighbor). With DUPLICATE buffers on
several panes, the saved index wins when it still shows the origin buffer;
otherwise the first match."
  (let ((wins (window-list)))
    (if (and capture-focus-window
             (< capture-focus-window (length wins))
             (string= (nth 2 (nth capture-focus-window wins)) capture-return-buffer))
      (capture-refocus capture-focus-window)
      (let ((pos nil) (i 0))
        (while (and (< i (length wins)) (not pos))
          (if (string= (nth 2 (nth i wins)) capture-return-buffer)
            (set! pos i)
            (set! i (+ i 1))))
        (if pos
          (capture-refocus pos)
          (if capture-focus-window
            (capture-refocus capture-focus-window)))
        t))))

(defun capture-focus-popup-pane ()
  "Put focus on the pane showing *Capture* (wherever it is, however the
layout changed). When NO pane shows it (the user switched the popup pane
elsewhere), pop it back up in the CURRENT pane — the draft lives in the
buffer and must never be read from an unrelated pane (codex r4). Returns
t when the compose buffer is current afterwards."
  (let ((pos (capture-popup-position)))
    (if pos
      (capture-refocus pos)
      (progn
        (set! capture-recovery-buffer (buffer-current))
        (switch-to-buffer "*Capture*")
        t))))

(defun capture-count-capture-panes ()
  "How many panes currently display *Capture* (a user split can duplicate)."
  (let ((wins (window-list)) (n 0) (i 0))
    (while (< i (length wins))
      (if (string= (nth 2 (nth i wins)) "*Capture*")
        (set! n (+ n 1)))
      (set! i (+ i 1)))
    n))

(defun capture-restore ()
  "Close the popup (or revert the reused pane + refocus the origin
window), kill *Capture*, and restore the recorded context. Acts on the
POPUP pane — focus may have moved elsewhere since the chord (codex r2)."
  ;; Hidden-popup recovery (codex r5): the pane *Capture* was popped into
  ;; gets its own buffer back — it may or may not have been the original
  ;; popup pane (the user hid the compose by switching ITS pane away), so
  ;; window deletion below targets the pane that is NOT the origin.
  (if capture-recovery-buffer
    (progn
      (switch-to-buffer capture-recovery-buffer)
      (set! capture-recovery-buffer nil)))
  ;; The user may have SPLIT the compose pane — close every pane showing
  ;; *Capture* beyond the first (codex r4 duplicate-pane linger).
  (while (and (> (window-count) 1)
              (> (capture-count-capture-panes) 1)
              (capture-popup-position))
    (capture-focus-popup-pane)
    (delete-window))
  (if capture-popup-window
    ;; We created the popup: close THE POPUP PANE (located by buffer —
    ;; never the origin, never the neighbor), then focus the origin.
    (progn
      (if (and (> (window-count) 1) (capture-popup-position))
        (progn
          (capture-focus-popup-pane)
          (delete-window)))
      (capture-refocus-origin))
    ;; Reuse case: locate the compose pane FIRST (an abort issued from
    ;; another pane previously rewrote THAT pane), restore its buffer, then
    ;; focus the origin.
    (progn
      (capture-focus-popup-pane)
      (if capture-pane-restore
        (switch-to-buffer capture-pane-restore))
      (capture-refocus-origin)))
  (set! capture-popup-window nil)
  (set! capture-pane-restore nil)
  (set! capture-active-p nil)
  ;; Kill the compose buffer. buffer-kill REBINDS the current pane to a
  ;; recency survivor even when the killed buffer is not displayed there
  ;; (codex r6 trace: the *RIGHT* pane was hijacked to "test") — snapshot
  ;; the intended buffer and force it back afterwards.
  (let ((intended (buffer-current)))
    (condition-case err
      (buffer-kill "*Capture*")
      (error (e) nil))
    (if (not (string= (buffer-current) intended))
      (switch-to-buffer intended)))
  ;; Popup-path safety net: the origin buffer must be current.
  (if (and (not (string= capture-return-buffer "*Capture*"))
           (not (string= (buffer-current) capture-return-buffer))
           (= (window-count) 1))
    (switch-to-buffer capture-return-buffer))
  (if (not (string= capture-return-buffer "*Capture*"))
    (cursor-move capture-return-line capture-return-col))
  (editor-set-mode capture-return-mode))

(defvar capture-header-prefix "capture -> "
  "The seeded header prefix — named so no substring magic number drifts
(a miscounted 10 shipped for one round: the header was filed).")

(defun capture-strip-skeleton (text)
  "Drop the seeded header line from compose TEXT — the EXACT seeded line
(capture-header-prefix + the open-stamped capture-target-path). An edited
header or a user line merely starting with the prefix is NOT eaten (codex
r1/r2: only the seed is sacrificial)."
  (let ((lines (string-split text "\n"))
        (seeded-line (concat capture-header-prefix capture-target-path)))
    (if (and (> (length lines) 0)
             (string= (nth 0 lines) seeded-line))
      (string-join "\n" (cdr lines))
      text)))

(defun capture-body (stripped)
  "STRIPPED compose text minus the UNTOUCHED seeded prefix; empty when
nothing was typed past the skeleton (the trailing space is eaten by trim,
so the bare-prefix case is matched explicitly)."
  (let ((seeded (concat "- [" capture-opened-ts "] ")))
    (cond
      ((string= stripped "") "")
      ((string= stripped (string-trim seeded)) "")
      ((and (>= (length stripped) (length seeded))
            (string= (substring stripped 0 (length seeded)) seeded))
       (string-trim (substring stripped (length seeded))))
      (t stripped))))

(defun capture-prefix-p (body)
  "t when BODY's first line carries a TIMESTAMP prefix (- [YYYY-MM-DD
HH:MM]) — an edited seed. A Markdown task (- [ ] x) does NOT match, so it
is ordinary text and keeps the open-time prefix (codex r3)."
  (if (or (< (length body) 3) (not (string= (substring body 0 3) "- [")))
    nil
    (let ((probe (substring body 3 (min (length body) 23))))
      (not (string= probe
        (replace-regexp-in-string
          "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]\\]"
          "" probe))))))

(defun capture-entry (body)
  "Turn compose BODY into the filed entry: a body whose first line carries
a TIMESTAMP prefix keeps it (edited seed); anything else — including a
Markdown task — gets the OPEN-time prefix prepended."
  (if (capture-prefix-p body)
    body
    (concat "- [" capture-opened-ts "] " body)))

(defun capture-open ()
  "Open the popup compose flow (assumes no capture is active)."
  (set! capture-return-buffer (buffer-current))
  (set! capture-return-mode (editor-mode))
  (set! capture-return-line (cursor-line))
  (set! capture-return-col (cursor-column))
  (set! capture-focus-window (window-current))
  ;; ONE clock reading (codex r2): the date is derived from the timestamp,
  ;; so ts and target can never straddle midnight differently.
  (set! capture-opened-ts (capture-timestamp))
  (set! capture-target-date (substring capture-opened-ts 0 10))
  (set! capture-target-path (markdown-journal-path capture-target-date))
  ;; Fresh compose buffer (no capture active means no draft to lose).
  (condition-case err
    (buffer-kill "*Capture*")
    (error (e) nil))
  ;; Popup geometry: only a single-window layout grows the 50/50 bottom
  ;; split; an existing layout composes in its BOTTOM pane, whose buffer
  ;; is restored afterwards.
  ;; Popup geometry: the compose pane must be a LOWER pane (mockup). When
  ;; the layout already has one below us, reuse it (its buffer is restored
  ;; afterwards); when it does not — single window OR side-by-side column
  ;; bottoms (codex r4) — split the current pane and take the new lower half.
  (let ((before (window-current)))
    (capture-goto-bottom-pane)
    (if (= (window-current) before)
      (progn
        (split-window-below)
        (window-move-focus "down")
        (set! capture-popup-window t))
      (progn
        (set! capture-popup-window nil)
        (set! capture-pane-restore (buffer-current)))))
  (buffer-create "*Capture*")
  (switch-to-buffer "*Capture*")
  ;; Skeleton: the header names the exact commit target; the seeded prefix
  ;; carries the open-time timestamp, cursor right after it (%? placement).
  (buffer-insert (concat "capture -> " capture-target-path
                         "\n- [" capture-opened-ts "] "))
  (editor-set-mode "insert")
  (capture-ensure-keymap)
  (set! capture-recovery-buffer nil)
  (set! capture-active-p t)
  (editor-set-status "Capture to daily - C-c C-c file | C-c C-k or C-g abort"))

(defun capture-daily ()
  "Capture directly to today's journal note (SPC r d): popup split, compose
in *Capture* with the skeleton seeded, C-c C-c files the entry under
markdown-journal-path, C-c C-k / C-g abort. Prior context is restored
either way. An in-progress capture is re-focused, never discarded."
  (interactive)
  (require-module editor/commands/markdown/knowledge)
  (if capture-active-p
    (progn
      ;; Focus the EXISTING popup pane (codex r2: switching the current
      ;; pane's buffer made abort delete the user's pane).
      (capture-focus-popup-pane)
      (editor-set-status "Capture in progress - finish (C-c C-c) or abort (C-c C-k) it first"))
    (capture-open)))

(defun capture-ends-with (s suffix)
  "t when S ends with SUFFIX."
  (and (>= (length s) (length suffix))
       (string= (substring s (- (length s) (length suffix))) suffix)))

(defun capture-journal-buffer-p (name)
  "t when buffer NAME is the target note, in ANY path form — the capture
target may be relative (daily/x.md) while the buffer was opened via an
absolute or tilde path (codex r6: exact-name matching missed it and a
stale buffer's save destroyed the entry)."
  (or (string= name capture-target-path)
      (capture-ends-with name (concat "/" capture-target-path))))

(defun capture-canonical (path)
  "Canonical identity of PATH via the file-realpath PRIMITIVE (codex r9:
shelling out to realpath kept breaking on quoting — spaces, then
apostrophes — each time as silent entry loss). Falls back to the raw path
when resolution fails, so comparison degrades consistently on both sides."
  (let ((rp (file-realpath path)))
    (if (> (length rp) 0)
      rp
      path)))

(defun capture-sync-open-buffer (entry-text)
  "Keep EVERY already-open alias of the daily note consistent with the
appended file: any of their next :w must not overwrite the entry (codex
r5/r7). Candidates are suffix matches (relative/absolute/tilde forms) and
are CONFIRMED by canonical realpath, so an unrelated journal with the same
daily/<date>.md suffix is never touched."
  ;; EVERY buffer is checked by canonical identity — no name prefilter
  ;; (codex r8: an alias whose buffer NAME differs from the target path was
  ;; missed by the suffix filter; realpath comparison is the whole rule)
  (let ((cur (buffer-current))
        (bufs (buffer-list))
        (canonical-target (capture-canonical capture-target-path))
        (i 0) (synced nil))
    (when (> (length canonical-target) 0)
      (while (< i (length bufs))
        (switch-to-buffer (nth i bufs))
        (let ((fname (buffer-filename)))
          ;; nested ifs, not (and ...) — T-Lisp `and` does not short-circuit,
          ;; so capture-canonical would receive nil on file-less buffers
          (if fname
            (if (string= (capture-canonical fname) canonical-target)
              ;; Preserve the buffer's cursor: appending must not yank the
              ;; user's point to the end (codex r10 polish).
              (let ((pl (cursor-line)) (pc (cursor-column)))
                (cursor-move (- (buffer-line-count) 1) 100000)
                (buffer-insert entry-text)
                (cursor-move pl pc)
                (set! synced t)))))
        (set! i (+ i 1))))
    (switch-to-buffer cur)
    synced))

(defun capture-commit ()
  "File the *Capture* text to the note named in the skeleton header (the
target stamped at OPEN) and restore context. The skeleton (header +
seeded prefix) is stripped; an edited prefix passes through; an absent one
is re-added from the open-time timestamp. Empty compose text is a
no-write abort."
  (interactive)
  ;; Read the DRAFT, whatever pane has focus (codex r3: a commit issued
  ;; from another pane previously filed that pane's buffer instead).
  (capture-focus-popup-pane)
  (let* ((text (string-trim (buffer-text)))
         (stripped (string-trim (capture-strip-skeleton text)))
         (seeded (concat "- [" capture-opened-ts "] "))
         ;; untouched = the exact seeded prefix (or its bare form when the
         ;; trailing space was eaten by trim) and nothing else was typed
         (untouched (or (string= stripped (string-trim seeded))
                        (and (>= (length stripped) (length seeded))
                             (string= (substring stripped 0 (length seeded)) seeded))))
         ;; An UNTOUCHED seed was removed — the remainder is typed text and
         ;; keeps the open-time prefix even when ts-shaped (codex r4); an
         ;; ABSENT-but-present prefix means the seed was EDITED and passes
         ;; through verbatim (capture-prefix-p).
         (body (if untouched
                 (string-trim (substring stripped (length seeded)))
                 stripped))
         (entry (cond
                  (untouched (concat seeded body))
                  ((capture-prefix-p stripped) stripped)
                  (t (concat "- [" capture-opened-ts "] " stripped)))))
    (if (> (length body) 0)
      (progn
        (if (not (file-exists-p capture-target-path))
          (markdown-daily-note-init capture-target-path capture-target-date))
        (append-file capture-target-path (concat "\n" entry "\n"))
        (capture-sync-open-buffer (concat "\n" entry "\n"))
        (message "Captured to %s" capture-target-path))
      (message "Capture empty - aborted")))
  (capture-restore))

(defun capture-abort ()
  "Discard the capture and restore context."
  (interactive)
  (capture-restore)
  (editor-set-status "Capture aborted"))

(key-bind "SPC r d" "(capture-daily)" "normal")

(provide "editor/commands/capture")
)
