(defmodule fikra/thought
  (export fikra-thought-feed fikra-thought-flush
          fikra-thought-complete-suppressed-p
          fikra-thought-watermark fikra-thought-reset
          fikra-thought-toggle-list fikra-thought-toggle-at)

;; #320 — THINKING DELTAS into THOUGHT EVENTS (the "considering…"
;; moments). The CLI streams extended-thinking as
;; content_block_delta/thinking_delta partials keyed by the CONTENT
;; BLOCK INDEX (which spans ALL block types — text blocks consume
;; indices we never observe); the normalizer maps each to a
;; thought-delta event carrying (block RAW-INDEX) + (text FRAGMENT).
;; THIS module owns delivery at RENUMBERED block granularity:
;;   raw == last-raw  → the OPEN block continues (fragments append);
;;   raw >  last-raw  → the NEXT sequential block (flush the old, open
;;                      fresh — the stream is ORDERED per block, its
;;                      contract; raw jumps are NORMAL interleaving
;;                      (text/tool blocks consume indices we never
;;                      observe), never reordering — holds and gap
;;                      timeouts were speculative dead weight over an
;;                      ordered stream, and they ATE interleaved
;;                      thinking (codex r2 c1));
;;   raw <  last-raw  → a redelivery of a SEEN block — dropped.
;; MESSAGE-FINAL events (tool-call, tool-result, a complete thought,
;; turn boundaries) reset the thinking context — content indices
;; restart per assistant message (codex r2 c2: a tool round starts a
;; fresh message mid-turn).
;;
;; The cumulative text is tracked PRIVATELY for the collapse threshold
;; (the pure helpers live in fikra/event); crossed fragments each ride
;; with a thought-collapse MARKER (a rebuild trigger: the collapsed
;; form's changing line-count is edit-based rendering).

(require-module fikra/event)

(defvar fikra-thought-state (hashmap)
  "id → state hashmap: watermark (sequential block id), last-raw (the
last raw content index), text (the open block's cumulative), closed
(the gap-closed sequential id), streamed (raw indices whose deltas
streamed — completed blocks must not duplicate).")

(defun fikra-thought-reset (id)
  "Reset a thread's delivery state (turn start — the CLI's indices
restart per message — / tests)."
  (editor/keymaps/keymap-mutable-set! fikra-thought-state id
    (hashmap "watermark" -1 "last-raw" -1 "text" ""
              "closed" -1 "streamed" (list)))
  t)

(defun fikra-thought-state-of (id)
  (let ((s (hashmap-get fikra-thought-state id)))
    (if (not s) (fikra-thought-reset id)))
  (hashmap-get fikra-thought-state id))

(defun fikra-thought-watermark (id)
  (hashmap-get (fikra-thought-state-of id) "watermark"))

(defun fikra-thought-complete-suppressed-p (id raw)
  "t when the thread already STREAMED raw block RAW — the completed
thinking block would duplicate its deltas."
  (let ((hit nil))
    (dolist (r (hashmap-get (fikra-thought-state-of id) "streamed"))
      (if (= r raw) (setq hit t)))
    hit))

;; ── the feed: events in → ordered events out ─────────────────────
(defun fikra-thought-feed (id events)
  "Route a normalized batch: non-thought events pass through AND close
the open block (the flush marker rides before them); thought-deltas
are order-checked. Returns the emit list."
  (fikra-thought-scan id events (list)))

(defun fikra-thought-scan (id events out)
  (if (null events)
    (reverse out)
    (let ((k (fikra/event/fikra-event-get-str (car events) "kind")))
      (cond
        ((string= k "thought-delta")
          (fikra-thought-scan id (cdr events)
            (fikra-thought-accept id (car events) out)))
        ;; A COMPLETED thought: drop in-order when its block streamed
        ;; (codex r2 c3 — same-chunk delta+complete), else pass; either
        ;; way the message boundary resets the context (c2).
        ((string= k "thought")
          (let ((raw (fikra/event/fikra-event-get-str (car events) "block")))
            (fikra-thought-scan id (cdr events)
              (fikra-thought-reset-context id
                (if (and raw (fikra-thought-complete-suppressed-p id (string-to-number raw)))
                  out
                  (cons (car events) (fikra-thought-flush id out)))))))
        ;; Other MESSAGE-FINAL kinds (tool rounds end an assistant
        ;; message) reset the context after passing.
        ((or (string= k "tool-call") (string= k "tool-result") (string= k "turn-start"))
          (fikra-thought-scan id (cdr events)
            (fikra-thought-reset-context id
              (cons (car events) (fikra-thought-flush id out)))))
        (t
          (fikra-thought-scan id (cdr events)
            (cons (car events) (fikra-thought-flush id out))))))))

(defun fikra-thought-accept (id e out)
  (let* ((raw (string-to-number (fikra/event/fikra-event-get-str e "block")))
         (st (fikra-thought-state-of id))
         (wm (hashmap-get st "watermark"))
         (last-raw (hashmap-get st "last-raw"))
         (fresh (> raw last-raw))
         (blk (if fresh (+ wm 1) wm))
         (frag (fikra/event/fikra-event-get-str e "text")))
    (cond
      ((< raw last-raw) out)
      ((= raw (hashmap-get st "closed")) out)
      (t
        (let* ((base (if fresh "" (hashmap-get st "text")))
               (txt (concat base frag))
               (was-crossed (if fresh nil (hashmap-get st "crossed")))
               (crossed (fikra/event/fikra-thought-collapsed-p txt))
               (pre (if fresh (fikra-thought-flush id out) out)))
          (editor/keymaps/keymap-mutable-set! st "watermark" blk)
          (editor/keymaps/keymap-mutable-set! st "last-raw" raw)
          (editor/keymaps/keymap-mutable-set! st "text" txt)
          (editor/keymaps/keymap-mutable-set! st "crossed"
            (if (or crossed was-crossed) t nil))
          (if fresh
            (editor/keymaps/keymap-mutable-set! st "streamed"
              (cons raw (hashmap-get st "streamed"))))
          (let ((ev (list (list "kind" "thought-delta")
                          (list "block" (fikra/event/fikra-event-get-str e "block"))
                          (list "text" frag))))
            (if (or crossed was-crossed)
              (cons (list (list "kind" "thought-collapse")) (cons ev pre))
              (cons ev pre))))))))

;; A MESSAGE boundary resets the thinking context (indices restart
;; per assistant message; streamed-suppression is per-message too).
(defun fikra-thought-reset-context (id out)
  (let ((st (fikra-thought-state-of id)))
    (editor/keymaps/keymap-mutable-set! st "watermark" -1)
    (editor/keymaps/keymap-mutable-set! st "last-raw" -1)
    (editor/keymaps/keymap-mutable-set! st "text" "")
    (editor/keymaps/keymap-mutable-set! st "closed" -1)
    (editor/keymaps/keymap-mutable-set! st "streamed" (list)))
  out)

;; Block close: if this block EVER crossed, the marker rides once more
;; (the final rebuild replaces the live raw growth with the collapsed
;; line).
(defun fikra-thought-flush (id out)
  (let ((st (fikra-thought-state-of id)))
    (if (hashmap-get st "crossed")
      (progn
        (editor/keymaps/keymap-mutable-set! st "crossed" nil)
        (cons (list (list "kind" "thought-collapse")) out))
      out)))

;; After a contiguous accept, release the hold when its raw index is
;; now the next expected — repeat until it no longer matches. The
;; released entry is REMOVED (a stale duplicate wedged the watermark).
;; The 2s timeout: polled by the #319 tick per RUNNING thread. A stale
;; hold closes: the status event rides through the normal emit path,
;; the hold drops, and the closed sequential id rejects late fills.
;; ── TAB toggle state (display-only; the render helpers live in
;; fikra/event) ────────────────────────────────────────────────────
(defun fikra-thought-toggle-list ()
  (fikra/event/fikra-thought-toggles))

(defun fikra-thought-toggle-at (key)
  (fikra/event/fikra-thought-toggle-at key))

(provide "fikra-thought"))
