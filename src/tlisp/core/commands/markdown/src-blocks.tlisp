(defmodule editor/commands/markdown/src-blocks
  (export markdown-src-block-at-point
          markdown-src-block-content
          markdown-src-mode-for-language
          markdown-src-lang-ext
          markdown-src-edit-active-p
          markdown-edit-src
          markdown-edit-src-commit
          markdown-edit-src-abort)

;; src-blocks.tlisp — RFC-037 (#335): the editing half of org-babel parity.
;; C-c ' / SPC e inside a fenced code block opens the block's content in a
;; *Src-Edit:<lang>* buffer with the language's major mode (full syntax
;; highlighting, indentation, electric chars). C-c C-c writes the edit
;; buffer's text back between the fences; C-c C-k / C-g discard. The
;; markdown buffer is only touched at commit — fences are never modified.
;;
;; Compose-then-commit contract (#277): the buffer-local keymap front-end
;; (the *Capture* pattern; the normal-mode keymap chain resolves the C-c
;; chords — no default C-c bindings exist to conflict).

;; ── Piece 2: language → major mode (RFC §2.3, normative) ─────────────
;; A hashmap (not an alist): T-Lisp cons requires a list tail, so dotted
;; pairs are not expressible; hashmap-get also makes the unmapped case a
;; plain nil. Extensible from init.tlisp: (hashmap-set! ...) style mutation
;; via hashmap-set on this defvar.
(defvar markdown-src-mode-map
  (hashmap
    "javascript" "typescript"
    "js" "typescript"
    "typescript" "typescript"
    "ts" "typescript"
    "python" "python"
    "py" "python"
    "lisp" "lisp"
    "tlisp" "lisp"
    "scheme" "lisp"
    "shell" "shell"
    "bash" "shell"
    "sh" "shell"
    "zsh" "shell"
    "go" "go"
    "rust" "rust"
    "json" "json"
    "yaml" "yaml"
    "toml" "toml"
    "html" "html"
    "css" "css"
    "sql" "sql"
    "c" "c"
    "cpp" "cpp"))

(defun markdown-src-mode-for-language (lang)
  "Major mode name for fence language LANG; fundamental when unmapped (RFC-037 §2.3)."
  (let ((mode (hashmap-get markdown-src-mode-map lang)))
    (if mode mode "fundamental")))

;; Extension per language — the edit buffer's synthetic filename uses this
;; so the syntax highlighter (which keys on filename extension) detects the
;; language and produces spans. Same hashmap construction as the mode map.
(defvar markdown-src-ext-map
  (hashmap
    "javascript" "ts"
    "js" "ts"
    "typescript" "ts"
    "ts" "ts"
    "python" "py"
    "py" "py"
    "lisp" "lisp"
    "tlisp" "lisp"
    "scheme" "lisp"
    "shell" "sh"
    "bash" "sh"
    "sh" "sh"
    "zsh" "sh"
    "go" "go"
    "rust" "rs"
    "json" "json"
    "yaml" "yaml"
    "toml" "toml"
    "html" "html"
    "css" "css"
    "sql" "sql"
    "c" "c"
    "cpp" "cpp"))

(defun markdown-src-lang-ext (lang)
  "File extension for fence language LANG (for the highlighter's filename detection)."
  (let ((ext (hashmap-get markdown-src-ext-map lang)))
    (if ext ext "txt")))

;; ── Piece 1: block detection (RFC §2.1) ───────────────────────────────

(defun markdown-src-fence-p (line)
  "t when LINE is a fence line (triple backtick after optional indentation)."
  (let ((trimmed (string-trim line)))
    (if (>= (length trimmed) 3)
      (string= (substring trimmed 0 3) "```")
      nil)))

(defun markdown-src-fence-len (line)
  "Length of LINE's backtick run (0 when LINE is not a fence). #335 audit: a ```` outer fence containing ``` inner lines must pair with its OWN length — shorter inner fences are content."
  (let ((trimmed (string-trim line)))
    (if (markdown-src-fence-p trimmed)
      (let ((i 0) (n (length trimmed)))
        (while (if (< i n) (string= (substring trimmed i (+ i 1)) "`") nil)
          (set! i (+ i 1)))
        i)
      0)))

(defun markdown-src-fence-language (line)
  "The language token of fence LINE (first word of the info string; \"\" when bare)."
  (let* ((trimmed (string-trim line))
         (len (markdown-src-fence-len trimmed))
         (info (if (> len 0) (string-trim (substring trimmed len)) "")))
    (if (= (length info) 0)
      ""
      (nth 0 (string-split info " ")))))

(defun markdown-src-block-at-point ()
  "The fenced block at point as a hashmap (start end fence-len language content-start content-end), or nil (RFC-037 §2.1)."
  (interactive)
  (let ((total (buffer-line-count))
        (cur (cursor-line))
        (fences (list))
        (i 0))
    (while (< i total)
      (if (markdown-src-fence-p (buffer-get-line i))
        (set! fences (cons (list i (markdown-src-fence-len (buffer-get-line i))) fences)))
      (set! i (+ i 1)))
    (set! fences (reverse fences))
    ;; Pair each opener with the NEXT fence of the SAME backtick length that
    ;; has NO info string (#335 audit: a ``` line inside a ```` block is
    ;; content; CommonMark: a fence carrying an info string can only OPEN).
    ;; An opener with no same-length bare closer is unclosed: everything
    ;; below it belongs to that unclosed block, so pairing stops (nil).
    (let ((result nil) (j 0) (n (length fences)))
      (while (and (< j n) (not result))
        (let ((open-line (nth 0 (nth j fences)))
              (open-len (nth 1 (nth j fences)))
              (close nil)
              (k (+ j 1)))
          (while (if (< k n) (not close) nil)
            (if (= (nth 1 (nth k fences)) open-len)
              (if (= (length (markdown-src-fence-language (buffer-get-line (nth 0 (nth k fences))))) 0)
                (set! close (nth 0 (nth k fences)))
                (set! k (+ k 1)))
              (set! k (+ k 1))))
          (if close
            (if (if (>= cur open-line) (<= cur close) nil)
              (set! result (hashmap
                             "start" open-line
                             "end" close
                             "fence-len" open-len
                             "language" (markdown-src-fence-language (buffer-get-line open-line))
                             "content-start" (+ open-line 1)
                             "content-end" (- close 1)))
              (set! j (+ k 1)))
            (set! j n))))
      result)))

(defun markdown-src-block-content (block)
  "BLOCK's content lines joined by newlines (no trailing newline)."
  (let ((lines (list))
        (i (hashmap-get block "content-start"))
        (end (hashmap-get block "content-end")))
    (while (<= i end)
      (set! lines (cons (buffer-get-line i) lines))
      (set! i (+ i 1)))
    (string-join "\n" (reverse lines))))

;; ── Piece 3: the edit command (RFC §2.2) ──────────────────────────────

(defvar markdown-src-edit-target nil
  "Buffer name of the markdown buffer being edited (nil = no pending edit).")
(defvar markdown-src-edit-buffer nil
  "Name of the live *Src-Edit:* buffer.")
(defvar markdown-src-edit-start 0
  "Opening fence line of the block under edit.")
(defvar markdown-src-edit-fence-text ""
  "The opening fence line's exact text at OPEN (#335 audit): commits validate/relocate the block by this identity when the buffer changed.")
(defvar markdown-src-edit-buffer-lines 0
  "The target buffer's line count at OPEN (#335 audit r5): ANY insertion or deletion changes it, so for ambiguous twins a preserved count is the precondition for claiming continuity — a shifted twin always arrives with a changed count.")
(defvar markdown-src-edit-pre-line ""
  "The line immediately ABOVE the opening fence at OPEN (#335 audit r4): with ambiguous twins, positional continuity alone is spoofable by a deletion that shifts the twin onto the recorded line — the neighborhood must match too.")
(defvar markdown-src-edit-pre-exists nil
  "t when the block had a line above it at open (start > 0).")
(defvar markdown-src-edit-post-line ""
  "The line immediately BELOW the closing fence at OPEN (#335 audit r4).")
(defvar markdown-src-edit-post-exists nil
  "t when the block had a line below it at open (end < line count - 1).")
(defvar markdown-src-edit-ambiguous-at-open nil
  "t when OTHER byte-identical blocks existed at OPEN (#335 audit r3): identity was never unique, so once positional continuity is lost the commit must ABORT rather than guess among twins.")
(defvar markdown-src-edit-abort-reason ""
  "Why the last locate returned nil: "gone" (no candidate) or "ambiguous" (identity not establishable).")
(defvar markdown-src-edit-content-full ""
  "The ORIGINAL block content at OPEN (#335 audit r2): a relocation candidate's content must EQUAL it — first-line/line-count anchors are spoofable by twin blocks and coincidental edits; full equality is the strongest position-free identity available (fully-identical twins remain indistinguishable in principle and resolve to the nearest candidate).")
(defvar markdown-src-edit-content-start 0)
(defvar markdown-src-edit-content-end 0)
(defvar markdown-src-edit-return-mode "normal"
  "Editor mode to restore after the edit ends.")

(defun markdown-src-edit-active-p ()
  "t while a *Src-Edit:* buffer is pending."
  (if markdown-src-edit-target t nil))

(defun markdown-edit-src-ensure-keymap (bufname)
  "Attach the edit buffer's local keymap: C-c C-c commits, C-c C-k / C-g abort."
  (let ((kmap (editor/keymaps/buffer-keymap bufname)))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "src-edit"))
        (editor/keymaps/keymap-set-key kmap "C-c C-c" "(markdown-edit-src-commit)")
        (editor/keymaps/keymap-set-key kmap "C-c C-k" "(markdown-edit-src-abort)")
        (editor/keymaps/keymap-set-key kmap "C-g" "(markdown-edit-src-abort)")
        (editor/keymaps/buffer-set-keymap bufname kmap))))
  t)

(defun markdown-edit-src-abort-pending ()
  "Abort a pending src edit, echoing its content to *Messages* for recovery (RFC §2.5). No-op when nothing is pending."
  (if markdown-src-edit-target
    (let ((bufname markdown-src-edit-buffer)
          (origin (buffer-current)))
      (if bufname
        (condition-case err
          (progn
            (switch-to-buffer bufname)
            (message "Abandoned src edit (%s) content for recovery: %s"
                     markdown-src-edit-target (buffer-text)))
          (error (e) nil)))
      (set! markdown-src-edit-target nil)
      (set! markdown-src-edit-buffer nil)
      (if (not (string= (buffer-current) origin))
        (switch-to-buffer origin))
      (if bufname
        (condition-case err (buffer-kill bufname) (error (e) nil)))
      (editor-set-status "abandoned pending src edit (content echoed to *Messages*)")
      t)
    nil))

(defun markdown-edit-src ()
  "Open the fenced block at point in a *Src-Edit:<lang>* buffer with the language's major mode (RFC-037)."
  (interactive)
  (let ((block (markdown-src-block-at-point)))
    (if (not block)
      (editor-set-status "not in a source block")
      (progn
        ;; Piece 5 — multi-block guard: one edit at a time; the pending
        ;; edit is aborted (content echoed) before the new one opens.
        (markdown-edit-src-abort-pending)
        (let* ((lang (hashmap-get block "language"))
               (label (if (> (length lang) 0) lang "text"))
               (bufname (concat "*Src-Edit:" label "*"))
               (mode (markdown-src-mode-for-language lang))
               (content (markdown-src-block-content block)))
          (set! markdown-src-edit-target (buffer-current))
          (set! markdown-src-edit-start (hashmap-get block "start"))
          (set! markdown-src-edit-fence-text (buffer-get-line (hashmap-get block "start")))
          (set! markdown-src-edit-content-full content)
          (set! markdown-src-edit-buffer-lines (buffer-line-count))
          ;; #335 audit r4: neighborhood anchors (only consulted for
          ;; ambiguous twins — see locate).
          (set! markdown-src-edit-pre-exists (> (hashmap-get block "start") 0))
          (set! markdown-src-edit-pre-line
                (if markdown-src-edit-pre-exists
                  (buffer-get-line (- (hashmap-get block "start") 1)) ""))
          (set! markdown-src-edit-post-exists
                (< (hashmap-get block "end") (- (buffer-line-count) 1)))
          (set! markdown-src-edit-post-line
                (if markdown-src-edit-post-exists
                  (buffer-get-line (+ (hashmap-get block "end") 1)) ""))
          ;; #335 audit r3: identity uniqueness is a property of the buffer
          ;; AT OPEN — twins recorded now make a later lost-continuity
          ;; resolution an abort, never a guess.
          (set! markdown-src-edit-ambiguous-at-open
                (> (length (markdown-edit-src-candidates)) 1))
          (set! markdown-src-edit-content-start (hashmap-get block "content-start"))
          (set! markdown-src-edit-content-end (hashmap-get block "content-end"))
          (set! markdown-src-edit-return-mode (editor-mode))
          (set! markdown-src-edit-buffer bufname)
          (condition-case err (buffer-kill bufname) (error (e) nil))
          (buffer-create bufname)
          (switch-to-buffer bufname)
          ;; Set a filename so the syntax highlighter detects the language
          ;; (highlight-buffer keys on the filename's extension, not the
          ;; major mode — without this the edit buffer gets no spans).
          (set-buffer-filename (concat "*src-edit*." (markdown-src-lang-ext lang)))
          (cursor-move 0 0)
          (buffer-insert content)
          (cursor-move 0 0)
          (major-mode-set mode)
          (editor-set-mode "normal")
          (markdown-edit-src-ensure-keymap bufname)
          (editor-set-status (concat label " src block - C-c C-c write back | C-c C-k abort")))))))

;; ── Piece 4: write-back and abort (RFC §2.4) ──────────────────────────

(defun markdown-edit-src-candidates ()
  "All blocks in the current buffer matching the recorded identity — fence text, bare same-length closer, FULL content equality — as (start end) pairs."
  (let ((total (buffer-line-count)) (out (list)) (i 0))
    (while (< i total)
      (if (string= (buffer-get-line i) markdown-src-edit-fence-text)
        (let ((flen (markdown-src-fence-len markdown-src-edit-fence-text))
              (k (+ i 1))
              (close nil))
          (while (if (< k total) (not close) nil)
            (if (= (markdown-src-fence-len (buffer-get-line k)) flen)
              (if (= (length (markdown-src-fence-language (buffer-get-line k))) 0)
                (set! close k)
                (set! k (+ k 1)))
              (set! k (+ k 1))))
          (if close
            (if (markdown-edit-src-content-matches-p (+ i 1) (- close 1))
              (set! out (cons (list i close) out))))))
      (set! i (+ i 1)))
    (reverse out)))

(defun markdown-edit-src-anchors-match-p (cand-start cand-end)
  "t when continuity is established for an AMBIGUOUS block (#335 audit r4/r5): the buffer's TOTAL line count is unchanged since open (any insertion or deletion — including every shift that could move a twin onto the recorded line — changes it) AND the neighborhood lines above/below the block are unchanged."
  (let ((count-ok (= (buffer-line-count) markdown-src-edit-buffer-lines))
        (pre-ok (if markdown-src-edit-pre-exists
                  (if (> cand-start 0)
                    (string= (buffer-get-line (- cand-start 1)) markdown-src-edit-pre-line)
                    nil)
                  (= cand-start 0)))
        (post-ok (if markdown-src-edit-post-exists
                   (if (< cand-end (- (buffer-line-count) 1))
                     (string= (buffer-get-line (+ cand-end 1)) markdown-src-edit-post-line)
                     nil)
                   (= cand-end (- (buffer-line-count) 1)))))
    (if count-ok (if pre-ok post-ok nil) nil)))

(defun markdown-edit-src-locate ()
  "Resolve the pending block's identity (#335 audit r3) — NEVER a proximity guess: (1) the candidate AT the recorded start line wins (positional continuity); (2) otherwise the unique candidate, and ONLY when identity was unique at open (no byte-identical twins existed); (3) otherwise nil with the reason in markdown-src-edit-abort-reason (gone | ambiguous) — the commit aborts with recovery."
  (let ((cands (markdown-edit-src-candidates))
        (start markdown-src-edit-start))
    (set! markdown-src-edit-abort-reason "")
    (let ((exact nil) (others (list)) (j 0) (chosen nil))
      (while (< j (length cands))
        (if (= (nth 0 (nth j cands)) start)
          (set! exact (nth j cands))
          (set! others (cons (nth j cands) others)))
        (set! j (+ j 1)))
      ;; #335 audit r6 — THE CONSERVATIVE RULE the audit prescribed: for
      ;; ambiguous-at-open blocks (byte-identical twins existed), identity
      ;; can NEVER be established without buffer-edit markers — position,
      ;; neighborhood, and line-count evidence are all constructible by
      ;; compensating edits. Such edits therefore NEVER commit: the edit
      ;; aborts with recovery. Unique-at-open blocks are safe: full-content
      ;; equality identifies the block buffer-wide (exact position or the
      ;; unique candidate).
      (set! markdown-src-edit-abort-reason
            (if markdown-src-edit-ambiguous-at-open "ambiguous" ""))
      (set! chosen
            (if markdown-src-edit-ambiguous-at-open
              nil
              (if exact
                exact
                (if (= (length others) 1) (nth 0 others) nil))))
      (if chosen
        (set! markdown-src-edit-abort-reason ""))
      (if chosen
        (hashmap
          "start" (nth 0 chosen)
          "end" (nth 1 chosen)
          "fence-len" (markdown-src-fence-len markdown-src-edit-fence-text)
          "language" (markdown-src-fence-language markdown-src-edit-fence-text)
          "content-start" (+ (nth 0 chosen) 1)
          "content-end" (- (nth 1 chosen) 1))
        (progn
          ;; Keep an already-established reason (the conservative
          ;; ambiguous-at-open abort) — only fall back when unset.
          (if (= (length markdown-src-edit-abort-reason) 0)
            (set! markdown-src-edit-abort-reason
                  (if (> (length cands) 0) "ambiguous" "gone")))
          nil)))))

(defun markdown-edit-src-content-matches-p (cstart cend)
  "t when the block content at [CSTART..CEND] EQUALS the recorded open-time content (#335 audit r2/r3). Full equality: a twin block with any differing line is rejected; a pairing that ran past a removed closing fence swallows intervening prose and is rejected; a directly-edited target block is rejected (the edit recovers via *Messages*)."
  (string= (markdown-edit-src-join-lines cstart cend) markdown-src-edit-content-full))

(defun markdown-edit-src-join-lines (cstart cend)
  "Lines [CSTART..CEND] joined by newlines, no trailing newline ("" for an empty range)."
  (let ((lines (list)) (i cstart))
    (while (<= i cend)
      (set! lines (cons (buffer-get-line i) lines))
      (set! i (+ i 1)))
    (string-join "\n" (reverse lines))))

(defun markdown-edit-src-commit ()
  "Write the edit buffer's text back between the block's fences, kill the edit buffer, and return to the fence line (RFC-037 §2.4). The block is re-located by its recorded fence text first (#335 audit): edits that shifted or removed the block can never write to stale line numbers."
  (interactive)
  (if (not markdown-src-edit-target)
    (editor-set-status "no source edit in progress")
    (let ((text nil)
          (target markdown-src-edit-target)
          (start markdown-src-edit-start)
          (bufname markdown-src-edit-buffer)
          (return-mode markdown-src-edit-return-mode))
      ;; Read the EDIT buffer's text BEFORE switching (the corruption fix):
      ;; buffer-text reads the CURRENT buffer — if the user already switched
      ;; back to the markdown buffer, the original buffer-text here would
      ;; capture the whole document and insert it into the block.
      (if (string= (buffer-current) bufname)
        (set! text (buffer-text))
        (progn
          (switch-to-buffer bufname)
          (set! text (buffer-text))
          (switch-to-buffer target)))
      ;; Neutralize the pending state first: the edit buffer is about to be
      ;; read and killed; a re-entry mid-commit must see no pending edit.
      (set! markdown-src-edit-target nil)
      (set! markdown-src-edit-buffer nil)
      (switch-to-buffer target)
      ;; Stale-line guard (#335 audit): re-locate the block by fence text.
      (let ((block (markdown-edit-src-locate)))
        (if (not block)
          (progn
            ;; Block gone: no write, no corruption — recover via *Messages*.
            (condition-case err (buffer-kill bufname) (error (e) nil))
            (editor-set-mode return-mode)
            (cursor-move (min start (- (buffer-line-count) 1)) 0)
            (message "src block %s — edit aborted, content for recovery: %s"
                     (if (> (length markdown-src-edit-abort-reason) 0) markdown-src-edit-abort-reason "gone") text)
            (editor-set-status (concat "src block "
                                       (if (> (length markdown-src-edit-abort-reason) 0) markdown-src-edit-abort-reason "gone")
                                       " — edit aborted (content echoed to *Messages*)")))
          (let ((cstart (hashmap-get block "content-start"))
                (cend (hashmap-get block "content-end"))
                (new-start (hashmap-get block "start")))
            ;; Replace [cstart..cend] with the edit text. Deleting up to
            ;; (cend+1, 0) removes the content lines AND their newlines,
            ;; leaving the closing fence as the new line cstart; the insert
            ;; re-adds the text plus its trailing newline. Empty text inserts
            ;; just "\n" — one blank line between the fences (RFC §2.4).
            (if (>= cend cstart)
              (buffer-delete-range cstart 0 (+ cend 1) 0))
            (cursor-move cstart 0)
            (buffer-insert (concat text "\n"))
            (cursor-move new-start 0)
            (condition-case err (buffer-kill bufname) (error (e) nil))
            (editor-set-mode return-mode)
            (message "src block updated")))))))

(defun markdown-edit-src-abort ()
  "Discard the source edit; the markdown buffer is untouched (RFC-037 §2.4)."
  (interactive)
  (if (not markdown-src-edit-target)
    (editor-set-status "no source edit in progress")
    (let ((target markdown-src-edit-target)
          (start markdown-src-edit-start)
          (bufname markdown-src-edit-buffer)
          (return-mode markdown-src-edit-return-mode))
      (set! markdown-src-edit-target nil)
      (set! markdown-src-edit-buffer nil)
      (switch-to-buffer target)
      (cursor-move start 0)
      (condition-case err (buffer-kill bufname) (error (e) nil))
      (editor-set-mode return-mode)
      (editor-set-status "src edit aborted"))))

(key-bind "SPC e" "(markdown-edit-src)" "normal")
(key-bind "C-c '" "(markdown-edit-src)" "normal")

(provide "markdown-commands/src-blocks")
)
