(defmodule fikra/backend-ollama
  (export fikra-backend-ollama-available-p fikra-backend-ollama-capabilities
          fikra-backend-ollama-start-turn fikra-backend-ollama-abort
          fikra-backend-ollama-model-get fikra-backend-ollama-http-filter
          fikra-backend-ollama-complete
          fikra-backend-ollama-seed fikra-ollama-history-messages
          fikra-ollama-messages-get fikra-ollama-tools-json
          fikra-backend-ollama-set-model fikra-backend-ollama-set-url
          fikra-backend-ollama-pending-p fikra-backend-ollama-decide
          fikra-ollama-parked-rest-get fikra-ollama-latest-id-get
          fikra-ollama-bash-filter fikra-ollama-bash-sentinel
          fikra-ollama-path-contained-p fikra-ollama-revert-latest-action
          fikra-ollama-action-posts-get fikra-ollama-record-action-pair
          fikra-ollama-last-action-stash-get)

;; RFC-029 §8.1's RAW-API NATIVE LOOP (r108): a fikra-owned chat turn —
;; no CLI wrapper. The adapter hands the user's message here; this module
;; drives the turn lifecycle ITSELF: turn-begin → the ASYNC /api/chat
;; request (the hex-transport http primitive; the ownership dispatcher in
;; ghost.tlisp routes the completion back here) → the reply renders as an
;; assistant text-delta → turn-end. The MODEL resolves from /api/tags at
;; first use (the first installed model; setq-free override via the
;; thread-independent defvar default is NOT possible cross-module — the
;; model-name getter exposes it, and the modeline reads it).
;;
;; Scope (r108): a pure chat turn — no tools, no mediation (the model is
;; the loop's ONLY actor; the permission gate has nothing to gate). The
;; tool-using native loop (§8.1's ⚙ rows driven by the model) is the named
;; next step.

(require-module fikra/event)
(require-module fikra/thread)
(require-module fikra/adapter)

;; The ownership registry may not exist yet (ghost.tlisp registers it at
;; ITS load; a session using only this backend never loads ghost).
;; Re-registering would RESET the map — guard on absence.
(if (not (editor/keymaps/keymap-named "fikra-http-owners"))
  (editor/keymaps/keymap-register "fikra-http-owners" (hashmap)))

(defvar fikra-ollama-url "http://localhost:11434"
  "The local ollama server (module-internal; the same default the ghost
completion source uses).")
(defvar fikra-ollama-model nil
  "The chat model. nil = resolve from /api/tags at first use.")
(defvar fikra-ollama-bodies (hashmap)
  "request-id → the accumulated response body (hex-decoded chunks).")
(defvar fikra-ollama-threads (hashmap)
  "request-id → the THREAD the turn belongs to (a late reply must land
on its own thread, never whatever is focused at land time).")
(defvar fikra-ollama-messages ""
  "The turn's accumulated messages-array body (history + user, then each
tool round's assistant tool_call + tool results — the loop's working
context; rebuilt per turn).")
(defvar fikra-ollama-round-text ""
  "r137: the round's accompanying text (scope bridge into the results
let).")
(defvar fikra-ollama-tool-exchanges (hashmap)
  "r137-r139 (codex): the tool exchanges keyed THREAD/TURN/ROUND — each
completed round's tool_calls fragment + its results (the accompanying
text is NOT re-embedded: it rides text-deltas — re-embedding it
duplicated the narration). Thread-scoped so same-numbered turns in
different threads never share fragments.")
(defvar fikra-ollama-parked-thread nil
  "The thread the parked call BELONGS to (r117: the decision resolves
against the originating thread's working dir — a focus switch must not
redirect the execution).")
(defvar fikra-ollama-parked-call nil
  "The tool_call PARKED at the L2 gate awaiting the user's a/r/A (the
destructive-bash mediation; the loop resumes on the decision).")
(defvar fikra-ollama-parked-rest nil
  "The calls AFTER the parked one in its reply (r120, codex r119 P2: a
decision resumes the remainder — they were dropped).")
(defvar fikra-ollama-parked-acc ""
  "The results ALREADY collected when the park hit (r121, codex r120
P2#2: 'echo BEFOREPARK' before a parked pair was dropped — the acc must
ride too).")
(defvar fikra-ollama-epoch 0
  "r131 (codex r130 P1#3): the turn GENERATION. Bumped at every
start-turn and abort — an async bash sentinel whose spawn-time epoch
differs is SUPERSEDED: no result row, no resume, no re-fire (the turn
it belonged to is gone).")
(defvar fikra-ollama-last-parked-calls nil
  "r139b: the parked call + its remainder (the exchange's TRUE assistant
message — the reject/approve-with-empty-rest path records from here).")
(defvar fikra-ollama-action-pairs (hashmap)
  "r142 (codex 9-item): post-ref → pre-ref per action (recorded when
both captures run back-to-back). The action-level revert restores an
action's touched paths from ITS pre-ref — the turn baseline is not the
pre-state when earlier actions changed the tree.")
(defvar fikra-ollama-last-action-stash nil
  "r142b: the last action revert's stash patch (the action's own
pre-to-post change — git-apply restores it).")
(defvar fikra-ollama-action-posts (list)
  "r142: the action post-refs newest-first (the revert target picker).")
(defvar fikra-ollama-turn-home nil
  "r131b (codex r131 catch): the thread that OWNS the running turn —
stamped at start-turn. Async spawns stamp their HOME from THIS (the
approval path executes while another thread may be focused; stamping
the focused thread misrouted the sentinel's resume).")
(defvar fikra-ollama-async-procs (hashmap)
  "r131 (codex r130 P1#1): pid → {epoch home out cont} — the async
bash's OWNERSHIP record, stamped at spawn: the turn generation, the
ORIGINATING thread (the sentinel renders + resumes under that focus
no matter what is focused at exit), the accumulated stdout (the
filter appends per-pid — concurrent children never share output), and
the round continuation (calls i acc) when the spawn holds a round.
Entries tombstone (nil) when their sentinel fires.")
(defvar fikra-ollama-round 0
  "The current tool round (the loop cap guard).")
(defvar fikra-ollama-max-rounds 4
  "Tool rounds before the loop stops honestly (an endless tool loop must
not spin forever).")
(defvar fikra-ollama-latest-id nil
  "The LATEST fired request (r110: a replacement turn's pending must not
adopt the REPLACED request's reply — only the latest may land).")

(defun fikra-backend-ollama-available-p ()
  "t when the local ollama answers /api/tags (a sync curl probe — the
availability gate must be synchronous; the turn itself is async)."
  (string-match "\"models\""
    (shell-command
      (concat "curl -s --max-time 2 " fikra-ollama-url "/api/tags 2>/dev/null"))))

(defun fikra-backend-ollama-capabilities ()
  ;; Honest: NON-streaming (stream:false — one landed reply), no
  ;; permissions surface (a pure chat model; nothing to mediate).
  (list (list "session-resume" nil)
        (list "interactive-approvals" nil)
        (list "streaming" nil)))

;; Drop ONE trailing comma (the accumulator appends separators; the
;; array close must not follow a comma — ollama 400s ',]').
(defun fikra-ollama-chomp (s)
  (if (and (> (length s) 0) (string= (substring s (- (length s) 1) (length s)) ","))
    (substring s 0 (- (length s) 1))
    s))

;; Test accessor for the message accumulator (defvars unreadable
;; cross-module).
(defun fikra-ollama-messages-get ()
  fikra-ollama-messages)

;; Test seam: pin the URL (the async sentinel re-fires REAL requests —
;; fixtures point at a dead port so seeded replies are the only
;; completions; the pending-guard discards the refused ones).
(defun fikra-backend-ollama-set-url (u)
  (setq fikra-ollama-url u))

;; Admin: pin the chat model (the auto-resolution takes the FIRST
;; installed model, which may lack tool support — the live script pins
;; a tools-capable one).
(defun fikra-backend-ollama-set-model (name)
  (setq fikra-ollama-model name))

;; Test accessor: the latest fired request id (the async sentinel's
;; re-fire creates a NEW id — tests intercept it).
(defun fikra-ollama-latest-id-get ()
  (if fikra-ollama-latest-id (number-to-string fikra-ollama-latest-id) "null"))

(defun fikra-ollama-parked-rest-get ()
  fikra-ollama-parked-rest)

(defun fikra-backend-ollama-model-get ()
  "The resolved chat model (the modeline's backend segment reads it)."
  fikra-ollama-model)

;; ── the turn ─────────────────────────────────────────────────────────
(defun fikra-backend-ollama-start-turn (message)
  "Drive one RAW-API chat turn: turn-begin, fire the ASYNC /api/chat,
  return 'pending (the completion callback renders the reply and ends
  the turn). Model unknown → the tags request resolves it and its
  completion re-fires the chat for the still-pending message."
  (setq fikra-ollama-pending-message message)
  (setq fikra-ollama-round 0)
  ;; r131: a new turn supersedes the previous one's in-flight async
  ;; children. r137 (codex re-grade): replacement also KILLS them — a
  ;; superseded command used to keep changing files with its evidence
  ;; suppressed (epoch-drop hid the result row; the mutations ran on).
  (setq fikra-ollama-epoch (+ fikra-ollama-epoch 1))
  (fikra-ollama-kill-children)
  ;; r131b: the turn's OWNING thread (the async spawn home truth).
  (setq fikra-ollama-turn-home (fikra/thread/fikra-thread-current))
  ;; r131c (codex r131b catch): a NEW turn orphans any pending park —
  ;; a later approval must not execute the OLD call under THIS turn's
  ;; epoch/home.
  (setq fikra-ollama-parked-call nil)
  (setq fikra-ollama-parked-rest nil)
  (setq fikra-ollama-parked-acc "")
  (setq fikra-ollama-parked-thread nil)
  (fikra/thread/fikra-thread-turn-begin)
  ;; The model resolves SYNCHRONOUSLY (a light curl, like the probe) —
  ;; no tags round-trip through the async machinery.
  (if (not fikra-ollama-model)
    (fikra-ollama-resolve-model))
  (if fikra-ollama-model
    (progn
      ;; The accumulator starts as history + the user message (once per
      ;; turn; tool rounds append to it).
      (setq fikra-ollama-messages
        (concat (fikra-ollama-history-messages)
                "{\"role\":\"user\",\"content\":" (fikra-ollama-json-string message) "},"))
      (fikra-ollama-chat message))
    (progn
      (fikra/thread/fikra-thread-turn-end "error")
      (editor-set-status "Fikra-ollama: no model installed")))
  'pending)

(defvar fikra-ollama-pending-message nil
  "The message awaiting its reply (the land-time guard).")

(defun fikra-ollama-chat (message)
  ;; The messages payload: system + the ACCUMULATOR (the history built
  ;; once at the first fire, then each tool round appends its exchange —
  ;; r112: tool rounds must ride the NEXT request or the model forgets
  ;; its own tool use) + TOOLS (the model-driven loop).
  ;; r135e (codex r135d catch): the model name ESCAPES (a quote in a
  ;; configured name broke the request body).
  (let* ((body (concat "{\"model\":" (fikra-ollama-json-string fikra-ollama-model)
                       ",\"stream\":false,\"messages\":["
                       "{\"role\":\"system\",\"content\":\"You are a concise coding assistant inside the tmax editor. Reply briefly. Use the provided tools when they help.\"},"
                       (fikra-ollama-chomp fikra-ollama-messages)
                       "],\"tools\":["
                       (fikra-ollama-tools-json)
                       "],\"options\":{\"num_ctx\":4096}}")))
    ;; Content-Type matters: bun's fetch defaults a string body to
    ;; text/plain — ollama 400s it (r108 live catch; curl -d worked).
    (let ((id (http-request (concat fikra-ollama-url "/api/chat")
                            :method "POST"
                            :body body
                            :headers (list (list "Content-Type" "application/json"))
                            :filter "fikra/backend-ollama/fikra-backend-ollama-http-filter")))
      ;; r109 (codex r108 P1#1): ownership stamps AT FIRE — a connection
      ;; failure never delivers a body chunk, so filter-time stamping let
      ;; the completion drop unowned and the turn hung running.
      (editor/keymaps/keymap-mutable-set!
        (editor/keymaps/keymap-named "fikra-http-owners")
        (number-to-string id) "fikra/backend-ollama/fikra-backend-ollama-complete")
      ;; The turn's THREAD identity (r109 P1#2): a late reply must land
      ;; on ITS thread even if focus moved.
      (editor/keymaps/keymap-mutable-set! fikra-ollama-threads
        (number-to-string id) (fikra/thread/fikra-thread-current))
      (setq fikra-ollama-latest-id id)
      id)))

;; The thread's prior turns as messages-array entries (the event memory
;; in order; the memory is newest-first — reverse for array order). The
;; in-flight user message is NOT yet in memory (the caller emits it), so
;; the history ends just before it.
;; ── the tools (the model-driven loop, r112) ─────────────────────────
;; Two tools, hand-built JSON (the schema layer): bash {command} and
;; buffer_edit {path, content}. The loop is L1-honest (no mediation —
;; the L2 gate integration is the named follow-up).
(defun fikra-ollama-tools-json ()
  (concat "{\"type\":\"function\",\"function\":{"
          "\"name\":\"bash\",\"description\":\"Run a shell command in the project directory and return its output.\","
          "\"parameters\":{\"type\":\"object\",\"properties\":{"
          "\"command\":{\"type\":\"string\",\"description\":\"The command to run\"}},"
          "\"required\":[\"command\"]}}},"
          "{\"type\":\"function\",\"function\":{"
          "\"name\":\"buffer_edit\",\"description\":\"Write the full new content of a file (relative path).\","
          "\"parameters\":{\"type\":\"object\",\"properties\":{"
          "\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}},"
          "\"required\":[\"path\",\"content\"]}}},"
          "{\"type\":\"function\",\"function\":{"
          "\"name\":\"buffer_read\",\"description\":\"Read a file's content (relative path) from the project directory.\","
          "\"parameters\":{\"type\":\"object\",\"properties\":{"
          "\"path\":{\"type\":\"string\"}},"
          "\"required\":[\"path\"]}}}"))

;; One tool ROUND: append the assistant tool_call message (the model's
;; own record), execute each call, append the tool results, RE-FIRE. The
;; arguments ride as a JSON STRING inside the reply's JSON — re-embed
;; verbatim (the accumulated messages keep the model's exact shape).
(defun fikra-ollama-tool-round (msg tool-calls)
  (setq fikra-ollama-round (+ fikra-ollama-round 1))
  ;; r135 (codex r130 P2): the model's text BESIDE its tool calls is
  ;; kept — rendered before the ⚙ rows and carried in the reconstructed
  ;; assistant message (it used to be discarded: content hardcoded "").
  (let ((text (let ((c (fikra-ollama-alist-get "content" msg)))
                (if (and c (stringp c) (> (length c) 0)) c ""))))
    (setq fikra-ollama-round-text text)
    (if (> (length text) 0)
      (fikra/event/fikra-event-emit
        (list (list "kind" "text-delta")
              (list "speaker" "assistant")
              (list "text" text))))
    (setq fikra-ollama-messages
      (concat fikra-ollama-messages
              "{\"role\":\"assistant\",\"content\":" (fikra-ollama-json-string text)
              ",\"tool_calls\":["
              (fikra-ollama-calls-json tool-calls 0 "")
              "]},")))
  (let ((results (fikra-ollama-run-calls tool-calls 0 "")))
    (if (and (symbolp results) (or (string= (symbol-name results) "parked")
                                   (string= (symbol-name results) "async")))
      nil
      (progn
        (setq fikra-ollama-messages
          (concat fikra-ollama-messages results))
        ;; r137+r138: the completed exchange persists IN ITS TURN's slot.
        (fikra-ollama-remember-exchange
          (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                  (fikra-ollama-calls-json tool-calls 0 "")
                  "]}," results))
        (if (>= fikra-ollama-round fikra-ollama-max-rounds)
          (progn
            (setq fikra-ollama-pending-message nil)
            (fikra/event/fikra-event-emit
              (list (list "kind" "text-delta")
                    (list "speaker" "assistant")
                    (list "text" "(tool round cap reached — stopping the loop)")))
            (fikra/thread/fikra-thread-turn-end "completed"))
          (fikra-ollama-chat fikra-ollama-pending-message))))))

;; The tool_calls array re-embedded as JSON (the raw arguments string
;; must survive verbatim — re-parsing loses its exact shape).
(defun fikra-ollama-calls-json (calls i acc)
  (if (>= i (length calls))
    acc
    (let* ((call (nth i calls))
           (fn (fikra-ollama-alist-get "function" call))
           (name (if fn (fikra-ollama-alist-get "name" fn) "?"))
           (args (if fn (fikra-ollama-alist-get "arguments" fn) "{}")))
      (fikra-ollama-calls-json calls (+ i 1)
        (concat acc (if (> i 0) ",")
                ;; r135d (codex r135c catch): the NAME escapes too (a
                ;; quote in a model-supplied tool name broke the array).
                "{\"function\":{\"name\":" (fikra-ollama-json-string (if name name "?"))
                ;; json-encode handles BOTH shapes (the reply's arguments
                ;; arrive as a string OR a parsed object — raw concat
                ;; stringified objects to "[object Object]", r113 live).
                ;; r135e (codex r135d catch): an EMPTY parsed object
                ;; re-embeds as {} — json-encode renders empty lists as
                ;; [] (object-ness is lost in the alist round-trip).
                ",\"arguments\":" (condition-case nil
                                    (if (and (listp args) (= (length args) 0))
                                      "{}"
                                      (json-encode args))
                                    (error () "{}"))
                "}}")))))

;; r117 (codex r116 P1#2): a PARKED call STOPS the round — later calls
;; in the same reply must not run while the first waits at the gate (the
;; adversarial rm -rf + touch sequence executed the touch).
(defun fikra-ollama-run-calls (calls i acc)
  ;; The empty-rest base returns "" — never nil (concat with nil throws
  ;; and the SENTINEL swallows it: the turn stuck 'running' live).
  (if (>= i (length calls))
    (if acc acc "")
    (let ((res (fikra-ollama-run-tool (nth i calls))))
      (cond
        ((numberp res)
          ;; r126: an async bash holds the round — the sentinel resumes
          ;; from i+1 (the tool message lands at exit). r127 (codex
          ;; catch 2): the ACC rides too (a buffer_read BEFORE the bash
          ;; vanished from the model's messages). r131: the continuation
          ;; rides the pid's OWNERSHIP entry (run-bash-now returns the
          ;; pid now) — no shared stash for concurrent children.
          (progn
            (keymap-mutable-set!
              (hashmap-get fikra-ollama-async-procs (number-to-string res))
              "cont" (list calls (+ i 1) acc))
            'async))
        ((and (symbolp res) (string= (symbol-name res) "parked"))
          ;; r120: the REMAINDER rides the park — the decision resumes
          ;; them (they were dropped). r121: the ACC rides too (results
          ;; before the park were discarded — 'echo BEFOREPARK' vanished).
          (progn
            (setq fikra-ollama-parked-acc acc)
            (setq fikra-ollama-parked-rest
              (condition-case nil
                (fikra-ollama-calls-rest calls (+ i 1))
                (error () nil)))
            'parked))
        (t
          (fikra-ollama-run-calls calls (+ i 1)
            (concat acc res)))))))

;; r120 catch: `cons` requires a proper list tail — (cons x nil) THROWS
;; in this dialect. Accumulate with append instead.
(defun fikra-ollama-calls-rest (calls i)
  (if (>= i (length calls))
    (list)
    (append (list (nth i calls))
            (fikra-ollama-calls-rest calls (+ i 1)))))

;; One tool_call: execute, emit the ⚙ row + the result row, return the
;; tool-result MESSAGE json fragment.
(defun fikra-ollama-run-tool (call)
  (let* ((fname (fikra-ollama-alist-get "name"
                 (fikra-ollama-alist-get "function" call)))
         (args-raw (fikra-ollama-alist-get "arguments"
                     (fikra-ollama-alist-get "function" call)))
         ;; r114 (codex r113 P1): arguments arrive as EITHER shape — a
         ;; JSON STRING (parse) or an already-parsed ALIST (the live
         ;; qwen3 object case; the string-only parse yielded empty
         ;; arguments and the tool executed NOTHING).
         (args (if (listp args-raw)
                 (if (and args-raw (> (length args-raw) 0)) args-raw ())
                 (condition-case nil (json-read-from-string (if args-raw args-raw "{}")) (error () ())))))
    (if (string= fname "bash")
      (fikra-ollama-run-bash call args)
      (if (string= fname "buffer_edit")
        (fikra-ollama-run-edit call args)
        (if (string= fname "buffer_read")
          (fikra-ollama-run-read call args)
          (fikra-ollama-tool-skip call fname))))))

;; r120 (codex r119 P2): the model can READ — the loop's blind spot.
(defun fikra-ollama-run-read (call args)
  (let* ((path (if (fikra-ollama-alist-get "path" args)
                 (fikra-ollama-alist-get "path" args) ""))
         (dir (fikra/thread/fikra-thread-working-dir))
         (abs (concat dir "/" path))
         ;; r133: reads are CONTAINED too — a symlink hop must not leak
         ;; outside files into the model's context.
         (contained (fikra-ollama-path-contained-p dir path))
         (content (if contained
                    (condition-case nil (read-file-content abs) (error () nil))
                    nil)))
    (fikra/event/fikra-event-emit
      (list (list "kind" "tool-call") (list "tool" "buffer-read")
            (list "summary" path)))
    (if (and contained (stringp content))
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" t)
                (list "summary" (concat path ": " (number-to-string (length content)) " chars"))))
        (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string content) "},"))
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" nil)
                (list "summary" (concat (if contained "not found: " "REFUSED (outside the working dir): ") path))))
        (concat "{\"role\":\"tool\",\"content\":"
                (fikra-ollama-json-string
                  (if contained
                    (concat "file not found: " path)
                    "refused: path escapes the working directory"))
                "},")))))

(defun fikra-ollama-run-bash (call args)
  (let* ((cmd (if (fikra-ollama-alist-get "command" args)
                (fikra-ollama-alist-get "command" args) ""))
         (dir (fikra/thread/fikra-thread-working-dir))
         ;; r116: the L2 gate — a DESTRUCTIVE command parks at the
         ;; approval panel (the mockup's per-action mediation); the loop
         ;; resumes on the user's a/r/A.
         (risk (condition-case nil
                  (progn (require-module fikra/approvals)
                         (fikra/approvals/fikra-approval-risk "bash" cmd))
                  (error () ""))))
    (if (string= risk "destructive")
      (fikra-ollama-park call cmd)
      (fikra-ollama-run-bash-now cmd dir))))

(defun fikra-ollama-park (call cmd)
  (setq fikra-ollama-parked-call call)
  (setq fikra-ollama-parked-thread (fikra/thread/fikra-thread-current))
  (require-module fikra/approvals)
  (fikra/event/fikra-event-emit
    (list (list "kind" "permission-request")
          (list "action" (concat "bash: " cmd))
          (list "tool" "bash")
          (list "id" "ollama-native")
          (list "target" (fikra/approvals/fikra-approval-target cmd))
          (list "thread" (fikra/thread/fikra-thread-current))
          (list "turn" (number-to-string (fikra/thread/fikra-thread-turn-count)))
          (list "risk" "destructive")
          (list "mode" (condition-case nil
                          (progn (require-module fikra/modes)
                                 (fikra/modes/fikra-effective-mode))
                          (error () "")))
          (list "checkpoint" (fikra/approvals/fikra-approval-baseline-ref))
          (list "origin" "native-loop")))
  (fikra/thread/fikra-thread-status-set "confirming")
  (editor-set-status "Fikra: approve bash? a Allow · r Reject · A Always")
  'parked)

;; The un-gated execution (the r113 path).
;; r126 (the codex-named responsiveness gap): bash runs ASYNC —
;; make-process with a filter/sentinel; the daemon NEVER blocks on a
;; long command. The r113 exit-status contract is preserved (the
;; command's own $? rides the output tail).
(defvar fikra-ollama-last-pre-name nil
  "r142: the mediated action's PRE ref name — the sentinel pairs it
with its post-exit capture.")
(defvar fikra-ollama-next-mediated nil
  "r134: set around a DECISION-executed spawn — the child was MEDIATED
(the user allowed it); its exit lands a per-action checkpoint.")

(defun fikra-ollama-run-bash-now (cmd dir)
  (fikra/event/fikra-event-emit
    (list (list "kind" "tool-call") (list "tool" "bash")
          (list "summary" cmd)))
  (let ((mediated fikra-ollama-next-mediated))
    (setq fikra-ollama-next-mediated nil)
    (let ((pid (condition-case nil
                (make-process
                  :command (list "sh" "-c"
                                 (concat "cd " (fikra/thread/fikra-thread-shq dir)
                                         " && __o=\"$( (" cmd ") 2>&1 )\"; __e=$?; echo \"$__o\" | head -30; echo EXIT:$__e"))
                  :cwd dir
                  :filter "fikra/backend-ollama/fikra-ollama-bash-filter"
                  :sentinel "fikra/backend-ollama/fikra-ollama-bash-sentinel")
                (error () nil))))
      (if pid
        ;; r131: stamp the OWNERSHIP entry (spawn-time epoch + home) and
        ;; return the PID — callers detect async by numberp; the round's
        ;; continuation (if any) is stashed into this entry by run-calls.
        ;; r134: MEDIATED children land an action checkpoint at exit.
        (progn
          (keymap-mutable-set! fikra-ollama-async-procs (number-to-string pid)
            (hashmap "epoch" fikra-ollama-epoch
                     "home" (if fikra-ollama-turn-home
                              fikra-ollama-turn-home
                              (fikra/thread/fikra-thread-current))
                     "out" ""
                     "cont" nil
                     "mediated" mediated))
          pid)
      ;; r127 (codex catch 4): a FAILED spawn reports an honest FAIL
      ;; row — never a pid (the turn would strand).
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" nil)
                (list "summary" "spawn failed")))
        "{\"role\":\"tool\",\"content\":\"spawn failed\"},")))))

(defun fikra-ollama-bash-filter (pid output)
  ;; r131: the output accumulates on the PID's own entry (concurrent
  ;; children never share a buffer).
  (let ((entry (hashmap-get fikra-ollama-async-procs (number-to-string pid))))
    (if entry
      (keymap-mutable-set! entry "out"
        (concat (hashmap-get entry "out") output))))
  t)

;; r131: the turn is still awaiting this async chain (a sentinel that
;; fires after the turn ended renders its evidence but resumes nothing).
(defun fikra-ollama-turn-live-p ()
  (and fikra-ollama-pending-message
       (string= (fikra/thread/fikra-thread-status) "running")))

;; r131 (codex r130 P1#1/P1#3): the sentinel is TURN- and THREAD-bound.
;; The per-pid entry carries the spawn-time epoch + HOME thread. A
;; sentinel whose turn was aborted/replaced (epoch mismatch) drops
;; everything — no result row, no resume, no re-fire (abort also KILLED
;; the child). A live sentinel renders and resumes under the HOME focus
;; (a mid-run focus switch must not reroute evidence or the next
;; request), and only continues the round while the turn still runs.
(defun fikra-ollama-bash-sentinel (pid exit-code)
  (let* ((key (number-to-string pid))
         (entry (hashmap-get fikra-ollama-async-procs key))
         (home (if entry (hashmap-get entry "home") nil))
         (cont (if entry (hashmap-get entry "cont") nil))
         (same-epoch (and entry
                        (string= (number-to-string (hashmap-get entry "epoch"))
                                 (number-to-string fikra-ollama-epoch))))
         (prev (fikra/thread/fikra-thread-current)))
    ;; The entry dies with this sentinel (tombstone).
    (keymap-mutable-set! fikra-ollama-async-procs key nil)
    (if (not same-epoch)
      'superseded
      (progn
        ;; The HOME focus for everything this sentinel does.
        (if (and home (not (string= home prev)))
          (fikra/thread/fikra-thread-focus home))
        ;; r131c (codex r131b catches): EVERYTHING after the focus
        ;; switch lives inside the handler — a throw anywhere restores
        ;; the focus — AND a thrown body SETTLES the turn honestly (the
        ;; entry is already tombstoned; an unsurfaced error would leave
        ;; the turn "running" with no continuation — the r125/r129
        ;; stuck-turn class).
        (let ((r (condition-case nil
                  (let* ((raw (if entry (hashmap-get entry "out") ""))
                         (raw-code (fikra-ollama-exit-code raw))
                         ;; r128 (codex r127 catch 3): a MISSING EXIT:
                         ;; marker defaulted to success — the child's own
                         ;; exit-code is the truth when the marker never
                         ;; printed (a kill, a crash).
                         (code (if (fikra-ollama-has-exit-p raw)
                                 raw-code
                                 (number-to-string exit-code)))
                         (ok (string= code "0"))
                         (out (string-trim (fikra-ollama-strip-exit raw)))
                         (msg (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string
                                       (concat out (if ok "" (concat "\nexit code: " code)))) "},")))
                    (fikra/event/fikra-event-emit
                      (list (list "kind" "tool-result") (list "ok" ok)
                            (list "summary" (concat out (if ok "" (concat "\nexit " code))))))
                    (if (not (fikra-ollama-turn-live-p))
                      ;; The turn ENDED while this child ran (e.g. the
                      ;; allow-path race): the evidence renders, nothing
                      ;; resumes — there is no turn to continue.
                      'turn-over
                      (progn
                        ;; r134 (codex r130 P1#4): a MEDIATED bash (the
                        ;; user allowed a mutation) lands its own action
                        ;; ref at exit — the snapshot pins exactly what
                        ;; the approved command changed.
                        (if (and entry (hashmap-get entry "mediated"))
                          (condition-case nil
                            (progn (require-module fikra/checkpoint)
                                   ;; r134c (codex r134b catch): SYNC — the
                                   ;; snapshot completes BEFORE the
                                   ;; continuation resumes (an async capture's
                                   ;; git add -A could stage a LATER edit into
                                   ;; this action's ref). r134e: this runs in
                                   ;; the SENTINEL context — the event emits
                                   ;; owner-bound (the pointer reads nil here).
                                   (fikra/checkpoint/fikra-checkpoint-set-emit-owner
                                     (if home home (fikra/thread/fikra-thread-current)))
                                   (fikra/checkpoint/fikra-checkpoint-capture "action")
                                   (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                                   ;; r142: the post→pre pair.
                                   (fikra-ollama-record-action-pair fikra-ollama-last-pre-name)
                                   (setq fikra-ollama-last-pre-name nil))
                            (error () nil)))
                        (if (not cont)
                          (progn
                            (setq fikra-ollama-messages
                              (concat fikra-ollama-messages msg))
                            (fikra-ollama-chat fikra-ollama-pending-message))
                          (fikra-ollama-resume-from cont msg)))))
                  (error (m)
                    ;; r131d (codex r131c catch): the handler itself
                    ;; must not throw — a failing turn-end (an
                    ;; unwritable event log) skipped the focus restore
                    ;; below and stranded the turn. Best effort, then
                    ;; restore regardless.
                    (condition-case nil
                      (progn
                        (editor-set-status (concat "Fikra-ollama: async resume failed — " m))
                        (if (fikra-ollama-turn-live-p)
                          (fikra/thread/fikra-thread-turn-end "error")))
                      (error () nil))
                    'sentinel-error))))
          (condition-case nil
            (if (and home (not (string= home prev)))
              (fikra/thread/fikra-thread-focus prev))
            (error () nil))
          r)))))

;; Resume run-calls from the stash's index (the message already
;; appended).
;; r129: the t-clause body MUST be a single progn — a multi-expression
;; cond clause throws ("cond clause must have exactly 2 elements") and
;; the dispatcher's condition-case swallowed it, sticking live turns
;; "running" after the async tool round (unit-green because the async
;; tests never asserted the post-refire settle).
(defun fikra-ollama-resume-from (cont msg)
  (let ((calls (car cont))
        (i (car (cdr cont)))
        (acc (car (cdr (cdr cont)))))
    ;; The pre-async results (r127) + the completed message land at
    ;; their positions; the remaining calls' results append after.
    (setq fikra-ollama-messages
      (concat fikra-ollama-messages (if acc acc "") msg))
    (let ((results (fikra-ollama-run-calls calls i nil)))
      (cond
        ((and (symbolp results) (string= (symbol-name results) "parked")) nil)
        ((and (symbolp results) (string= (symbol-name results) "async")) nil)
        (t (progn
          (setq fikra-ollama-messages
            (concat fikra-ollama-messages "" results))
          ;; r137+r138: the async round's exchange persists in its turn's
          ;; slot (the sync branch lives in tool-round).
          (fikra-ollama-remember-exchange
            (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                    (fikra-ollama-calls-json calls 0 "")
                    "]}," (if acc acc "") msg results))
          (if (>= fikra-ollama-round fikra-ollama-max-rounds)
            (progn
              (setq fikra-ollama-pending-message nil)
              (fikra/event/fikra-event-emit
                (list (list "kind" "text-delta")
                      (list "speaker" "assistant")
                      (list "text" "(tool round cap reached — stopping the loop)")))
              (fikra/thread/fikra-thread-turn-end "completed"))
            (fikra-ollama-chat fikra-ollama-pending-message))))))))

;; The trailing EXIT:N line's N.
;; Does RAW's last line carry the EXIT:N marker?
(defun fikra-ollama-has-exit-p (raw)
  (let* ((lines (string-split (string-trim raw) "\n"))
         (last (if (> (length lines) 0) (nth (- (length lines) 1) lines) "")))
    (string-prefix-p "EXIT:" last)))

(defun fikra-ollama-exit-code (raw)
  (let* ((lines (string-split (string-trim raw) "\n"))
         (last (if (> (length lines) 0) (nth (- (length lines) 1) lines) "")))
    (if (string-prefix-p "EXIT:" last)
      (substring last 5 (length last))
      "0")))

;; Everything before the trailing EXIT line.
(defun fikra-ollama-strip-exit (raw)
  (let* ((lines (string-split (string-trim raw) "\n"))
         (kept (if (and (> (length lines) 0)
                        (string-prefix-p "EXIT:" (nth (- (length lines) 1) lines)))
                 (reverse (cdr (reverse lines)))
                 lines)))
    (fikra-ollama-join-lines kept "")))

(defun fikra-ollama-join-lines (lines acc)
  (if (null lines)
    acc
    (fikra-ollama-join-lines (cdr lines)
      (concat acc (if (> (length acc) 0) "\n") (car lines)))))

;; r133 (codex r130 P1#5): resolve SYMLINKS before the containment
;; verdict — a relative path through an in-tree symlink pointing
;; OUTSIDE wrote/read outside the tree while passing the ../ check.
;; Resolves the deepest EXISTING ancestor of DIR/PATH (the file itself
;; when it exists — a symlinked target is caught), then requires it to
;; sit under the RESOLVED working dir.
;; r133 catch: the old (string-match "\.\./" path) was a REGEX whose
;; stripped dots are WILDCARDS — any path with a directory component
;; matched (a latent over-refusal). A literal ".." byte scan instead.
(defun fikra-ollama-has-dotdot-p (s)
  (fikra-ollama-dotdot-scan s 0))

(defun fikra-ollama-dotdot-scan (s i)
  (if (> (+ i 1) (- (length s) 1))
    nil
    (if (and (string= (substring s i (+ i 1)) ".")
             (string= (substring s (+ i 1) (+ i 2)) "."))
      t
      (fikra-ollama-dotdot-scan s (+ i 1)))))

(defun fikra-ollama-path-contained-p (dir path)
  (if (or (<= (length path) 0)
          (string-prefix-p "/" path)
          (fikra-ollama-has-dotdot-p path))
    nil
    (let ((real-dir (condition-case nil
                      (string-trim (shell-command
                        (concat "realpath " (fikra/thread/fikra-thread-shq dir))))
                      (error () dir)))
          ;; The skeleton is HEX-BUILT (the reader leaves backslash
          ;; escapes intact in .tlisp literals). r133b (codex catch): a
          ;; DANGLING symlink escapes -e (the test follows links) — the
          ;; walk now stops at the link itself (-L) and readlink reveals
          ;; its outside target when realpath fails.
          (resolved (condition-case nil
                      (string-trim (shell-command
                        (concat "p=" (fikra/thread/fikra-thread-shq (concat dir "/" path))
                                (hex-decode "3b207768696c65205b2021202d652022247022205d202626205b2021202d4c2022247022205d3b20646f20703d24286469726e616d652022247022293b20646f6e653b207265616c70617468202224702220323e2f6465762f6e756c6c207c7c20726561646c696e6b2022247022"))))
                      (error () (concat dir "/" path)))))
      ;; resolved walks up to dir ITSELF for a not-yet-existing path
      ;; (no trailing slash) — the exact dir is contained too.
      ;; r133d (codex r133c catch): the readlink FALLBACK (a dangling
      ;; link) returns the RAW target — a lexical ".." hop inside it
      ;; passed the prefix compare; unresolvable hops refuse.
      (if (fikra-ollama-has-dotdot-p resolved)
        nil
        (if (string= resolved real-dir)
          t
          (string-prefix-p (concat real-dir "/") resolved))))))

;; r135 (codex r130 P2): up to 3 sign-prefixed lines + a counted tail
;; (the r106 evidence shape; the claude backend's preview builder is
;; module-scoped — a local twin).
;; r138 (codex r137 finding): a CHANGE-FOCUSED preview — the common
;; prefix/suffix lines trim away; only the CHANGED middles show (the
;; first-3-of-each shape displayed unchanged opening lines while a
;; change below them hid).
(defun fikra-ollama-diff-preview (old-text new-text)
  (let* ((a (string-split old-text (hex-decode "0a")))
         (b (string-split new-text (hex-decode "0a")))
         (p (fikra-ollama-diff-prefix a b 0))
         (s (fikra-ollama-diff-suffix a b 1 p))
         (removed (fikra-ollama-join-slice a p (- (length a) s)))
         (added (fikra-ollama-join-slice b p (- (length b) s))))
    (concat (if (> (length removed) 0) (fikra-ollama-preview-lines "-" removed) "")
            (if (> (length added) 0) (fikra-ollama-preview-lines "+" added) ""))))

;; The first index where the lines differ.
(defun fikra-ollama-diff-prefix (a b i)
  (if (or (>= i (length a)) (>= i (length b))
          (not (string= (nth i a) (nth i b))))
    i
    (fikra-ollama-diff-prefix a b (+ i 1))))

;; The count of MATCHING TAIL lines (bounded so it never overlaps the
;; prefix; stops at the first mismatch from the end).
(defun fikra-ollama-diff-suffix (a b i p)
  (if (or (>= i (length a)) (>= i (length b))
          (< (- (length a) i) p) (< (- (length b) i) p))
    (- i 1)
    (if (string= (nth (- (length a) i) a) (nth (- (length b) i) b))
      (fikra-ollama-diff-suffix a b (+ i 1) p)
      (- i 1))))

(defun fikra-ollama-join-slice (lines from to)
  (if (>= from to)
    ""
    (concat (nth from lines)
            (if (< (+ from 1) to) (hex-decode "0a") "")
            (fikra-ollama-join-slice lines (+ from 1) to))))

(defun fikra-ollama-preview-lines (sign text)
  (let ((lines (string-split text "\n"))
        (out ""))
    (fikra-ollama-preview-scan sign lines 0 (length lines) out)))

(defun fikra-ollama-preview-scan (sign lines i n out)
  (if (>= i n)
    (if (> n 3)
      (concat out sign " … " (number-to-string (- n 3)) " more
")
      out)
    (if (< i 3)
      (fikra-ollama-preview-scan sign lines (+ i 1) n
        (concat out sign " " (nth i lines) "
"))
      ;; skip the middle — the tail marker lands at the end
      (fikra-ollama-preview-scan sign lines (+ i 1) n out))))

(defun fikra-ollama-run-edit (call args)
  (let* ((path (if (fikra-ollama-alist-get "path" args)
                 (fikra-ollama-alist-get "path" args) ""))
         (content (if (fikra-ollama-alist-get "content" args)
                    (fikra-ollama-alist-get "content" args) ""))
         (dir (fikra/thread/fikra-thread-working-dir))
         ;; r117 (codex r116 P1#4) + r133: CONTAINMENT — a model edit
         ;; may not escape the working dir (absolute paths, .. escapes,
         ;; and — r133 — SYMLINK hops all refuse).
         (contained (fikra-ollama-path-contained-p dir path))
         (abs (concat dir "/" path))
         ;; r135: the OLD content for the INLINE diff evidence.
         (old-content (if contained
                        (condition-case nil (read-file-content abs) (error () nil))
                        nil)))
    (if (not contained)
      (progn
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-call") (list "tool" "buffer-edit")
                (list "summary" (concat path " @" (number-to-string (length content))))))
        (fikra/event/fikra-event-emit
          (list (list "kind" "tool-result") (list "ok" nil)
                (list "summary" (concat "REFUSED: path escapes the working dir: " path))))
        (concat "{\"role\":\"tool\",\"content\":\"refused: path escapes the working directory\"},"))
      (progn
        (shell-command (concat "mkdir -p " (fikra/thread/fikra-thread-shq
                                             (fikra/thread/fikra-thread-dirname abs))))
        ;; r137+r139: the PRE-state ref (BEFORE the write — the revert
        ;; target). r142: its NAME is kept for the post→pre pair.
        (let ((pre-name nil))
          (condition-case nil
            (let ((sha (progn (require-module fikra/checkpoint)
                              (fikra/checkpoint/fikra-checkpoint-capture "action")))
                  (n (fikra/checkpoint/fikra-checkpoint-last-ref-name-get)))
              (setq pre-name n)
              (if (not sha)
                (editor-set-status "Fikra: action checkpoint FAILED — the edit proceeds without a revert ref")))
            (error (m)
              (editor-set-status
                (concat "Fikra: action checkpoint FAILED — the edit proceeds without a revert ref ("
                        (if (stringp m) m "capture error") ")"))))
          (let ((written (condition-case nil
                          (progn (write-file-content abs content) t)
                          (error () nil))))
            ;; r135c: the GEAR row + preview emit AFTER the verified
            ;; write (a failed write shows nothing it didn't do).
            (fikra/event/fikra-event-emit
              (list (list "kind" "tool-call") (list "tool" "buffer-edit")
                    (list "summary" (concat path " @" (number-to-string (length content))))
                    (list "preview"
                      (if written
                        (fikra-ollama-diff-preview
                          (if (and old-content (stringp old-content)) old-content "")
                          content)
                        ""))))
            (if (not written)
              (progn
                (fikra/event/fikra-event-emit
                  (list (list "kind" "tool-result") (list "ok" nil)
                        (list "summary" (concat "WRITE FAILED: " path))))
                (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string (concat "write failed: " path)) "},"))
              (progn
                ;; The POST-write ref (evidence + inline marker). r142:
                ;; the post→pre pair (the action-level revert).
                (condition-case nil
                  (progn (require-module fikra/checkpoint)
                         (fikra/checkpoint/fikra-checkpoint-capture "action")
                         (fikra-ollama-record-action-pair pre-name))
                  (error () nil))
                (fikra/event/fikra-event-emit
                  (list (list "kind" "tool-result") (list "ok" t)
                        (list "summary" (concat "wrote " path))))
                (concat "{\"role\":\"tool\",\"content\":" (fikra-ollama-json-string (concat "wrote " path)) "},")))))))))

;; r135c (codex catch): the fragment must be VALID JSON — the content
;; string was never closed, and the tool name rode in unescaped.
(defun fikra-ollama-tool-skip (call fname)
  (concat "{\"role\":\"tool\",\"content\":"
          (fikra-ollama-json-string (concat "unknown tool: " (if fname fname "?")))
          "},"))

;; Events arrive OLDEST-FIRST; the history is every COMPLETED turn —
;; everything up to and including the LAST turn-end (the in-flight
;; user message is emitted BEFORE its turn-start — a turn-start cut
;; would double it; the turn-end boundary excludes the whole open turn).
;; r142b: the last action-revert stash accessor.
(defun fikra-ollama-last-action-stash-get ()
  (if fikra-ollama-last-action-stash fikra-ollama-last-action-stash nil))

;; r142: the action post-refs (newest-first) as a NEWLINE-joined string
;; (list values stringify as [object Object] across the eval boundary).
(defun fikra-ollama-action-posts-get ()
  (fikra-ollama-join-strings fikra-ollama-action-posts ""))

(defun fikra-ollama-join-strings (items acc)
  (if (or (not items) (= (length items) 0))
    acc
    (fikra-ollama-join-strings (cdr items)
      (concat acc (if (> (length acc) 0) (hex-decode "0a") "") (car items)))))

;; r142: pair an action's post-ref with its pre-ref (called right
;; after the post capture; both names read from the checkpoint module's
;; last-ref-name stash).
(defun fikra-ollama-record-action-pair (pre)
  (let* ((post (fikra/checkpoint/fikra-checkpoint-last-ref-name-get))
         (pre-ref (if pre pre nil)))
    (if (and post pre-ref)
      (progn
        (keymap-mutable-set! fikra-ollama-action-pairs post pre-ref)
        (setq fikra-ollama-action-posts (append (list post) fikra-ollama-action-posts)))
      nil)))

;; r142: THE ACTION-LEVEL REVERT — restore the LATEST action's touched
;; paths from ITS pre-ref (checkout when the pre-ref has the path,
;; remove when the action ADDED it). A verified stash patch lands first
;; (the turn-revert discipline).
(defun fikra-ollama-revert-latest-action ()
  (require-module fikra/checkpoint)
  (if (or (not fikra-ollama-action-posts) (= (length fikra-ollama-action-posts) 0))
    (editor-set-status "Fikra: no action to revert")
    (let* ((post (car fikra-ollama-action-posts))
           (pre (hashmap-get fikra-ollama-action-pairs post))
           (root (fikra/thread/fikra-thread-working-dir)))
      (if (not pre)
        (editor-set-status (concat "Fikra: no pre-ref recorded for " post))
        (let* ((stash (concat root "/.tmax/fikra/stash/action-"
                              (number-to-string (current-time)) ".patch"))
               (paths-text (string-trim
                             (shell-command
                               (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                       " diff --name-only " pre " " post))))
               (paths (if (string= paths-text "") (list)
                        (string-split paths-text (hex-decode "0a")))))
          (cond
            ((= (length paths) 0)
              (editor-set-status "Fikra: the action changed nothing"))
            (t (progn
              (shell-command (concat "mkdir -p " (fikra/thread/fikra-thread-shq
                               (concat root "/.tmax/fikra/stash"))))
              ;; r142b (codex r142 catch): the stash preserves the ACTION's
              ;; own change (pre→post per path) — git-apply restores it;
              ;; a worktree-vs-ref diff was EMPTY whenever the worktree
              ;; matched the post tree (nothing was "saved").
              (let ((patch-out (shell-command
                                 (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                         " diff --binary " pre " " post " -- "
                                         (fikra-ollama-paths-args paths)
                                         " > " (fikra/thread/fikra-thread-shq stash)
                                         " && test -s " (fikra/thread/fikra-thread-shq stash)
                                         " || echo EMPTY"))))
                (setq fikra-ollama-last-action-stash stash)
                (let ((fails (fikra-ollama-restore-paths root pre paths (list))))
                  (setq fikra-ollama-action-posts (cdr fikra-ollama-action-posts))
                  (keymap-mutable-set! fikra-ollama-action-pairs post nil)
                  (editor-set-status
                    (concat "Fikra: action reverted to " pre
                            (if (> (length fails) 0)
                              (concat " — " (number-to-string (length fails)) " path(s) FAILED")
                              "")))
                  fails))))))))))

;; Paths as sh-quoted argv text.
(defun fikra-ollama-paths-args (paths)
  (if (or (not paths) (= (length paths) 0))
    ""
    (concat (fikra/thread/fikra-thread-shq (car paths))
            (if (> (length paths) 1) (concat " " (fikra-ollama-paths-args (cdr paths))) ""))))

;; Restore each PATH from REF (checkout when REF has it; remove when
;; REF lacks it — the action ADDED it). Returns the failure list.
(defun fikra-ollama-restore-paths (root ref paths fails)
  (if (or (not paths) (= (length paths) 0))
    fails
    (let* ((p (car paths))
           (has (string= (string-trim (shell-command
                          (concat "git -C " (fikra/thread/fikra-thread-shq root)
                                  " cat-file -e " ref ":" (fikra/thread/fikra-thread-shq p)
                                  " 2>/dev/null && echo YES || echo NO"))) "YES"))
           (out (if has
                  (shell-command
                    (concat "git -C " (fikra/thread/fikra-thread-shq root)
                            " checkout " ref " -- " (fikra/thread/fikra-thread-shq p) " 2>&1"))
                  (shell-command
                    (concat "rm -f " (fikra/thread/fikra-thread-shq (concat root "/" p)) " 2>/dev/null; true")))))
      (fikra-ollama-restore-paths root ref (cdr paths)
        (if (and has (not (string= (string-trim out) "")))
          (append fails (list p))
          fails)))))

;; r138: append FRAGMENT into the CURRENT turn's exchange slot.
;; r139: the slot key is THREAD/TURN/ROUND — every round flushes in
;; event order (the walker appends them at the turn's end in key
;; order), and no fragment re-embeds the narration text.
(defun fikra-ollama-remember-exchange (fragment)
  (let* ((key (concat (fikra/thread/fikra-thread-current) "/"
                      (number-to-string (fikra/thread/fikra-thread-turn-count))
                      "/" (number-to-string fikra-ollama-round)))
         (prior (hashmap-get fikra-ollama-tool-exchanges key)))
    (keymap-mutable-set! fikra-ollama-tool-exchanges key
      (concat (if prior prior "") fragment))))

(defun fikra-ollama-history-messages ()
  (let* ((events (fikra/event/fikra-event-events))
         (cutoff (+ (fikra-ollama-last-turn-end events 0 -1) 1)))
    ;; r139: rounds flush one-by-one as the turn's narrations arrive
    ;; (narration1, tools1, narration2, tools2, final reply).
    (fikra-ollama-history-scan events 0 cutoff "" nil nil 1)))

;; The index of the LAST turn-end (-1 when none — a first turn has no
;; history).
(defun fikra-ollama-last-turn-end (events i best)
  (if (>= i (length events))
    best
    (if (string= (fikra/event/fikra-event-get-str (nth i events) "kind") "turn-end")
      (fikra-ollama-last-turn-end events (+ i 1) i)
      (fikra-ollama-last-turn-end events (+ i 1) best))))

;; r138: TOOLS-SEEN tracks whether the current turn already ran tools;
;; the turn's exchange flushes BEFORE the first assistant text that
;; follows them (the true intra-turn order — the tools ran BEFORE the
;; final reply), and any remainder flushes at the turn's end.
;; The next unflushed ROUND's slot for the current thread+turn ("" when
;; none pending). The events belong to the CURRENT thread's log.
(defun fikra-ollama-round-frag (turn-n round)
  (if turn-n
    (let ((k (concat (fikra/thread/fikra-thread-current) "/" turn-n "/"
                     (number-to-string round))))
      (hashmap-get fikra-ollama-tool-exchanges k))
    nil))

(defun fikra-ollama-history-scan (events i cutoff acc tools-seen turn-n next-round)
  ;; r138: TOOLS-SEEN tracks whether the current turn already ran tools;
  ;; the turn's exchange flushes BEFORE the first ASSISTANT text that
  ;; follows them (the true intra-turn order — the tools ran before the
  ;; final reply); any remainder flushes at the turn's end.
  (if (or (>= i (length events)) (>= i cutoff))
    acc
    (let* ((e (nth i events))
           (k (fikra/event/fikra-event-get-str e "kind"))
           (raw-turn (fikra/event/fikra-event-get e "turn"))
           (this-turn (if (numberp raw-turn)
                        (number-to-string raw-turn)
                        (if raw-turn raw-turn turn-n))))
      (cond
        ((string= k "turn-start")
          (fikra-ollama-history-scan events (+ i 1) cutoff acc nil this-turn 1))
        ((or (string= k "tool-call") (string= k "tool-result")
             (string= k "permission-denied") (string= k "permission-allowed"))
          ;; r139b (codex round-2 catch): decision events mark the turn
          ;; as having run tools — the flush must precede the reply even
          ;; without an intervening narration.
          (fikra-ollama-history-scan events (+ i 1) cutoff acc t this-turn next-round))
        ((string= k "text-delta")
          (let* ((sp (fikra/event/fikra-event-get-str e "speaker"))
                 (tx (fikra/event/fikra-event-get-str e "text"))
                 ;; r139: flush ONE pending round slot before an
                 ;; assistant narration (the round's tools preceded it).
                 (frag (if (and tools-seen turn-n (string= sp "assistant"))
                         (fikra-ollama-round-frag turn-n next-round)
                         nil)))
            (if (> (length tx) 0)
              (fikra-ollama-history-scan events (+ i 1) cutoff
                (concat acc (if frag frag "") "{\"role\":\""
                        (if (string= sp "user") "user" "assistant")
                        "\",\"content\":" (fikra-ollama-json-string tx) "},")
                tools-seen this-turn (if frag (+ next-round 1) next-round))
              (fikra-ollama-history-scan events (+ i 1) cutoff acc tools-seen this-turn next-round))))
        ((string= k "turn-end")
          (let ((rest (fikra-ollama-rounds-rest turn-n next-round)))
            (fikra-ollama-history-scan events (+ i 1) cutoff
              (concat acc rest) tools-seen this-turn (+ next-round
                (fikra-ollama-rounds-count turn-n next-round)))))
        (t
          (fikra-ollama-history-scan events (+ i 1) cutoff acc tools-seen this-turn next-round))))))

;; The concatenation of turn's round slots from ROUND on (bounded — a
;; runaway model cannot loop this past the cap).
(defun fikra-ollama-rounds-rest (turn-n round)
  (if (or (not turn-n) (> round fikra-ollama-max-rounds))
    ""
    (let ((frag (fikra-ollama-round-frag turn-n round)))
      (concat (if frag frag "")
              (fikra-ollama-rounds-rest turn-n (+ round 1))))))

(defun fikra-ollama-rounds-count (turn-n round)
  (if (or (not turn-n) (> round fikra-ollama-max-rounds))
    0
    (let ((frag (fikra-ollama-round-frag turn-n round)))
      (+ (if frag 1 0) (fikra-ollama-rounds-count turn-n (+ round 1))))))

;; JSON-string escaping (quotes + backslashes; runtime concat is
;; reader-safe, the embedded chars must be JSON-escaped — hex-built
;; backslash per the established idiom).
(defun fikra-ollama-json-string (s)
  (fikra-ollama-escape-scan s 0 ""))

(defun fikra-ollama-escape-scan (s i acc)
  (if (>= i (length s))
    (concat "\"" acc "\"")
    (let ((c (substring s i (+ i 1)))
          (bs (hex-decode "5c")))
      (fikra-ollama-escape-scan s (+ i 1)
        (cond
          ((string= c "\"") (concat acc bs (hex-decode "22")))
          ((string= c bs) (concat acc bs bs))
          ;; r135b (codex catch + a latent bug): the control characters
          ;; are HEX-BUILT — the file literal "\n" is backslash-n (the
          ;; reader leaves escapes intact), which NEVER matched a real
          ;; newline: multi-line content rode raw into the JSON. Tab
          ;; and CR join (raw control chars make the request invalid).
          ((string= c (hex-decode "0a")) (concat acc bs "n"))
          ((string= c (hex-decode "09")) (concat acc bs "t"))
          ((string= c (hex-decode "0d")) (concat acc bs "r"))
          ;; r135c (codex catch): the remaining plausible control bytes.
          ((string= c (hex-decode "08")) (concat acc bs "b"))
          ((string= c (hex-decode "0c")) (concat acc bs "f"))
          ((string= c (hex-decode "1b")) (concat acc bs "u001b"))
          ;; r135d (codex catch): ANY remaining control character
          ;; escapes as backslash-u00XX (JSON forbids raw U+0000-001F).
          ((< (char-code c) 32)
            (concat acc bs "u00" (fikra-ollama-hex2 (char-code c))))
          (t (concat acc c)))))))

;; Two lowercase hex digits (the control-char range fits a byte).
;; r135e (codex r135d catch): INTEGER division — T-Lisp / is
;; fractional; the low nibble was lost (U+0001 escaped as \u0000).
(defun fikra-ollama-hex2 (n)
  (let ((hi (floor (/ n 16))))
    (concat (fikra-ollama-hex-nibble hi)
            (fikra-ollama-hex-nibble (- n (* 16 hi))))))

(defun fikra-ollama-hex-nibble (k)
  (substring "0123456789abcdef" k (+ k 1)))

;; The http filter: stamp ownership + accumulate the body. A TAGS request
;; is recognizable by its marker entry ("tags-<id>"); a chat request by a
;; plain id.
(defun fikra-backend-ollama-http-filter (id chunk-hex)
  (let ((k (number-to-string id)))
    (editor/keymaps/keymap-mutable-set!
      (editor/keymaps/keymap-named "fikra-http-owners") k
      "fikra/backend-ollama/fikra-backend-ollama-complete")
    (editor/keymaps/keymap-mutable-set! fikra-ollama-bodies k
      (concat (hashmap-get fikra-ollama-bodies k) (hex-decode chunk-hex)))
    t))

;; The completion handler (ownership-routed): a tags reply adopts the
;; model and re-fires; a chat reply renders the assistant turn + ENDS it.
(defun fikra-backend-ollama-complete (id status data-hex)
  (let* ((k (number-to-string id))
         (thread-id (hashmap-get fikra-ollama-threads k))
         (body (hashmap-get fikra-ollama-bodies k)))
    (editor/keymaps/keymap-mutable-set! fikra-ollama-bodies k nil)
    (editor/keymaps/keymap-mutable-set! fikra-ollama-threads k nil)
    ;; r109-r110: only the LATEST fired request may land; a gone turn
    ;; discards. r111 (codex r110 P2): a SWITCHED-AWAY thread no longer
    ;; discards — the reply SETTLES ITS OWN THREAD via the bg-settle
    ;; pattern (focus the firing thread, work, restore).
    (if (not (= id (if fikra-ollama-latest-id fikra-ollama-latest-id -1)))
      nil
    (if (not (and thread-id fikra-ollama-pending-message))
      nil
    ;; r136c (codex catch): the SAME-THREAD path gets the SAME recovery
    ;; (a render throw with the log unwritable stranded the turn — the
    ;; handler only lived on the switched branch).
    (if (string= thread-id (fikra/thread/fikra-thread-current))
      (condition-case nil
        (fikra-ollama-handle-reply status body)
        (error (m)
          (condition-case nil
            (progn
              (editor-set-status (concat "Fikra-ollama: reply failed — " m))
              (setq fikra-ollama-pending-message nil)
              (if (string= (fikra/thread/fikra-thread-status) "running")
                (fikra/thread/fikra-thread-turn-end "error")))
            (error () nil))
          'reply-error))
      ;; r136 (codex re-grade P2): the bg-settle dance is THROW-SAFE
      ;; (a reply-handling error used to leak the focus and strand the
      ;; turn) and settles honestly — the bash sentinel's pattern.
      (let ((prev (fikra/thread/fikra-thread-current)))
        ;; r136b (codex catch): the focus call itself is guarded; and the
        ;; settle keys on the thread STATUS (the success path clears the
        ;; pending marker BEFORE its render — a throw there left the
        ;; turn "running" with nothing pending to key on).
        (let ((focused (condition-case nil
                        (progn (fikra/thread/fikra-thread-focus thread-id) t)
                        (error () nil))))
          ;; r137 (codex re-grade): a FAILED focus switch must not handle
          ;; the reply under an inconsistent context — settle honestly.
          (if (not focused)
            (progn
              (setq fikra-ollama-pending-message nil)
              (editor-set-status "Fikra-ollama: reply thread focus failed")
              (condition-case nil
                (if (string= (fikra/thread/fikra-thread-status) "running")
                  (fikra/thread/fikra-thread-turn-end "error"))
                (error () nil))
              'focus-failed)
          (let ((r (condition-case nil
                    (fikra-ollama-handle-reply status body)
                    (error (m)
                      (condition-case nil
                        (progn
                          (editor-set-status (concat "Fikra-ollama: reply failed — " m))
                          (setq fikra-ollama-pending-message nil)
                          (if (string= (fikra/thread/fikra-thread-status) "running")
                            (fikra/thread/fikra-thread-turn-end "error")))
                        (error () nil))
                      'reply-error))))
            (if focused
              (condition-case nil
                (fikra/thread/fikra-thread-focus prev)
                (error () nil)))
            r)))))))))

;; The reply handling, thread-local (runs with the FIRING thread
;; focused; the guards already ran).
(defun fikra-ollama-handle-reply (status body)
  (if (not (= status 200))
      (progn
        ;; The turn dies honestly: an error turn-end, a visible status.
        (setq fikra-ollama-pending-message nil)
        (fikra/thread/fikra-thread-turn-end "error")
        (editor-set-status
          (concat "Fikra-ollama: server unreachable (" (number-to-string status)
                  ") " (substring (if body body "") 0 120))))
      ;; The chat reply: tool_calls → the ROUND (execute, append,
      ;; re-fire); plain content → render + end (the existing path).
      (let* ((msg (condition-case nil
                     (fikra-ollama-alist-get "message"
                       (json-read-from-string body))
                     (error () nil)))
             (content (if msg (fikra-ollama-alist-get "content" msg) nil))
             (tool-calls (if msg (fikra-ollama-alist-get "tool_calls" msg) nil)))
        (if (and tool-calls (listp tool-calls) (> (length tool-calls) 0)
                 (< fikra-ollama-round fikra-ollama-max-rounds))
          (fikra-ollama-tool-round msg tool-calls)
          (progn
        (setq fikra-ollama-pending-message nil)
        (if (and content (stringp content) (> (length content) 0))
          (progn
            (fikra/event/fikra-event-emit
              (list (list "kind" "text-delta")
                    (list "speaker" "assistant")
                    (list "text" content)))
            ;; The thread state machine settles the turn (emits turn-end).
            (fikra/thread/fikra-thread-turn-end "completed")
            (editor-set-status
              (concat "Fikra: ollama (" fikra-ollama-model ") turn completed")))
          (progn
            (fikra/thread/fikra-thread-turn-end "error")
            (editor-set-status "Fikra-ollama: empty reply"))))))))

;; Model resolution: the tags body is small — the filter DID accumulate
;; nothing for tags (marker-shaped); resolve via one sync curl instead
;; (the availability probe already proved curl works).
(defun fikra-ollama-resolve-model ()
  (if fikra-ollama-model
    fikra-ollama-model
    (let ((name (condition-case nil
                   (fikra-ollama-first-model-of
                     (shell-command
                       (concat "curl -s --max-time 3 " fikra-ollama-url "/api/tags 2>/dev/null")))
                   (error () nil))))
      (if (and name (stringp name) (> (length name) 0))
        (setq fikra-ollama-model name))
      fikra-ollama-model)))

;; Parse the tags JSON for the first model name (a line scan — the
;; transport is a runtime string; json-read-from-string handles it).
(defun fikra-ollama-first-model-of (raw)
  (let* ((parsed (json-read-from-string raw))
         (models (fikra-ollama-alist-get "models" parsed)))
    (if models
      (fikra-ollama-alist-get "name" (car models))
      nil)))

(defun fikra-ollama-alist-get (key alist)
  (let ((found nil))
    (dolist (e alist)
      (if (and (not found) (listp e) (= (length e) 2)
               (string= (car e) key))
        (setq found (car (cdr e)))))
    found))

;; The L2 decide seam (the adapter contract): the parked tool resumes on
;; the user's a/r/A. y → execute + continue the round; n → the denial
;; rides the accumulator (the model learns); a → y (a persistent native
;; allow-list is the follow-up).
(defun fikra-backend-ollama-pending-p ()
  (if fikra-ollama-parked-call t nil))

(defun fikra-backend-ollama-decide (decision)
  ;; r117 (codex r116 P1#1): the SAME interactive resolve-guard as every
  ;; other decide seam — a direct eval of this exported fn must not
  ;; self-approve.
  (require-module fikra/approvals)
  (if (not (fikra/approvals/fikra-approval-resolve-guard))
    nil
    (fikra-backend-ollama-decide-inner decision)))

;; r119 (codex r118 P1): the decision settles the ORIGINATING thread —
;; reading the FOCUSED status left the home thread 'confirming' forever
;; after a focus switch.
(defun fikra-ollama-settle-home (home-thread)
  (if (and home-thread (string= home-thread (fikra/thread/fikra-thread-current)))
    (if (string= (fikra/thread/fikra-thread-status) "confirming")
      (fikra/thread/fikra-thread-status-set "running"))
    (let ((prev (fikra/thread/fikra-thread-current)))
      (fikra/thread/fikra-thread-focus home-thread)
      (if (string= (fikra/thread/fikra-thread-status) "confirming")
        (fikra/thread/fikra-thread-status-set "running"))
      (fikra/thread/fikra-thread-focus prev)
      t)))

(defun fikra-backend-ollama-decide-inner (decision)
  (let* ((call fikra-ollama-parked-call)
         (home-thread fikra-ollama-parked-thread))
    ;; r139b: the exchange fragment's TRUE call list (the parked call +
    ;; its remainder — stashed HERE: at park time the remainder is not
    ;; yet known, and by resume time it is consumed).
    (if call
      (setq fikra-ollama-last-parked-calls
        (append (list call) fikra-ollama-parked-rest)))
    (setq fikra-ollama-parked-call nil)
    (setq fikra-ollama-parked-thread nil)
    (if (not call)
      nil
      (if (string= decision "n")
        (progn
          (fikra/event/fikra-event-emit
            (list (list "kind" "permission-denied")))
          ;; r122: ORDER — the lesson joins the SAVED acc at the
          ;; rejected call's position (the decision never appends to
          ;; messages out of order).
          (setq fikra-ollama-parked-acc
            (concat fikra-ollama-parked-acc
                    "{\"role\":\"tool\",\"content\":\"user rejected this command; do not retry it\"},"))
          ;; r139b (codex round-2 catch): the rejection rides via
          ;; resume-rest's ONE complete exchange (recording here too
          ;; duplicated the pre-park acc in the round's slot).
          (fikra-ollama-settle-home home-thread)
          (fikra-ollama-continue-home home-thread))
        (progn
          (fikra/event/fikra-event-emit
            (list (list "kind" "permission-allowed")))
          (fikra-ollama-settle-home home-thread)
          (let* ((fn (fikra-ollama-alist-get "function" call))
                 (args-raw (fikra-ollama-alist-get "arguments" fn))
                 (args (if (listp args-raw) args-raw
                         (condition-case nil (json-read-from-string (if args-raw args-raw "{}")) (error () ()))))
                 (cmd (if (fikra-ollama-alist-get "command" args)
                        (fikra-ollama-alist-get "command" args) "")))
            ;; r117: execute against the ORIGINATING thread (a focus
            ;; switch must not redirect the command).
            (let ((dir (if (and home-thread
                                (string= home-thread (fikra/thread/fikra-thread-current)))
                        (fikra/thread/fikra-thread-working-dir)
                        (if home-thread
                          (or (fikra/thread/fikra-thread-working-dir-of home-thread)
                              (fikra/thread/fikra-thread-working-dir))
                          (fikra/thread/fikra-thread-working-dir)))))
              ;; r122 (codex r121 P1): ORDER — the approved call's
              ;; result joins the SAVED acc (its position in the reply),
              ;; then the remainder appends; the decision never appends
              ;; out of order again.
              ;; r141 (codex 9-item): the PRE-state ref captures BEFORE
              ;; the command runs — an earlier action in the turn may
              ;; have changed the tree since the baseline; the ref a
              ;; revert restores to is the state immediately before THIS
              ;; mutation. The post-exit capture (evidence) remains.
              ;; r141b (codex r141 catch): the capture's RETURN is
              ;; checked — nil (disabled or failed) triggers the honest
              ;; status, not just exceptions.
              (condition-case nil
                (let ((sha (progn (require-module fikra/checkpoint)
                                  (fikra/checkpoint/fikra-checkpoint-set-emit-owner
                                    (if home-thread home-thread (fikra/thread/fikra-thread-current)))
                                  (let ((r (fikra/checkpoint/fikra-checkpoint-capture "action")))
                                    (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                                    r))))
                  (if (not sha)
                    (editor-set-status
                      "Fikra: pre-action checkpoint FAILED — the command proceeds without a revert ref")))
                (error (m)
                  ;; r141c (codex r141b catch): the owner flag clears on
                  ;; the THROW path too (a leaked owner routed later sync
                  ;; captures through the stale owner emitter).
                  (condition-case nil
                    (fikra/checkpoint/fikra-checkpoint-set-emit-owner nil)
                    (error () nil))
                  (editor-set-status
                    (concat "Fikra: pre-action checkpoint FAILED — the command proceeds without a revert ref ("
                            (if (stringp m) m "capture error") ")"))))
              ;; r142: the pre-name for the sentinel's pair record.
              (setq fikra-ollama-last-pre-name
                (condition-case nil
                  (progn (fikra/checkpoint/fikra-checkpoint-last-ref-name-get))
                  (error () nil)))
              (setq fikra-ollama-next-mediated t)
              (let ((approved (fikra-ollama-run-bash-now cmd dir)))
                ;; r131: an async spawn returns the PID — the result
                ;; arrives via the sentinel (appending the pid would
                ;; corrupt the acc; 'async used to append junk).
                (if (numberp approved)
                  ;; r132 (codex r130 P1#2): an async approved command
                  ;; HOLDS the continuation — the remainder + the
                  ;; pre-park acc + the re-fire ride the pid's ownership
                  ;; entry; the SENTINEL resumes them at exit (the model's
                  ;; next request must carry the approved result — before,
                  ;; the round continued immediately and re-fired without
                  ;; it, racing a second re-fire through the no-cont
                  ;; branch).
                  (let ((entry (hashmap-get fikra-ollama-async-procs
                                  (number-to-string approved))))
                    ;; r139 (codex catch): the stash carries the FULL
                    ;; call list with skip-index 1 — the approved call's
                    ;; message arrives as the sentinel's msg, and the
                    ;; remembered exchange then reconstructs the TRUE
                    ;; assistant message (rest-only stashes lied).
                    (if entry
                      (keymap-mutable-set! entry "cont"
                        (list (append (list call) fikra-ollama-parked-rest) 1
                              fikra-ollama-parked-acc))
                      nil)
                    (setq fikra-ollama-parked-rest nil)
                    (setq fikra-ollama-parked-acc "")
                    'held)
                  (progn
                    (setq fikra-ollama-parked-acc
                      (concat fikra-ollama-parked-acc approved))
                    ;; r120-r121: the remainder resumes; a RE-PARK holds
                    ;; the next model request until ITS decision.
                    (fikra-ollama-continue-home home-thread)))))))))))

;; r120: run the parked reply's remaining calls (their results append;
;; a SECOND destructive call parks again — the rest re-rides).
;; Returns 'done or 'reparked (r121, codex r120 P1: the decision paths
;; must NOT re-fire the model while a second action still parks).
;; r123 (codex r122 P1): the resumed remainder runs with the HOME
;; thread focused when focus moved — every resumed call (bash, read,
;; edit) resolves the ORIGINATING dir, not the focused one.
(defun fikra-ollama-resume-rest-for (home-thread)
  (if (and home-thread (not (string= home-thread (fikra/thread/fikra-thread-current))))
    (let ((prev (fikra/thread/fikra-thread-current)))
      (fikra/thread/fikra-thread-focus home-thread)
      (let ((r (fikra-ollama-resume-rest)))
        (fikra/thread/fikra-thread-focus prev)
        r))
    (fikra-ollama-resume-rest)))

;; r124 (codex r123 P1): the CONTINUATION — the resumption AND the next
;; model request — runs home-bound (the re-fire stamps the request with
;; the focused thread; a switched-away decision would route the
;; continuing turn to the wrong thread).
(defun fikra-ollama-continue-home (home-thread)
  (let ((moved (and home-thread
                    (not (string= home-thread (fikra/thread/fikra-thread-current))))))
    (if moved
      (let ((prev (fikra/thread/fikra-thread-current)))
        (fikra/thread/fikra-thread-focus home-thread)
        (let ((r (fikra-ollama-continue)))
          (fikra/thread/fikra-thread-focus prev)
          r))
      (fikra-ollama-continue))))

(defun fikra-ollama-continue ()
  (if (string= (symbol-name (fikra-ollama-resume-rest)) "done")
    ;; r135b (codex catch): the cap guards EVERY re-fire (a park in the
    ;; last round continued without it — an extra model request past
    ;; the cap).
    (if (>= fikra-ollama-round fikra-ollama-max-rounds)
      (progn
        (setq fikra-ollama-pending-message nil)
        (fikra/event/fikra-event-emit
          (list (list "kind" "text-delta")
                (list "speaker" "assistant")
                (list "text" "(tool round cap reached — stopping the loop)")))
        (fikra/thread/fikra-thread-turn-end "completed")
        'capped)
      (progn (fikra-ollama-chat fikra-ollama-pending-message) 'fired))
    'held))

(defun fikra-ollama-resume-rest ()
  (let* ((rest fikra-ollama-parked-rest)
         (acc fikra-ollama-parked-acc))
    (setq fikra-ollama-parked-rest nil)
    (setq fikra-ollama-parked-acc "")
    ;; r140 ROOT CAUSE: (list) is TRUTHY in this dialect — a single-call
    ;; park (empty proper-list rest) took the NON-empty branch, whose
    ;; remember serialized the empty rest as the assistant's calls
    ;; ("tool_calls":[]). The branch test is LENGTH-based now.
    (if (or (not rest) (= (length rest) 0))
      (progn
        ;; Nothing to resume — the pre-park results still count.
        (if (> (length acc) 0)
          (setq fikra-ollama-messages
            (concat fikra-ollama-messages acc)))
        ;; r139b: a single-call park (rejection or approval) records its
        ;; exchange HERE (the refusal/pre-park acc + the decision result).
        (if fikra-ollama-last-parked-calls
          (fikra-ollama-remember-exchange
            (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                    (fikra-ollama-calls-json fikra-ollama-last-parked-calls 0 "")
                    "]}," acc)))
        'done)
      (let ((results (fikra-ollama-run-calls rest 0 acc)))
        ;; r139 (codex catch): the DECISION continuations flow through
        ;; here — their exchanges must persist for future turns (the
        ;; full call list lives in the parked continuation's stash).
        ;; r140: the fragment carries the STASH's full call list (the
        ;; parked call + remainder — rest-only fragments showed the
        ;; remainder as the whole assistant message).
        (if (stringp results)
          (fikra-ollama-remember-exchange
            (concat "{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":["
                    (fikra-ollama-calls-json
                      (if (and fikra-ollama-last-parked-calls
                               (> (length fikra-ollama-last-parked-calls) 0))
                        fikra-ollama-last-parked-calls
                        rest)
                      0 "")
                    "]}," results)))
        (cond
          ((and (symbolp results) (string= (symbol-name results) "parked"))
            'reparked)
          ;; r132b (codex r132 P1): an async remainder call HOLDS the
          ;; round — its continuation rides the pid's ownership entry
          ;; and the SENTINEL resumes + re-fires at exit. Appending the
          ;; 'async marker re-fired immediately without the result (and
          ;; the sentinel's own resume re-fired AGAIN).
          ((and (symbolp results) (string= (symbol-name results) "async"))
            'held)
          (t
            (progn
              (setq fikra-ollama-messages
                (concat fikra-ollama-messages results))
              'done)))))))

;; r137: SIGKILL every live async child (shared by abort AND turn
;; replacement — the epoch bump alone suppressed their evidence while
;; the commands kept running).
(defun fikra-ollama-kill-children ()
  (dolist (k (hashmap-keys fikra-ollama-async-procs))
    (if (hashmap-get fikra-ollama-async-procs k)
      (condition-case nil
        (signal (string-to-number k) "SIGKILL")
        (error () nil)))))

(defun fikra-backend-ollama-abort ()
  ;; The async request cannot be cancelled (the http primitive has no
  ;; abort) — but the turn state settles: a late reply for an aborted
  ;; turn is guarded by pending-message.
  ;; r131 (codex r130 P1#3): the interrupt also INVALIDATES the turn's
  ;; async children — the epoch bump makes their sentinels drop, and
  ;; the children are KILLED (the model's command stops running).
  (setq fikra-ollama-epoch (+ fikra-ollama-epoch 1))
  (fikra-ollama-kill-children)
  ;; r131c: the interrupted turn's pending park dies with it.
  (setq fikra-ollama-parked-call nil)
  (setq fikra-ollama-parked-rest nil)
  (setq fikra-ollama-parked-acc "")
  (setq fikra-ollama-parked-thread nil)
  (dolist (k (hashmap-keys fikra-ollama-async-procs))
    (if (hashmap-get fikra-ollama-async-procs k)
      (condition-case nil
        (signal (string-to-number k) "SIGKILL")
        (error () nil))))
  (if fikra-ollama-pending-message
    (progn
      (setq fikra-ollama-pending-message nil)
      (fikra/thread/fikra-thread-turn-end "interrupted")
      t)
    nil))

;; Test seam: drive the callbacks synthetically (no live server).
;; URL "dead": point the module at an unreachable port AND mark the
;; pending message (the connection-failure path). Anything else: live.
(defun fikra-backend-ollama-seed (id url)
  (if (string= url "dead")
    (progn
      (setq fikra-ollama-url "http://127.0.0.1:1")
      (setq fikra-ollama-pending-message "seeded")
      ;; The fired turn's state (a real fire ran turn-begin; the error
      ;; turn-end is only a legal transition FROM running).
      (fikra/thread/fikra-thread-status-set "running")))
  (editor/keymaps/keymap-mutable-set!
    (editor/keymaps/keymap-named "fikra-http-owners")
    (number-to-string id) "fikra/backend-ollama/fikra-backend-ollama-complete")
  (editor/keymaps/keymap-mutable-set! fikra-ollama-threads
    (number-to-string id) (fikra/thread/fikra-thread-current))
  ;; The latest-request stamp the real fire carries (r110's guard reads
  ;; it — the seed simulates the fire fully).
  (setq fikra-ollama-latest-id id)
  id)

(defun fikra-backend-ollama-seed-unused (id)
  (editor/keymaps/keymap-mutable-set!
    (editor/keymaps/keymap-named "fikra-http-owners")
    (number-to-string id) "fikra/backend-ollama/fikra-backend-ollama-complete")
  ;; The thread identity the real fire stamps (r109 guards read it).
  (editor/keymaps/keymap-mutable-set! fikra-ollama-threads
    (number-to-string id) (fikra/thread/fikra-thread-current))
  ;; The latest-request stamp the real fire carries (r110's guard reads
  ;; it — the seed simulates the fire fully).
  (setq fikra-ollama-latest-id id)
  id)

;; Self-register
(fikra/adapter/fikra-register-backend "ollama")

(provide "fikra-backend-ollama")
)
