(defmodule fikra/thread
  (export fikra-thread-buffer-name fikra-thread-working-dir fikra-thread-in-worktree-p fikra-thread-focus fikra-thread-new fikra-thread-archive fikra-thread-archived-p fikra-thread-switch fikra-thread-rows fikra-thread-ids fikra-thread-init fikra-thread-open fikra-thread-reopen
          fikra-thread-current fikra-thread-status fikra-thread-status-set
          fikra-thread-turn-begin fikra-thread-turn-end fikra-thread-turn-count
          fikra-thread-root fikra-thread-log-path fikra-thread-session-id
          fikra-thread-set-session-id fikra-thread-save fikra-thread-field
          fikra-thread-set-field)

;; #213 (RFC-027 §D3/§D7, Phase 1 — MINIMAL subset): one implicit "main"
;; thread per project. State machine + persistence + reopen-after-restart +
;; project-root detection. NO thread creation/list/worktrees (Phase 4).
;;
;; Thread state lives under <project-root>/.tmax/fikra/threads/<id>/:
;;   events.jsonl — the FAEP log (#212; fikra/event points at it)
;;   state.json   — backend, session-id, runtime-mode, trust, turn-count
;; The FAEP module is the only integration seam: log-set wires the log path.

;; Module deps: FAEP (#212) owns the event log; chat (#206) owns the
;; *Fikra* buffer-local keymap.
(require-module fikra/event)

(defvar fikra-threads (hashmap)
  "Thread-id → state hashmap (in-memory cache).")

(defvar fikra-current-thread-id nil
  "Focused thread id (the minimal subset has only \"main\").")

;; ── project root ────────────────────────────────────────────────────
(defun fikra-thread-root ()
  "Project root = git toplevel of cwd (fallback: cwd)."
  (let ((out (string-trim (shell-command "git rev-parse --show-toplevel 2>/dev/null"))))
    (if (> (length out) 0) out (process-cwd))))

(defun process-cwd ()
  (string-trim (shell-command "pwd")))

;; #221 (RFC-027 §D7): the thread's WORKING dir — the worktree path when
;; in worktree mode (backend cwd + checkpoint captures run there), the
;; local project root otherwise. State (.tmax) stays under the LOCAL root.
;; #222: PER-THREAD chat buffer — main keeps the historical *Fikra* name
;; (back-compat), other threads get *Fikra-<id>*. Concurrent threads
;; stream to separate buffers with no shared state.
(defun fikra-thread-buffer-name ()
  (let ((id (fikra-thread-current)))
    ;; nil-safe: events can render before any thread is focused.
    (if (or (null id) (string= id "main")) "*Fikra*"
      (concat "*Fikra-" id "*"))))

(defun fikra-thread-working-dir ()
  (let ((wt (fikra-thread-field "worktree")))
    (if wt wt (fikra-thread-field "root"))))

(defun fikra-thread-in-worktree-p ()
  (if (fikra-thread-field "worktree") t nil))

;; ── init / open / reopen ────────────────────────────────────────────
(defun fikra-thread-init ()
  "Detect the project root and initialize (or load) the main thread.
Creates .tmax/fikra/threads/main/ and points the FAEP log at it. Returns
the thread id. Idempotent."
  (let* ((root (fikra-thread-root))
         (dir (concat root "/.tmax/fikra/threads/main")))
    (file-mkdir dir)
    (let ((state (fikra-thread-load root "main")))
      (editor/keymaps/keymap-mutable-set! fikra-threads "main" state)
      (setq fikra-current-thread-id "main")
      ;; Wire FAEP at the thread's log; loading resets in-memory events, so
      ;; re-point even when the thread already existed.
      (fikra/event/fikra-event-log-set (concat dir "/events.jsonl"))
      "main")))

(defun fikra-thread-open ()
  "Open the main thread: init-or-load, create *Fikra* when absent, replay
history into it (daemon-restart reopen path), focus it."
  (fikra-thread-init)
  (fikra-thread-ensure-chat-buffer)
  ;; The buffer-local keymap is attached by fikra/chat (chat-open, after
  ;; this returns) — requiring chat here would cycle.
  (buffer-switch (fikra-thread-buffer-name))
  ;; Reopen: replay the full log into the buffer (empty log → empty buffer).
  (fikra/event/fikra-event-rebuild-fikra-buffer)
  (fikra-thread-buffer-name))

(defun fikra-thread-reopen ()
  "Alias of fikra-thread-open (the daemon-restart entry point)."
  (fikra-thread-open))

;; Load state.json for ID under ROOT; absent file → fresh state.
(defun fikra-thread-load (root id)
  (let* ((dir (concat root "/.tmax/fikra/threads/" id))
         (path (concat dir "/state.json"))
         (fresh (hashmap "id" id
                         "root" root
                         "backend" "none"
                         "session-id" nil
                         ;; runtime-mode stays nil until set — #219's
                         ;; fikra/modes owns the default (defvar + setter
                         ;; escape hatch); seeding here would freeze it.
                         "runtime-mode" nil
                         "worktree" nil
                         "worktree-base" nil
                         "archived" nil
                         "trust" (list)
                         "status" "idle"
                         "turn-count" 0)))
    (if (file-exists-p path)
      (let* ((raw (read-file-content path))
             (parsed (if raw (json-read-from-string raw) nil)))
        (if (null parsed)
          fresh
          (let ((state fresh))
            ;; Overlay persisted fields onto fresh defaults (forward-
            ;; compatible: unknown persisted fields ignored, missing fields
            ;; keep defaults).
            (dolist (key (list "backend" "session-id" "runtime-mode" "trust" "worktree" "worktree-base" "archived" "turn-count"))
              (let ((v (fikra-alist-get key parsed)))
                (if (not (null v))
                  (editor/keymaps/keymap-mutable-set! state key v))))
            (editor/keymaps/keymap-mutable-set! state "root" root)
            state)))
      fresh)))

;; alist getter (json-read produces ("k" v) 2-list alists).
(defun fikra-alist-get (key alist)
  (let ((found nil))
    (dolist (entry alist)
      (if (and (not found)
               (listp entry)
               (= (length entry) 2)
               (string= (car entry) key))
        (setq found (car (cdr entry)))))
    found))

(defun fikra-thread-save ()
  "Persist the current thread's state.json."
  (let* ((state (fikra-thread-state)))
    (write-file-content
      (concat (fikra-thread-field "root") "/.tmax/fikra/threads/"
              (fikra-thread-field "id") "/state.json")
      (json-encode (list
                     (list "id" (fikra-thread-field "id"))
                     (list "backend" (fikra-thread-field "backend"))
                     (list "session-id" (fikra-thread-field "session-id"))
                     (list "runtime-mode" (fikra-thread-field "runtime-mode"))
                     (list "trust" (fikra-thread-field "trust"))
                     (list "worktree" (fikra-thread-field "worktree"))
                     (list "worktree-base" (fikra-thread-field "worktree-base"))
                     (list "archived" (fikra-thread-field "archived"))
                     (list "turn-count" (fikra-thread-field "turn-count")))))))

(defun fikra-thread-current ()
  "Current thread id (nil before init)."
  fikra-current-thread-id)

;; #221: focus another thread id (lazy state init happens on first
;; access — fikra-thread-state). Module defvars are not setq-able from
;; outside, hence the setter. Full thread switching machinery is #222.
(defun fikra-thread-focus (id)
  "Focus thread ID (creating its state lazily). Returns the id."
  (setq fikra-current-thread-id id)
  (fikra-thread-state)
  id)

;; ── #222: creation / switching / archive / listing ─────────────────
(defun fikra-thread-ensure-chat-buffer ()
  "Create the current thread's chat buffer (read-only) when absent."
  (let ((name (fikra-thread-buffer-name)))
    (if (not (member name (buffer-list)))
      (progn (buffer-create name) (buffer-set-read-only t)))))

(defun fikra-thread-ids ()
  "All thread ids known for the current project root (disk listing —
a restarted editor sees old threads; the current session's threads are
on disk from their init)."
  (if (not fikra-current-thread-id) (fikra-thread-init))
  (fikra-thread-ids-scan (fikra-thread-field "root") (list)))

(defun fikra-thread-ids-scan (root acc)
  ;; ls the threads dir; registry ids not on disk (created this session,
  ;; dir exists anyway after init) are covered by the dir listing.
  (let ((out (string-trim (shell-command
            (concat "ls -1 " (fikra-shq2 (concat root "/.tmax/fikra/threads/"))
                    " 2>/dev/null || true")))))
    (if (string= out "")
      acc
      (fikra-thread-ids-collect (string-split out "\n") acc))))

(defun fikra-thread-ids-collect (lines acc)
  (if (null lines)
    acc
    (fikra-thread-ids-collect (cdr lines)
      (if (> (length (car lines)) 0) (cons (car lines) acc) acc))))

(defun fikra-thread-new ()
  "Create a NEW thread with a generated short id (fix-<n> style — the
first free number), inheriting the current thread's runtime mode. Focuses
it and opens its chat buffer. Returns the id."
  ;; let*: the id binding READS root — parallel let would see an unbound
  ;; symbol (probe catch).
  (let* ((parent-mode (if fikra-current-thread-id (fikra-thread-field "runtime-mode") nil))
         (root (progn (if (not fikra-current-thread-id) (fikra-thread-init))
                      (fikra-thread-field "root")))
         (id (fikra-thread-free-id root 1)))
    (setq fikra-current-thread-id id)
    (let ((state (fikra-thread-state)))
      (editor/keymaps/keymap-mutable-set! state "id" id)
      (editor/keymaps/keymap-mutable-set! state "root" root)
      ;; Child threads inherit the parent's runtime mode (#219).
      (if parent-mode
        (editor/keymaps/keymap-mutable-set! state "runtime-mode" parent-mode)))
    (fikra-thread-ensure-chat-buffer)
    (buffer-switch (fikra-thread-buffer-name))
    (fikra-thread-save)
    id))

(defun fikra-thread-free-id (root n)
  (let ((candidate (concat "fix-" (number-to-string n))))
    (if (or (file-exists-p (concat root "/.tmax/fikra/threads/" candidate "/state.json"))
            (file-exists-p (concat root "/.tmax/fikra/threads/" candidate "/events.jsonl")))
      (fikra-thread-free-id root (+ n 1))
      candidate)))

(defun fikra-thread-switch (id)
  "Switch focus to thread ID: state, FAEP log pointer, chat buffer, and
modeline all follow; concurrent threads keep independent state."
  (setq fikra-current-thread-id id)
  (let* ((state (fikra-thread-state))
         (dir (concat (fikra-thread-field "root") "/.tmax/fikra/threads/" id)))
    (fikra/event/fikra-event-log-set (concat dir "/events.jsonl"))
    (fikra-thread-ensure-chat-buffer)
    (buffer-switch (fikra-thread-buffer-name))
    (fikra/event/fikra-event-rebuild-fikra-buffer)
    (fikra-refresh-switch-lighter)
    id))

(defun fikra-refresh-switch-lighter ()
  (condition-case nil
    (funcall "fikra/chat/fikra-refresh-lighter")
    (error () nil)))

(defun fikra-thread-archive ()
  "Soft-delete the current thread: hidden from lists, logs + refs
preserved (the retention policy owns real deletion). Cannot archive main."
  (let ((id (fikra-thread-current)))
    (if (string= id "main")
      (progn (editor-set-status "Fikra: main thread cannot be archived") nil)
      (progn
        (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "archived" t)
        (fikra-thread-save)
        (editor-set-status (concat "Fikra: thread " id " archived"))
        t))))

(defun fikra-thread-archived-p (id)
  ;; Read from disk when the thread is not loaded (a restarted editor).
  (if (and (string= id (fikra-thread-current))
           (hashmap-get (fikra-thread-state) "archived"))
    t
    (string= (string-trim (shell-command
      (concat "test -f " (fikra-shq2 (fikra-thread-archived-path id))
              " && jq -r '.archived // empty' "
              (fikra-shq2 (fikra-thread-archived-path id)) " 2>/dev/null || echo no")))
      "true")))

(defun fikra-thread-archived-path (id)
  (concat (if fikra-current-thread-id (fikra-thread-field "root") (process-cwd))
          "/.tmax/fikra/threads/" id "/state.json"))

(defun fikra-thread-rows ()
  "List rows (hashmap: id/backend/mode/location/status/turns) for the
current project's NON-archived threads."
  (fikra-thread-rows-collect (fikra-thread-ids) (list)))

(defun fikra-thread-rows-collect (ids acc)
  (if (null ids)
    (reverse acc)
    (fikra-thread-rows-collect (cdr ids)
      (if (fikra-thread-archived-p (car ids))
        acc
        (cons (fikra-thread-row-for (car ids)) acc)))))

(defun fikra-thread-row-for (id)
  ;; Load that thread's state from disk (or registry when current).
  (let* ((current (string= id (fikra-thread-current)))
         (state (if current (fikra-thread-state) (fikra-thread-load-row id)))
         (get (lambda (k) (if state (hashmap-get state k) nil))))
    (hashmap
      "id" id
      "backend" (funcall get "backend")
      "mode" (funcall get "runtime-mode")
      "location" (if (funcall get "worktree") "worktree" "local")
      "status" (funcall get "status")
      "turns" (funcall get "turn-count"))))

(defun fikra-thread-load-row (id)
  ;; Parse another thread's state.json (registry holds only loaded threads).
  (let ((path (fikra-thread-archived-path id)))
    (if (file-exists-p path)
      (json-read-from-string (read-file-content path))
      nil)))

(defun fikra-shq2 (s)
  (concat "'" s "'"))

(defun fikra-thread-state ()
  "The focused thread's state; LAZY-INITIALIZES the main thread when absent
  (backends may fire turn lifecycle before an explicit init — mutating nil
  would crash; #216 hardening)."
  (let ((id (if fikra-current-thread-id fikra-current-thread-id "main")))
    (let ((state (hashmap-get fikra-threads id)))
      (if state
        state
        (progn
          (setq fikra-current-thread-id id)
          (let* ((root (fikra-thread-root))
                 (dir (concat root "/.tmax/fikra/threads/" id)))
            ;; An implicit thread is a REAL thread — init's contract:
            ;; mkdir + load + FAEP log wiring, so saves and emits work.
            (file-mkdir dir)
            (fikra/event/fikra-event-log-set (concat dir "/events.jsonl"))
            (let ((fresh (fikra-thread-load root id)))
              (editor/keymaps/keymap-mutable-set! fikra-threads id fresh)
              fresh)))))))

(defun fikra-thread-field (key)
  (let ((state (fikra-thread-state)))
    (if state (hashmap-get state key) nil)))

(defun fikra-thread-set-field (key value)
  "Mutate a thread-state field (runtime mode, trust, ...). Callers save."
  (editor/keymaps/keymap-mutable-set! (fikra-thread-state) key value)
  value)

(defun fikra-thread-status ()
  "Current status; an un-initialized thread reads as idle (nil never leaks
into string= transitions — #216 gate-hardening)."
  (let ((s (fikra-thread-field "status")))
    (if s s "idle")))

(defun fikra-thread-turn-count ()
  (fikra-thread-field "turn-count"))

(defun fikra-thread-root-id ()
  (fikra-thread-field "root"))

(defun fikra-thread-log-path ()
  (concat (fikra-thread-field "root") "/.tmax/fikra/threads/"
          (fikra-thread-field "id") "/events.jsonl"))

(defun fikra-thread-session-id ()
  (fikra-thread-field "session-id"))

(defun fikra-thread-set-session-id (sid)
  "Record the backend session id (#214's adapter calls this on the first
turn's init event); persisted on save."
  (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "session-id" sid)
  (fikra-thread-save)
  sid)

;; ── state machine ───────────────────────────────────────────────────
;; idle → running → {idle | error | interrupted}
;; running → confirming → running (approval round-trip; #220 wires it)
;; Validity is CHECKED: illegal transitions error (a crashed adapter must
;; not silently corrupt thread state).
(defun fikra-thread-status-set (new-status)
  (let ((from (fikra-thread-status)))
    (if (not (fikra-transition-valid-p from new-status))
      (error (concat "fikra: illegal thread transition " from " → " new-status))
      (progn
        (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "status" new-status)
        (fikra-thread-save)
        new-status))))

(defun fikra-transition-valid-p (from to)
  (or
    ;; Any state can be reset by open (init path).
    (string= to "idle")
    (and (string= from "idle") (string= to "running"))
    (and (string= from "running")
         (or (string= to "error")
             (string= to "interrupted")
             (string= to "confirming")))
    (and (string= from "confirming")
         (or (string= to "running") (string= to "interrupted")))
    ;; Recovery: error/interrupted resume to running on the next turn.
    (and (or (string= from "error") (string= from "interrupted"))
         (string= to "running"))))

;; ── turn lifecycle (#214's adapter drives these) ───────────────────
;; fikra-thread-turn-begin: bump turn-count, set running, emit turn-start.
;; fikra-thread-turn-end: the AUTHORITATIVE end (process exit per §D3 —
;; checkpoint capture is async follow-up in #217 and never blocks the next
;; turn): emit turn-end, settle the state machine.
(defun fikra-thread-turn-begin ()
  ;; Validate the transition FIRST — an illegal begin must not bump the
  ;; persisted turn count (checked-state hygiene, gate catch).
  (fikra-thread-status-set "running")
  (let* ((state (fikra-thread-state))
         (n (+ 1 (hashmap-get state "turn-count"))))
    (editor/keymaps/keymap-mutable-set! state "turn-count" n)
    (fikra/event/fikra-event-emit
      (list (list "kind" "turn-start")
            (list "turn" (if (numberp n) n (string-to-number (if (stringp n) n "0"))))
            (list "backend" (fikra-thread-field "backend"))))
    ;; Persist the bumped count (a crash before turn-end must still show
    ;; the turn happened).
    (fikra-thread-save)
    n))

(defun fikra-thread-turn-end (status)
  "STATUS: completed | error | interrupted (the turn-end event's status)."
  (fikra/event/fikra-event-emit
    (list (list "kind" "turn-end")
          (list "turn" (fikra-thread-field "turn-count"))
          (list "status" status)))
  ;; Map the event status onto the thread state machine.
  (fikra-thread-status-set
    (cond
      ((string= status "completed") "idle")
      ((string= status "interrupted") "interrupted")
      (t "error"))))

(provide "fikra-thread")
)
