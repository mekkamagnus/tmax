(defmodule stagehand/status
  (export stagehand-status stagehand-status-buffer-name
          stagehand-status-refresh stagehand-status-parse
          stagehand-status-sections stagehand-status-fold-toggle
          stagehand-status-next stagehand-status-prev
          stagehand-status-open-file stagehand-status-quit
          stagehand-status-folded-p stagehand-status-root
          stagehand-status-rows-of stagehand-visible-rows
          stagehand-render-row stagehand-status-diff
          stagehand-git stagehand-shq stagehand-has-commits-p
          stagehand-current-sections stagehand-git-line
          stagehand-visible-pairs stagehand-current-index)

  (require-module stagehand/diff)

;; #286 — Stagehand T0: the *Stagehand* STATUS BUFFER. Foldable sections
;; (Untracked / Unstaged / Staged / Conflicted), row navigation, refresh.
;; THIS issue owns buffer creation, repo selection, parsing, rendering,
;; folding, navigation, refresh, and the error states. The MUTATION keys
;; (s/u/d, c c...) arrive with #287/#288 and bind into this buffer.
;;
;; Parsing: `git status --porcelain=v1 -z` (NUL-delimited — filenames
;; with spaces/quotes/leading dashes/unicode are structurally safe;
;; renames R carry "orig -> new" rendered as "new (from orig)").
;; Sections: ?? → Untracked; worktree-side codes → Unstaged; index-side
;; → Staged; the conflicted set (DD AU UD UA DU AA UU) → Conflicted.
;;
;; Repo selection: FRESH detection at every invocation (no cached root
;; — the project-detect-root pattern). Not a repo → status, no buffer.
;; Git failure → status names exit + stderr; no buffer. Unborn → the
;; buffer renders with a `unborn: <branch>` header. Empty → three empty
;; sections + `nothing to commit, working tree clean`. Detached →
;; `HEAD detached at <sha>`; no upstream → the suffix.

(defvar stagehand-root nil
  "The root this buffer's parse came from (refresh re-runs in place).")
(defvar stagehand-folded (hashmap)
  "Section name → t/nil — fold state, persisted across refresh for
surviving sections (keyed by name).")
(defvar stagehand-cursor-row 0
  "The selected row (line index into the buffer).")

(defun stagehand-status-buffer-name () "*Stagehand*")

(defun stagehand-status-root ()
  "The root this buffer's parse came from (nil before the first
successful render — a failed read never commits a root)."
  stagehand-root)

;; ── parsing ─────────────────────────────────────────────────────────
;; The porcelain -z record stream: "XY <path>" NUL, renames
;; "XY <new>\0<orig>" (TWO NUL fields). Split on the NUL and re-join
;; rename pairs structurally (never by string-search in a path).
(defun stagehand-status-parse (zout)
  "The porcelain -z stream → ((code path rename-from) ...) alist."
  (stagehand-parse-scan (string-split zout (hex-decode "00")) (list) nil))

(defun stagehand-parse-scan (fields out pending-rename)
  ;; pending-rename: a rename's ORIGIN field follows its record.
  (if (null fields)
    (reverse out)
    (let ((f (car fields)))
      (if (or (null f) (string= f ""))
        (stagehand-parse-scan (cdr fields) out pending-rename)
        (if pending-rename
          ;; This field IS the pending rename's origin.
          (stagehand-parse-scan (cdr fields)
            (cons (list (car (cdr pending-rename))    ;; code
                        (car (cdr (cdr pending-rename))) ;; path
                        f)                              ;; rename-from
              out)
            nil)
          (let ((code (substring f 0 2))
                (rest (substring f 3 (length f))))
            (if (stagehand-record-origin-p code)
              ;; Rename/copy: the origin is the NEXT NUL field (check
              ;; EITHER column — git only emits index-side R/C today, but
              ;; a worktree-side record must not leave its origin to be
              ;; mis-parsed as another record).
              (stagehand-parse-scan (cdr fields) out (list "pending" code rest))
              (stagehand-parse-scan (cdr fields)
                (cons (list code rest nil) out) nil))))))))

(defun stagehand-record-origin-p (code)
  (or (string= (substring code 0 1) "R")
      (string= (substring code 0 1) "C")
      (string= (substring code 1 2) "R")
      (string= (substring code 1 2) "C")))

(defun stagehand-status-sections (entries)
  "The parsed entries → ((section-name (rows...)) ...) in display
order: Untracked, Unstaged, Staged, Conflicted."
  (list
    (list "Untracked" (stagehand-rows-for entries "??" "untracked"))
    (list "Unstaged" (stagehand-worktree-rows entries))
    (list "Staged" (stagehand-index-rows entries))
    (list "Conflicted" (stagehand-conflicted-rows entries))))

(defun stagehand-rows-for (entries code kind)
  (stagehand-rows-scan entries code kind (list)))

(defun stagehand-rows-scan (entries code kind out)
  ;; Sections carry the PARSED entry triples (code path rename-from) —
  ;; display strings are a RENDER concern (row identity stays the
  ;; parsed path, never presentation text).
  (if (null entries)
    (reverse out)
    (stagehand-rows-scan (cdr entries) code kind
      (if (stagehand-code-matches-p (car (car entries)) code kind)
        (cons (car entries) out)
        out))))

(defun stagehand-code-matches-p (c code kind)
  (cond
    ((string= kind "untracked")
      (string= (substring c 0 1) "?"))
    ((string= kind "worktree")
      ;; The worktree side (column 2) non-space, non-?, non-conflict.
      (let ((w (substring c 1 2)))
        (and (not (string= w " "))
             (not (string= w "?"))
             (not (stagehand-conflict-code-p c)))))
    ((string= kind "index")
      ;; The index side (column 1) non-space, non-?, non-conflict.
      (let ((i (substring c 0 1)))
        (and (not (string= i " "))
             (not (string= i "?"))
             (not (stagehand-conflict-code-p c))
             ;; Untracked has no index side — exclude ??.
             (not (string= c "??")))))
    (t nil)))

(defun stagehand-conflict-code-p (c)
  (or (string= c "DD") (string= c "AU") (string= c "UD")
      (string= c "UA") (string= c "DU") (string= c "AA")
      (string= c "UU")))

(defun stagehand-conflicted-rows (entries)
  (stagehand-conflict-scan entries (list)))

(defun stagehand-conflict-scan (entries out)
  ;; Entry triples, not display strings (see stagehand-rows-scan).
  (if (null entries)
    (reverse out)
    (stagehand-conflict-scan (cdr entries)
      (if (stagehand-conflict-code-p (car (car entries)))
        (cons (car entries) out)
        out))))

(defun stagehand-worktree-rows (entries)
  (stagehand-rows-for entries "" "worktree"))

(defun stagehand-index-rows (entries)
  (stagehand-rows-for entries "" "index"))

(defun stagehand-render-row (code path rename-from)
  ;; Renames render "new (from orig)". Display text ESCAPES newlines
  ;; (a filename containing one must occupy ONE screen row — identity
  ;; is the parsed path, never this string).
  (concat code " "
          (stagehand-display-escape path)
          (if rename-from
            (concat " (from " (stagehand-display-escape rename-from) ")")
            "")))

(defun stagehand-display-escape (s)
  ;; "\n" → the two visible chars backslash-n (hex literals: the READER
  ;; strips backslash escapes, so the replacement cannot be a "\\n"
  ;; literal).
  (string-replace s (hex-decode "0a") (hex-decode "5c6e")))

(defun stagehand-status-rows-of (sections)
  "The flat DISPLAY rows: header + rendered rows per section (ALL
rows — folding is not applied here; the rendered buffer uses the
fold-aware variant, navigation math uses the complete set)."
  (mapcar (lambda (pair) (car pair)) (stagehand-blocks-of sections nil)))

(defun stagehand-blocks-of (sections respect-fold)
  ;; ((display path code section origin) ...) per visible row, in
  ;; order — display is the rendered text, path/code/origin the PARSED
  ;; entry fields (nil on headers), section the owning section name.
  ;; Position in this list IS row identity. RESPECT-FOLD drops a folded
  ;; section's file rows (the header stays — the unfold affordance).
  (if (null sections)
    (list)
    (let* ((name (car (car sections)))
           (entries (car (cdr (car sections))))
           (hdr (concat name " (" (number-to-string (length entries)) ")")))
      (append
        (if (and respect-fold (stagehand-status-folded-p name))
          (list (list hdr nil nil name nil))
          (cons (list hdr nil nil name nil) (stagehand-entry-pairs name entries)))
        (stagehand-blocks-of (cdr sections) respect-fold)))))

(defun stagehand-entry-pairs (section-name entries)
  ;; ((display path code section origin) ...) for a section's entries.
  (if (null entries)
    (list)
    (let* ((e (car entries))
           (c (car e))
           (p (car (cdr e)))
           (r (car (cdr (cdr e)))))
      (cons (list (stagehand-render-row c p r) p c section-name r)
        (stagehand-entry-pairs section-name (cdr entries))))))

;; ── fold state ──────────────────────────────────────────────────────
(defun stagehand-status-folded-p (section-name)
  (if (hashmap-get stagehand-folded section-name) t nil))

(defun stagehand-status-fold-toggle ()
  "TAB at a header: toggle the section's fold (persisted by name)."
  (let ((row (stagehand-row-at-cursor)))
    (if (stagehand-header-row-p row)
      (let ((name (stagehand-section-name-of row)))
        ;; Sync the counter to the ACTUAL cursor before re-render so the
        ;; position survives the fold (j/k moves count too).
        (setq stagehand-cursor-row (stagehand-current-index))
        (keymap-mutable-set! stagehand-folded name
          (if (stagehand-status-folded-p name) nil t))
        (stagehand-status-rerender))
      (editor-set-status "Stagehand: TAB folds section headers"))))

;; ── navigation ──────────────────────────────────────────────────────
(defun stagehand-status-next ()
  "n — the next VISIBLE row (wraps; skips folded sections' rows)."
  (stagehand-nav 1))

(defun stagehand-status-prev ()
  "p — the previous VISIBLE row (wraps; skips folded sections' rows)."
  (stagehand-nav -1))

(defun stagehand-nav (dir)
  ;; Derive the current row FROM THE CURSOR (j/k moves stay in sync with
  ;; the n/p counter — they are the same position now), then wrap.
  (let ((n (length (stagehand-visible-rows))))
    (if (= n 0)
      nil
      (progn
        (setq stagehand-cursor-row
          (stagehand-wrap (+ (stagehand-current-index) dir) n))
        (stagehand-place-cursor)))))

(defun stagehand-current-index ()
  ;; The visible-row index under the cursor (0 when outside the rows).
  (let ((idx (- (cursor-line) (stagehand-header-line-count)))
        (n (length (stagehand-visible-rows))))
    (if (or (< idx 0) (>= idx n)) 0 idx)))

(defun stagehand-wrap (i n)
  (cond
    ((< i 0) (- n 1))
    ((>= i n) 0)
    (t i)))

(defun stagehand-visible-rows ()
  "The DISPLAY rows with folded sections' FILE rows excluded (headers
stay — they are the unfold affordance)."
  (mapcar (lambda (pair) (car pair))
    (stagehand-blocks-of (stagehand-current-sections) t)))

(defun stagehand-visible-pairs ()
  "The ((display path) ...) pairs behind `stagehand-visible-rows' —
position here is RET's row identity."
  (stagehand-blocks-of (stagehand-current-sections) t))

(defun stagehand-place-cursor ()
  ;; CLAMP to the visible rows: a preserved index that outlived a
  ;; re-render (refresh shrank a section) lands on the last row, not
  ;; beyond the buffer.
  (let ((n (length (stagehand-visible-rows))))
    (if (> n 0)
      (progn
        (setq stagehand-cursor-row (min stagehand-cursor-row (- n 1)))
        (cursor-move (+ (stagehand-header-line-count) stagehand-cursor-row) 0)))))

(defun stagehand-header-line-count () 2)

(defun stagehand-row-at-cursor ()
  ;; The DISPLAY string of the row under the cursor (header checks).
  (nth (stagehand-current-index) (stagehand-visible-rows)))

(defun stagehand-header-row-p (row)
  (and row
       (or (string-prefix-p "Untracked (" row)
           (string-prefix-p "Unstaged (" row)
           (string-prefix-p "Staged (" row)
           (string-prefix-p "Conflicted (" row))))

(defun stagehand-section-name-of (header-row)
  (substring header-row 0
    (stagehand-index-of-str header-row " (")))

(defun stagehand-index-of-str (s pat)
  (stagehand-idx-scan s pat 0 (length s)))

(defun stagehand-idx-scan (s pat i len)
  (if (>= i len)
    nil
    (if (stagehand-starts-with-p s pat i)
      i
      (stagehand-idx-scan s pat (+ i 1) len))))

(defun stagehand-starts-with-p (s pat i)
  (if (> (+ i (length pat)) (length s))
    nil
    (string= (substring s i (+ i (length pat))) pat)))

;; ── actions ─────────────────────────────────────────────────────────
(defun stagehand-status-open-file ()
  "RET on a file row: open the file at the repo root (the grep-hit
landing pattern). Row identity is POSITIONAL — the visible-pairs slot
under the cursor carries the PARSED path, so display text (renames,
escaped newlines, ' (from ' literals) can never redirect RET."
  (let* ((idx (stagehand-current-index))
         (pairs (stagehand-visible-pairs))
         (pair (if (and (>= idx 0) (< idx (length pairs))) (nth idx pairs) nil))
         (path (if pair (car (cdr pair)) nil)))
    (if path
      (find-file (concat stagehand-root "/" path))
      (editor-set-status "Stagehand: no file on this row"))))

;; ── the d dispatch (#289 — diff view) ───────────────────────────────
(defun stagehand-status-diff ()
  "d — the diff view for the row at point. A FILE row: that path
(staged rows → --cached; unstaged/conflicted → the worktree side; a
path argument is always quoted). A SECTION header: the section's OWN
files, side-selected (Staged → --cached + paths; Unstaged/
Conflicted → paths on the worktree side) — never a whole-repo diff.
The Untracked section has NO diff side (v1 does not synthesize
full-file diffs) → refusal status. Git failure → status names it;
the buffer is untouched."
  (let* ((idx (stagehand-current-index))
         (pairs (stagehand-visible-pairs))
         (pair (if (and (>= idx 0) (< idx (length pairs))) (nth idx pairs) nil)))
    (cond
      ((null pair)
        (editor-set-status "Stagehand: no row here"))
      ((null (car (cdr pair)))
        ;; A section header — the section's own files, or the refusal.
        (let ((name (nth 3 pair)))
          (cond
            ((string= name "Untracked")
              (editor-set-status "untracked files — no diff"))
            (t
              (let ((entries (stagehand-entries-of-section name)))
                (if (null entries)
                  (editor-set-status "Stagehand: nothing to diff in this section")
                  (stagehand-diff-run (stagehand-side-of-section name)
                    (stagehand-paths-arg entries)
                    (concat "section: " name)
                    (stagehand-section-path-list entries))))))))
      ((string= (nth 2 pair) "??")
        (editor-set-status "untracked file — no diff"))
      (t
        (stagehand-diff-run (stagehand-side-of-section (nth 3 pair))
          (stagehand-row-paths-arg pair)
          (car (cdr pair))
          (if (nth 4 pair)
            (list (car (cdr pair)) (nth 4 pair))
            (list (car (cdr pair)))))))))

(defun stagehand-side-of-section (section-name)
  ;; Staged rows carry index-side codes → --cached; everything else
  ;; with a diff reads the worktree side.
  (if (string= section-name "Staged") "cached" "worktree"))

(defun stagehand-entries-of-section (name)
  ;; The section's entry triples from the live parse (nil if absent).
  (stagehand-section-scan (stagehand-current-sections) name))

(defun stagehand-section-scan (sections name)
  (if (null sections)
    nil
    (if (string= (car (car sections)) name)
      (car (cdr (car sections)))
      (stagehand-section-scan (cdr sections) name))))

(defun stagehand-section-path-list (entries)
  ;; The section's distinct paths (the view's -- arguments for
  ;; refresh/hunk-op scoping).
  (stagehand-section-paths-scan entries (list)))

(defun stagehand-section-paths-scan (entries out)
  ;; Valve r2: renamed entries contribute their ORIGIN too — the
  ;; view's refresh pathspec needs both sides or git shows a bare
  ;; add where the rename was.
  (if (null entries)
    (reverse out)
    (let* ((e (car entries))
           (p (car (cdr e)))
           (o (car (cdr (cdr e)))))
      (stagehand-section-paths-scan (cdr entries)
        (let ((acc (if (member p out) out (cons p out))))
          (if (and o (not (member o acc))) (cons o acc) acc))))))

(defun stagehand-paths-arg (entries)
  ;; " -- ':(literal)p1' ':(literal)p2' ..." — one -- separator
  ;; (option-shaped filenames like --stat must not become flags), every
  ;; path shell-quoted AND wrapped in git's :(literal) pathspec magic
  ;; (a filename like a*.txt must not glob its siblings). Renamed
  ;; entries contribute their ORIGIN too (the rename diff needs both
  ;; sides or git shows a bare add).
  (stagehand-paths-scan entries " --"))

(defun stagehand-paths-scan (entries acc)
  (if (null entries)
    acc
    (let* ((e (car entries))
           (dest (car (cdr e)))
           (origin (car (cdr (cdr e)))))
      (stagehand-paths-scan (cdr entries)
        (concat acc
          " " (stagehand-shq (stagehand-literal-pathspec dest))
          (if origin
            (concat " " (stagehand-shq (stagehand-literal-pathspec origin)))
            ""))))))

(defun stagehand-literal-pathspec (path)
  ;; Git's literal pathspec magic — disables globbing and pathspec
  ;; interpretation for this argument.
  (concat ":(literal)" path))

(defun stagehand-row-paths-arg (pair)
  ;; The row form: one -- + the literal destination (+ origin when the
  ;; row is a rename/copy — the pair's 5th slot).
  (concat " --"
    " " (stagehand-shq (stagehand-literal-pathspec (car (cdr pair))))
    (if (nth 4 pair)
      (concat " " (stagehand-shq (stagehand-literal-pathspec (nth 4 pair))))
      "")))

(defun stagehand-diff-run (side paths-arg title &optional (paths nil))
  (let* ((flag (if (string= side "cached") " --cached" ""))
         (res (stagehand-git (concat "diff --no-color" flag paths-arg) stagehand-root))
         (out (car res))
         (err (car (cdr res)))
         (exit (car (cdr (cdr res)))))
    (if (and (numberp exit) (> exit 0))
      (editor-set-status
        (concat "Stagehand: git diff failed (" (number-to-string exit)
                ") " (stagehand-first-line err)))
      ;; The view carries side/root/paths so the hunk ops know which
      ;; side they act on and where to apply (#291).
      (stagehand/diff/stagehand-diff-open out
        (concat "Stagehand-Diff: " title)
        side stagehand-root paths))))

(defun stagehand-status-quit ()
  "q — close the buffer. buffer-kill's Editor path picks the
recency-correct survivor (the #307 pattern) — no manual restore."
  (buffer-kill (stagehand-status-buffer-name)))

(defun stagehand-status-refresh ()
  "g — re-parse in place (fold state preserved by section name; the
cursor's row is synced BEFORE the re-render so j/k position survives)."
  (if stagehand-root
    (progn
      (setq stagehand-cursor-row (stagehand-current-index))
      (stagehand-status-render stagehand-root))
    (editor-set-status "Stagehand: no status to refresh")))

;; ── the entry point ────────────────────────────────────────────────
(defun stagehand-detect-root ()
  "The GIT repository root for the current file / client launch dir /
cwd (`rev-parse --show-toplevel`), or nil outside a repository. NOT
the generic project-detect-root: porcelain paths are relative to the
REPO root, so a nested package.json marker must not win (a monorepo
package would mis-join every RET path), and a marker-only directory
with no .git must report 'not in a repository', not a git failure.
Fileless buffers fall back to the CLIENT's launch dir (a daemon's
process cwd is NOT the user's repo — #298), then '.'."
  (let* ((start (or (stagehand-dir-of (buffer-filename))
                    (client-launch-dir)
                    "."))
         (dir (stagehand-abs start))
         (res (shell-exec
                (concat "cd " (stagehand-shq dir)
                        " && git rev-parse --show-toplevel")))
         (out (car res))
         (exit (car (cdr (cdr res))))
         ;; A .git entry (here or in any ANCESTOR — a corrupted repo's
         ;; rev-parse fails from every subdir) with a failing rev-parse
         ;; = a BROKEN repo: the render path reports the honest git
         ;; failure, not a false 'not in a repository'.
         (broken (stagehand-broken-repo-root dir)))
    (cond
      ((and (numberp exit) (= exit 0))
        (string-trim (stagehand-first-line out)))
      (broken broken)
      (t nil))))

(defun stagehand-abs (dir)
  ;; The absolute form of DIR (cd + pwd); DIR unchanged on failure.
  (let* ((res (shell-exec (concat "cd " (stagehand-shq dir) " && pwd")))
         (out (car res))
         (exit (car (cdr (cdr res)))))
    (if (and (numberp exit) (= exit 0))
      (string-trim (stagehand-first-line out))
      dir)))

(defun stagehand-broken-repo-root (dir)
  ;; The nearest ancestor of DIR (DIR included) holding a .git entry.
  (if (or (null dir) (string= dir "") (string= dir "/"))
    nil
    (if (file-exists-p (concat dir "/.git"))
      dir
      (stagehand-broken-repo-root (stagehand-dir-of dir)))))

(defun stagehand-dir-of (path)
  ;; The directory portion of PATH (up to the LAST '/'), else nil.
  (if (or (null path) (string= path ""))
    nil
    (let ((cut (stagehand-last-slash path (- (length path) 1))))
      (if cut (substring path 0 cut) nil))))

(defun stagehand-last-slash (s i)
  (if (< i 0)
    nil
    (if (string= (substring s i (+ i 1)) "/")
      i
      (stagehand-last-slash s (- i 1)))))

(defun stagehand-status ()
  "Open/refresh the *Stagehand* status buffer for the current
repository (fresh root detection every invocation)."
  (interactive)
  (let ((root (stagehand-detect-root)))
    (if (null root)
      (editor-set-status "Stagehand: not in a repository")
      (progn
        ;; A FRESH open starts at the top; refresh (g) preserves.
        (setq stagehand-cursor-row 0)
        (stagehand-status-render root)))))

(defun stagehand-current-sections ()
  ;; stagehand-last-parse is a DEFVAR (a list value), not a function.
  ;; Exported for the cluster's consumers (commit reads the Staged set).
  (stagehand-status-sections stagehand-last-parse))

(defvar stagehand-last-parse (list)
  "The last parse's entries (refresh + navigation read this).")

(defun stagehand-git (args root)
  "Run `git <args>` at ROOT via shell-exec → (stdout stderr exit).
The cwd rides a quoted `cd <root> &&` prefix (shell-exec has no cwd
arg; the quoting is the apostrophe-escape pattern)."
  (shell-exec (concat "cd " (stagehand-shq root) " && git " args)))

(defun stagehand-shq (s)
  ;; Single-quote with apostrophe escaping (the fikra-shq pattern).
  (concat "'" (stagehand-shq-scan s) "'"))

(defun stagehand-shq-scan (s)
  ;; The separator is hex-built (the fikra-thread-sq-join pattern) —
  ;; the T-Lisp reader strips backslashes, so a literal '\'' mangles
  ;; into three bare quotes and any apostrophe-bearing filename BREAKS
  ;; OUT of shell quoting (gate r2 reproduced command execution via a
  ;; crafted filename + d). Never write escape literals directly.
  (stagehand-join (string-split s "'") (concat "'" (hex-decode "5c") "''")))

(defun stagehand-join (parts sep)
  (if (null parts)
    ""
    (if (null (cdr parts))
      (car parts)
      (concat (car parts) sep (stagehand-join (cdr parts) sep)))))

(defun stagehand-status-render (root)
  ;; --untracked-files=all: git collapses a new directory to '?? dir/'
  ;; by default — its files must be individually navigable/openable.
  (let* ((res (stagehand-git "status --porcelain=v1 -z --untracked-files=all" root))
          (out (car res))
          (err (car (cdr res)))
          (exit (car (cdr (cdr res)))))
    (if (and (numberp exit) (> exit 0))
      ;; Failure: NO state commits — a displayed status for repository A
      ;; must keep its root (RET/refresh keep addressing A, not a root
      ;; whose read just failed).
      (editor-set-status
        (concat "Stagehand: git status failed (" (number-to-string exit)
                ") " (stagehand-first-line err)))
      (let ((entries (stagehand-status-parse out)))
        (setq stagehand-root root)
        (setq stagehand-last-parse entries)
        (stagehand-render-buffer root entries)))))

(defun stagehand-first-line (s)
  (let ((l (car (string-split (concat (or s "") "\n") "\n"))))
    (if (and l (> (length l) 0)) l "")))

(defun stagehand-render-buffer (root entries)
  (let ((sections (stagehand-status-sections entries))
        (branch (stagehand-git-line "symbolic-ref --short HEAD" root))
        (upstream (stagehand-git-line
                    "rev-parse --abbrev-ref --symbolic-full-name @{u}" root)))
    (stagehand-ensure-buffer)
    (major-mode-set "stagehand-status")
    (editor-set-mode "normal")
    (buffer-set-read-only nil)
    (stagehand-clear-buffer)
    ;; The header block (2 lines).
    (buffer-append (concat "Stagehand: " root "\n"))
    (buffer-append (concat (stagehand-head-line root branch upstream) "\n"))
    ;; The sections, FOLD-AWARE: a folded section renders its header
    ;; only (the buffer IS the fold display; TAB re-renders through
    ;; here, refresh preserves the fold map by section name). Each row
    ;; is a (display path) pair — the buffer shows the display half.
    (dolist (r (stagehand-blocks-of sections t))
      (buffer-append (concat (car r) "\n")))
    ;; The empty-repo tail.
    (if (stagehand-all-empty-p sections)
      (buffer-append "nothing to commit, working tree clean\n"))
    (buffer-set-read-only t)
    (stagehand-ensure-keymap)
    ;; No cursor reset here: a FRESH open resets at the entry point;
    ;; fold-toggle and refresh (g) PRESERVE the row (place-cursor
    ;; clamps when a re-render shrank the visible rows).
    (stagehand-place-cursor)))

(defun stagehand-head-line (root branch upstream)
  ;; branch = `symbolic-ref --short HEAD` — it RESOLVES on unborn repos
  ;; (so "" means detached, not unborn). No commits + a branch → unborn.
  (cond
    ((and (not (string= branch "")) (= (stagehand-has-commits-p root) 0))
      (concat "unborn: " branch))
    ((string= branch "")
      (concat "HEAD detached at "
              (stagehand-git-line "rev-parse --short HEAD" root)))
    ((string= upstream "")
      (concat branch " no upstream"))
    (t branch)))

(defun stagehand-has-commits-p (root)
  ;; 1 when HEAD resolves (a commit exists); 0 unborn.
  (let ((res (stagehand-git "rev-parse --verify HEAD" root)))
    (if (= (car (cdr (cdr res))) 0) 1 0)))

(defun stagehand-all-empty-p (sections)
  (stagehand-all-empty-scan sections t))

(defun stagehand-all-empty-scan (sections acc)
  (if (null sections)
    acc
    (stagehand-all-empty-scan (cdr sections)
      (and acc (= (length (car (cdr (car sections)))) 0)))))

(defun stagehand-ensure-buffer ()
  ;; Create-then-switch (the fikra idiom): buffer-switch errors on a
  ;; missing buffer.
  (if (not (string= (buffer-current) (stagehand-status-buffer-name)))
    (progn
      (if (not (member (stagehand-status-buffer-name) (buffer-list)))
        (buffer-create (stagehand-status-buffer-name)))
      (buffer-switch (stagehand-status-buffer-name)))))

(defun stagehand-clear-buffer ()
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (buffer-delete-range 0 0 (- count 1) 0)))
  ;; A 1-line remnant row: clear its content.
  (let ((l (buffer-line 0)))
    (if (and l (> (length l) 0))
      (buffer-delete-range 0 0 0 (length l)))))

(defun stagehand-git-line (git-args root)
  "Run `git <args>` at ROOT; the first stdout line ('' on failure)."
  (let* ((res (stagehand-git git-args root))
         (out (car res))
         (exit (car (cdr (cdr res)))))
    (if (and (numberp exit) (= exit 0))
      (string-trim (stagehand-first-line out))
      "")))

(defun stagehand-status-rerender ()
  (if stagehand-root
    (stagehand-render-buffer stagehand-root stagehand-last-parse)))

;; ── the mode + dispatch ────────────────────────────────────────────
;; Buffer-local keys via a *Stagehand* keymap (the fikra-diff pattern:
;; keymap-init + buffer-set-keymap, innermost tier of the #206 chain —
;; full bindings shadow the global map, including outer prefixes like
;; vim's `g` after the #286 keymap-prefix-p refinement). SPC g is the
;; global dispatch. The per-section MUTATION keys (s/u/d, c c on file
;; rows) arrive with #287/#288 and bind into this keymap — absent here.
(major-mode-register "stagehand-status" '() nil)
(major-mode-doc "stagehand-status" "Stagehand git status — TAB folds a section, n/p navigate (wrap), g refreshes (fold state survives), RET opens the file at point, q closes")
(key-bind "SPC g" "(stagehand/status/stagehand-status)" "normal")

(defun stagehand-ensure-keymap ()
  ;; Key spellings are the HANDLER's normalized names ("Enter"/"Tab" —
  ;; what normalizeKey produces from the raw bytes), not the "RET"/"TAB"
  ;; spellings some older keymap entries use.
  (let ((kmap (editor/keymaps/buffer-keymap (stagehand-status-buffer-name))))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "stagehand-status"))
        (editor/keymaps/keymap-set-key kmap "Tab" "(stagehand/status/stagehand-status-fold-toggle)")
        (editor/keymaps/keymap-set-key kmap "n" "(stagehand/status/stagehand-status-next)")
        (editor/keymaps/keymap-set-key kmap "p" "(stagehand/status/stagehand-status-prev)")
        (editor/keymaps/keymap-set-key kmap "g" "(stagehand/status/stagehand-status-refresh)")
        (editor/keymaps/keymap-set-key kmap "q" "(stagehand/status/stagehand-status-quit)")
        (editor/keymaps/keymap-set-key kmap "Enter" "(stagehand/status/stagehand-status-open-file)")
        (editor/keymaps/keymap-set-key kmap "d" "(stagehand/status/stagehand-status-diff)")
        (editor/keymaps/keymap-set-key kmap "c" "(stagehand/commit/stagehand-commit-new)")
        (editor/keymaps/keymap-set-key kmap "C" "(stagehand/commit/stagehand-commit-amend)")
        (editor/keymaps/keymap-set-key kmap "R" "(stagehand/commit/stagehand-commit-reword)")
        (editor/keymaps/keymap-set-key kmap "s" "(stagehand/stage/stagehand-stage-file)")
        (editor/keymaps/keymap-set-key kmap "u" "(stagehand/stage/stagehand-unstage-file)")
        (editor/keymaps/keymap-set-key kmap "D" "(stagehand/stage/stagehand-discard-file)")
        (editor/keymaps/keymap-set-key kmap "S" "(stagehand/stage/stagehand-stage-section)")
        (editor/keymaps/keymap-set-key kmap "U" "(stagehand/stage/stagehand-unstage-section)")
        (editor/keymaps/keymap-set-key kmap "l" "(stagehand/log/stagehand-log-open)")
        (editor/keymaps/keymap-set-key kmap "Z" "(stagehand/stash/stagehand-stash)")
        (editor/keymaps/keymap-set-key kmap "b" "(stagehand/blame/stagehand-blame-row)")
        (editor/keymaps/buffer-set-keymap (stagehand-status-buffer-name) kmap))))
  t)

(provide "stagehand-status"))
