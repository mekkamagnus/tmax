(defmodule editor/commands/edit-commands
  (export vim-delete-char vim-change-char vim-delete-to-line-end vim-change-to-line-end vim-yank-to-line-end vim-paste-after vim-paste-before vim-join-lines visual-change visual-swap-anchor vim-change-number vim-increment-number vim-decrement-number vim-visual-paste vim-visual-paste-block)

;; edit-commands.tlisp -- Single-key Vim edit commands composed in T-Lisp

(defun vim-delete-char (count)
  "Vim x: delete COUNT characters at point."
  (progn
    (undo-begin)
    (let ((deleted (buffer-delete count)))
      (progn
        (set-register "\"" deleted)
        (undo-commit "x")
        (vim-record-change "x" count)
        t))))

(defun vim-change-char (count)
  "Vim cl: delete COUNT characters and enter insert mode."
  (progn
    (vim-delete-char count)
    (editor-set-mode "insert")
    t))

(defun vim-delete-to-line-end ()
  "Vim D: delete to end of current line."
  (progn
    (undo-begin)
    (delete-to-line-end)
    (undo-commit "D")
    (vim-record-change "D" 1)
    t))

(defun vim-change-to-line-end ()
  "Vim C: delete to end of current line and enter insert mode."
  (progn
    (undo-begin)
    (change-to-line-end)
    (undo-commit "C")
    (vim-record-change "C" 1)
    t))

(defun vim-yank-to-line-end ()
  "Vim Y: yank to end of current line."
  (progn
    (yank-to-line-end)
    t))

(defun vim-paste-after (count)
  "Vim p: paste after cursor COUNT times. If a register prefix is active
(the user typed \"x before p), temporarily swap the unnamed register with
the named register's contents so the paste reads from the right place,
then restore. vim-consume-pending-register clears the stash; it lives in
operators.tlisp because vim-pending-register is module-scoped there.

SPEC-044 Phase 2.4: for + or * registers, pull from the OS clipboard
(clipboard-get primitive) instead of the in-memory register."
  (progn
    (undo-begin)
    (let ((register (vim-consume-pending-register)))
      (if register
        (let ((saved (get-register "\"")))
          (progn
            (set-register "\""
              (if (or (string= register "+") (string= register "*"))
                (clipboard-get)
                (get-register register)))
            (paste-after count)
            (set-register "\"" saved)))
        (paste-after count)))
    (undo-commit "p")
    (vim-record-change "p" count)
    t))

(defun vim-paste-before (count)
  "Vim P: paste before cursor COUNT times. See vim-paste-after for the
register-prefix swap-and-restore logic."
  (progn
    (undo-begin)
    (let ((register (vim-consume-pending-register)))
      (if register
        (let ((saved (get-register "\"")))
          (progn
            (set-register "\""
              (if (or (string= register "+") (string= register "*"))
                (clipboard-get)
                (get-register register)))
            (paste-before count)
            (set-register "\"" saved)))
        (paste-before count)))
    (undo-commit "P")
    (vim-record-change "P" count)
    t))

(defun vim-join-lines ()
  "Vim J: join current line with the next line."
  (let ((line (cursor-line)))
    (if (>= (+ line 1) (buffer-line-count))
      (progn
        (editor-set-status "No next line")
        t)
      (let ((first (buffer-line line)))
        (let ((next-line (+ line 1)))
          (let ((second (buffer-line next-line)))
            (let ((joined (concat first " " second)))
              (progn
                (undo-begin)
                (buffer-replace-range line 0 next-line (length second) joined)
                (cursor-move line (length first))
                (undo-commit "J")
                (vim-record-change "J" 1)
                t))))))))

(defun visual-change ()
  "Delete visual selection and enter insert mode."
  (progn
    (undo-begin)
    (visual-delete)
    (undo-commit "visual-change")
    (editor-set-mode "insert")
    t))

(defun vim-visual-paste-block (top left source)
  "Re-insert SOURCE as a block at TOP/LEFT, one segment per line (#230).
Short lines pad with spaces to the block column; segments past the buffer
end append as new lines (inserted at the END of the last line so no
out-of-bounds position ever aborts the paste mid-way). Leaves the cursor
at the block's top-left — the caller moves it there (buffer-insert-at-
position moves the cursor on every insert)."
  (let ((segs (string-split source "\n"))
        (i 0))
    (while (< i (length segs))
      (let ((ln (+ top i)))
        (if (< ln (buffer-line-count))
            (let* ((line-len (length (buffer-get-line ln)))
                   (col (if (< left line-len) left line-len))
                   (pad (- left col)))
              (buffer-insert-at-position ln col
                (if (> pad 0)
                    (concat (make-string pad 32) (nth i segs))
                    (nth i segs))))
            (let* ((last (- (buffer-line-count) 1))
                   (last-len (length (buffer-get-line last))))
              (buffer-insert-at-position last last-len
                (concat "\n" (make-string left 32) (nth i segs))))))
      (set! i (+ i 1)))))

(defun vim-visual-paste ()
  "Vim visual p/P (#230): replace the visual selection with the unnamed
register (or a pending \"x register prefix; +/* read the OS clipboard).
Vim swap — visual-delete leaves the replaced selection in the unnamed
register. Exits to normal mode; cursor on the last pasted character
(charwise), first non-blank of the first pasted line (linewise), or the
block's top-left (blockwise). P === p in visual mode."
  (let ((sel (visual-get-selection)))
    (if (null sel)
        (progn (editor-set-status "No visual selection") t)
        ;; Normalize bounds the way visual-delete does (it does not move the cursor).
        (let* ((sl (nth 0 sel))
               (sc (nth 1 sel))
               (el (nth 2 sel))
               (ec (nth 3 sel))
               (fwd (or (< sl el) (and (= sl el) (<= sc ec))))
               (start-line (if fwd sl el))
               (start-col (if fwd sc ec))
               ;; Block rectangles use the true left/top edges regardless of
               ;; which corner the anchor is (verify-gate: forward-normalized
               ;; cols paste at the wrong column for reversed selections).
               (block-top (if (< sl el) sl el))
               (block-left (if (< sc ec) sc ec))
               (mode (nth 4 sel))
               (reg (vim-consume-pending-register))
               (source (if reg
                           (if (or (string= reg "+") (string= reg "*"))
                               (clipboard-get)
                               (get-register reg))
                           (get-register "\""))))
          (if (string= source "")
              (progn (editor-set-status "Nothing to paste") t)
              (progn
                (undo-begin)
                ;; Removes the selection, sets " to the removed text (the
                ;; swap), exits to normal mode.
                (visual-delete)
                (let ((swapped (get-register "\"")))
                  (set-register "\"" source)
                  (if (string= mode "block")
                      (progn
                        (vim-visual-paste-block block-top block-left source)
                        ;; The per-segment inserts move the cursor; pin it to
                        ;; the block's top-left (verify-gate: docstring claim).
                        (cursor-move block-top block-left))
                      (if (string= mode "line")
                          (progn
                            (cursor-move start-line 0)
                            ;; Deletion through EOF: the remaining last line is
                            ;; above the paste point — lines go below it.
                            (if (>= start-line (buffer-line-count))
                                (paste-after 1)
                                (paste-before 1))
                            (line-first-non-blank))
                          (progn
                            (cursor-move start-line start-col)
                            (paste-before 1)
                            ;; Cursor to the LAST pasted character (single-line
                            ;; registers; multi-line ones follow the primitives'
                            ;; existing \n-implies-linewise behavior).
                            (if (string-match "\n" source)
                                nil
                                (cursor-move (cursor-line)
                                             (+ (cursor-column) (- (length source) 1)))))))
                  (set-register "\"" swapped)
                  (undo-commit "visual-p")
                  (vim-record-change "p" 1)
                  t)))))))

(defun visual-swap-anchor ()
  "Swap visual selection anchor and active endpoint."
  (progn
    (visual-swap-endpoints)
    t))

;; =====================================================================
;; SPEC-067 — numeric increment/decrement (C-a / C-x).
;; The number scan (find the decimal at/after cursor on this line, with a
;; leading '-' only when it is a true sign) is a factual character scan done
;; by the scan-number-on-line primitive. The decision — apply count, replace,
;; land cursor on the last digit — is editor logic owned here.
;; =====================================================================

(defun vim-change-number (delta)
  "Find the number at/after cursor on this line, add DELTA, replace it in
place. Cursor lands on the last digit of the new number (vim semantics).
No number on the line is a no-op. Shared by C-a (delta=+count) and
C-x (delta=-count)."
  (let ((info (scan-number-on-line (cursor-line) (cursor-column))))
    (if (null info)
      (progn
        (vim-count-reset)
        (editor-set-status "No number on line")
        t)
      (let ((start (nth 0 info)))
        (let ((end (nth 1 info)))
          (let ((text (nth 2 info)))
            (let ((line (cursor-line)))
              (let ((new-text (number-to-string (+ (string-to-number text) delta))))
                (progn
                  (vim-count-reset)
                  (undo-begin)
                  (buffer-replace-range line start line end new-text)
                  (cursor-move line (+ start (- (length new-text) 1)))
                  (undo-commit "C-a")
                  (vim-record-change "C-a" 1)
                  t)))))))))

(defun vim-increment-number (count)
  "C-a: increment the number at/after cursor by COUNT (default 1)."
  (vim-change-number count))

(defun vim-decrement-number (count)
  "C-x: decrement the number at/after cursor by COUNT (default 1)."
  (vim-change-number (- count)))
)
