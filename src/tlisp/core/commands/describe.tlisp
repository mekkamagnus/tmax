(defmodule editor/commands/describe
  (export describe-to-help describe-function describe-mode describe-variable describe-key describe-function-at-point describe-variable-at-point describe-key-at-point describe-binding-line apropos apropos-documentation apropos-run apropos-documentation-run cheatsheet helpgrep helpgrep-run helpgrep-jump help-follow help-next-ref help-prev-ref help-back help-forward help-bury help-detect-references help-history-push describe-function-table describe-variable-table info info-next info-prev info-up info-top info-bury info-menu info-goto-node info--render-node info--menu-accept
          info-tlisp info-manual-nodes info-menu-links info-menu-table info-node-table info--goto-accept)

;; describe.tlisp --- SPEC-083 Emacs-style self-documentation.
;;
;; Composes the factual TS primitives in src/editor/api/describe-ops.ts into
;; user-facing commands that render into a reusable *Help* buffer (NOT a
;; reserved buffer per src/editor/CLAUDE.md — it can be killed and is recreated
;; on the next describe call). The TS layer answers "what does this key run",
;; "what is this variable's value", "what does this mode bind"; this file
;; decides HOW to prompt (completing-read / next-key capture) and WHERE to show
;; the answer (the *Help* buffer).
;;
;; Every exported defun has a docstring so it is M-x-discoverable per
;; command-detail-interactive-p (execute-extended-command.tlisp:15-19): a
;; function appears in M-x completion IFF it has a docstring OR a keybinding.

(defvar help-buffer-name "*Help*"
  "Name of the reusable help buffer describe-* commands render into. Not a
reserved buffer (src/editor/CLAUDE.md reserves only *scratch*/*Messages*/*daemon*),
so it can be killed and is recreated on the next describe call.")

(defvar help-return-id nil
  "The identity (buffer-id) of the buffer that was shown when this help
session was opened (#375). q (help-bury) buries *Help* and shows that
buffer again — the buffer, not whichever buffer has its name by then.
nil while no help session is open.")
(defvar help-return-cursor nil
  "The (line column) the cursor had in help-return-buffer when this help
session was opened (#375): q puts it back.")

;; ── Shared renderer ───────────────────────────────────────────────────
(defun describe-to-help (title body)
  "Render TITLE + BODY into the reusable *Help* buffer in help-mode (read-only,
cross-references, history). Creates *Help* if absent and clears it on each call.
Returns the buffer name. Used by every describe-* command so the surface is
consistent."
  (progn
    ;; #375: remember where this help session was opened from. A page opened
    ;; from *Help* itself keeps the FIRST buffer, so q leaves help entirely.
    (unless (string= (buffer-current) help-buffer-name)
      (setq help-return-id (buffer-id))
      (setq help-return-cursor (list (cursor-line) (cursor-column))))
    ;; Push current page onto help history before rendering the new one.
    (help-history-push title body)
    (unless (member help-buffer-name (buffer-list))
      (buffer-create help-buffer-name))
    (buffer-switch help-buffer-name)
    (buffer-set-read-only nil help-buffer-name)
    (let ((lines (buffer-line-count)))
      (when (> lines 1)
        (let ((last-line (- lines 1)))
          (buffer-delete-range 0 0 last-line 100000))))
    (buffer-insert-at-position 0 0 (concat title "\n\n" body))
    (buffer-set-read-only t help-buffer-name)
    (major-mode-set "help")
    (help-detect-references)
    (cursor-move 0 0)
    (editor-set-mode "normal")
    help-buffer-name))

;; ── describe-function ─────────────────────────────────────────────────
;; helpful-style section formatters (SPEC-113 / #180).
(defun help-source-section (src)
  "Format the helpful “Source” section from a help-source-location result
(file:line + excerpt), or empty string when SRC is nil."
  (if (nilp src) ""
    (concat "\n\n— Source —\n"
            (hashmap-get src "file") ":"
            (format "%d" (hashmap-get src "line"))
            "\n\n" (hashmap-get src "excerpt"))))

(defun help-list-section (title sep items)
  "Format a titled section joining ITEMS with SEP, or empty string when ITEMS
is nil or empty."
  (if (or (nilp items) (= (length items) 0)) ""
    (concat "\n\n— " title " —\n" (string-join sep items))))

(defun describe-function (name)
  "Show the signature, docstring, source location + excerpt, key bindings,
references, related, and examples for the named T-Lisp function in *Help*
(helpful-style rich layout, SPEC-113). NAME is a function-name string.
Returns nil for an unknown name. M-x discoverable."
  (let ((resolved (describe-function-data name)))
    (if (nilp resolved)
      (describe-to-help
        (concat "Function: " name)
        (concat name " is not defined."))
      (let* ((rname (hashmap-get resolved "name"))
             (sig (hashmap-get resolved "signature"))
             (doc (hashmap-get resolved "docstring"))
             (mod (hashmap-get resolved "module"))
             (full (hashmap-get resolved "documentation"))
             (keys (hashmap-get resolved "keys"))
             (related (hashmap-get resolved "related"))
             (examples (hashmap-get resolved "examples"))
             (src (help-source-location name))
             (refs (help-symbol-references name)))
        (describe-to-help
          (concat "Function: " rname)
          (concat
            (help-linkify sig) "\n\n"
            (help-linkify doc)
            (if (nilp mod) "" (concat "\n\nFrom module: " mod))
            (help-source-section src)
            (help-list-section "Key bindings" ", " keys)
            (help-list-section "References" ", " refs)
            (help-list-section "Related" ", " related)
            (help-list-section "Examples" "\n" examples)
            (if (nilp full) "" (concat "\n\n" (help-linkify full)))))))))

(defun describe-function-candidate (name)
  "Completion candidate wrapping a callable-command-details entry into the
shape completing-read expects (value/display/annotation/metadata)."
  (hashmap
    "value" name
    "display" name
    "annotation" ""
    "metadata" (hashmap)))

(defun describe-function-complete-p (name _input _action)
  "Always-accept predicate so describe-function completing-read admits any
function name (not just those with a docstring)."
  name)

(defun describe-function-table (input action)
  "Completion table for the describe-function minibuffer. Sources every
visible callable name from callable-command-details."
  (if (string= action "metadata")
    (hashmap "category" "command")
    (mapcar
      (lambda (details)
        (describe-function-candidate (hashmap-get details "name")))
      (callable-command-details))))

(defun describe-function-at-point ()
  "Prompt for a function name via the minibuffer and describe it in *Help*.
Bound to SPC h f. M-x discoverable via this docstring."
  (interactive)
  (completing-read
    "Describe function: "
    "describe-function-table"
    nil
    nil
    ""
    "describe-function-history"
    "describe-function"))

;; ── describe-mode ─────────────────────────────────────────────────────
(defun describe-binding-line (binding)
  "Format one describe-mode binding entry [key command mode docstring] into a
readable line for *Help*."
  (let ((key (nth 0 binding))
        (command (nth 1 binding))
        (doc (nth 3 binding)))
    (concat
      key "  →  [" command "]"
      (if (or (nilp doc) (string= doc "No documentation available"))
        ""
        (concat "  ; " doc)))))

(defun describe-mode (&optional mode)
  "Describe the current buffer's major mode and every key bound in the editor
minor mode (default: the current editor mode). Renders the major mode, editor
mode, and each binding (key → command ; docstring) into *Help*. Bound to
SPC h m. M-x discoverable via this docstring."
  (interactive)
  (let ((result (describe-mode-data (or mode (editor-mode)))))
    (let ((editor (hashmap-get result "editor-mode"))
          (major (hashmap-get result "major-mode"))
          (bindings (hashmap-get result "bindings")))
      (let ((desc (major-mode-description major)))
        (describe-to-help
          (concat "Mode: " editor)
          (concat
            "Major mode: " major
            (if (string= desc "") "" (concat " — " desc))
            "\n"
            "Editor mode: " editor "\n\n"
            "Key bindings:\n"
            ;; #253: string-join the mapcar result (the codebase idiom — concat
            ;; alone stringifies the LIST as [object Object],[object Object],…).
            (string-join "\n" (mapcar "describe-binding-line" bindings))))))))

;; ── describe-variable ─────────────────────────────────────────────────
(defun describe-variable (name)
  "Show the value, documentation, source location, and references of the named
T-Lisp variable in *Help* (helpful-style, SPEC-113). Renders `NAME is <value>`
for a bound variable, or `NAME is not defined` for an unbound one.
Bound to SPC h v. M-x discoverable via this docstring."
  (let ((result (describe-variable-data name)))
    (if (nilp (hashmap-get result "bound"))
      (describe-to-help
        (concat "Variable: " name)
        (concat name " is not defined."))
      (let* ((value (hashmap-get result "value"))
             (doc (hashmap-get result "documentation"))
             (src (help-source-location name))
             (refs (help-symbol-references name)))
        (describe-to-help
          (concat "Variable: " name)
          (concat
            name " is " (format "%s" value) "\n"
            (if (nilp doc) "" (concat "\nDocumentation:\n" (help-linkify doc)))
            (help-source-section src)
            (help-list-section "References" ", " refs)))))))

(defun describe-variable-candidate (name)
  "Completion candidate wrapping a variable name for the describe-variable
minibuffer."
  (hashmap
    "value" name
    "display" name
    "annotation" ""
    "metadata" (hashmap)))

(defun describe-variable-table (input action)
  "Completion table for the describe-variable minibuffer, sourced from
describe-variables-list (every visible non-function global binding)."
  (if (string= action "metadata")
    (hashmap "category" "plain")
    (mapcar "describe-variable-candidate" (describe-variables-list))))

(defun describe-variable-at-point ()
  "Prompt for a variable name via the minibuffer and describe it in *Help*.
Bound to SPC h v. M-x discoverable via this docstring."
  (interactive)
  (completing-read
    "Describe variable: "
    "describe-variable-table"
    nil
    nil
    ""
    "describe-variable-history"
    "describe-variable"))

;; ── describe-key ──────────────────────────────────────────────────────
(defun describe-key (key)
  "Show the command a key runs, plus that command's docstring, in *Help*.
KEY is a key string (e.g. \"j\"). Uses the current editor mode when none is
supplied. Bound to SPC h k. M-x discoverable via this docstring."
  (let ((result (describe-key-data key)))
    (if (nilp result)
      (describe-to-help
        (concat "Key: " key)
        (concat key " is unbound in this mode."))
      (let ((command (hashmap-get result "command"))
            (mode (hashmap-get result "mode"))
            (doc (hashmap-get result "docstring")))
        (describe-to-help
          (concat "Key: " key)
          (concat
            key " runs the command [" command "] (in " mode " mode).\n\n"
            (help-linkify doc)))))))

(defun describe-key-at-point ()
  "Prompt the user to press a key, then describe that key in *Help*. Sets the
describe-key pending flag (the existing describe-key-prompt machinery) so the
next keypress is captured; the actual describe runs in the pending-key
dispatch path. Bound to SPC h k. M-x discoverable via this docstring.

Known limitation: if the SetDescribeKeyPending next-key dispatch is not yet
wired end-to-end, drive (describe-key \"j\") directly via eval — the
docstring-correctness path does not depend on the interactive capture."
  (interactive)
  (describe-key-prompt))

;; ── Apropos (SPEC-107 / #174) ─────────────────────────────────────────
;; Search the live symbol table. `apropos` matches command/function NAMES;
;; `apropos-documentation` matches docstring BODIES (the "I think there's a
;; command for X" tool). Both render to *Help*. The TS primitives
;; (`apropos-command`, `apropos-documentation` in editor.ts) enumerate visible
;; global bindings + module exports; results are (name bindings doc) and
;; (name type doc) respectively.

(defun apropos--render-empty (title)
  "Render a no-matches *Help* page."
  (describe-to-help title "No matches."))

(defun apropos-run (pattern)
  "Run the name-search (apropos-command) for PATTERN and render to *Help*.
Accept-function for `apropos' (called by the minibuffer with the typed regex)."
  (let ((matches (apropos-command pattern)))
    (if (or (nilp matches) (= (length matches) 0))
      (apropos--render-empty (concat "Apropos: " pattern))
      (describe-to-help
        (concat "Apropos: " pattern)
        (string-join
          "\n\n"
          (mapcar
            (lambda (row)
              (let ((name (nth 0 row))
                    (bindings (nth 1 row))
                    (doc (nth 2 row)))
                (concat
                  "[" name "]"
                  (if (or (nilp bindings) (string= bindings "")) "" (concat "  (" bindings ")"))
                  "\n  " doc)))
            matches))))))

(defun apropos-documentation-run (pattern)
  "Run the docstring-search (apropos-documentation) for PATTERN and render to *Help*.
Accept-function for `apropos-documentation'."
  (let ((matches (apropos-documentation pattern)))
    (if (or (nilp matches) (= (length matches) 0))
      (apropos--render-empty (concat "Apropos doc: " pattern))
      (describe-to-help
        (concat "Apropos doc: " pattern)
        (string-join
          "\n\n"
          (mapcar
            (lambda (row)
              (let ((name (nth 0 row))
                    (type (nth 1 row))
                    (doc (nth 2 row)))
                (concat "[" name "]  (" type ")\n  " doc)))
            matches))))))

(defun apropos ()
  "Prompt for a regex and list matching command/function names in *Help*.
Searches NAMES. Bound to SPC h a. M-x discoverable via this docstring."
  (interactive)
  (read-from-minibuffer "Apropos (regex): " "" "apropos-history" "apropos-run"))

(defun apropos-documentation ()
  "Prompt for a regex and list functions whose docstrings match in *Help*.
Searches docstring BODIES. M-x discoverable via this docstring."
  (interactive)
  (read-from-minibuffer "Apropos doc (regex): " "" "apropos-doc-history" "apropos-documentation-run"))

;; ── Help-mode: cross-references + history (SPEC-110, #177) ───────────
(defvar help-history (list))
(defvar help-history-pos 0)
(defvar help-references (list))

(defun help-detect-references ()
  "Scan the current *Help* buffer for [name] patterns; store in help-references."
  (setq help-references (help-scan-references)))

(defun help-history-push (title body)
  "Push (title body) onto the help navigation history before rendering a new page."
  (setq help-history (cons (list title body) help-history))
  (setq help-history-pos 0))

(defun help-history-render (entry)
  "Render a history entry (title body) into *Help* WITHOUT pushing history."
  (let ((title (nth 0 entry))
        (body (nth 1 entry)))
    (buffer-switch help-buffer-name)
    (buffer-set-read-only nil help-buffer-name)
    (let ((lines (buffer-line-count)))
      (when (> lines 1)
        (let ((last (- lines 1)))
          (buffer-delete-range 0 0 last 100000))))
    (buffer-insert-at-position 0 0 (concat title "\n\n" body))
    (buffer-set-read-only t help-buffer-name)
    (major-mode-set "help")
    (help-detect-references)
    (cursor-move 0 0)
    (editor-set-mode "normal")
    help-buffer-name))

(defun help-follow ()
  "Describe the symbol at point in *Help* and push onto history.
Bound to RET in help-mode."
  (interactive)
  (let ((name (symbol-at-point)))
    (if (or (nilp name) (string= name ""))
      (message "No symbol at cursor")
      (describe-function name))))

(defun help-find-next-ref (refs cur-line)
  (if (nilp refs) nil
    (if (> (nth 0 (car refs)) cur-line) (car refs)
      (help-find-next-ref (cdr refs) cur-line))))

(defun help-find-less-ref (refs cur-line)
  (if (nilp refs) nil
    (if (< (nth 0 (car refs)) cur-line) (car refs)
      (help-find-less-ref (cdr refs) cur-line))))

(defun help-next-ref ()
  "Move cursor to the next [name] reference in *Help*. Bound to TAB."
  (interactive)
  (let ((ref (help-find-next-ref help-references (cursor-line))))
    ;; col 1 lands inside the [ brackets so symbol-at-point can read the name.
    (if ref (cursor-move (nth 0 ref) 1) (message "No next reference"))))

(defun help-prev-ref ()
  "Move cursor to the previous [name] reference. Bound to S-TAB."
  (interactive)
  (let ((ref (help-find-less-ref (reverse help-references) (cursor-line))))
    (if ref (cursor-move (nth 0 ref) 1) (message "No previous reference"))))

(defun help-back ()
  "Navigate help history backward (previous page). Bound to l."
  (interactive)
  (let ((new-pos (+ help-history-pos 1)))
    (when (< new-pos (length help-history))
      (setq help-history-pos new-pos)
      (help-history-render (nth help-history-pos help-history)))))

(defun help-forward ()
  "Navigate help history forward (next page). Bound to r."
  (interactive)
  (when (> help-history-pos 0)
    (setq help-history-pos (- help-history-pos 1))
    (help-history-render (nth help-history-pos help-history))))

(defun help-bury ()
  "Leave the help buffer (q in help-mode): bury *Help* and show the buffer
that was shown when this help session was opened — the buffer before the
first page when help was opened from help, or *scratch* when that buffer
is gone. Returns the buried name."
  (interactive)
  (let ((return-id help-return-id)
        (position help-return-cursor))
    (setq help-return-id nil)
    (setq help-return-cursor nil)
    (funcall "bury-buffer-and-switch" help-buffer-name return-id position)))

(major-mode-register "help" '() nil)
(major-mode-doc "help" "Read-only navigation mode for *Help* — RET follows references, TAB cycles, l/r history, q buries")
;; Mode keys are spelled as the key handler names them ("Enter", "Tab",
;; "S-TAB"), so each binding matches the key that was pressed (#368).
(key-bind "Enter" "(help-follow)" "normal" "help")
(key-bind "Tab" "(help-next-ref)" "normal" "help")
(key-bind "l" "(help-back)" "normal" "help")
(key-bind "r" "(help-forward)" "normal" "help")
(key-bind "q" "(help-bury)" "normal" "help")
(key-bind "S-TAB" "(help-prev-ref)" "normal" "help")

;; ── Helpgrep: full-text search over the manual (SPEC-111, #178) ──────
(defun helpgrep-run (pattern)
  "Search the Texinfo manual corpus for PATTERN and render results in *Help*.
Accept-function for `helpgrep'."
  (let ((matches (helpgrep-search pattern)))
    (if (or (nilp matches) (= (length matches) 0))
      (describe-to-help (concat "Helpgrep: " pattern) "No matches in the doc corpus.")
      (describe-to-help
        (concat "Helpgrep: " pattern "  (" (number-to-string (length matches)) " matches)")
        (string-join
          "\n"
          (mapcar
            (lambda (m)
              (concat (nth 0 m) ":" (number-to-string (nth 1 m)) ": " (nth 2 m)))
            matches)))))
  (major-mode-set "helpgrep"))

(defun helpgrep ()
  "Prompt for a regex and full-text search the tmax + T-Lisp manuals.
Distinct from apropos (live symbol metadata) — this searches the WRITTEN prose.
M-x / :helpgrep discoverable via this docstring."
  (interactive)
  (read-from-minibuffer "Helpgrep (regex): " "" "helpgrep-history" "helpgrep-run"))

(defun helpgrep-jump ()
  "Jump to the corpus file + line shown at cursor in *Help*.
Parses the 'file:line:text' format of helpgrep results. Bound to RET in
helpgrep results (major-mode 'helpgrep')."
  (interactive)
  (let ((line (buffer-line (cursor-line))))
    (when (string-match "^\\([a-z]+\\.texinfo\\):\\([0-9]+\\):" line)
      (let ((file (match-string 1))
            (lineno (string-to-number (match-string 2))))
        (funcall "find-file" (concat (helpgrep-docs-dir) "/" file))
        (cursor-move (- lineno 1) 0)))))

;; Register the helpgrep results mode + RET binding.
(major-mode-register "helpgrep" '() nil)
(major-mode-doc "helpgrep" "Helpgrep results mode — RET jumps to the corpus source location")
(key-bind "Enter" "(helpgrep-jump)" "normal" "helpgrep")

;; ── Info reader: browse .info manuals (SPEC-112, #179) ──────────────
(defvar info-nodes (hashmap))
(defvar info-current-node "")
(defvar info-return-id nil
  "The identity (buffer-id) of the buffer that was shown when *Info* was
opened (#375). q (info-bury) buries *Info* and shows that buffer again —
the buffer, not whichever buffer has its name by then. nil while *Info*
is closed.")
(defvar info-return-cursor nil
  "The (line column) the cursor had in info-return-buffer when *Info* was
opened (#375): q puts it back.")
(defvar info-buffer-name "*Info*")

(defun info--render-node (node-name)
  "Render NODE-NAME from info-nodes into *Info* (read-only, major-mode 'info')."
  (let ((node (hashmap-get info-nodes node-name)))
    (if (nilp node)
      (message (concat "Info: node '" node-name "' not found"))
      (progn
        (setq info-current-node node-name)
        (unless (member info-buffer-name (buffer-list))
          (buffer-create info-buffer-name))
        ;; #375: remember where *Info* was entered from. A node opened
        ;; from *Info* itself keeps the FIRST buffer.
        (unless (string= (buffer-current) info-buffer-name)
          (setq info-return-id (buffer-id))
          (setq info-return-cursor (list (cursor-line) (cursor-column))))
        (buffer-switch info-buffer-name)
        (buffer-set-read-only nil info-buffer-name)
        (let ((lines (buffer-line-count)))
          (when (> lines 1)
            (let ((last (- lines 1)))
              (buffer-delete-range 0 0 last 100000))))
        (buffer-insert-at-position 0 0
          (concat "Node: " node-name "\n\n"
            (hashmap-get node "text")))
        (buffer-set-read-only t info-buffer-name)
        (major-mode-set "info")
        (cursor-move 0 0)
        (editor-set-mode "normal")
        info-buffer-name))))

(defun info-next ()
  "Navigate to the Next node. Bound to n in info-mode."
  (interactive)
  (let ((node (hashmap-get info-nodes info-current-node)))
    (when node
      (let ((next (hashmap-get node "next")))
        (when (and next (not (string= next "")))
          (info--render-node next))))))

(defun info-prev ()
  "Navigate to the Previous node. Bound to p in info-mode."
  (interactive)
  (let ((node (hashmap-get info-nodes info-current-node)))
    (when node
      (let ((prev (hashmap-get node "prev")))
        (when (and prev (not (string= prev "")))
          (info--render-node prev))))))

(defun info-up ()
  "Navigate to the Up node. Bound to u in info-mode."
  (interactive)
  (let ((node (hashmap-get info-nodes info-current-node)))
    (when node
      (let ((up (hashmap-get node "up")))
        (when (and up (not (string= up "")) (not (string= up "(dir)")))
          (info--render-node up))))))

(defun info-top ()
  "Navigate to the Top node. Bound to t in info-mode."
  (interactive)
  (info--render-node "Top"))

(defun info-bury ()
  "Leave the manual (q in info-mode): bury *Info* and show the buffer that
was shown when the manual was opened, or *scratch* when that buffer is
gone. Returns the buried name."
  (interactive)
  (let ((return-id info-return-id)
        (position info-return-cursor))
    (setq info-return-id nil)
    (setq info-return-cursor nil)
    (funcall "bury-buffer-and-switch" info-buffer-name return-id position)))

(defun info-menu-links ()
  "The menu items of the current node as (display target) lists, in menu
order — the '* Name::' and '* Name: Node.' lines under its '* Menu:'."
  (let ((node (hashmap-get info-nodes info-current-node)))
    (if (nilp node)
      (list)
      (mapcar
        (lambda (link) (list (nth 1 link) (nth 2 link)))
        (filter
          (lambda (link) (string= (nth 0 link) "menu"))
          (info-parse-links (hashmap-get node "text")))))))

(defun info-candidate (display value)
  "A completion candidate that shows DISPLAY and gives VALUE."
  (hashmap
    "value" value
    "display" display
    "annotation" ""
    "metadata" (hashmap)))

(defun info-menu-table (input action)
  "Completion table of m in info-mode: the menu items of the current node."
  (if (string= action "metadata")
    (hashmap "category" "plain")
    (mapcar
      (lambda (item) (info-candidate (nth 0 item) (nth 1 item)))
      (info-menu-links))))

(defun info-node-table (input action)
  "Completion table of i in info-mode: every node of the open manual, the
Index first — so Enter alone opens the Index."
  (if (string= action "metadata")
    (hashmap "category" "plain")
    (mapcar
      (lambda (name) (info-candidate name name))
      (append
        (filter (lambda (name) (string= name "Index")) (hashmap-keys info-nodes))
        (filter (lambda (name) (not (string= name "Index"))) (hashmap-keys info-nodes))))))

(defun info-menu ()
  "Prompt for a menu item of the current node and show that node (m in
info-mode). The prompt offers the items of the node's '* Menu:' section."
  (interactive)
  (if (nilp (hashmap-get info-nodes info-current-node))
    (message "No current node")
    (let ((items (info-menu-links)))
      (if (or (null items) (= (length items) 0))
        (message "No menu items in this node")
        (completing-read
          "Menu item: "
          "info-menu-table"
          nil
          nil
          ""
          "info-menu-history"
          "info--menu-accept")))))

(defun info--menu-accept (name)
  "Accept-function for info-menu: show the node NAME."
  (when (and name (not (string= name "")))
    (info--render-node name)))

(defun info--goto-accept (name)
  "Accept-function for info-goto-node: show the node NAME, or the Index
node when NAME is empty."
  (info--render-node (if (string= name "") "Index" name)))

(defun info-goto-node ()
  "Prompt for a node of the manual and show it (i in info-mode). The
prompt offers every node; Enter alone opens the Index node, which is the
manual's index."
  (interactive)
  (completing-read
    "Info node (Enter: the Index): "
    "info-node-table"
    nil
    nil
    ""
    "info-node-history"
    "info--goto-accept"))

;; ── The manuals the reader can open ───────────────────────────────────

(defvar info-manuals (list "tmax" "tlisp")
  "The manuals the info reader opens, by name: NAME.info in the docs
directory (helpgrep-docs-dir), where the compiled binary embeds them too.")

(defun info-manual-nodes (manual)
  "The nodes of the manual named MANUAL, or an empty hashmap when its
file is not installed."
  (info-parse (concat (helpgrep-docs-dir) "/" manual ".info")))

(defun info (&optional manual)
  "Open a manual in *Info* at its Top node. With MANUAL — a name of
info-manuals, \"tmax\" or \"tlisp\" — open that manual; with none, the tmax
manual. An unknown name, or a manual whose file is not installed, gives a
message and opens nothing. M-x / :info discoverable."
  (interactive)
  (let ((name (if manual manual "tmax")))
    (cond
      ((not (member name info-manuals))
        (message (concat "info: no manual named '" name "' (manuals: "
          (string-join ", " info-manuals) ")")))
      (t
        (let ((nodes (info-manual-nodes name)))
          (if (not (hashmap-get nodes "Top"))
            (message (concat "info: the " name " manual is not installed (no "
              name ".info in " (helpgrep-docs-dir) ")"))
            (progn
              (setq info-nodes nodes)
              (info--render-node "Top"))))))))

(defun info-tlisp ()
  "Open the T-Lisp manual in *Info* at its Top node (the tlisp manual).
M-x discoverable; (info \"tlisp\") does the same."
  (interactive)
  (info "tlisp"))

(major-mode-register "info" '() nil)
(major-mode-doc "info" "Info reader (the buffer is read-only) — n next node, p previous node, u up, t Top; m picks a menu item, i picks a node (Enter alone: the Index); q leaves. RET does not follow a reference.")
(key-bind "n" "(info-next)" "normal" "info")
(key-bind "p" "(info-prev)" "normal" "info")
(key-bind "u" "(info-up)" "normal" "info")
(key-bind "t" "(info-top)" "normal" "info")
(key-bind "m" "(info-menu)" "normal" "info")
(key-bind "i" "(info-goto-node)" "normal" "info")
(key-bind "q" "(info-bury)" "normal" "info")

;; ── Cheatsheet (SPEC-109, #176) ──────────────────────────────────────
(defun cheatsheet ()
  "Open a read-only cheatsheet buffer with essential tmax keys.
Bound to SPC h c. M-x discoverable via this docstring."
  (interactive)
  (progn
    (unless (member "*Cheatsheet*" (buffer-list))
      (buffer-create "*Cheatsheet*"))
    (buffer-switch "*Cheatsheet*")
    (let ((lines (buffer-line-count)))
      (when (> lines 1)
        (let ((last (- lines 1)))
          (buffer-delete-range 0 0 last 100000))))
    (buffer-insert-at-position 0 0
      (concat
        "tmax Cheatsheet\n\n"
        "Modes:\n"
        "  i           Insert mode\n"
        "  Escape      Normal mode\n"
        "  v / V / C-v Visual (char / line / block)\n"
        "  :           Command mode (:w :q :e FILE)\n"
        "  SPC ;       M-x (command palette)\n\n"
        "Movement:\n"
        "  h j k l     Left / down / up / right\n"
        "  w b e       Word motions\n"
        "  gg  G       Top / bottom of file\n"
        "  0  $        Line start / end\n\n"
        "Editing:\n"
        "  d y c       Delete / yank / change (operators)\n"
        "  p           Paste from kill ring\n"
        "  u  C-r      Undo / redo\n\n"
        "Files:\n"
        "  :e FILE     Open\n"
        "  :w          Save\n"
        "  :q          Quit\n"
        "  :wq         Save and quit\n\n"
        "Help:\n"
        "  SPC h f     Describe function\n"
        "  SPC h m     Describe mode\n"
        "  SPC h k     Describe key\n"
        "  SPC h v     Describe variable\n"
        "  SPC h a     Apropos (name search)\n"
        "  SPC h A     Apropos documentation (docstring search)\n"
        "  SPC h c     This cheatsheet\n"
        "  C-h f/m/v/k Same as SPC h (help prefix)\n"
        "  C-h e/s/a/t View *Messages* / *Shell* / *Async* / *Tests*\n"))
    (buffer-set-read-only t)
    (cursor-move 0 0)))

;; ── Bindings ─────────────────────────────────────────────────────────
;; SPC h prefix (primary help leader):
(key-bind "SPC h f" "(describe-function-at-point)" "normal")
(key-bind "SPC h m" "(describe-mode)" "normal")
(key-bind "SPC h v" "(describe-variable-at-point)" "normal")
(key-bind "SPC h k" "(describe-key-at-point)" "normal")
(key-bind "SPC h a" "(apropos)" "normal")
(key-bind "SPC h A" "(apropos-documentation)" "normal")
(key-bind "SPC h c" "(cheatsheet)" "normal")

;; C-h prefix (SPEC-109, #176): mirrors SPC h for Emacs muscle-memory.
;; C-h a is already view-async-output (observability.tlisp); apropos stays SPC h a.
;; C-h e/s/t are existing log viewers (messages.tlisp + observability.tlisp).
(key-bind "C-h f" "(describe-function-at-point)" "normal")
(key-bind "C-h m" "(describe-mode)" "normal")
(key-bind "C-h v" "(describe-variable-at-point)" "normal")
(key-bind "C-h k" "(describe-key-at-point)" "normal")
(key-bind "C-h A" "(apropos-documentation)" "normal")

(provide "describe")
)
