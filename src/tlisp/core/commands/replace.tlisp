(defmodule editor/commands/replace
  (export query-replace replace-yes replace-no replace-all replace-quit replace-string)

;; replace.tlisp — query-replace commands
(defun query-replace (find replace &optional start end)
  "Start interactive find/replace."
  (interactive)
  (let ((matches (replace-find-matches find start end)))
    (when (null matches)
      (message "No matches found")
      (return-from query-replace))
    (replace-state-init find replace matches)
    (message (concat "Replace " find " with " replace "? (y/n/a/q)"))))

(defun replace-string (find replace &optional start end)
  "Globally replace every occurrence of FIND with REPLACE in the current buffer, non-interactively (no y/n prompts). Returns the replacement count."
  (interactive)
  (let ((matches (replace-find-matches find start end)))
    (when (null matches)
      (message "No matches found")
      (return-from replace-string 0))
    (replace-state-init find replace matches)
    (let ((count (replace-apply-all)))
      (replace-exit)
      (message (concat "Replaced " (number-to-string count) " occurrences"))
      count)))

(defun replace-yes ()
  "Replace current match and advance."
  (replace-apply-current)
  (message "Replaced"))

(defun replace-no ()
  "Skip current match."
  (replace-skip))

(defun replace-all ()
  "Replace all remaining matches."
  (interactive)
  (replace-apply-all)
  (message "All replaced"))

(defun replace-quit ()
  "Exit replace mode."
  (replace-exit)
  (editor-set-mode "normal"))
)
