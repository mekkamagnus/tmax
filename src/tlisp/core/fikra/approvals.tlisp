(defmodule fikra/approvals
  (export fikra-approval-target fikra-approval-risk fikra-approval-enqueue fikra-approval-answer
          fikra-approval-answer-allow fikra-approval-answer-reject
          fikra-approval-answer-always fikra-approval-resolve-guard
          fikra-set-approval-guard fikra-approval-pending-p
          fikra-approvals-ensure-bindings fikra-approval-target-rich
          fikra-approval-baseline-ref fikra-approval-json-command
          fikra-approval-abort-pending fikra-approval-scope-live-p)

;; #220 (RFC-027 §D5 L2, §Security) — Fikra policy on the generic
;; confirmation mechanism (#210): the daemon parks a mediate from the MCP
;; bridge (bin/tmax-mcp-confirmation), this handler validates the scope
;; names a LIVE thread+turn (cross-turn/stale tokens reject BEFORE any
;; prompt), then prompts in *Fikra* with [y] allow / [n] reject / [a]
;; always-allow (buffer-local bindings, confirming state).
;;
;; DEFAULT RESOLVE POLICY: interactive-frames-only. The daemon stamps the
;; resolver kind at dispatch (server.ts: keypress=interactive, eval=
;; headless); a headless client — the threat is an agent with Bash access
;; spawning `tmaxclient --eval` to approve its own request — is DENIED and
;; the prompt stays pending. `always` additionally writes thread trust
;; (#219), which the claude adapter promotes to --allowedTools.
;; The kind fact is READ-ONLY from T-Lisp (confirmation-resolver-kind) —
;; deliberately no setter: eval-reachable code must not self-mark
;; interactive. Users who genuinely want headless resolution install a
;; guard override via fikra-set-approval-guard (deliberate, visible).

(require-module fikra/event)
(require-module fikra/thread)

;; Registered for source "fikra" — the token's minted source must match.
(confirmation-handler-register "fikra" "fikra/approvals/fikra-approval-enqueue")

(require-module fikra/modes)

(defvar fikra-approval-pending-id nil
  "The parked mediate id the y/n/a keys answer (single pending per thread
until #222's child threads).")

(defvar fikra-approval-pending-kind nil
  "The pending request's action class (trust key on always-allow).")

(defvar fikra-approval-guard-override nil
  "User override: a T-Lisp fn NAME (string) replacing the default
interactive-frames-only guard. Set via fikra-set-approval-guard only
(module defvars are not setq-able cross-module) — a deliberate act.")

(defun fikra-set-approval-guard (fn-name)
  "Override the approval resolve guard (default: interactive-frames-only).
FN-NAME is a T-Lisp function name answering t/nil.
PROVENANCE-CHECKED (gate catch): refuses a headless caller — an agent
reaching this via eval must not install a trivially-passing guard and
unlock its own approvals. Installing the override ALSO relaxes the
primitive-level policy (the enforcement lives in BOTH layers)."
  (if (string= (confirmation-resolver-kind) "headless")
    (progn
      (editor-set-status "Fikra: guard override refused — interactive client required")
      nil)
    (progn
      (setq fikra-approval-guard-override fn-name)
      (confirmation-set-resolve-policy "permissive")
      fn-name)))

(defun fikra-approval-resolve-guard ()
  "t when the CURRENT resolver may answer approvals. Default policy:
anything except a headless eval client. An override fn, when installed,
decides instead."
  (if fikra-approval-guard-override
    (funcall fikra-approval-guard-override)
    (not (string= (confirmation-resolver-kind) "headless"))))

;; ── scope liveness (the cross-turn gate) ────────────────────────────
;; Scope format: "<thread-id>/<turn>" — minted by the adapter per turn.
;; A token from an earlier turn (turn-count moved on), another thread, or
;; a mid-turn-less moment (status not running) is DEAD: reject before any
;; prompt is shown.
(defun fikra-approval-scope-live-p (scope)
  (let ((parts (string-split scope "/")))
    (if (not (= (length parts) 2))
      nil
      (let ((thread (car parts))
            (turn-str (car (cdr parts))))
        ;; string-to-number THROWS on garbage — regex-gate first
        ;; (string-match returns the match INDEX or nil; there is no
        ;; string-match-p builtin — chat.tlisp's old calls are latent).
        (if (null (string-match "^[0-9]+$" turn-str))
          nil
          (let ((turn (string-to-number turn-str)))
            (and (string= thread (fikra/thread/fikra-thread-current))
                 (= turn (fikra/thread/fikra-thread-turn-count))
                 (string= (fikra/thread/fikra-thread-status) "running"))))))))

;; The mockup's target context (8.3): "src/client/.legacy-render/  (14
;; files, 3.1 MB)" — a DIRECTORY target carries its file count and size,
;; so the reviewer sees the blast radius before answering (r80).
;; r81 (codex r80 catch 3): ANY name resolving to an existing directory
;; enriches (bare "lib" was missed); ABSOLUTE targets are used as-is
;; (they were wrongly re-prefixed with the working dir). Non-dirs pass
;; through unchanged.
(defun fikra-approval-target-rich (target)
  (if (string= target "")
    target
    (let* ((dir (fikra/thread/fikra-thread-working-dir))
           (abs (if (string-prefix-p "/" target)
                  target
                  (concat dir "/" target)))
           (is-dir (string= (string-trim (shell-command
                          (concat "test -d " (fikra/thread/fikra-thread-shq abs)
                                  " && echo yes || echo no"))) "yes")))
      (if (not is-dir)
        target
        (concat target "  ("
                (string-trim (shell-command
                  (concat "find " (fikra/thread/fikra-thread-shq abs)
                          " -type f 2>/dev/null | wc -l | tr -d ' '")))
                " files, "
                (string-trim (shell-command
                  (concat "du -sh " (fikra/thread/fikra-thread-shq abs)
                          " 2>/dev/null | cut -f1")))
                ")")))))

;; The verified turn-begin baseline ref NAME (refs/fikra/<id>/<n>-baseline
;; as "fikra/<id>/<n>-baseline") — "" when the capture has not landed (the
;; panel must not synthesize a ✓ it cannot honor: r81, codex r80 catch 2).
(defun fikra-approval-baseline-ref ()
  (condition-case nil
    (let* ((id (fikra/thread/fikra-thread-current))
           (n (fikra/thread/fikra-thread-turn-count))
           (ref (concat "refs/fikra/" id "/" (number-to-string n) "-baseline")))
      (if (string= (string-trim (shell-command
              (concat "git -C " (fikra/thread/fikra-thread-shq (fikra/thread/fikra-thread-working-dir))
                      " rev-parse --verify -q " ref " >/dev/null 2>&1 && echo yes || echo no"))) "yes")
        (concat "fikra/" id "/" (number-to-string n) "-baseline")
        ""))
    (error () "")))

(defun fikra-approval-pending-p ()
  "t when an approval is waiting — EITHER a parked mediate (#220) OR a
backend pause (#303's gate: the turn is parked at a permission awaiting
the user's y/n/a — the same signal the modeline's approval-required
segment reads)."
  (require-module fikra/adapter)
  (if (or fikra-approval-pending-id (fikra/adapter/fikra-backend-pending-p)) t nil))

;; ── the registered handler (runs at mediate-park time) ─────────────

;; The detail's actionable TARGET: the first PATH-looking token (a word
;; containing "/"), else the first word (the command). Word-scanning keeps
;; the path whole ("src/x.ts", never "/x.ts") and skips filler.
;; claude's permission detail carries the tool input as JSON — when a
;; "command" key exists its VALUE is the actionable target (the raw word
;; scan grabbed the '{"command":"touch' blob — r82 live catch).
(defun fikra-approval-json-command (detail)
  ;; Mode base is "" (not nil): cond's (string= mode ...) TESTS would
  ;; throw on a nil mode before the fallback branch is reached.
  (fikra-approval-json-scan (string-split detail "\"") ""))

(defun fikra-approval-json-scan (parts mode)
  (if (null parts)
    nil
    (let ((p (car parts)))
      (cond
        ((string= mode "want-colon")
          (if (string= (string-trim p) ":")
            (fikra-approval-json-scan (cdr parts) "want-value")
            (fikra-approval-json-scan (cdr parts) nil)))
        ((string= mode "want-value")
          (fikra-approval-json-acc parts ""))
        (t
          (if (or (string= p "command") (string= (string-trim p) "{command")
                  (string= (string-trim p) ",command"))
            (fikra-approval-json-scan (cdr parts) "want-colon")
            (fikra-approval-json-scan (cdr parts) "")))))))

;; Collect the value across ESCAPED quotes (r83, codex r82 P2): a command
;; with quoted args arrives as JSON 'echo \"hi\" there' — the quote-split
;; leaves the escape backslash at each part's end; rejoin with the quote
;; until a part does NOT end in a backslash.
(defun fikra-approval-json-acc (parts acc)
  (if (null parts)
    (if (> (length acc) 0) acc nil)
    (let ((p (car parts)))
      (if (and (> (length p) 0)
               (string= (substring p (- (length p) 1) (length p)) (hex-decode "5c")))
        ;; DECODE the escape: drop the backslash, keep the quote (the JSON
        ;; value's backslash is the ESCAPE, not part of the command).
        (fikra-approval-json-acc (cdr parts)
          (concat acc (substring p 0 (- (length p) 1)) (hex-decode "22")))
        (let ((final (concat acc p)))
          (if (> (length final) 0) final nil))))))

(defun fikra-approval-target (detail)
  (let ((cmd (fikra-approval-json-command detail)))
    (if cmd cmd (fikra-approval-target-words (string-split detail " ") nil))))

;; Two slots (r71): WORD — the first short non-filler word (the command
;; fallback); PATH — the first word containing "/". The FIRST path wins
;; over any word and stops the scan; a long PATH still qualifies (the
;; cap applies only to the word fallback).
(defun fikra-approval-target-words (words word)
  (if (null words)
    word
    (let ((w (car words)))
      (if (string-match "/" w)
        w
        (if (or (string= w "") (string= w "to") (string= w "in") (string= w "at")
                (> (length w) 36))
          (fikra-approval-target-words (cdr words) word)
          (if word
            (fikra-approval-target-words (cdr words) word)
            (fikra-approval-target-words (cdr words) w)))))))

;; "rm <glob>" (rm *.txt / rm build/*) — a byte scan; the regex '*'
;; escape is reader-fragile (the r117 catch: the reader strips the
;; backslash and the engine sees a bare '*').
(defun fikra-risk-has-glob-rm (d)
  (let ((i (string-match "rm " d)))
    (if (and i (numberp i))
      (fikra-glob-scan (substring d (+ i 3) (length d)) 0)
      nil)))

(defun fikra-glob-scan (s i)
  (if (>= i (length s))
    nil
    (if (string= (substring s i (+ i 1)) "*")
      t
      (fikra-glob-scan s (+ i 1)))))

(defun fikra-approval-risk (kind detail)
  ;; Destructive first (any tool can carry it), then the tool class —
  ;; BOTH case-insensitive (the detail is downcased; "drop table" counts).
  (let ((d (fikra-risk-down detail)))
    (if (or (string-match "rm -rf" d)
            (string-match "rm -fr" d)
            (string-match "git push --force" d)
            (string-match "git reset --hard" d)
            (string-match "drop table" d)
            ;; r117 (codex r116 P1#3): the deletion-class evasions —
            ;; find -delete, xargs rm, rm without -f on a glob, and the
            ;; truncate/clobber family.
            (string-match "find .*-delete" d)
            (string-match "xargs rm" d)
            (fikra-risk-has-glob-rm d)
            (string-match "truncate -s" d)
            (string-match "> /dev/null.*rm" d)
            (string-match "shred " d))
    "destructive"
    (if (or (string= (fikra-risk-down kind) "bash") (string= (fikra-risk-down kind) "shell"))
      "shell"
      (if (or (string= (fikra-risk-down kind) "edit") (string= (fikra-risk-down kind) "write")
              (string= (fikra-risk-down kind) "buffer-edit"))
        "file-edit"
        "")))))

(defun fikra-risk-down (s)
  (if s (fikra-risk-down-scan s 0 "") ""))

(defun fikra-risk-down-scan (s i acc)
  (if (>= i (length s))
    acc
    (fikra-risk-down-scan s (+ i 1)
      (concat acc (fikra-risk-lower (substring s i (+ i 1)))))))

;; Downcase ONE char via the uppercase alphabet index (string<= does not
;; exist in this dialect — string= only).
(defun fikra-risk-lower (ch)
  (if (>= (length ch) 1)
    (let ((i (fikra-risk-alpha-index ch 0)))
      (if i
        (substring "abcdefghijklmnopqrstuvwxyz" i (+ i 1))
        ch))
    ch))

(defun fikra-risk-alpha-index (ch i)
  (if (>= i 26)
    nil
    (if (string= (substring "ABCDEFGHIJKLMNOPQRSTUVWXYZ" i (+ i 1)) ch)
      i
      (fikra-risk-alpha-index ch (+ i 1)))))


(defun fikra-approval-enqueue (id detail kind scope)
  "A confirmation/mediate arrived for fikra. Validate the scope names a
LIVE thread+turn; dead correlation → reject immediately (no prompt).
Live → permission-request FAEP event, confirming state, y/n/a prompt."
  (if (not (fikra-approval-scope-live-p scope))
    (progn
      ;; Settles the parked mediate reject — the subprocess unblocks; no
      ;; prompt was ever shown.
      (confirmation-resolve id "reject")
      (editor-set-status "Fikra: approval rejected (dead correlation)"))
    (progn
      (setq fikra-approval-pending-id id)
      (setq fikra-approval-pending-kind kind)
      (fikra-approvals-ensure-bindings)
      (fikra/event/fikra-event-emit
        (list (list "kind" "permission-request")
              (list "action" (concat kind ": " detail))
              (list "id" id)
              ;; Mockup 8.3 fields (r70): the panel's context rows —
              ;; tool name, target (the detail's leading path/cmd), the
              ;; thread+turn the gate belongs to, and the risk tag.
              (list "tool" kind)
              (list "target" (fikra-approval-target-rich (fikra-approval-target detail)))
              (list "thread" (fikra/thread/fikra-thread-current))
              (list "turn" (number-to-string (fikra/thread/fikra-thread-turn-count)))
              (list "risk" (fikra-approval-risk kind detail))
              ;; Provenance (codex rounds 12/16: richer approval presentation):
              ;; the runtime mode that GATED this action, the content
              ;; CHECKPOINT the turn began from (the stash baseline tree —
              ;; revert target), and the resolver origin.
              (list "mode" (fikra/modes/fikra-effective-mode))
              ;; r81: the ✓ is EARNED — the verified baseline ref name, or
              ;; "" (the panel then says revert unavailable).
              (list "checkpoint" (fikra-approval-baseline-ref))
              ;; r86 reword (codex r85 P1): the scope check proves the
              ;; token names a live thread+turn — with once-per-scope
              ;; minting the token cannot be re-obtained, so a fabricated
              ;; prompt needs the adapter's own token.
              (list "origin" (concat "model="
                              (condition-case nil
                                (fikra/adapter/fikra-current-backend)
                                (error () "?"))
                              " · token scope " scope " live (mint-locked)"))))
      ;; running → confirming (checked transition — an illegal enqueue
      ;; errors rather than corrupting thread state).
      (fikra/thread/fikra-thread-status-set "confirming")
      ;; The emit's refresh hook ran BEFORE this transition — the queued
      ;; modeline segment needs one more beat (r85).
      (condition-case nil
        (progn (require-module fikra/chat)
               (fikra/chat/fikra-refresh-lighter))
        (error () nil))
      (editor-set-status
        ;; Mockup 8.3 key labels (r80); y/n remain bound as aliases.
        (concat "Fikra: approve " kind "? a Allow · r Reject · A Always · C-g abort"))
      t)))

;; Abort settles a parked mediate as REJECTED (r86, codex r85 P2): the
;; turn is dead — the bridge must unblock and the pending state clear.
;; Denial direction: safe regardless of resolver kind.
(defun fikra-approval-abort-pending ()
  (if (null fikra-approval-pending-id)
    nil
    (progn
      (let ((id fikra-approval-pending-id))
        (setq fikra-approval-pending-id nil)
        (setq fikra-approval-pending-kind nil)
        (fikra/event/fikra-event-emit
          (list (list "kind" "permission-response")
                (list "decision" "reject")))
        ;; confirmation-CANCEL, not resolve (r87, codex r86 P2#3): cancel
        ;; is the policy-free DENIAL direction — the interactive-only
        ;; resolve policy rightly refuses headless callers, and an abort
        ;; must unblock the bridge regardless of who interrupted.
        (confirmation-cancel id))
      (if (string= (fikra/thread/fikra-thread-status) "confirming")
        (fikra/thread/fikra-thread-status-set "running"))
      t)))

;; ── answering ────────────────────────────────────────────────────────
(defun fikra-approval-answer (decision)
  "Answer the pending approval (allow | reject | always). The BACKEND
pause takes precedence (#303's gate — the P1 interactive loop: pause →
USER KEY → resume; the fixture backend proves the seam a native backend
adopts); otherwise the parked mediate path (#220): guarded, a headless
resolver is DENIED and the prompt stays pending. always also writes
thread trust (promoted to --allowedTools on later turns)."
  (require-module fikra/adapter)
  (if (fikra/adapter/fikra-backend-pending-p)
    ;; The L2 guard is enforced at the ADAPTER's decide seam (r78: it
    ;; lived here first — a direct eval of fikra-backend-decide bypassed
    ;; it; enforcement belongs at the service primitive, not one caller).
    (fikra/adapter/fikra-backend-decide
      (if (string= decision "allow") "y"
        (if (string= decision "reject") "n" "a")))
    (if (null fikra-approval-pending-id)
      (progn
        (editor-set-status
          ;; codex r77 catch 2: confirming with nothing parked — the
          ;; backend lacks the pause seam; say so instead of a bare
          ;; "no pending" (the idle variant stays unchanged).
          (if (string= (fikra/thread/fikra-thread-status) "confirming")
            "Fikra: no pending approval — this backend cannot take approval keys"
            "Fikra: no pending approval"))
        nil)
    (if (not (fikra-approval-resolve-guard))
      (progn
        ;; The denial leaves the mediate PARKED (pending) — only an
        ;; interactive client may settle it.
        (editor-set-status
          "Fikra: approval resolve DENIED — interactive client required; prompt stays pending")
        nil)
      (let ((id fikra-approval-pending-id)
            (kind fikra-approval-pending-kind))
        (setq fikra-approval-pending-id nil)
        (setq fikra-approval-pending-kind nil)
        ;; First resolver wins; a lost race returns nil (audited).
        (let ((won (confirmation-resolve id decision)))
          (fikra/event/fikra-event-emit
            (list (list "kind" "permission-response")
                  (list "decision" decision)))
          (if (string= decision "always")
            (progn
              (require-module fikra/modes)
              (fikra/modes/fikra-trust-add kind)
              (message "Fikra: %s trusted for this thread (--allowedTools on later turns)" kind)))
          ;; confirming → running (only if still confirming — the turn may
          ;; have ended under us; that settle is the turn's business).
          (if (string= (fikra/thread/fikra-thread-status) "confirming")
            (fikra/thread/fikra-thread-status-set "running"))
          won))))))

(defun fikra-approval-answer-allow () (fikra-approval-answer "allow"))
(defun fikra-approval-answer-reject () (fikra-approval-answer "reject"))
(defun fikra-approval-answer-always () (fikra-approval-answer "always"))

;; ── buffer-local y/n/a in *Fikra* ───────────────────────────────────
;; Extends chat's buffer keymap (created on first use by chat's ensure —
;; during a real turn the buffer always exists; bindings tolerate a nil
;; keymap by re-running on the next enqueue).
(defun fikra-approvals-ensure-bindings ()
  (require-module fikra/chat)
  (fikra/chat/fikra-ensure-buffer-keymap)
  (let ((kmap (editor/keymaps/buffer-keymap (fikra/thread/fikra-thread-buffer-name))))
    (if kmap
      (progn
        ;; Mockup 8.3 (r80): a Allow / r Reject / A Always; y/n stay as
        ;; aliases (the pre-r80 muscle memory).
        (editor/keymaps/keymap-set-key kmap "a" "(fikra/approvals/fikra-approval-answer-allow)")
        (editor/keymaps/keymap-set-key kmap "r" "(fikra/approvals/fikra-approval-answer-reject)")
        (editor/keymaps/keymap-set-key kmap "A" "(fikra/approvals/fikra-approval-answer-always)")
        (editor/keymaps/keymap-set-key kmap "y" "(fikra/approvals/fikra-approval-answer-allow)")
        (editor/keymaps/keymap-set-key kmap "n" "(fikra/approvals/fikra-approval-answer-reject)"))))
  t)

(provide "fikra-approvals")
)
