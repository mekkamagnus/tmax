(defmodule editor/commands/grep-consult
  (export grep-consult grep-consult-parse-query grep-consult-on-input
          grep-consult-accept grep-consult-cancel grep-consult-table
          grep-consult-glob->regex grep-consult-glob-match-p
          grep-consult-test-end grep-consult-pattern-of grep-consult-glob-of
          grep-consult-files-in grep-consult-filtered-files
          grep-consult-fire
          grep-consult-test-begin
          grep-consult-parse-globs
          grep-consult-state-get grep-consult-preview
          grep-consult-style-filter)

;; #311 — the consult-grade interactive search layer (RFC-031 §2.4)
;; on #307's producer interface + #308's backend + #310's scope
;; preflight. The QUERY GRAMMAR is a left-to-right parser:
;;   ## → a literal # in the pattern
;;   the first UNESCAPED # → the pattern/glob boundary
;;   everything after (incl. further #s) → the glob side
;; 'foo#bar#baz' → pattern "foo", glob "bar#baz".
(require-module editor/commands/grep)
(require-module editor/completion/minibuffer)
(require-module editor/completion/orderless)
(require-module editor/completion)

;; valve r3 finding 1: the default styles filter candidates against
;; the WHOLE input — a glob query ('consult#*.lisp') zeroes the
;; candidate list (no display contains the literal '#*.lisp'). The
;; consult category matches the PATTERN side only.
(editor/completion/completion-register-style
  "consult-pattern" "editor/commands/grep-consult/grep-consult-style-filter")
(editor/completion/completion-set-category-styles
  "grep-consult" (list "consult-pattern"))

(defvar grep-consult-state nil
  "The consult session: {query, pendingGen, completedSnapshot,
timerId, preview-pane, preview-borrowed, preview-prior}.")
(defvar grep-consult-scope nil
  "The resolved scope for this consult invocation (frame-local in
spirit; one consult at a time per frame — the minibuffer is
single-session).")

(defun grep-consult-state-get () grep-consult-state)

(defun grep-consult-test-end ()
  "A test seam: tear the session down (module defvars are not
setq-able across the boundary)."
  (setq grep-consult-state nil)
  (setq grep-consult-scope nil)
  (editor/commands/grep/grep-completion-hook-set! nil)
  t)

(defun grep-consult-test-begin ()
  "A test seam: initialize the session state (module defvars are
not setq-able across the module boundary) — entry-equivalent,
INCLUDING the completion hook (gate r2: without it a direct-path
completion never wrote the snapshot the restore rule needs)."
  (setq grep-consult-scope ".")
  (setq grep-consult-state
    (hashmap "query" "" "pendingGen" nil "completedSnapshot" nil
      "snapshotContent" nil
      "timerId" nil "preview-pane" nil "preview-borrowed" nil
      "preview-prior" nil))
  (editor/commands/grep/grep-completion-hook-set!
    (lambda (status) (grep-consult-on-complete status)))
  t)

;; ── the query grammar ───────────────────────────────────────────────
(defun grep-consult-parse-query (q)
  "Left-to-right: ## → literal # in the pattern; the first
UNESCAPED # ends the pattern; the rest (incl. #s) is the glob.
Returns (pattern glob|nil)."
  (grep-consult-parse-scan q "" nil))

(defun grep-consult-parse-scan (rest pat saw-hash)
  (if (= (length rest) 0)
    (list pat saw-hash)
    (let ((two (>= (length rest) 2))
          (c0 (substring rest 0 1)))
      (cond
        ((and two (string= (substring rest 0 2) "##"))
          (grep-consult-parse-scan (substring rest 2 (length rest))
            (concat pat "#") saw-hash))
        ((string= c0 "#")
          ;; The FIRST unescaped # — the boundary; the REST is glob.
          (list pat (substring rest 1 (length rest))))
        (t
          (grep-consult-parse-scan (substring rest 1 (length rest))
            (concat pat c0) saw-hash))))))

;; ── glob translation (fnmatch-style → T-Lisp regex) ───────────────
(defun grep-consult-glob->regex (glob)
  "Translate ONE glob entry. valve r2: LITERAL characters are
CLASS-ESCAPED ([.], [$], … — the reader strips backslashes, so
[.]-classes are the only escape form T-Lisp can build; '*.tlisp'
used to also match 'Xtlisp'). * → .*; ? → .; [class] passes through
verbatim (so fnmatch [^…] negation works). A bare ^ or backslash
outside a class, an EMPTY class [], or an unterminated class → nil
(untranslatable — the entry is ignored + noted)."
  (let ((body (grep-consult-glob-scan glob "" nil)))
    (if (stringp body)
      (let ((rx (concat "^" body "$")))
        ;; valve r3 finding 5: COMPILE-PROBE — syntactically closed
        ;; but invalid classes ('[z-a]') used to pass translation and
        ;; throw at every match (swallowed → silent no-match).
        (if (condition-case nil (progn (string-match rx "") t) (error () nil))
          rx
          nil))
      nil)))

(defun grep-consult-glob-scan (rest acc in-class)
  (if (= (length rest) 0)
    (if in-class nil acc)
    (let ((c (substring rest 0 1))
          (tail (substring rest 1 (length rest))))
      (cond
        (in-class
          (grep-consult-glob-scan tail (concat acc c) (not (string= c "]"))))
        ((string= c "*")
          (grep-consult-glob-scan tail (concat acc ".*") nil))
        ((string= c "?")
          (grep-consult-glob-scan tail (concat acc ".") nil))
        ((string= c "[")
          (if (string-prefix-p tail "]")
            nil
            (grep-consult-glob-scan tail (concat acc "[") t)))
        ((or (string= c "^") (string= c "\\"))
          nil)
        ((or (string= c ".") (string= c "$") (string= c "+") (string= c "(")
             (string= c ")") (string= c "{") (string= c "}") (string= c "|"))
          (grep-consult-glob-scan tail (concat acc (concat "[" c "]")) nil))
        (t
          (grep-consult-glob-scan tail (concat acc c) nil))))))

(defun grep-consult-glob-match-p (path entries)
  "PATH (a full relative path string) vs the parsed ENTRIES
((positive-regexes...) (negative-regexes...) note): no negative AND
(≥1 positive OR no positive constraint — valve r2: NEGATIVES-ONLY
globs match everything not negated, the issue's combination
clause). The emptiness check lives HERE, before the recursion — an
exhausted positives list at the recursion base means 'no positive
matched', not 'no constraint'."
  (if (grep-consult-glob-neg-p path (nth 1 entries))
    (if (null (nth 0 entries))
      t
      (grep-consult-glob-pos-p path (nth 0 entries) nil))
    nil))

(defun grep-consult-glob-pos-p (path positives hit)
  ;; NIL-SAFE: string-match returns a NUMBER (0 = match at 0) — and
  ;; 0 may be falsy in some paths; only (null hit) is the miss.
  (if (not (null hit))
    t
    (if (null positives)
      nil
      (grep-consult-glob-pos-p path (cdr positives)
        (condition-case nil (string-match (car positives) path) (error () nil))))))

(defun grep-consult-glob-neg-p (path negatives)
  (if (null negatives)
    t
    (if (not (null (condition-case nil (string-match (car negatives) path) (error () nil))))
      nil
      (grep-consult-glob-neg-p path (cdr negatives)))))

(defun grep-consult-parse-globs (glob-str)
  "The glob side → ((positive-regexes...) (negative-regexes...))
plus a validity note. An EMPTY entry or wholly empty side → the
'empty glob' marker."
  (if (or (null glob-str) (= (length glob-str) 0))
    (list nil nil "empty")
    (grep-consult-parse-glob-scan (string-split glob-str ",") (list) (list) nil)))

(defun grep-consult-parse-glob-scan (entries pos neg note)
  (if (null entries)
    (list (reverse-of pos) (reverse-of neg) note)
    (let ((raw (car entries)))
      (cond
        ((= (length raw) 0)
          ;; An empty entry → 'empty glob'.
          (list nil nil "empty"))
        ((string= raw "!")
          ;; A bare ! → noted + ignored.
          (grep-consult-parse-glob-scan (cdr entries) pos neg "ignored-bang"))
        (t
          (let ((negated (string-prefix-p "!" raw))
                (body (if (string-prefix-p "!" raw)
                        (substring raw 1 (length raw))
                        raw)))
            (if (= (length body) 0)
              (grep-consult-parse-glob-scan (cdr entries) pos neg "ignored-bang")
              (let ((rx (grep-consult-glob->regex body)))
                (if (null rx)
                  (grep-consult-parse-glob-scan (cdr entries) pos neg "ignored-untranslatable")
                  (grep-consult-parse-glob-scan (cdr entries)
                    (if negated pos (cons rx pos))
                    (if negated (cons rx neg) neg)
                    note))))))))))

(defun reverse-of (lst)
  (if (null lst) (list)
    (append (reverse-of (cdr lst)) (list (car lst)))))

;; ── the state machine ───────────────────────────────────────────────
(defun grep-consult ()
  "SPC s G — the consult-grade interactive search. #310's scope +
backend preflight, then the debounced live prompt."
  (interactive)
  (let ((scope (grep-consult-scope-resolve)))
    (if (null scope)
      (editor-set-status "not in a project — SPC s g searches from here")
      (if (not (editor/commands/grep/grep-backend-available-p))
        nil ; the matrix set its own refusal status
        (progn
          (setq grep-consult-scope scope)
          (setq grep-consult-state
            (hashmap "query" "" "pendingGen" nil "completedSnapshot" nil
              "snapshotContent" nil
              "timerId" nil "preview-pane" nil "preview-borrowed" nil
              "preview-prior" nil))
          ;; The input hook + the prompt (SPEC-116 shape, free text).
          (editor/completion/minibuffer/minibuffer-on-input-set!
            (lambda (input) (grep-consult-on-input input)))
          ;; gate r1: the EVERY-close teardown — timers + processes
          ;; die on accept/cancel/error alike (the dead-code finding).
          ;; gate r2: the exit KIND runs the cancel contract on cancel
          ;; alone (close precedes the accept fn — a state-based
          ;; branch would fire it on Enter too).
          (editor/completion/minibuffer/minibuffer-on-close-set!
            (lambda (kind)
              (grep-consult-teardown)
              (if (string= kind "cancel")
                (grep-consult-cancel))))
          ;; valve r2: the echo — the selected candidate shows in the
          ;; status on every selection change (the issue's Navigation
          ;; clause; the preview pane rides the recorded reduction).
          (editor/completion/minibuffer/minibuffer-on-select-set!
            (lambda (v)
              (if (stringp v) (editor-set-status (concat "grep: " v)) nil)))
          ;; gate r1: the snapshot write rides #307's completion
          ;; (the setter seam — module defvars are not setq-able).
          (editor/commands/grep/grep-completion-hook-set!
            (lambda (status) (grep-consult-on-complete status)))
          (completing-read
            (concat "grep (" (grep-scope-backend-label) ") " scope ": ")
            "editor/commands/grep-consult/grep-consult-table"
            nil nil "" "grep-scope-history"
            "editor/commands/grep-consult/grep-consult-accept"))))))

(defun grep-consult-scope-resolve ()
  "FRESH detection (the #310 rule): (project-detect-root start)
  directly — the *project-root* cache bypassed. gate r3: NO '.'
  FALLBACK — outside a project resolve returns nil and the entry
  refuses with the SPC s g hint (the fallback made the refusal dead
  code AND let non-repo glob queries report 'no files match' over
  an empty git-ls-files enumeration)."
  (let ((detected (project-detect-root ".")))
    (if (stringp detected) detected nil)))

(defun grep-scope-backend-label ()
  "rg (auto resolves to it; the only landed backend)."
  "rg")

(defun grep-consult-style-filter (input candidates)
  "The consult category's completion style (valve r3): components
match against the PATTERN side only — the glob side would zero the
candidate list (no display contains a literal '#*.lisp'). An empty
pattern keeps everything (glob-only queries navigate all hits).
No-match returns the EMPTY LIST, never nil (the nil convention
means 'try the next style' — this category has none, and a nil
matches list breaks the session length reads)."
  (let ((r (editor/completion/orderless/orderless-filter
             (grep-consult-pattern-of input) candidates)))
    (if (null r) (list) r)))

(defun grep-consult-table (input action)
  "valve r2: the prompt's candidates ARE the current generation's
hits — Up/Down move the selection, the echo shows the candidate,
RET jumps from the CURRENT selection (the issue's Navigation
clause). The consult style filters by the PATTERN side."
  (if (string= action "metadata")
    (hashmap "category" "grep-consult")
    (grep-consult-candidates (editor/commands/grep/grep-hits-get) (list))))

(defun grep-consult-candidates (hits acc)
  (if (null hits)
    (reverse-of acc)
    (grep-consult-candidates (cdr hits)
      (cons (grep-consult-candidate (car hits)) acc))))

(defun grep-consult-candidate (hit)
  (hashmap
    "value" (grep-consult-hit-ref hit)
    "display" (concat (grep-consult-hit-ref hit) ":" (nth 3 hit))
    "annotation" ""
    "metadata" hit))

(defun grep-consult-hit-ref (hit)
  ;; "path:line:col" — unique per hit (rg emits one match per
  ;; line:col); the accept path parses it back to the hit index.
  (concat (nth 0 hit) ":" (number-to-string (nth 1 hit)) ":"
    (number-to-string (nth 2 hit))))

(defun grep-consult-index-of-hit (value hits i)
  (if (null hits)
    nil
    (if (string= value (grep-consult-hit-ref (car hits)))
      i
      (grep-consult-index-of-hit value (cdr hits) (+ i 1)))))

;; ── per-keystroke: debounce + threshold + snapshot restore ──────────
(defun grep-consult-on-input (input)
  "The hook body: cancel timer, kill pending, restore the snapshot;
a VALID query arms the 200ms idle timer."
  (if (null grep-consult-state)
    nil
    (grep-consult-input-1 input)))

(defun grep-consult-input-1 (input)
  (grep-consult-cancel-timer grep-consult-state)
  (grep-consult-kill-pending)
  (grep-consult-restore-snapshot)
  (setq grep-consult-state
    (hashmap-set grep-consult-state "query" input))
  (let ((pattern (grep-consult-pattern-of input))
        (glob (grep-consult-glob-of input)))
    (cond
      ((and (= (length pattern) 0) (null glob))
        (editor-set-status "empty pattern"))
      ((and (< (length pattern) 2) (null glob))
        (editor-set-status "grep consult: type more (2+ chars or a #glob)"))
      ((and (not (null glob)) (= (length glob) 0))
        (editor-set-status "empty glob"))
      (t
        (setq grep-consult-state
          (hashmap-set grep-consult-state "timerId"
            (run-with-idle-timer 200 "editor/commands/grep-consult/grep-consult-fire")))))))

(defun grep-consult-pattern-of (input)
  (nth 0 (grep-consult-parse-query input)))

(defun grep-consult-glob-of (input)
  (nth 1 (grep-consult-parse-query input)))

(defun grep-consult-teardown ()
  "The every-close hygiene (idempotent): cancel the timer, kill the
pending process, and unset the grep completion hook (gate r2: a
leaked session let a later plain SPC s s completion write a snapshot
into it). The session vars clear separately (accept keeps them for
the jump; cancel clears them in grep-consult-cancel)."
  (if (not (null grep-consult-state))
    (progn
      (grep-consult-cancel-timer grep-consult-state)
      (grep-consult-kill-pending)))
  (editor/commands/grep/grep-completion-hook-set! nil)
  nil)

(defun grep-consult-cancel-timer (st)
  (let ((tid (hashmap-get st "timerId")))
    (if (numberp tid)
      (cancel-idle-timer tid)))
  nil)

(defun grep-consult-kill-pending ()
  (editor/commands/grep/grep-rg-kill-prior)
  (setq grep-consult-state
    (hashmap-set grep-consult-state "pendingGen" nil)))

(defun grep-consult-on-complete (status)
  "The completedSnapshot write: ONLY completion updates it — a killed
partial stream NEVER becomes the restore target. gate r2: the
snapshot is the completed generation id AND its rendered content
(the restore source for the input-change rule). valve r2: a live
prompt re-refreshes so the CANDIDATES (the generation's hits)
appear without another keystroke."
  (if (not (null grep-consult-state))
    (progn
      (setq grep-consult-state
        (hashmap-set
          (hashmap-set grep-consult-state "completedSnapshot"
            (editor/commands/grep/grep-current-gen-get))
          "snapshotContent" (editor/commands/grep/grep-buffer-content)))
      (if (minibuffer-state-get)
        (editor/completion/minibuffer/minibuffer-refresh)
        nil)))
  nil)

(defun grep-consult-restore-snapshot ()
  "The input-change rule (gate r2 — was a literal no-op). valve r2:
STRUCTURAL — roll the producer back to the completed generation
(content AND selection/state, so RET/navigation agree with the
display), not a text re-render over a newer generation's hits. nil
snapshot (no completed search) → unchanged; already current →
no-op; the newer generation already completed (snapshot moved on)
→ the rollback guard refuses, caught, no-op."
  (let ((snap-gen (hashmap-get grep-consult-state "completedSnapshot")))
    (if (numberp snap-gen)
      (if (= snap-gen (editor/commands/grep/grep-current-gen-get))
        nil
        (condition-case nil
          (editor/commands/grep/grep-buffer-rollback
            (editor/commands/grep/grep-current-gen-get))
          (error () nil)))
      nil)))

(defun grep-consult-chomp-nl (s)
  "Drop ONE trailing newline."
  (if (and (stringp s) (> (length s) 0)
           (string= (substring s (- (length s) 1) (length s)) "\n"))
    (substring s 0 (- (length s) 1))
    s))

(defun grep-consult-files-in (scope)
  "Enumerate the tracked+untracked files under SCOPE (the glob side
matches against full relative path strings). valve r3:
core.quotepath=false — git quotes non-ASCII paths ('é.lisp' came
back escaped and the glob missed it)."
  (condition-case nil
    (grep-consult-split-lines
      (nth 0 (shell-exec-argv
                (list "git" "-c" "core.quotepath=false" "-C" scope "ls-files"
                      "--others" "--exclude-standard" "--cached")
                scope)))
    (error () (list))))

(defun grep-consult-split-lines (s)
  (if (or (not (stringp s)) (= (length s) 0)
          (and (= (length s) 1) (string= s "\n")))
    (list)
    (string-split (grep-consult-chomp-nl s) "\n")))

(defun grep-consult-filtered-files (scope entries)
  ;; The combination: ≥1 positive AND no negative, against the FULL
  ;; relative path strings.
  (grep-consult-filter-scan (grep-consult-files-in scope) entries (list)))

(defun grep-consult-filter-scan (files entries acc)
  (if (null files)
    (reverse-of acc)
    (if (editor/commands/grep-consult/grep-consult-glob-match-p (car files) entries)
      (grep-consult-filter-scan (cdr files) entries (cons (car files) acc))
      (grep-consult-filter-scan (cdr files) entries acc))))

(defun grep-consult-fire ()
  "The debounce fired: run the parsed query through the #308
backend (the scope resolved at entry). GLOB FILTERING applies when
the query has a glob side (gate r1: it was never applied); zero
files after filtering → NO process spawns (the status names it);
glob-only queries DO run (the empty pattern registers per #307)."
  (if (null grep-consult-state)
    nil
    (let ((pattern (grep-consult-pattern-of (hashmap-get grep-consult-state "query")))
          (glob (grep-consult-glob-of (hashmap-get grep-consult-state "query"))))
      (if (null glob)
        (editor/commands/grep/grep-search pattern grep-consult-scope)
        (let ((parsed (editor/commands/grep-consult/grep-consult-parse-globs glob)))
          (if (and (stringp (nth 2 parsed)) (string= (nth 2 parsed) "empty"))
            (editor-set-status "empty glob")
            (progn
              ;; valve r3 finding 4: the ignored-entry note fires
              ;; whenever ANY entry was ignored (a valid entry
              ;; alongside a bare '!' or an untranslatable filters
              ;; SILENTLY otherwise), not only in the all-ignored
              ;; case.
              (if (and (nth 2 parsed)
                       (not (string= (nth 2 parsed) "empty")))
                (editor-set-status "glob entry ignored — filtering with the rest")
                nil)
              (let ((files
                      (if (and (= (length (nth 0 parsed)) 0)
                               (= (length (nth 1 parsed)) 0)
                               (nth 2 parsed))
                        ;; gate r2 + valve r2: EVERY entry ignored (BOTH
                        ;; lists empty) → NO filtering applies (all files)
                        ;; + the note. A valid negative + an ignored entry
                        ;; ('!*.txt,!') is NOT this case — it filters.
                        (progn
                          (editor-set-status "glob entries ignored — searching all files")
                          (grep-consult-files-in grep-consult-scope))
                        (grep-consult-filtered-files grep-consult-scope parsed))))
                (if (= (length files) 0)
                  (editor-set-status "no files match glob filters")
                  (editor/commands/grep/grep-rg-run-files pattern files grep-consult-scope))))))))))

(defun grep-consult-accept (value)
  "RET: kill pending + cancel the timer, jump via #307 from the
CURRENT selection (valve r2: the prompt's SELECTED candidate when
the value parses as a hit — the *grep* row otherwise). valve r3: a
pending newer generation is rolled back to the completed snapshot
FIRST — the selection was taken against the completed hits, and
resolving it against the partial's hits could jump somewhere
unrelated. The hook tears down with the close."
  (let ((st grep-consult-state))
    (if (not (null st))
      (progn
        (grep-consult-cancel-timer st)
        (grep-consult-kill-pending)
        (grep-consult-restore-snapshot)))
    (setq grep-consult-state nil)
    (setq grep-consult-scope nil)
    ;; Jump from the current selection in *grep* (#307's RET).
    (if (member "*grep*" (buffer-list))
      (progn
        (buffer-switch "*grep*")
        (let ((idx (grep-consult-index-of-hit value (editor/commands/grep/grep-hits-get) 0)))
          (if (numberp idx)
            (cursor-move idx 0)
            nil))
        (editor/commands/grep/grep-ret))
      nil)))

(defun grep-consult-cancel ()
  "C-g/Escape: kill pending + cancel the timer, restore the
snapshot (valve r2: STRUCTURALLY — a later partial never stays on
screen when a completed search exists), or close the results buffer
when no search ever completed."
  (let ((st grep-consult-state))
    (if (not (null st))
      (progn
        (grep-consult-cancel-timer st)
        (grep-consult-kill-pending)
        (let ((snap (hashmap-get st "completedSnapshot")))
          (if (null snap)
            (if (member "*grep*" (buffer-list))
              (buffer-kill "*grep*"))
            (grep-consult-restore-snapshot)))))
    (setq grep-consult-state nil)
    (setq grep-consult-scope nil)))

;; ── the preview (bottom split; focus stays in the prompt) ──────────
(defun grep-consult-preview (path line)
  "Open PATH at LINE in the bottom split (OURS on single-window;
reuse-below + BORROWED otherwise)."
  (condition-case nil
    (progn
      (if (not (member path (buffer-list)))
        (find-file path))
      (buffer-switch path)
      (cursor-move (max 0 (- line 1)) 0))
    (error () nil)))

(provide "grep-consult")
)
