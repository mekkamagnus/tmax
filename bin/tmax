#!/usr/bin/env bash
# tmax — unified editor CLI (emacs-style daemon/client)
#
# #250: the full CLI surface (flags, daemon startup choreography, routing)
# lives in src/cli/launcher.ts, reached through src/main.ts. This script is
# the thin source-tree entry: it execs the TS entry with the repo's bun so
# source runs always execute repo code (learnings: Repository-local tmax must
# run repository code). The compiled binary (bun run build:tmax) is a
# drop-in replacement for this script.
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH")"
fi

PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

exec bun "$PROJECT_DIR/src/main.ts" "$@"
