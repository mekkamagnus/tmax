(defmodule editor/bindings/visual
  (export)

  (require-module editor/commands/indent-ops)

;; visual.tlisp
;; Default key bindings for visual mode in tmax editor
;;
;; This file contains all default key bindings for visual mode, extracted from TypeScript
;; to achieve pure T-Lisp-centric key binding management.
;;
;; Maintainer guidance:
;; - Each (key-bind) call defines a key, command, and optional mode
;; - Commands are T-Lisp expressions that get executed when keys are pressed
;; - Mode is specified as "visual" for all bindings in this file
;; - Keep bindings organized by functional groups for readability

;; =================================================================
;; VISUAL MODE BINDINGS (US-1.7.1)
;; =================================================================
;; Key bindings specific to visual mode

;; Navigation keys (same as normal mode) - update visual selection after movement
(key-bind "h" "(progn (cursor-move (cursor-line) (- (cursor-column) 1)) (visual-update-end))" "visual")
(key-bind "j" "(progn (cursor-move (+ (cursor-line) 1) (cursor-column)) (visual-update-end))" "visual")
(key-bind "k" "(progn (cursor-move (- (cursor-line) 1) (cursor-column)) (visual-update-end))" "visual")
(key-bind "l" "(progn (cursor-move (cursor-line) (+ (cursor-column) 1)) (visual-update-end))" "visual")

;; Word navigation - update visual selection after movement
(key-bind "w" "(progn (word-next) (visual-update-end))" "visual")
(key-bind "b" "(progn (word-previous) (visual-update-end))" "visual")
(key-bind "e" "(progn (word-end) (visual-update-end))" "visual")

;; WORD navigation (#146) — same pattern, WORD variants
(key-bind "W" "(progn (word-next-WORD) (visual-update-end))" "visual")
(key-bind "B" "(progn (word-previous-WORD) (visual-update-end))" "visual")
(key-bind "E" "(progn (word-end-WORD) (visual-update-end))" "visual")

;; Line navigation (#146) — extend selection to line boundaries
(key-bind "0" "(progn (line-first-column) (visual-update-end))" "visual")
(key-bind "$" "(progn (line-last-column) (visual-update-end))" "visual")
(key-bind "_" "(progn (line-first-non-blank) (visual-update-end))" "visual")

;; Buffer navigation (#146) — extend selection to buffer boundaries
(key-bind "G" "(progn (vim-G) (visual-update-end))" "visual")

;; Paragraph motion (#146) — extend selection
(key-bind "}" "(progn (paragraph-next) (visual-update-end))" "visual")
(key-bind "{" "(progn (paragraph-previous) (visual-update-end))" "visual")

;; Toggle-off (#146) — pressing v/V/C-v in visual mode exits to normal
(key-bind "v" "(visual-exit)" "visual")
(key-bind "V" "(visual-exit)" "visual")

;; Additional operators (#146)
(key-bind "x" "(visual-delete)" "visual")

;; Exit visual mode (Escape)
(key-bind "Escape" "(visual-exit)" "visual")

;; Delete selected text (d)
(key-bind "d" "(visual-delete)" "visual")

;; Yank (copy) selected text (y)
(key-bind "y" "(visual-yank)" "visual")

;; Lowercase selected text (u) — SPEC-044 Phase 5.C T-Lisp implementation
(key-bind "u" "(vim-visual-lowercase)" "visual")

;; Uppercase selected text (U) — SPEC-044 Phase 5.C T-Lisp implementation
(key-bind "U" "(vim-visual-uppercase)" "visual")

;; Change selected text (c)
(key-bind "c" "(visual-change)" "visual")

;; Swap visual anchor (o)
(key-bind "o" "(visual-swap-anchor)" "visual")

;; Text-object selection (SPEC-069 Phase 3) — i/a stash the inner/around
;; choice; the next key (the class char) is routed by visual-handler to
;; visual-dispatch-text-object, which re-anchors the selection to the
;; text-object region (viw/vaw/vi"/va().
(key-bind "i" "(visual-begin-text-object \"i\")" "visual")
(key-bind "a" "(visual-begin-text-object \"a\")" "visual")
)
