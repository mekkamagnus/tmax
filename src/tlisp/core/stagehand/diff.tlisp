(defmodule stagehand/diff
  (export stagehand-diff-parse stagehand-diff-classify
          stagehand-diff-face stagehand-diff-face-line
          stagehand-diff-partial-patch stagehand-diff-partial-patch-cached
          stagehand-diff-toggle-mark stagehand-diff-selection-range
          stagehand-diff-mark-get
          stagehand-diff-partial-refusal-get
          stagehand-diff-flags-for-lines
          stagehand-diff-buffer-name stagehand-diff-open
          stagehand-diff-next stagehand-diff-prev
          stagehand-diff-quit stagehand-diff-hunk-lines
          stagehand-diff-hunk-patch stagehand-diff-stage-hunk
          stagehand-diff-unstage-hunk stagehand-diff-discard-hunk
          stagehand-diff-table stagehand-diff-accept
          stagehand-diff-apply-filter stagehand-diff-apply-sentinel
          stagehand-diff-apply-exit-get stagehand-diff-side-get
          stagehand-diff-apply-hunk-at
          stagehand-diff-refresh-view)

;; #289 — Stagehand T0: the diff GRAMMAR + faces. `git diff
;; --no-color` output is PARSED into line classes (never ANSI
;; passthrough), and faces are EMITTED from the classes through the
;; buffer-carries-ANSI pipeline (the fikra-diff render precedent) —
;; one face source for the cluster (#312/#313 adopt this mapping).
;;
;; The *Stagehand-Diff* view: n/p navigate hunk headers, q closes
;; (recency restore). The `d` dispatch lives in stagehand/status (it
;; reads the status buffer's row/section state); this module renders.

(defvar stagehand-diff-view-gen 0
  "Bumped on every open — an apply's sentinel refreshes only when
its ORIGINATING view is still current (valve r1: a diff opened
mid-apply made the sentinel refresh the WRONG view's targets).")
(defvar stagehand-diff-apply-in-flight nil
  "An apply is running (s/u/D no-op until its sentinel lands).")
(defvar stagehand-diff-apply-view-gen nil
  "The view generation the in-flight apply was launched against.")
(defvar stagehand-diff-hunks (list)
  "The buffer line indices of hunk-header lines (n/p targets).")
(defun stagehand-diff-side-get ()
  "The view's current side (a VALUE getter)."
  stagehand-diff-side)

(defvar stagehand-diff-raw nil
  "The raw `git diff` TEXT the view rendered (hunk extraction +
  patch reconstruction read this — never the faced buffer).")
(defvar stagehand-diff-side "worktree"
  "The view's side: worktree (git diff) | cached (git diff --cached)
  — which hunk ops apply.")
(defvar stagehand-diff-root nil
  "The repo root the diff came from (the apply cwd).")
(defvar stagehand-diff-paths nil
  "The diff's paths (the apply -- arguments).")

(major-mode-register "stagehand-diff" '() nil)
(major-mode-doc "stagehand-diff" "Stagehand diff view — n/p navigate hunk headers (wrap), q closes")

;; ── the grammar (pure — unit-testable without git) ─────────────────
(defun stagehand-diff-parse (text)
  "Diff TEXT → ((class line) ...) in order. Pure: no git, no globals —
the positional state (inside-hunks) threads through the scan."
  (stagehand-diff-scan (string-split text "\n") (list) nil))

(defun stagehand-diff-scan (lines out in-hunks)
  ;; IN-HUNKS: a @@ has been seen since the last file header — so
  ;; ---/+++ leading lines are remove/add PAYLOADS (SQL/Lua/Haskell
  ;; '--' banners), not file headers. 'diff --git' resets it for the
  ;; next file's header block.
  (if (null lines)
    (reverse out)
    (let* ((line (car lines))
           (class (stagehand-diff-classify line in-hunks)))
      (stagehand-diff-scan (cdr lines)
        (cons (list class line) out)
        (if (string-prefix-p "diff --git " line)
          nil
          (or in-hunks (string= class "hunk-header")))))))

(defun stagehand-diff-classify (line in-hunks)
  "One diff line → its class: file-header, hunk-header, add, remove,
context, meta. ---/+++ are file headers ONLY in the header region
(IN-HUNKS nil); the meta markers precede the add/remove catch."
  (cond
    ((or (string-prefix-p "diff --git " line)
         (string-prefix-p "index " line))
      "file-header")
    ((and (not in-hunks)
          (or (string-prefix-p "--- " line)
              (string-prefix-p "+++ " line)))
      "file-header")
    ((string-prefix-p "@@" line) "hunk-header")
    ;; The meta family (rename/copy/mode/no-newline markers). The
    ;; backslash literal is hex — the T-Lisp reader strips backslash
    ;; escapes, so "\\ No newline" cannot be written directly.
    ((or (string-prefix-p "new file mode" line)
         (string-prefix-p "deleted file mode" line)
         (string-prefix-p "old mode" line)
         (string-prefix-p "new mode" line)
         (string-prefix-p "similarity index" line)
         (string-prefix-p "dissimilarity index" line)
         (string-prefix-p "rename from" line)
         (string-prefix-p "rename to" line)
         (string-prefix-p "copy from" line)
         (string-prefix-p "copy to" line)
         (string-prefix-p (hex-decode "5c204e6f") line))
      "meta")
    ((string-prefix-p "+" line) "add")
    ((string-prefix-p "-" line) "remove")
    (t "context")))

;; ── faces (the one class → SGR source) ──────────────────────────────
;; Emitted ANSI rides the established buffer-carries-ANSI render path.
;; The literals are hex (the T-Lisp reader strips backslash escapes,
;; so "\x1b[32m" cannot be written directly).
(defun stagehand-diff-face (class)
  "CLASS → its SGR opening sequence ('' for default/context)."
  (cond
    ((string= class "file-header") (stagehand-ansi "1;36"))
    ((string= class "hunk-header") (stagehand-ansi "1;34"))
    ((string= class "add") (stagehand-ansi "32"))
    ((string= class "remove") (stagehand-ansi "31"))
    ((string= class "meta") (stagehand-ansi "2"))
    (t "")))

(defun stagehand-diff-face-line (pair)
  "(class line) → the FACED display line (ANSI open + line + reset;
context passes through bare)."
  (let ((class (car pair))
        (line (car (cdr pair))))
    (if (string= class "context")
      line
      (concat (stagehand-diff-face class) line (stagehand-ansi-reset)))))

(defun stagehand-ansi (sgr)
  (hex-decode (concat "1b5b" (stagehand-hex-encode sgr) "6d")))

(defun stagehand-ansi-reset ()
  (hex-decode "1b5b306d"))

(defun stagehand-hex-encode (s)
  ;; string-join is the BUILTIN (separator first); stagehand-join
  ;; belongs to the status module, not this one.
  (string-join "" (mapcar (lambda (ch) (stagehand-hex-byte ch)) (string-split s ""))))

(defun stagehand-hex-byte (ch)
  (cond
    ((string= ch "0") "30") ((string= ch "1") "31")
    ((string= ch "2") "32") ((string= ch "3") "33")
    ((string= ch "4") "34") ((string= ch "5") "35")
    ((string= ch "6") "36") ((string= ch "7") "37")
    ((string= ch "8") "38") ((string= ch "9") "39")
    ((string= ch ";") "3b")
    (t "")))

;; ── the view ────────────────────────────────────────────────────────
(defun stagehand-diff-buffer-name () "*Stagehand-Diff*")

(defun stagehand-diff-open (text title &optional (side "worktree" side-supplied-p) (root nil root-supplied-p) (paths nil paths-supplied-p))
  "Render the parsed, FACED diff into *Stagehand-Diff* and switch to
it. TEXT is raw `git diff --no-color` output; TITLE rides the first
line. SIDE ('worktree'|'cached') selects which hunk ops apply; ROOT
is the apply cwd; PATHS the diff's -- arguments (nil = the whole
diff)."
  (let ((pairs (stagehand-diff-parse text)))
    (if (and (null (cdr pairs)) (string= (car (car pairs)) "context") (string= (car (cdr (car pairs))) ""))
      (editor-set-status "Stagehand: empty diff")
      (progn
        (setq stagehand-diff-view-gen (+ (or stagehand-diff-view-gen 0) 1))
        (setq stagehand-diff-raw text)
        (setq stagehand-diff-side side)
        (setq stagehand-diff-root root)
        (setq stagehand-diff-paths paths)
        (stagehand-diff-ensure-buffer)
        (major-mode-set "stagehand-diff")
        (editor-set-mode "normal")
        (buffer-set-read-only nil)
        (stagehand-diff-clear)
        (buffer-append (concat title "\n"))
        (setq stagehand-diff-hunks (list))
        (stagehand-diff-emit pairs 1)
        (buffer-set-read-only t)
        (stagehand-diff-ensure-keymap)
        (setq stagehand-diff-hunks (reverse stagehand-diff-hunks))
        (cursor-move 1 0)))))

(defun stagehand-diff-emit (pairs line)
  ;; Append each faced line; record hunk-header buffer indices.
  (if (not (null pairs))
    (let ((pair (car pairs)))
      (buffer-append (concat (stagehand-diff-face-line pair) "\n"))
      (if (string= (car pair) "hunk-header")
        (setq stagehand-diff-hunks (cons line stagehand-diff-hunks)))
      (stagehand-diff-emit (cdr pairs) (+ line 1)))))

(defun stagehand-diff-hunk-lines ()
  "The buffer line indices of hunk headers (n/p targets)."
  stagehand-diff-hunks)

(defun stagehand-diff-next ()
  "n — the next hunk header (wraps)."
  (stagehand-diff-nav 1))

(defun stagehand-diff-prev ()
  "p — the previous hunk header (wraps)."
  (stagehand-diff-nav -1))

(defun stagehand-diff-nav (dir)
  (let ((hunks stagehand-diff-hunks))
    (if (null hunks)
      (editor-set-status "Stagehand: no hunks")
      (let ((target (stagehand-diff-next-hunk hunks dir)))
        (cursor-move target 0)))))

(defun stagehand-diff-next-hunk (hunks dir)
  ;; The first hunk strictly beyond the cursor (dir 1) / the last
  ;; strictly before it (dir -1); wraps to the far end (forward → the
  ;; FIRST hunk, backward → the LAST). HUNKS is ascending.
  (let* ((cur (cursor-line))
         (ahead (stagehand-diff-filter-ahead hunks cur dir)))
    (cond
      ((not (null ahead)) (if (> dir 0) (car ahead) (stagehand-diff-last ahead)))
      ((> dir 0) (car hunks))
      (t (stagehand-diff-last hunks)))))

(defun stagehand-diff-filter-ahead (hunks cur dir)
  ;; Hunks strictly past CUR in DIR order.
  (stagehand-filter-scan hunks cur dir (list)))

(defun stagehand-filter-scan (hunks cur dir out)
  (if (null hunks)
    (reverse out)
    (let ((h (car hunks)))
      (stagehand-filter-scan (cdr hunks) cur dir
        (if (or (and (> dir 0) (> h cur))
                (and (< dir 0) (< h cur)))
          (cons h out)
          out)))))

(defun stagehand-diff-last (lst)
  (if (null (cdr lst)) (car lst) (stagehand-diff-last (cdr lst))))

(defun stagehand-diff-quit ()
  "q — close (buffer-kill's Editor path picks the recency survivor).
Valve r2: bump the view gen — an in-flight apply's sentinel must
not recreate or switch back to a quit view."
  (setq stagehand-diff-view-gen (+ (or stagehand-diff-view-gen 0) 1))
  (setq stagehand-diff-mark nil)
  (buffer-kill (stagehand-diff-buffer-name)))

;; ── hunk extraction + patch reconstruction (#291) ───────────────────
(defun stagehand-diff-hunk-patch (idx)
  "The APPLYABLE patch for hunk IDX (0-based, in stream order): the
source diff's FILE HEADER (diff --git/index/---/+++ — the block
since the last 'diff --git') verbatim + the hunk verbatim (@@ header
+ body + the no-newline marker carried WITH it)."
  (stagehand-diff-collect (stagehand-diff-parse (or stagehand-diff-raw ""))
    (list) 0 idx nil))

(defun stagehand-diff-collect (pairs header count target cur)
  ;; Walk the CLASSIFIED pairs. COUNT is the number of hunk headers
  ;; seen so far; CUR is the current hunk's accumulating lines (nil
  ;; between hunks).
  (if (null pairs)
    (string-join "\n"
      (append header (if cur (reverse cur) (list))))
    (let* ((pair (car pairs))
           (cls (car pair))
           (line (car (cdr pair))))
      (cond
        ((string= cls "file-header")
          ;; A header line: part of the current file's header block
          ;; (before any hunk) — or the NEXT file's start (a hunk
          ;; ended). 'diff --git' resets; index/---/+++ extend.
          (if cur
            ;; Inside a hunk: a new file header ends it.
            (if (= (- count 1) target)
              (string-join "\n" (append header (reverse cur)))
            (stagehand-diff-collect (cdr pairs) header count target nil))
            (if (string-prefix-p "diff --git " line)
              (stagehand-diff-collect (cdr pairs) (list line) count target nil)
              (stagehand-diff-collect (cdr pairs) (append header (list line)) count target nil))))
        ((or (string-prefix-p "new file mode" line)
             (string-prefix-p "deleted file mode" line)
             (string-prefix-p "similarity index" line)
             (string-prefix-p "dissimilarity index" line)
             (string-prefix-p "rename from " line)
             (string-prefix-p "rename to " line)
             (string-prefix-p "copy from " line)
             (string-prefix-p "copy to " line))
          ;; #291 gate r1: mode lines RIDE IN THE HEADER — dropping
          ;; them made the patch module-shaped and `git apply` staged
          ;; a PHANTOM dev/null path into the index (the gate's
          ;; live-reproduced corruption). r4: rename/copy/similarity
          ;; meta rides too — the reconstructed patch is
          ;; git-apply-semantically complete even for
          ;; rename-with-content (defense in depth: the refusal
          ;; still owns renames in the UI).
          (if (and cur (= (- count 1) target))
            (string-join "\n" (append header (reverse cur)))
            (stagehand-diff-collect (cdr pairs) (append header (list line))
              count target nil)))
        ((string= cls "hunk-header")
          (if (= count target)
            ;; The TARGET hunk starts.
            (stagehand-diff-collect (cdr pairs) header (+ count 1) target (list line))
            (if (and cur (= (- count 1) target))
              (string-join "\n" (append header (reverse cur)))
              (stagehand-diff-collect (cdr pairs) header (+ count 1) target nil))))
        ((string= cls "meta")
          (if (string-prefix-p (hex-decode "5c204e6f") line)
            ;; The no-newline marker rides WITH its hunk.
            (if (and cur (= (- count 1) target))
              (stagehand-diff-collect (cdr pairs) header count target (cons line cur))
              (stagehand-diff-collect (cdr pairs) header count target cur))
            ;; Other meta (rename/mode/binary): ends any hunk.
            (if (and cur (= (- count 1) target))
              (string-join "\n" (append header (reverse cur)))
              (stagehand-diff-collect (cdr pairs) header count target nil))))
        (t
          ;; add/remove/context: hunk BODY.
          (if (and cur (= (- count 1) target))
            (stagehand-diff-collect (cdr pairs) header count target (cons line cur))
            (stagehand-diff-collect (cdr pairs) header count target cur)))))))

;; ── partial-patch construction (#331) ───────────────────────────────
(defun stagehand-diff-split-patch (text)
  "The collected patch TEXT → (header-lines hunk-lines): everything
before the first '@@ ' line vs the '@@ ' line onward. NIL when no
hunk line exists. Trailing EMPTY lines chomp — the raw diff's
trailing newline rides through collect as a phantom '' body line
(kept by the exhausted-flags default, +1 to newC, and its blank
line corrupts `git apply')."
  (stagehand-diff-split-scan
    (stagehand-diff-chomp-empty (string-split text "\n")) (list)))

(defun stagehand-diff-chomp-empty (lines)
  (if (null lines)
    lines
    (if (string= "" (car (reverse lines)))
      (stagehand-diff-chomp-empty (reverse (cdr (reverse lines))))
      lines)))

(defun stagehand-diff-split-scan (lines acc)
  (if (null lines)
    nil
    (if (string-prefix-p "@@ " (car lines))
      (list (reverse acc) lines)
      (stagehand-diff-split-scan (cdr lines) (cons (car lines) acc)))))

(defun stagehand-diff-num-spec (spec)
  "'-12,5' / '+13' → (start count); a missing count is 1 (git's
single-line abbreviation)."
  (let* ((bare (if (or (string-prefix-p "-" spec) (string-prefix-p "+" spec))
                 (substring spec 1 (length spec))
                 spec))
         (halves (string-split bare ",")))
    (list (string-to-number (car halves))
      (if (null (cdr halves)) 1 (string-to-number (car (cdr halves)))))))

(defun stagehand-diff-hunk-spec (line)
  "'@@ -oS[,oC] +nS[,nC] @@[ tail]' → (oS oC nS nC tail). Splits on
single spaces (git's emission format); the tail is everything after
the closing @@, joined back with spaces."
  (let* ((parts (string-split line " "))
         (old (stagehand-diff-num-spec (nth 1 parts)))
         (new (stagehand-diff-num-spec (nth 2 parts))))
    (list (nth 0 old) (nth 1 old) (nth 0 new) (nth 1 new)
      (stagehand-diff-tail-join parts 4))))

(defun stagehand-diff-tail-join (parts i)
  ;; The joined tail CARRIES its leading space (string-split ate it;
  ;; the rebuild concats " @@" directly against this value).
  (if (>= i (length parts))
    ""
    (if (string= (stagehand-diff-tail-join parts (+ i 1)) "")
      (concat " " (nth i parts))
      (concat " " (nth i parts) (stagehand-diff-tail-join parts (+ i 1))))))

(defun stagehand-diff-partial-refusal-get ()
  "The last partial build's refusal reason (a test/inspection seam)."
  stagehand-diff-partial-refusal)

(defvar stagehand-diff-partial-refusal nil
  "Why the last partial-patch build refused (nil when it built).")

(defun stagehand-diff-partial-patch (idx flags)
  "The applyable patch for the SUBSET of hunk IDX's change lines —
#331's core. FLAGS: one boolean per BODY line (the @@ header
excluded), in stream order; context lines ignore their flag (always
kept); '+'/'-' lines are kept iff flagged; the no-newline marker
must follow a line KEPT AS-IS (anything else refuses). Arithmetic
(the conversion rule): a dropped '-' becomes CONTEXT (both side
counts advance; the old start NEVER moves — every old-side line
stays represented); a dropped '+' omits (a LEADING dropped
insertion shifts the new start, the only start movement); trailing
drops never move starts. A missing flag defaults to KEEP; zero kept
changes refuses ('nothing selected'). Returns the patch string, or
nil with `stagehand-diff-partial-refusal' naming why."
  (setq stagehand-diff-partial-refusal nil)
  (let* ((split (stagehand-diff-split-patch (stagehand-diff-hunk-patch idx))))
    (if (null split)
      (progn
        (setq stagehand-diff-partial-refusal "no hunk at that index")
        nil)
      (let* ((header (nth 0 split))
             (hunk (nth 1 split))
             (spec (stagehand-diff-hunk-spec (car hunk))))
        (stagehand-diff-partial-scan
          (cdr hunk) flags (list) (list)
          0 0                     ;; kept old/new counts
          0                       ;; leading dropped '+'
          nil nil 0               ;; kept-any, prev-kept, changes
          (nth 0 spec) (nth 2 spec) (nth 4 spec) header)))))

(defun stagehand-diff-partial-scan (body flags out held oldC newC leadN keptAny prevKept changes oStart nStart tail header)
  "The walk. OUT accumulates reversed output lines; OLDC/NEWC count
old/new-side lines; HELD buffers converted context (a kept '+' jumps over it — git coalesces adjacent change blocks); LEADN counts dropped '+' lines before the first
kept line (a leading dropped insertion shifts the NEW start — the
old start NEVER moves: every old-side line stays represented);
KEPTANY freezes LEADN; PREVKEPT = the previous line was KEPT AS-IS
(the only state a no-newline marker may follow); CHANGES counts
kept change lines (zero → the nothing-selected refusal).

The CONVERSION rule (the classic partial-patch pitfall): a DROPPED
'-' line becomes a CONTEXT line (' ' + content — it occupies its
old position on BOTH sides; interior drops cannot simply vanish or
the surrounding context mismatches the file); a dropped '+' line
omits entirely."
  (if (null body)
    (if (= changes 0)
      (progn
        (setq stagehand-diff-partial-refusal "nothing selected")
        nil)
      (let* ((at (concat "@@ -" (number-to-string oStart)
                         "," (number-to-string oldC)
                         " +" (number-to-string (+ nStart leadN))
                         "," (number-to-string newC)
                         " @@" tail))
             (lines (append header (list at)
                            (reverse out)
                            (reverse held))))
        (string-join "\n" lines)))
    (let* ((line (car body))
           (flag (if (null flags) t (car flags)))
           (marker (string-prefix-p (hex-decode "5c204e6f") line))
           (ctx (string-prefix-p " " line))
           (rem (string-prefix-p "-" line))
           (keep (if marker prevKept (if ctx t flag))))
      (cond
        ((and marker (not prevKept))
          ;; The marker's line was dropped or converted — the new
          ;; final line's newline state is uncomputable from the
          ;; diff. (Markers are always hunk-final.)
          (progn
            (setq stagehand-diff-partial-refusal
              "the no-newline line must stay selected")
            nil))
        (marker
          ;; Rides its kept line (after flushing held context);
          ;; counts toward NEITHER side.
          (stagehand-diff-partial-scan (cdr body) (cdr flags)
            (cons line (append held out))
            (list) oldC newC leadN keptAny prevKept changes
            oStart nStart tail header))
        (keep
          ;; A kept CONTEXT line counts toward BOTH sides; a kept
          ;; '-' only old; a kept '+' only new. Context and '-'
          ;; FLUSH held lines first; a kept '+' jumps over them
          ;; (git coalesces '-b -c +B +C': selecting b→B must emit
          ;; -b +B ' c', not -b ' c' +B).
          (if (or ctx rem)
            (stagehand-diff-partial-scan (cdr body) (cdr flags)
              (cons line (append held out))
              (list)
              (+ oldC 1) (+ newC (if ctx 1 0))
              leadN t t (+ changes (if ctx 0 1))
              oStart nStart tail header)
            (stagehand-diff-partial-scan (cdr body) (cdr flags)
              (cons line out) held
              oldC (+ newC 1)
              leadN t t (+ changes 1)
              oStart nStart tail header)))
        ((and rem (not ctx))
          ;; DROPPED '-': CONTEXT conversion (old position keeps its
          ;; line; both side counts advance) — HELD behind kept '+'.
          (stagehand-diff-partial-scan (cdr body) (cdr flags)
            out
            (cons (concat " " (substring line 1 (length line))) held)
            (+ oldC 1) (+ newC 1)
            leadN t nil changes
            oStart nStart tail header))
        (t
          ;; DROPPED '+': omit; a leading one shifts the new start.
          (stagehand-diff-partial-scan (cdr body) (cdr flags)
            out held oldC newC
            (+ leadN (if keptAny 0 1))
            keptAny nil changes
            oStart nStart tail header))))))

(defun stagehand-diff-swap-body (lines)
  "Swap '+'/'-' prefixes (context and markers untouched) — the
CACHED-side partial construction's sign mirror."
  (if (null lines)
    (list)
    (let ((l (car lines)))
      (cons (cond
              ((string-prefix-p "-" l) (concat "+" (substring l 1 (length l))))
              ((string-prefix-p "+" l) (concat "-" (substring l 1 (length l))))
              (t l))
        (stagehand-diff-swap-body (cdr lines))))))

(defun stagehand-diff-partial-patch-cached (idx flags)
  "The CACHED-side (unstage) partial patch: the roles INVERT — the
patch's old side is the INDEX content, so the body's signs swap
(a dropped change STAYS in the index: its '+' line becomes CONTEXT
' +content', its '-' line omits; a SELECTED change swaps to
'-new/+old') and the header starts exchange places. Built with the
SAME scan; applied via `git apply --cached -` WITHOUT -R. Returns
the patch string, or nil with the refusal named."
  (setq stagehand-diff-partial-refusal nil)
  (let* ((split (stagehand-diff-split-patch (stagehand-diff-hunk-patch idx))))
    (if (null split)
      (progn
        (setq stagehand-diff-partial-refusal "no hunk at that index")
        nil)
      (let* ((header (nth 0 split))
             (hunk (nth 1 split))
             (spec (stagehand-diff-hunk-spec (car hunk))))
        (stagehand-diff-partial-scan
          (stagehand-diff-swap-body (cdr hunk)) flags (list) (list)
          0 0
          0
          nil nil 0
          (nth 2 spec) (nth 0 spec) (nth 4 spec) header)))))

(defun stagehand-diff-flags-for-lines (idx from-line to-line)
  "FLAGS for hunk IDX restricted to the view lines FROM..TO
(inclusive, view-line space): body line k of hunk IDX sits at view
line hunk-start + 1 + k. The list spans the hunk's FULL body (a
short flag list would default-to-keep its tail and over-stage)."
  (let* ((split (stagehand-diff-split-patch (stagehand-diff-hunk-patch idx)))
         (body-len (if split (- (length (nth 1 split)) 1) 0))
         (start (nth idx stagehand-diff-hunks)))
    (stagehand-diff-flags-scan 0 body-len start from-line to-line (list))))

(defun stagehand-diff-flags-scan (k body-len start from to acc)
  (if (>= k body-len)
    (reverse acc)
    (stagehand-diff-flags-scan (+ k 1) body-len start from to
      (cons (and (>= (+ start 1 k) from) (<= (+ start 1 k) to)) acc))))

(defun stagehand-diff-stage-hunk ()
  "s (worktree view) — stage the hunk at point: git apply --cached -
with the reconstructed patch on stdin."
  (stagehand-diff-apply-hunk "stage"))

(defun stagehand-diff-unstage-hunk ()
  "u (cached view) — unstage the hunk at point: git apply --cached
-R -."
  (stagehand-diff-apply-hunk "unstage"))

(defun stagehand-diff-discard-hunk ()
  "D (worktree view) — discard the hunk at point in the WORKTREE:
git apply -R - (a worktree mutation, NOT an index op). Confirms via
the n-first y/n."
  (cond
    (stagehand-diff-apply-in-flight
      ;; Valve r2: the async y/n confirm outlives the keypress —
      ;; never open it (or launch from its accept) over a running
      ;; apply.
      (editor-set-status "Stagehand: an apply is still running"))
    ((not (string= stagehand-diff-side "worktree"))
      (editor-set-status "Stagehand: D discards worktree hunks"))
    (t
    (let ((refusal (stagehand-diff-refusal-reason)))
      (if refusal
        (editor-set-status (concat "Stagehand: " refusal))
        (let ((idx (stagehand-diff-hunk-idx-at-cursor)))
          (if (null idx)
            (editor-set-status "Stagehand: no hunk at point")
            (progn
          (setq stagehand-diff-pending idx)
          (setq stagehand-diff-pending-gen stagehand-diff-view-gen)
          (completing-read
            (concat "Discard this hunk in the worktree? (y/n)")
            "stagehand/diff/stagehand-diff-table"
            nil t "" "stagehand-diff-hist"
            "stagehand/diff/stagehand-diff-accept")))))))))

(defvar stagehand-diff-pending nil
  "The hunk idx awaiting the discard y/n.")
(defvar stagehand-diff-pending-gen nil
  "The view generation the pending discard was opened against (a
stale y must not discard ANOTHER view's hunk — valve r3).")

(defun stagehand-diff-table (input action)
  "n FIRST (the #287 lesson: a bare Enter must CANCEL)."
  (if (string= action "metadata")
    (hashmap "category" "plain")
    (list
      (hashmap "value" "n" "display" "n" "annotation" "" "metadata" (hashmap))
      (hashmap "value" "y" "display" "y" "annotation" "" "metadata" (hashmap)))))

(defun stagehand-diff-accept (answer)
  (if (string= answer "y")
    (let ((idx stagehand-diff-pending))
      (setq stagehand-diff-pending nil)
      (cond
        ((and idx (not (= (or stagehand-diff-pending-gen -1)
                          (or stagehand-diff-view-gen -2))))
          ;; valve r3: the view CHANGED since the confirm opened —
          ;; the pending idx belongs to ANOTHER view's hunks.
          (editor-set-status "Stagehand: the view changed — discard cancelled"))
        (stagehand-diff-apply-in-flight
          (editor-set-status "Stagehand: an apply is still running"))
        (idx (stagehand-diff-apply-hunk-at idx "discard"))
        (t (editor-set-status "Stagehand: no discard pending"))))
    (progn
      (setq stagehand-diff-pending nil)
      (editor-set-status "Stagehand: discard cancelled"))))

(defun stagehand-diff-hunk-idx-at-cursor ()
  ;; The 0-based hunk index whose HEADER is at/above the cursor AND
  ;; in the CURSOR'S file block (valve r1: on a later file's header
  ;; region the old global lookup grabbed the PREVIOUS file's last
  ;; hunk — s/u/D acted on the wrong file; now it yields nil).
  (let ((blk (stagehand-diff-block-at-cursor)) (best nil) (i 0))
    (while (< i (length stagehand-diff-hunks))
      (if (<= (nth i stagehand-diff-hunks) (cursor-line))
        (if (= (stagehand-diff-hunk-block-of i) blk)
          (setq best i))
        (setq i (length stagehand-diff-hunks)))
      (setq i (+ i 1)))
    best))

(defun stagehand-diff-hunk-block-of (idx)
  ;; Hunk IDX → its 0-based file block (a pairs-walk counting
  ;; diff --git blocks and hunks; RAW-index space like block-scan).
  (stagehand-diff-hunk-block-of-scan
    (stagehand-diff-parse (or stagehand-diff-raw ""))
    -1 0 idx))

(defun stagehand-diff-hunk-block-of-scan (pairs block count target)
  (if (null pairs)
    block
    (let* ((pair (car pairs))
           (cls (car pair))
           (line (car (cdr pair))))
      (cond
        ((and (string= cls "file-header")
              (string-prefix-p "diff --git " line))
          (stagehand-diff-hunk-block-of-scan (cdr pairs)
            (+ block 1) count target))
        ((string= cls "hunk-header")
          (if (= count target)
            block
            (stagehand-diff-hunk-block-of-scan (cdr pairs) block
              (+ count 1) target)))
        (t
          (stagehand-diff-hunk-block-of-scan (cdr pairs) block count target))))))

(defun stagehand-diff-apply-hunk (op)
  ;; Key availability FIRST (the issue: a key that does not apply in
  ;; the current view no-ops with a status).
  (cond
    (stagehand-diff-apply-in-flight
      ;; valve r1: a second s/u/D before the running apply's sentinel
      ;; lands would stomp its err/exit state — no-op instead.
      (editor-set-status "Stagehand: an apply is still running"))
    ((and (string= op "stage") (not (string= stagehand-diff-side "worktree")))
      (editor-set-status "Stagehand: s stages worktree hunks (open with d)"))
    ((and (string= op "unstage") (not (string= stagehand-diff-side "cached")))
      (editor-set-status "Stagehand: u unstages cached hunks"))
    (t
      ;; Refusal scoped to the CURSOR'S BLOCK first (r4: structural
      ;; keying — the refusal classes have no hunks, their cursor
      ;; sits in the block), then the hunk-at-point check (never a
      ;; mislabeled 'no hunk at point' for a refusal-class block).
      (let ((refusal (stagehand-diff-refusal-reason)))
        (if refusal
          (editor-set-status (concat "Stagehand: " refusal))
          (let ((idx (stagehand-diff-hunk-idx-at-cursor)))
            (if (null idx)
              (editor-set-status "Stagehand: no hunk at point")
              (let ((sel (stagehand-diff-selection-range)))
                (if sel
                  (stagehand-diff-apply-partial-at idx (nth 0 sel) (nth 1 sel) op)
                  (stagehand-diff-apply-hunk-at idx op))))))))))

(defun stagehand-diff-spawn-apply (flags patch)
  "The shared apply spawn: `git apply <flags> -` with PATCH on stdin.
git apply's diagnostics go to STDERR, and make-process filters see
STDOUT only — so it runs `sh -c \"git apply <flags> - 2>&1\"` (a
FIXED constant — no user data crosses the shell)."
  (let* ((cmd (concat "git apply " (string-join " " flags) " - 2>&1"))
         (pid (make-process
                :command cmd
                :cwd (or stagehand-diff-root ".")
                :filter "stagehand/diff/stagehand-diff-apply-filter"
                :sentinel "stagehand/diff/stagehand-diff-apply-sentinel")))
    (setq stagehand-diff-apply-err nil)
    (setq stagehand-diff-apply-exit nil)
    (setq stagehand-diff-apply-view-gen stagehand-diff-view-gen)
    (setq stagehand-diff-apply-in-flight t)
    (process-write pid (concat patch "\n"))
    (process-close-stdin pid)
    (editor-set-status "Stagehand: applying hunk…")))

(defun stagehand-diff-apply-hunk-at (idx op)
  (let ((flags (cond
                 ((string= op "discard") (list "-R"))
                 ((string= op "unstage") (list "--cached" "-R"))
                 (t (list "--cached")))))
    ;; git apply takes the PATCH (here '-') — no pathspec args (the
    ;; patch itself carries the paths). Each flag is its own argv
    ;; element ("--cached -R" as ONE string was a usage error).
    (stagehand-diff-spawn-apply flags (stagehand-diff-hunk-patch idx))))

;; ── selected-line staging: the mark + the partial apply (#331) ──────
(defvar stagehand-diff-mark nil
  "The MARKED view line (m toggles; s/u with the mark inside the
cursor's hunk stage/unstage the mark..cursor LINE RANGE). Cleared
at apply-launch, refresh and quit (line numbers shift).")

(defun stagehand-diff-toggle-mark ()
  "m — set the mark at point; a second m on the same line clears."
  (if (and (numberp stagehand-diff-mark)
           (= stagehand-diff-mark (cursor-line)))
    (progn
      (setq stagehand-diff-mark nil)
      (editor-set-status "Stagehand: mark cleared"))
    (progn
      (setq stagehand-diff-mark (cursor-line))
      (editor-set-status
        (concat "Stagehand: mark at line "
          (number-to-string (+ (cursor-line) 1))
          " — s/u stages the mark..cursor lines")))))

(defun stagehand-diff-mark-get ()
  "The marked view line (a test/inspection seam)."
  stagehand-diff-mark)

(defun stagehand-diff-selection-range ()
  "The (FROM TO) view lines (ordered) when the mark is set AND both
the mark and the cursor sit inside the SAME hunk; nil otherwise
(whole-hunk mode)."
  (if (not (numberp stagehand-diff-mark))
    nil
    (let ((idx (stagehand-diff-hunk-idx-at-cursor)))
      (if (null idx)
        nil
        (let* ((start (nth idx stagehand-diff-hunks))
               (split (stagehand-diff-split-patch (stagehand-diff-hunk-patch idx)))
               (end (+ start (if split (length (nth 1 split)) 1)))
               (a stagehand-diff-mark)
               (b (cursor-line)))
          (if (and (>= a start) (< a end)
                   (>= b start) (< b end))
            (if (<= a b) (list a b) (list b a))
            nil))))))

(defun stagehand-diff-apply-partial-at (idx from to op)
  "s/u over the mark..cursor RANGE: build the partial patch and
spawn the SAME apply flow. The cached side uses the SIGN-SWAP
variant (applied WITHOUT -R). The constructor's refusal surfaces
as the named status (nothing launched)."
  (let* ((flags (if (string= op "unstage") (list "--cached") (list "--cached")))
         (patch (if (string= op "unstage")
                  (stagehand-diff-partial-patch-cached idx
                    (stagehand-diff-flags-for-lines idx from to))
                  (stagehand-diff-partial-patch idx
                    (stagehand-diff-flags-for-lines idx from to)))))
    (if (not (stringp patch))
      (editor-set-status
        (concat "Stagehand: "
          (or stagehand-diff-partial-refusal "selection refused")))
      (progn
        (setq stagehand-diff-mark nil)
        (stagehand-diff-spawn-apply flags patch)))))

(defun stagehand-diff-refusal-reason ()
  ;; Binary / rename-copy / mode-only hunks REFUSE (named, no-op).
  (cond
    ((stagehand-diff-patch-has "Binary files ") "binary files not supported (hunk ops)")
    ((stagehand-diff-patch-has "rename from ") "rename hunks: use file-level ops (#287)")
    ((stagehand-diff-patch-has "rename to ") "rename hunks: use file-level ops (#287)")
    ((stagehand-diff-patch-has "copy from ") "copy hunks: use file-level ops (#287)")
    ((stagehand-diff-patch-has "copy to ") "copy hunks: use file-level ops (#287)")
    ((and (stagehand-diff-patch-has "old mode ")
          (stagehand-diff-patch-has "new mode ")
          (not (stagehand-diff-patch-has "@@ ")))
      ;; MODE-ONLY: no hunks in the block. A mode+CONTENT block
      ;; stages its content hunks (the reconstructed header omits the
      ;; mode lines — the patch carries content only; the mode change
      ;; stays unstaged, hunk-granular like file-level ops own it).
      "mode-only changes not supported")
    (t nil)))

(defun stagehand-diff-block-at-cursor ()
  "The 0-based file BLOCK containing the cursor (the count of
'diff --git' raw lines up to the cursor's — NOTE the index spaces
differ from stagehand-diff-hunks: hunk positions live in BUFFER-line
space (compared to cursor-line directly), this scan walks RAW-index
space (cursor-line - 1, the title-line offset)). The refusal scope
keys on THIS: structural, never path-text
(git's trailing-tab space form and core.quotePath quoted forms made
every path-parse-based keying miss — the r4 gate's confirmed hole:
a rename-with-content hunk on a space/non-ASCII path reached git
apply unrefused), and never hunk-at-point-keyed (the refusal
classes — binary/rename/mode-only — have NO hunks, so their cursor
sits in the block, not on a hunk)."
  ;; The view prepends a TITLE line: buffer line 0 is the title and
  ;; raw line k (0-based split index) renders at cursor-line k+1 —
  ;; so the cursor's raw line is cursor-line - 1, CLAMPED to 0 (the
  ;; cursor at the title scopes the FIRST block — the refusal tests'
  ;; contract; an off-by-one here scopes a block-final cursor to the
  ;; NEXT file's block).
  (stagehand-diff-block-scan
    (string-split (or stagehand-diff-raw "") "\n")
    (if (< (cursor-line) 1) 0 (- (cursor-line) 1)) 0 0))

(defun stagehand-diff-block-scan (lines i idx seen)
  ;; IDX: raw line index; SEEN: diff --git lines passed (so far).
  (if (or (null lines) (> idx i))
    (- seen 1)
    (stagehand-diff-block-scan (cdr lines) i (+ idx 1)
      (if (string-prefix-p "diff --git " (car lines))
        (+ seen 1)
        seen))))

(defun stagehand-diff-patch-has (needle)
  ;; Scoped to the TARGET FILE's section (a rename on an unrelated
  ;; file in the view must not block this hunk — the r1/r2 gate
  ;; catch, live-reproduced).
  (stagehand-diff-scan-for
    (string-split (or (stagehand-diff-file-section) "") "\n") needle))

(defun stagehand-diff-file-section ()
  "The section under the CURSOR — its 'diff --git' BLOCK, verbatim
to the next one. Keyed on the cursor's block ordinal (structural —
the r3 wrong-keying catch AND the r4 quoted/space-path hole both
die here: no path is ever parsed, no hunk is required at point)."
  (stagehand-diff-section-block
    (string-split (or stagehand-diff-raw "") "\n")
    (stagehand-diff-block-at-cursor) 0 nil (list)))

(defun stagehand-diff-section-block (lines target block collecting out)
  ;; The TARGET-th 'diff --git' block, verbatim (to the next one).
  (if (null lines)
    (string-join "\n" (reverse out))
    (let ((line (car lines)))
      (if (string-prefix-p "diff --git " line)
        (if collecting
          (string-join "\n" (reverse out))
          (if (= block target)
            (stagehand-diff-section-block (cdr lines) target block t (list line))
            (stagehand-diff-section-block (cdr lines) target (+ block 1) nil (list))))
        (if collecting
          (stagehand-diff-section-block (cdr lines) target block t (cons line out))
          (stagehand-diff-section-block (cdr lines) target block nil (list)))))))

(defun stagehand-diff-scan-for (lines needle)
  (if (null lines)
    nil
    (if (string-prefix-p needle (car lines))
      t
      (stagehand-diff-scan-for (cdr lines) needle))))

(defvar stagehand-diff-apply-err nil "The last apply's diagnostics.")

(defun stagehand-diff-apply-filter (pid output)
  "The apply's MERGED stdout+stderr (the 2>&1 shell redirect in the
apply command — make-process filters see stdout only, and git
apply's diagnostics go to stderr; the merge is what makes the
failure message's first line possible)."
  (setq stagehand-diff-apply-err
    (concat (or stagehand-diff-apply-err "") output)))

(defun stagehand-diff-apply-exit-get ()
  "The last apply's exit code (a VALUE getter — tests poll this)."
  stagehand-diff-apply-exit)
(defvar stagehand-diff-apply-exit nil
  "The last apply's exit code (tests poll this).")

(defun stagehand-diff-apply-sentinel (pid code)
  "The apply's exit: 0 → refresh the view in place + 'hunk applied';
≠ 0 → the failure names exit + stderr + the refresh-and-retry hint
(a stale diff lands here — the view does NOT auto-retry)."
  (setq stagehand-diff-apply-exit code)
  (setq stagehand-diff-apply-in-flight nil)
  (if (and (numberp code) (= code 0))
    (if (not (= stagehand-diff-apply-view-gen stagehand-diff-view-gen))
      ;; valve r1/r2: the view was quit or replaced (gen bump) —
      ;; refreshing would recreate it against the wrong targets.
      (editor-set-status "Stagehand: hunk applied (the view changed — press g to refresh)")
      ;; valve r3: a switched-away view still refreshes IN PLACE
      ;; (refresh-view restores the current buffer); 'hunk applied'
      ;; only when the refresh succeeded — a failed refresh keeps
      ;; its own 'refresh failed' status.
      (if (stagehand-diff-refresh-view)
        (editor-set-status "Stagehand: hunk applied")))
    (editor-set-status
      (concat "Stagehand: apply failed ("
        (number-to-string code) ") "
        (stagehand-diff-first-line stagehand-diff-apply-err)
        " — refresh and retry"))))

(defun stagehand-diff-first-line (s)
  (let ((l (car (string-split (concat (or s "") "\n") "\n"))))
    (if (and l (> (length l) 0)) l "")))

(defun stagehand-diff-refresh-view ()
  "Re-render in place on the SAME side (the #289 contract; the
refresh-and-retry hint's action — bound to g). Returns t on
success, nil when the underlying git diff failed (the sentinel
then does NOT overwrite 'refresh failed' with 'hunk applied' —
valve r3). The render happens INTO the diff buffer without
stealing the user's current buffer (valve r3: a switched-away
view still refreshes; only a quit/replaced view — a gen mismatch —
does not)."
  (let* ((cached (string= stagehand-diff-side "cached"))
         (res (shell-exec-argv
                (append (list "git" "diff" "--no-color")
                  (append (if cached (list "--cached") (list))
                    (if stagehand-diff-paths
                      ;; Valve r2: every path in git's :(literal)
                      ;; magic — a raw glob-shaped filename would
                      ;; sweep its siblings into the refreshed view.
                      (append (list "--")
                        (mapcar (lambda (p) (concat ":(literal)" p))
                          stagehand-diff-paths))
                      (list))))
                (or stagehand-diff-root "."))))
    (if (and (numberp (nth 2 res)) (= (nth 2 res) 0))
      (let ((cb (buffer-name)))
        (if (string= (string-trim (car res)) "")
          ;; Nothing left on this side: the clean EMPTY notice + state
          ;; cleared (no stale silent no-op).
          (progn
            (setq stagehand-diff-hunks (list))
            (setq stagehand-diff-raw nil)
            (stagehand-diff-ensure-buffer)
            (buffer-set-read-only nil)
            (stagehand-diff-clear)
            (buffer-append (concat "Stagehand-Diff: "
              (or (car stagehand-diff-paths) "diff")
              " — no changes on this side\n"))
            (buffer-set-read-only t)
            (editor-set-status "Stagehand: no changes on this side"))
          (stagehand-diff-open (car res)
            (concat "Stagehand-Diff: " (or (car stagehand-diff-paths) "diff"))
            stagehand-diff-side stagehand-diff-root stagehand-diff-paths))
        ;; Restore the user's current buffer (the render switched to
        ;; the diff buffer); t = refreshed.
        (if (not (string= cb (stagehand-diff-buffer-name)))
          (buffer-switch cb))
        t)
      (progn
        (editor-set-status "Stagehand: refresh failed")
        nil))))

(defun stagehand-diff-ensure-buffer ()
  (if (not (string= (buffer-current) (stagehand-diff-buffer-name)))
    (progn
      (if (not (member (stagehand-diff-buffer-name) (buffer-list)))
        (buffer-create (stagehand-diff-buffer-name)))
      (buffer-switch (stagehand-diff-buffer-name)))))

(defun stagehand-diff-clear ()
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (buffer-delete-range 0 0 (- count 1) 0)))
  (let ((l (buffer-line 0)))
    (if (and l (> (length l) 0))
      (buffer-delete-range 0 0 0 (length l)))))

(defun stagehand-diff-ensure-keymap ()
  (let ((kmap (editor/keymaps/buffer-keymap (stagehand-diff-buffer-name))))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "stagehand-diff"))
        (editor/keymaps/keymap-set-key kmap "n" "(stagehand/diff/stagehand-diff-next)")
        (editor/keymaps/keymap-set-key kmap "p" "(stagehand/diff/stagehand-diff-prev)")
        (editor/keymaps/keymap-set-key kmap "q" "(stagehand/diff/stagehand-diff-quit)")
        (editor/keymaps/keymap-set-key kmap "m" "(stagehand/diff/stagehand-diff-toggle-mark)")
        (editor/keymaps/keymap-set-key kmap "s" "(stagehand/diff/stagehand-diff-stage-hunk)")
        (editor/keymaps/keymap-set-key kmap "u" "(stagehand/diff/stagehand-diff-unstage-hunk)")
        (editor/keymaps/keymap-set-key kmap "D" "(stagehand/diff/stagehand-diff-discard-hunk)")
        (editor/keymaps/keymap-set-key kmap "g" "(stagehand/diff/stagehand-diff-refresh-view)")
        (editor/keymaps/buffer-set-keymap (stagehand-diff-buffer-name) kmap))))
  t)

(provide "stagehand-diff"))
