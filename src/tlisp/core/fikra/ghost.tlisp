(defmodule fikra/ghost
  (export fikra-ghost-active-p fikra-ghost-accept fikra-ghost-accept-word
          fikra-ghost-dismiss fikra-ghost-maybe-trigger fikra-ghost-set
          fikra-ghost-set-source fikra-ghost-source-local fikra-ghost-source-none
          fikra-ghost-text fikra-ghost-stale-dismiss
          fikra-ghost-source-ollama fikra-ghost-ollama-model-get
          fikra-ghost-ollama-last-ms fikra-ghost-http-filter
          fikra-ghost-cycle-source fikra-ghost-ollama-seed fikra-ghost-http-complete)

;; RFC-029 section 8.8 (P5, round 1): inline completion at the cursor.
;; The EDITOR state carries the rendered text (ghost-text-set); this module
;; mirrors it, owns the SOURCE, and the keys: TAB accept (the insert-mode
;; handler checks accept FIRST, before snippet mode), C-n partial (accept
;; to the first word boundary — bound in the insert keymap below), Esc
;; dismiss (the handler clears on leaving insert).

(require-module fikra/event)
(defvar fikra-ghost-source-name "fikra/ghost/fikra-ghost-source-none"
  "The completion source: none (default), local (buffer-context), or a
custom function name taking the line prefix and returning a string/nil.")
(defvar fikra-ghost-current nil
  "The active ghost text (mirrors editor state; nil when dismissed).")
(defvar fikra-ghost-min-prefix 3)
(defvar fikra-ghost-max-len 60)

(defun fikra-ghost-set-source (name)
  (setq fikra-ghost-source-name name)
  name)

(defvar fikra-ghost-anchor-line nil
  "The line the ghost was computed for (accept refuses on a moved cursor).")
(defvar fikra-ghost-anchor-col nil)
(defvar fikra-ghost-anchor-prefix nil
  "The line's text up to the anchor at trigger time (r40: coordinates alone
re-armed after move-away-and-back; the CONTENT must match too).")

(defun fikra-ghost-set (text)
  ;; Single-line scope: the MIRROR stores the same first line the render
  ;; shows (codex r38: a multiline source could display one thing and
  ;; accept another).
  (let ((first (fikra-ghost-first-line text 0)))
    (setq fikra-ghost-current (if (> (length first) 0) first nil))
    (setq fikra-ghost-anchor-line (cursor-line))
    (setq fikra-ghost-anchor-col (cursor-column))
    (setq fikra-ghost-anchor-prefix
      (let ((l (buffer-line)))
        (if (> fikra-ghost-anchor-col (length l)) l
          (substring l 0 fikra-ghost-anchor-col))))
    (if fikra-ghost-current
      (progn
        (ghost-text-set fikra-ghost-current)
        (ghost-anchor-set fikra-ghost-anchor-line fikra-ghost-anchor-col))
      (ghost-text-clear))))

(defun fikra-ghost-first-line (s i)
  (if (or (>= i (length s)) (string= (substring s i (+ i 1)) "\n"))
    (substring s 0 i)
    (fikra-ghost-first-line s (+ i 1))))

(defun fikra-ghost-dismiss ()
  (interactive)
  (setq fikra-ghost-current nil)
  (ghost-text-clear)
  nil)

(defun fikra-ghost-active-p ()
  (if (and fikra-ghost-current (> (length fikra-ghost-current) 0)) t nil))

(defun fikra-ghost-text ()
  "The active ghost text (nil when dismissed)."
  (if (fikra-ghost-active-p) fikra-ghost-current nil))

(defun fikra-ghost-anchored-p ()
  ;; The suggestion belongs to its (line, column) AND the line's PREFIX
  ;; up to that column (r40: coordinates alone re-armed after a move away
  ;; and back). PREFIX edits invalidate (the completion's basis changed);
  ;; suffix edits do not (the ghost still means the same insertion at the
  ;; same position; the r41 product boundary, stated deliberately).
  (if (not (fikra-ghost-active-p))
    nil
    (and (= fikra-ghost-anchor-line (cursor-line))
         (= fikra-ghost-anchor-col (cursor-column))
         (string= (fikra-ghost-current-prefix) fikra-ghost-anchor-prefix))))

(defun fikra-ghost-current-prefix ()
  (let ((l (buffer-line)))
    (if (> fikra-ghost-anchor-col (length l)) l
      (substring l 0 fikra-ghost-anchor-col))))

(defun fikra-ghost-stale-dismiss ()
  "Public: clear a ghost that no longer matches its context (movement)."
  (if (fikra-ghost-anchored-p)
    nil
    (progn (fikra-ghost-dismiss) t)))

(defun fikra-ghost-accept ()
  "TAB: insert the whole ghost at the cursor, dismiss. Refuses (and
clears) when the cursor left the suggestion's anchor."
  (interactive)
  (if (fikra-ghost-anchored-p)
    (progn
      (buffer-insert fikra-ghost-current)
      (fikra-ghost-dismiss)
      t)
    (progn
      (fikra-ghost-dismiss)
      nil)))

(defun fikra-ghost-accept-word ()
  "C-n: accept the ghost's first word; the REMAINDER stays as the new
ghost (r92, codex r91 P3 — dismissing it all made a second C-n lose the
suggestion; repeated partial accepts walk the ghost word by word)."
  (interactive)
  (if (fikra-ghost-anchored-p)
    (let* ((word (fikra-ghost-word-prefix fikra-ghost-current 0 ""))
           (rest (substring fikra-ghost-current
                            (length word) (length fikra-ghost-current))))
      (buffer-insert word)
      (if (> (length rest) 0)
        (fikra-ghost-set rest)
        (fikra-ghost-dismiss))
      t)
    (progn
      (fikra-ghost-dismiss)
      nil)))

(defun fikra-ghost-word-prefix (s i acc)
  ;; Through the first word: skip leading spaces, then include through the
  ;; NEXT space (a ghost starting with " brave" accepts " brave ").
  (fikra-ghost-word-scan s (fikra-ghost-skip-spaces s 0)))

(defun fikra-ghost-skip-spaces (s i)
  (if (and (< i (length s)) (string= (substring s i (+ i 1)) " "))
    (fikra-ghost-skip-spaces s (+ i 1))
    i))

(defun fikra-ghost-word-scan (s i)
  (if (>= i (length s))
    s
    (if (string= (substring s i (+ i 1)) " ")
      (substring s 0 (+ i 1))
      (fikra-ghost-word-scan s (+ i 1)))))

(defun fikra-ghost-maybe-trigger ()
  "After a printable insert: ask the SOURCE for a completion of the
current line prefix; set or clear the ghost. No-op when the source is
none or the prefix is too short."
  (let* ((line (buffer-line))
         (col (cursor-column))
         (prefix (if (> col (length line)) line (substring line 0 col))))
    (if (< (length prefix) fikra-ghost-min-prefix)
      (fikra-ghost-dismiss)
      (let ((completion (condition-case nil
                            (funcall fikra-ghost-source-name prefix)
                            (error () nil))))
        (if (and completion (> (length completion) 0))
          (fikra-ghost-set (fikra-ghost-truncate completion 0 ""))
          (fikra-ghost-dismiss))))))

(defun fikra-ghost-truncate (s i acc)
  (if (>= i fikra-ghost-max-len)
    acc
    (if (>= i (length s))
      s
      (fikra-ghost-truncate s (+ i 1) (concat acc (substring s i (+ i 1)))))))

;; ── sources ─────────────────────────────────────────────────────────
(defun fikra-ghost-source-none (prefix)
  nil)

;; LOCAL context: find another line in this buffer that STARTS with the
;; prefix and is longer — offer its remainder. Zero-dependency, honest
;; "local (buffer context)" completion; the mockup's ollama source slots
;; in as another fikra-ghost-set-source choice.
(defun fikra-ghost-source-local (prefix)
  (fikra-ghost-local-scan (buffer-lines) prefix 0 nil))

(defun fikra-ghost-local-scan (lines prefix i best)
  (if (>= i (length lines))
    best
    (let* ((line (nth i lines))
           (rest (fikra-ghost-local-rest line prefix 0)))
      (fikra-ghost-local-scan lines prefix (+ i 1)
        (if (and rest (> (length rest) 0)
                 (or (not best) (> (length rest) (length best))))
          rest
          best)))))

;; The remainder of LINE after PREFIX when LINE starts with PREFIX.
(defun fikra-ghost-local-rest (line prefix i)
  (if (>= i (length prefix))
    (if (> (length line) (length prefix))
      (substring line (length prefix) (length line))
      nil)
    (if (or (>= i (length line))
            (not (string= (substring line i (+ i 1)) (substring prefix i (+ i 1)))))
      nil
      (fikra-ghost-local-rest line prefix (+ i 1)))))

;; ── the ollama source (r89 — the mockup's "ollama (local, 40ms)") ────
;; ASYNC by design: the source fires the HTTP request and returns nil;
;; the ghost SETS when the response lands (the http filter + the global
;; fikra-http-complete callback below) — and only if the cursor still
;; sits at the request's prefix. The measured latency rides the footer.

(defvar fikra-ghost-ollama-url "http://localhost:11434"
  "The local ollama server.")
(defvar fikra-ghost-ollama-model nil
  "The model to complete with. nil = resolve from /api/tags at first use
(the first installed model — a deliberate default, setq to override).")
(defvar fikra-ghost-ollama-last-ms nil
  "The last completion's measured latency (the footer label's number).")
(defvar fikra-ghost-http-bodies (hashmap)
  "request-id → the accumulated response body (hex-decoded chunks).")
(defvar fikra-ghost-http-starts (hashmap)
  "request-id → the fire time in ms (the latency measurement).")
(defvar fikra-ghost-pending-prefix nil
  "The line prefix the in-flight request completes (the land-time check).")
(defvar fikra-ghost-latest-id nil
  "The id of the LATEST fired request (r90, codex r89 P1#1: an older
response must NEVER land — stale arrivals are ignored entirely).")
(defvar fikra-ghost-pending-line nil
  "The line NUMBER + buffer at fire time (r90, codex r89 P2#3: the prefix
alone could be satisfied by identical text on another line/buffer).")

(defun fikra-ghost-source-ollama (prefix)
  "The ASYNC completion source: fire the request, return nil (the ghost
sets on arrival). The model resolves from /api/tags on first use."
  (setq fikra-ghost-pending-prefix prefix)
  (setq fikra-ghost-pending-line
    (concat (buffer-name) ":" (number-to-string (cursor-line))))
  (setq fikra-ghost-ollama-last-ms nil)
  (if fikra-ghost-ollama-model
    (fikra-ghost-ollama-generate prefix)
    ;; Model unknown: ask /api/tags first; its completion fires the
    ;; generate for the still-pending prefix.
    (fikra-ghost-ollama-tags))
  nil)

(defun fikra-ghost-ollama-tags ()
  ;; r92 (codex r91 P1): the tags request IS the latest request until its
  ;; follow-up generate restamps — it must carry the identity or the
  ;; completion guard discards it and first-use discovery dies.
  (let ((id (http-request (concat fikra-ghost-ollama-url "/api/tags")
                          :method "GET"
                          :filter "fikra/ghost/fikra-ghost-http-filter")))
    (setq fikra-ghost-latest-id id)
    id))

(defun fikra-ghost-ollama-generate (prefix)
  (let* ((esc (fikra-ghost-json-escape prefix 0 ""))
         (prompt (concat "Complete this code line. Output ONLY the continuation text, no commentary, no quotes around it:\n" esc))
         (body (concat "{\"model\":\"" fikra-ghost-ollama-model
                       "\",\"prompt\":\"" (fikra-ghost-json-escape prompt 0 "")
                       "\",\"stream\":false,"
                       "\"options\":{\"num_predict\":16,\"temperature\":0}}")))
      (let ((id (http-request (concat fikra-ghost-ollama-url "/api/generate")
                            :method "POST"
                            :body body
                            :filter "fikra/ghost/fikra-ghost-http-filter")))
      (editor/keymaps/keymap-mutable-set! fikra-ghost-http-starts
        (number-to-string id) (current-time))
      (setq fikra-ghost-latest-id id)
      id)))

;; JSON-string escaping on the T-Lisp side (a runtime concat never sees
;; the reader, but the EMBEDDED quotes/backslashes must be JSON-escaped;
;; the backslash is hex-built — literal backslashes are reader-hostile).
(defun fikra-ghost-json-escape (s i acc)
  (if (>= i (length s))
    acc
    (let ((c (substring s i (+ i 1)))
          (bs (hex-decode "5c")))
      (fikra-ghost-json-escape s (+ i 1)
        (cond
          ((string= c "\"") (concat acc bs (hex-decode "22")))
          ((string= c bs) (concat acc bs bs))
          ((string= c "\n") (concat acc bs "n"))
          (t (concat acc c)))))))

;; The http filter (the primitive's callback): accumulate the body per id
;; AND stamp ownership — the global completion dispatcher (below) routes
;; by it (r108: the ollama chat backend shares the one bare global).
(defun fikra-ghost-http-filter (id chunk-hex)
  (let ((k (number-to-string id)))
    (editor/keymaps/keymap-mutable-set!
      (editor/keymaps/keymap-named "fikra-http-owners") k
      "fikra/ghost/fikra-ghost-http-complete")
    (editor/keymaps/keymap-mutable-set! fikra-ghost-http-bodies k
      (concat (hashmap-get fikra-ghost-http-bodies k) (hex-decode chunk-hex))))
  t)


(defun fikra-ghost-strip-echo (resp prefix)
  (if (and prefix (>= (length resp) (length prefix))
           (string= (substring resp 0 (length prefix)) prefix))
    (substring resp (length prefix) (length resp))
    resp))

(defun fikra-ghost-ollama-anchor-holds-p ()
  (let* ((line (buffer-line))
         (col (cursor-column))
         (cur (if (> col (length line)) line (substring line 0 col))))
    (and fikra-ghost-pending-prefix
         (string= cur fikra-ghost-pending-prefix)
         ;; r90: the same prefix on ANOTHER line or buffer does not
         ;; satisfy the anchor (the request belongs to its ground).
         (string= (concat (buffer-name) ":" (number-to-string (cursor-line)))
                  fikra-ghost-pending-line))))

;; alist getter over json-read-from-string shapes (lists of ("k" v)).
(defun fikra-alist-get-ghost (key alist)
  (let ((found nil))
    (dolist (e alist)
      (if (and (not found) (listp e) (= (length e) 2)
               (string= (car e) key))
        (setq found (car (cdr e)))))
    found))

;; Test seam: seed a request's start time + pending prefix (+ point the
;; URL somewhere controllable) — the async land path is otherwise only
;; observable against a live server.
(defun fikra-ghost-ollama-seed (id prefix url)
  (if (not (string= url "no-start"))
    (setq fikra-ghost-ollama-url url))
  ;; url "no-start": seed WITHOUT a start time (the unmeasured-latency
  ;; path — the footer must not reuse an older number).
  (if (not (string= url "no-start"))
    (editor/keymaps/keymap-mutable-set! fikra-ghost-http-starts
      (number-to-string id) (current-time)))
  (setq fikra-ghost-pending-prefix prefix)
  ;; r90: the seed simulates the FIRE — the identity stamps a real fire
  ;; carries (latest request, line+buffer ground, source selected).
  (setq fikra-ghost-latest-id id)
  (setq fikra-ghost-pending-line
    (concat (buffer-name) ":" (number-to-string (cursor-line))))
  (setq fikra-ghost-source-name "fikra/ghost/fikra-ghost-source-ollama")
  ;; r108: the seed simulates the FIRE — ownership included (the
  ;; dispatcher routes by it; the filter normally stamps it).
  (editor/keymaps/keymap-mutable-set!
    (editor/keymaps/keymap-named "fikra-http-owners")
    (number-to-string id) "fikra/ghost/fikra-ghost-http-complete")
  id)

;; TEMP debug getter (remove before landing).
;; Model getter (defvars are not readable cross-module; the export list
;; is callables only).
(defun fikra-ghost-ollama-model-get ()
  fikra-ghost-ollama-model)

(defun fikra-ghost-body-get (id)
  (hashmap-get fikra-ghost-http-bodies (number-to-string id)))

;; SPC a o: cycle the completion source none → local → ollama → none
;; (the status announces the live choice; the mockup's footer rides each
;; landed ghost).
(defun fikra-ghost-cycle-source ()
  (interactive)
  (let ((next
          (cond
            ((string= fikra-ghost-source-name "fikra/ghost/fikra-ghost-source-none")
              "fikra/ghost/fikra-ghost-source-local")
            ((string= fikra-ghost-source-name "fikra/ghost/fikra-ghost-source-local")
              "fikra/ghost/fikra-ghost-source-ollama")
            (t "fikra/ghost/fikra-ghost-source-none"))))
    (setq fikra-ghost-source-name next)
    (editor-set-status
      (cond
        ((string= next "fikra/ghost/fikra-ghost-source-local")
          "Fikra ghost: local (buffer context)")
        ((string= next "fikra/ghost/fikra-ghost-source-ollama")
          (concat "Fikra ghost: ollama (local"
                  (if fikra-ghost-ollama-model (concat ", " fikra-ghost-ollama-model) "")
                  ")"))
        (t "Fikra ghost: off")))
    next))

;; The primitive's callback body (module-side — its defvars live here;
;; the GLOBAL fikra-http-complete is a thin dispatcher below).
(defun fikra-ghost-http-complete (id status data-hex)
  (let* ((k (number-to-string id))
         (body (hashmap-get fikra-ghost-http-bodies k))
         (start (hashmap-get fikra-ghost-http-starts k)))
    ;; r91 (codex r90 P1): the LATEST-request guard runs BEFORE anything
    ;; else — a stale arrival (success OR error) is ignored ENTIRELY; it
    ;; must not clear pending state nor claim the footer with its error.
    (editor/keymaps/keymap-mutable-set! fikra-ghost-http-bodies k "")
    (if (not (= id (if fikra-ghost-latest-id fikra-ghost-latest-id -1)))
      nil
    (progn
    ;; r92 (codex r91 P2): the source check precedes the status branch —
    ;; a mid-flight switch to none cancels EVERYTHING, including the
    ;; error footer.
    (if (not (string= fikra-ghost-source-name "fikra/ghost/fikra-ghost-source-ollama"))
      (progn (setq fikra-ghost-pending-prefix nil) nil)
    (progn
    ;; r90: the latency belongs to THIS request — absent start means
    ;; UNMEASURED (nil), never a reused older number.
    (if start
      (setq fikra-ghost-ollama-last-ms (- (current-time) start))
      (setq fikra-ghost-ollama-last-ms nil))
    (if (not (= status 200))
      (progn
        (setq fikra-ghost-pending-prefix nil)
        (editor-set-status
          (concat "TAB accept · C-n partial · Esc dismiss · ollama (unavailable: "
                  (number-to-string status) ")")))
      (let ((parsed (condition-case nil (json-read-from-string body) (error () nil))))
        (if (and parsed (fikra-alist-get-ghost "models" parsed))
          ;; the tags reply: adopt the first model, fire the generate
          (let ((first-model
                  (condition-case nil
                    (fikra-alist-get-ghost "name"
                      (car (fikra-alist-get-ghost "models" parsed)))
                    (error () nil))))
            (if (and first-model (stringp first-model))
              (progn
                (setq fikra-ghost-ollama-model first-model)
                ;; r91 (codex r90 P2): the follow-up generate honors the
                ;; CURRENT source selection (a mid-flight switch to none
                ;; cancels the whole chain).
                (if (and fikra-ghost-pending-prefix
                         (string= fikra-ghost-source-name
                                  "fikra/ghost/fikra-ghost-source-ollama"))
                  (fikra-ghost-ollama-generate fikra-ghost-pending-prefix))))
            t)
          ;; the generate reply: the "response" field completes the line.
          ;; Both guards (latest-request, source-selected) ran above.
          (let ((resp (condition-case nil
                         (fikra-alist-get-ghost "response" parsed)
                         (error () nil))))
            ;; pending-prefix clears AFTER the anchor check/strip.
            (if (and resp (stringp resp) (> (length resp) 0)
                     (fikra-ghost-ollama-anchor-holds-p))
              (progn
                ;; Models often ECHO the prefix (live probe: dolphin-mistral
                ;; returned 'const total = items.reduce...') — the ghost is
                ;; the REMAINDER; strip a leading echo, keep the rest whole.
                (fikra-ghost-set
                  (fikra-ghost-strip-echo resp fikra-ghost-pending-prefix))
                (editor-set-status
                  (concat "TAB accept · C-n partial · Esc dismiss · ollama (local"
                          (if fikra-ghost-ollama-last-ms
                            (concat ", "
                              (number-to-string fikra-ghost-ollama-last-ms) "ms")
                            " — latency unmeasured")
                          ")")))
              (fikra-ghost-dismiss))
            ;; clear AFTER the anchor check/strip (r89: clearing first
            ;; failed anchor-holds' own pending-prefix read).
            (setq fikra-ghost-pending-prefix nil)))))))))))

(provide "fikra-ghost")
)

;; Strip RESP's


;; The anchor check at LAND time: the cursor's line must still carry the
;; requested prefix at the current column (a 20s completion must never
;; land on moved ground — the mockup's 40ms budget is aspirational; the
;; contract is honesty about what arrived).

