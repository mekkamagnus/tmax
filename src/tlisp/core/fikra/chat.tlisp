(defmodule fikra/chat
  (export fikra-chat-open fikra-chat-close fikra-turn-send
          fikra-turn-interrupt fikra-turn-status fikra-quit
          fikra-ensure-buffer-keymap fikra-refresh-lighter
          fikra-follow-link)

;; #216 (RFC-027 §UI): the chat UI as a THIN layer over the Phase-1 stack —
;; threads own state (#213), FAEP owns rendering (#212), adapters own turns
;; (#214). The old globals (fikra-message-history, fikra-turn-status-val)
;; are GONE; the modeline rides dynamic minor-mode lighters (#211).

(require-module fikra/event)
(require-module fikra/thread)
(require-module fikra/adapter)

(defvar fikra-chat-buffer-name "*Fikra*"
  "Name of the Fikra chat buffer.")

;; ── open / close ────────────────────────────────────────────────────
(defun fikra-chat-open ()
  "Open the project chat: thread init-or-load + history replay into *Fikra*
+ buffer-local keymap + lighter. The SPC a a entry point.
#225: init-or-load runs only when NO thread is focused — a workflow that
just created/switched its OWN thread must not be dragged back to main."
  (interactive)
  ;; Mode activation is the caller's job (SPC a a starts it) — requiring
  ;; fikra/mode here would create a mode↔chat cycle.
  (if (not (fikra/thread/fikra-thread-current))
    (fikra/thread/fikra-thread-open)
    (progn
      (fikra/thread/fikra-thread-ensure-chat-buffer)
      (buffer-switch (fikra/thread/fikra-thread-buffer-name))
      (fikra/event/fikra-event-rebuild-fikra-buffer)))
  ;; Markdown major mode: AI replies are markdown (code fences, lists) —
  ;; the buffer-local chat keymap (RET/C-g/approval y/n) still wins over
  ;; mode bindings because buffer keymaps take precedence (codex round-3:
  ;; "the final answer still shows raw Markdown").
  (major-mode-set "markdown")
  ;; Word wrap: long AI replies must not clip at the terminal edge (codex
  ;; round 4). auto-fill toggles the renderer's wordWrap. Safe since the
  ;; wrapped path now uses the ANSI-aware block-cursor walker (the naive
  ;; one crashed the client on live-appended colored lines — fixed
  ;; 2026-11-20 in buffer-lines.ts).
  (minor-mode-set "auto-fill" t)
  (fikra-ensure-buffer-keymap)
  (fikra-refresh-lighter)
  fikra-chat-buffer-name)

(defun fikra-chat-close ()
  "Close the chat buffer view (thread + log preserved)."
  (buffer-switch "default"))

(defun fikra-quit ()
  (fikra-chat-close))

;; ── turn lifecycle ──────────────────────────────────────────────────
(defun fikra-turn-send (message)
  "Send MESSAGE as a new turn: FAEP user text + the backend's start-turn.
The adapter drives everything after this (turn-begin, stream, turn-end)."
  (if (string= (fikra/adapter/fikra-current-backend) "none")
    (progn
      (editor-set-status "Fikra: no backend — SPC a b to select")
      nil)
    (progn
      ;; The user's message is part of the transcript — tagged with the
      ;; speaker so the renderer prefixes "You: " (the old baked-in prefix
      ;; doubled up as "AI: You: …" — codex UI verification, structure 3/10).
      (fikra/event/fikra-event-emit
        (list (list "kind" "text-delta")
              (list "speaker" "user")
              (list "text" message)))
      (fikra-refresh-lighter)
      (fikra/adapter/fikra-backend-start-turn message))))

(defun fikra-turn-interrupt ()
  "Cancel the in-progress turn (backend abort; guard prevents double-end)."
  (fikra/adapter/fikra-backend-abort)
  (fikra-refresh-lighter))

(defun fikra-turn-status ()
  "Thread status (idle/running/confirming/interrupted/error)."
  (fikra/thread/fikra-thread-status))

;; ── modeline (#211 dynamic lighters) ────────────────────────────────
;; fikra:<backend><state>:<effective-mode><star> — recomputed from live
;; state; NOT the transient editor-set-status slot. The state char lives
;; in fikra/modes (#219: ONE definition, same format pre- and post-chat).
;; #219 wires the per-FAEP-event refresh hook; for now the interactive
;; entry points (open/send/interrupt) refresh.
(defun fikra-refresh-lighter ()
  "Recompute the fikra minor-mode lighter from live state: backend +
state char + effective runtime mode with the degradation star (#219).
Also re-ENABLES the minor mode — a fresh editor session (client restart)
starts with every minor mode off, so a buffer-switch back into the chat
without an SPC a a lost the lighter entirely (codex round-5/6: mode-line
context flakiness)."
  (require-module fikra/modes)
  (minor-mode-set "fikra" t)
  (minor-mode-set-lighter "fikra"
    (concat "fikra:" (fikra/adapter/fikra-current-backend)
            (fikra/modes/fikra-lighter-state-char)
            ":" (fikra/modes/fikra-effective-mode)
            (fikra/modes/fikra-mode-star)
            ;; Turn count (mockup modeline: thread context): t9-style,
            ;; omitted before the first turn.
            (fikra-lighter-turn-segment)
            ;; Tool calls in the current/last turn (mockup modeline):
            ;; x5-style, omitted at zero.
            (fikra-lighter-tools-segment)
            ;; Thread name when not the implicit main thread.
            (fikra-lighter-thread-segment)
            ;; #221: the wt:<id> segment appears only in worktree mode.
            (fikra-worktree-segment))))

(defun fikra-lighter-tools-segment ()
  (require-module fikra/event)
  (let ((n (fikra/event/fikra-event-turn-tools)))
    (if (and (numberp n) (> n 0)) (concat ":x" (number-to-string n)) "")))

(defun fikra-lighter-thread-segment ()
  (let ((id (fikra/thread/fikra-thread-current)))
    (if (and id (not (string= id "main"))) (concat " th:" id) "")))

(defun fikra-lighter-turn-segment ()
  (let ((n (fikra/thread/fikra-thread-field "turn-count")))
    (if (and (numberp n) (> n 0)) (concat ":t" (number-to-string n)) "")))

;; #221: worktree marker — requires thread lazily (chat→worktree cycle:
;; worktree requires checkpoint → thread; chat requires modes only).
(defun fikra-worktree-segment ()
  (require-module fikra/thread)
  (let ((wt (fikra/thread/fikra-thread-field "worktree")))
    (if wt (concat " wt:" (fikra/thread/fikra-thread-current)) "")))

;; ── buffer-local keymap (#206 chain) ────────────────────────────────
(defun fikra-ensure-buffer-keymap ()
  "Attach the *Fikra* buffer-local keymap (idempotent)."
  (let ((kmap (editor/keymaps/buffer-keymap (fikra/thread/fikra-thread-buffer-name))))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "fikra-chat"))
        (editor/keymaps/keymap-set-key kmap "RET" "(fikra/chat/fikra-follow-link)")
        (editor/keymaps/keymap-set-key kmap "C-g" "(fikra/chat/fikra-turn-interrupt)")
        (editor/keymaps/buffer-set-keymap (fikra/thread/fikra-thread-buffer-name) kmap))))
  t)

;; RET follows file links — paths in tool-call/file-change lines are
;; navigable (rendered by FAEP's §D2 table).
(defun fikra-follow-link ()
  "Follow the file path under cursor in *Fikra*."
  (let ((line (buffer-current-line-text)))
    (let ((path (fikra-extract-file-path line)))
      (if path
        (find-file path)
        (editor-set-status "Fikra: no file path on this line")))))

(defun fikra-file-path-in-line-p (line)
  (or (string-match-p "src/[^ \t\n]+" line)
      (string-match-p "test/[^ \t\n]+" line)))

(defun fikra-extract-file-path (line)
  ;; Absolute paths first (tool rows print repo/temp roots), then any
  ;; path-shaped relative token (codex round 9: the old matcher only knew
  ;; src|test and could not follow the paths actually shown).
  (let ((m-abs (string-match "/[A-Za-z0-9_.][^\s\t\n,;)\"]*" line)))
    (if m-abs
      m-abs
      (let ((m-rel (string-match "[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+" line)))
        (if m-rel m-rel nil)))))

(provide "fikra-chat")
)
