(defmodule editor/commands/describe
  (export describe-to-help describe-function describe-mode describe-variable describe-key describe-function-at-point describe-variable-at-point describe-key-at-point describe-binding-line apropos apropos-documentation apropos-run apropos-documentation-run cheatsheet helpgrep helpgrep-run helpgrep-jump)

;; describe.tlisp --- SPEC-083 Emacs-style self-documentation.
;;
;; Composes the factual TS primitives in src/editor/api/describe-ops.ts into
;; user-facing commands that render into a reusable *Help* buffer (NOT a
;; reserved buffer per src/editor/CLAUDE.md — it can be killed and is recreated
;; on the next describe call). The TS layer answers "what does this key run",
;; "what is this variable's value", "what does this mode bind"; this file
;; decides HOW to prompt (completing-read / next-key capture) and WHERE to show
;; the answer (the *Help* buffer).
;;
;; Every exported defun has a docstring so it is M-x-discoverable per
;; command-detail-interactive-p (execute-extended-command.tlisp:15-19): a
;; function appears in M-x completion IFF it has a docstring OR a keybinding.

(defvar help-buffer-name "*Help*"
  "Name of the reusable help buffer describe-* commands render into. Not a
reserved buffer (src/editor/CLAUDE.md reserves only *scratch*/*Messages*/*daemon*),
so it can be killed and is recreated on the next describe call.")

;; ── Shared renderer ───────────────────────────────────────────────────
(defun describe-to-help (title body)
  "Render TITLE + BODY into the reusable *Help* buffer and switch to it in
normal mode. Creates *Help* if absent (never duplicates it) and clears it on
each call so re-runs never accumulate. Returns the buffer name. Used by every
describe-* command so the surface is consistent."
  (progn
    (unless (member help-buffer-name (buffer-list))
      (buffer-create help-buffer-name))
    (buffer-switch help-buffer-name)
    ;; Clear existing content: delete from (0,0) to the end of the buffer.
    ;; Skip when there is no real content (> 1 line) — a fresh buffer-create
    ;; yields a single empty line and deleting it entirely mis-handles the
    ;; zero-width/last-line delete in the gap buffer (rejects 0-line state).
    (let ((lines (buffer-line-count)))
      (when (> lines 1)
        (let ((last-line (- lines 1)))
          ;; delete-range is bounded by line count; delete the whole span.
          (buffer-delete-range 0 0 last-line 100000))))
    (buffer-insert-at-position 0 0 (concat title "\n\n" body))
    (cursor-move 0 0)
    (editor-set-mode "normal")
    help-buffer-name))

;; ── describe-function ─────────────────────────────────────────────────
(defun describe-function (name)
  "Show the signature, docstring, and source of the named T-Lisp function in
*Help*. NAME is a function-name string (e.g. \"buffer-save\"). When the
documentation DB has a static entry for NAME it is appended as a formatted
Documentation block. Returns nil for an unknown name. M-x discoverable."
  (let ((resolved (describe-function-data name)))
    (if (nilp resolved)
      (describe-to-help
        (concat "Function: " name)
        (concat name " is not defined."))
      (describe-to-help
        (concat "Function: " (hashmap-get resolved "name"))
        (let ((sig (hashmap-get resolved "signature"))
              (doc (hashmap-get resolved "docstring"))
              (mod (hashmap-get resolved "module"))
              (full (hashmap-get resolved "documentation")))
          (concat
            sig "\n\n"
            doc
            (if (nilp mod) "" (concat "\n\nFrom module: " mod))
            (if (nilp full) "" (concat "\n\n" full))))))))

(defun describe-function-candidate (name)
  "Completion candidate wrapping a callable-command-details entry into the
shape completing-read expects (value/display/annotation/metadata)."
  (hashmap
    "value" name
    "display" name
    "annotation" ""
    "metadata" (hashmap)))

(defun describe-function-complete-p (name _input _action)
  "Always-accept predicate so describe-function completing-read admits any
function name (not just those with a docstring)."
  name)

(defun describe-function-table (input action)
  "Completion table for the describe-function minibuffer. Sources every
visible callable name from callable-command-details."
  (if (string= action "metadata")
    (hashmap "category" "command")
    (mapcar
      (lambda (details)
        (describe-function-candidate (hashmap-get details "name")))
      (callable-command-details))))

(defun describe-function-at-point ()
  "Prompt for a function name via the minibuffer and describe it in *Help*.
Bound to SPC h f. M-x discoverable via this docstring."
  (completing-read
    "Describe function: "
    "describe-function-table"
    nil
    nil
    ""
    "describe-function-history"
    "describe-function"))

;; ── describe-mode ─────────────────────────────────────────────────────
(defun describe-binding-line (binding)
  "Format one describe-mode binding entry [key command mode docstring] into a
readable line for *Help*."
  (let ((key (nth 0 binding))
        (command (nth 1 binding))
        (doc (nth 3 binding)))
    (concat
      key "  →  " command
      (if (or (nilp doc) (string= doc "No documentation available"))
        ""
        (concat "  ; " doc)))))

(defun describe-mode (&optional mode)
  "Describe the current buffer's major mode and every key bound in the editor
minor mode (default: the current editor mode). Renders the major mode, editor
mode, and each binding (key → command ; docstring) into *Help*. Bound to
SPC h m. M-x discoverable via this docstring."
  (let ((result (describe-mode-data (or mode (editor-mode)))))
    (let ((editor (hashmap-get result "editor-mode"))
          (major (hashmap-get result "major-mode"))
          (bindings (hashmap-get result "bindings")))
      (let ((desc (major-mode-description major)))
        (describe-to-help
          (concat "Mode: " editor)
          (concat
            "Major mode: " major
            (if (string= desc "") "" (concat " — " desc))
            "\n"
            "Editor mode: " editor "\n\n"
            "Key bindings:\n"
            (mapcar "describe-binding-line" bindings)))))))

;; ── describe-variable ─────────────────────────────────────────────────
(defun describe-variable (name)
  "Show the value (and documentation, when available) of the named T-Lisp
variable in *Help*. Renders `NAME is <value>` for a bound variable, or
`NAME is not defined` for an unbound one. Bound to SPC h v.
M-x discoverable via this docstring."
  (let ((result (describe-variable-data name)))
    (if (nilp (hashmap-get result "bound"))
      (describe-to-help
        (concat "Variable: " name)
        (concat name " is not defined."))
      (let ((value (hashmap-get result "value"))
            (doc (hashmap-get result "documentation")))
        (describe-to-help
          (concat "Variable: " name)
          (concat
            name " is " (format "%s" value) "\n"
            (if (nilp doc) "" (concat "\nDocumentation:\n" doc))))))))

(defun describe-variable-candidate (name)
  "Completion candidate wrapping a variable name for the describe-variable
minibuffer."
  (hashmap
    "value" name
    "display" name
    "annotation" ""
    "metadata" (hashmap)))

(defun describe-variable-table (input action)
  "Completion table for the describe-variable minibuffer, sourced from
describe-variables-list (every visible non-function global binding)."
  (if (string= action "metadata")
    (hashmap "category" "plain")
    (mapcar "describe-variable-candidate" (describe-variables-list))))

(defun describe-variable-at-point ()
  "Prompt for a variable name via the minibuffer and describe it in *Help*.
Bound to SPC h v. M-x discoverable via this docstring."
  (completing-read
    "Describe variable: "
    "describe-variable-table"
    nil
    nil
    ""
    "describe-variable-history"
    "describe-variable"))

;; ── describe-key ──────────────────────────────────────────────────────
(defun describe-key (key)
  "Show the command a key runs, plus that command's docstring, in *Help*.
KEY is a key string (e.g. \"j\"). Uses the current editor mode when none is
supplied. Bound to SPC h k. M-x discoverable via this docstring."
  (let ((result (describe-key-data key)))
    (if (nilp result)
      (describe-to-help
        (concat "Key: " key)
        (concat key " is unbound in this mode."))
      (let ((command (hashmap-get result "command"))
            (mode (hashmap-get result "mode"))
            (doc (hashmap-get result "docstring")))
        (describe-to-help
          (concat "Key: " key)
          (concat
            key " runs the command " command " (in " mode " mode).\n\n"
            doc))))))

(defun describe-key-at-point ()
  "Prompt the user to press a key, then describe that key in *Help*. Sets the
describe-key pending flag (the existing describe-key-prompt machinery) so the
next keypress is captured; the actual describe runs in the pending-key
dispatch path. Bound to SPC h k. M-x discoverable via this docstring.

Known limitation: if the SetDescribeKeyPending next-key dispatch is not yet
wired end-to-end, drive (describe-key \"j\") directly via eval — the
docstring-correctness path does not depend on the interactive capture."
  (describe-key-prompt))

;; ── Apropos (SPEC-107 / #174) ─────────────────────────────────────────
;; Search the live symbol table. `apropos` matches command/function NAMES;
;; `apropos-documentation` matches docstring BODIES (the "I think there's a
;; command for X" tool). Both render to *Help*. The TS primitives
;; (`apropos-command`, `apropos-documentation` in editor.ts) enumerate visible
;; global bindings + module exports; results are (name bindings doc) and
;; (name type doc) respectively.

(defun apropos--render-empty (title)
  "Render a no-matches *Help* page."
  (describe-to-help title "No matches."))

(defun apropos-run (pattern)
  "Run the name-search (apropos-command) for PATTERN and render to *Help*.
Accept-function for `apropos' (called by the minibuffer with the typed regex)."
  (let ((matches (apropos-command pattern)))
    (if (or (nilp matches) (= (length matches) 0))
      (apropos--render-empty (concat "Apropos: " pattern))
      (describe-to-help
        (concat "Apropos: " pattern)
        (string-join
          "\n\n"
          (mapcar
            (lambda (row)
              (let ((name (nth 0 row))
                    (bindings (nth 1 row))
                    (doc (nth 2 row)))
                (concat
                  name
                  (if (or (nilp bindings) (string= bindings "")) "" (concat "  [" bindings "]"))
                  "\n  " doc)))
            matches))))))

(defun apropos-documentation-run (pattern)
  "Run the docstring-search (apropos-documentation) for PATTERN and render to *Help*.
Accept-function for `apropos-documentation'."
  (let ((matches (apropos-documentation pattern)))
    (if (or (nilp matches) (= (length matches) 0))
      (apropos--render-empty (concat "Apropos doc: " pattern))
      (describe-to-help
        (concat "Apropos doc: " pattern)
        (string-join
          "\n\n"
          (mapcar
            (lambda (row)
              (let ((name (nth 0 row))
                    (type (nth 1 row))
                    (doc (nth 2 row)))
                (concat name "  (" type ")\n  " doc)))
            matches))))))

(defun apropos ()
  "Prompt for a regex and list matching command/function names in *Help*.
Searches NAMES. Bound to SPC h a. M-x discoverable via this docstring."
  (read-from-minibuffer "Apropos (regex): " "" "apropos-history" "apropos-run"))

(defun apropos-documentation ()
  "Prompt for a regex and list functions whose docstrings match in *Help*.
Searches docstring BODIES. M-x discoverable via this docstring."
  (read-from-minibuffer "Apropos doc (regex): " "" "apropos-doc-history" "apropos-documentation-run"))

;; ── Helpgrep: full-text search over the manual (SPEC-111, #178) ──────
(defun helpgrep-run (pattern)
  "Search the Texinfo manual corpus for PATTERN and render results in *Help*.
Accept-function for `helpgrep'."
  (let ((matches (helpgrep-search pattern)))
    (if (or (nilp matches) (= (length matches) 0))
      (describe-to-help (concat "Helpgrep: " pattern) "No matches in the doc corpus.")
      (describe-to-help
        (concat "Helpgrep: " pattern "  (" (number-to-string (length matches)) " matches)")
        (string-join
          "\n"
          (mapcar
            (lambda (m)
              (concat (nth 0 m) ":" (number-to-string (nth 1 m)) ": " (nth 2 m)))
            matches)))))
  (major-mode-set "helpgrep"))

(defun helpgrep ()
  "Prompt for a regex and full-text search the tmax + T-Lisp manuals.
Distinct from apropos (live symbol metadata) — this searches the WRITTEN prose.
M-x / :helpgrep discoverable via this docstring."
  (read-from-minibuffer "Helpgrep (regex): " "" "helpgrep-history" "helpgrep-run"))

(defun helpgrep-jump ()
  "Jump to the corpus file + line shown at cursor in *Help*.
Parses the 'file:line:text' format of helpgrep results. Bound to RET in
helpgrep results (major-mode 'helpgrep')."
  (let ((line (buffer-line (cursor-line))))
    (when (string-match "^\\([a-z]+\\.texinfo\\):\\([0-9]+\\):" line)
      (let ((file (match-string 1))
            (lineno (string-to-number (match-string 2))))
        (funcall "find-file" (concat (helpgrep-docs-dir) "/" file))
        (cursor-move (- lineno 1) 0)))))

;; Register the helpgrep results mode + RET binding.
(major-mode-register "helpgrep" '() nil)
(major-mode-doc "helpgrep" "Helpgrep results mode — RET jumps to the corpus source location")
(key-bind "RET" "(helpgrep-jump)" "normal" "helpgrep")

;; ── Cheatsheet (SPEC-109, #176) ──────────────────────────────────────
(defun cheatsheet ()
  "Open a read-only cheatsheet buffer with essential tmax keys.
Bound to SPC h c. M-x discoverable via this docstring."
  (progn
    (unless (member "*Cheatsheet*" (buffer-list))
      (buffer-create "*Cheatsheet*"))
    (buffer-switch "*Cheatsheet*")
    (let ((lines (buffer-line-count)))
      (when (> lines 1)
        (let ((last (- lines 1)))
          (buffer-delete-range 0 0 last 100000))))
    (buffer-insert-at-position 0 0
      (concat
        "tmax Cheatsheet\n\n"
        "Modes:\n"
        "  i           Insert mode\n"
        "  Escape      Normal mode\n"
        "  v / V / C-v Visual (char / line / block)\n"
        "  :           Command mode (:w :q :e FILE)\n"
        "  SPC ;       M-x (command palette)\n\n"
        "Movement:\n"
        "  h j k l     Left / down / up / right\n"
        "  w b e       Word motions\n"
        "  gg  G       Top / bottom of file\n"
        "  0  $        Line start / end\n\n"
        "Editing:\n"
        "  d y c       Delete / yank / change (operators)\n"
        "  p           Paste from kill ring\n"
        "  u  C-r      Undo / redo\n\n"
        "Files:\n"
        "  :e FILE     Open\n"
        "  :w          Save\n"
        "  :q          Quit\n"
        "  :wq         Save and quit\n\n"
        "Help:\n"
        "  SPC h f     Describe function\n"
        "  SPC h m     Describe mode\n"
        "  SPC h k     Describe key\n"
        "  SPC h v     Describe variable\n"
        "  SPC h a     Apropos (name search)\n"
        "  SPC h A     Apropos documentation (docstring search)\n"
        "  SPC h c     This cheatsheet\n"
        "  C-h f/m/v/k Same as SPC h (help prefix)\n"
        "  C-h e/s/a/t View *Messages* / *Shell* / *Async* / *Tests*\n"))
    (buffer-set-read-only t)
    (cursor-move 0 0)))

;; ── Bindings ─────────────────────────────────────────────────────────
;; SPC h prefix (primary help leader):
(key-bind "SPC h f" "(describe-function-at-point)" "normal")
(key-bind "SPC h m" "(describe-mode)" "normal")
(key-bind "SPC h v" "(describe-variable-at-point)" "normal")
(key-bind "SPC h k" "(describe-key-at-point)" "normal")
(key-bind "SPC h a" "(apropos)" "normal")
(key-bind "SPC h A" "(apropos-documentation)" "normal")
(key-bind "SPC h c" "(cheatsheet)" "normal")

;; C-h prefix (SPEC-109, #176): mirrors SPC h for Emacs muscle-memory.
;; C-h a is already view-async-output (observability.tlisp); apropos stays SPC h a.
;; C-h e/s/t are existing log viewers (messages.tlisp + observability.tlisp).
(key-bind "C-h f" "(describe-function-at-point)" "normal")
(key-bind "C-h m" "(describe-mode)" "normal")
(key-bind "C-h v" "(describe-variable-at-point)" "normal")
(key-bind "C-h k" "(describe-key-at-point)" "normal")
(key-bind "C-h A" "(apropos-documentation)" "normal")

(provide "describe")
)
