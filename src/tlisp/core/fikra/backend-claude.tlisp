(defmodule fikra/backend-claude
  (export fikra-backend-claude-available-p fikra-backend-claude-capabilities
          fikra-backend-claude-start-turn fikra-backend-claude-abort
          fikra-backend-claude-normalize fikra-backend-claude-args
          fikra-backend-claude-line-events fikra-backend-claude-filter
          fikra-backend-claude-abort-sim fikra-backend-claude-adopt-process
          fikra-backend-claude-reset-accumulator fikra-afield
          fikra-claude-approvals-probe fikra-claude-write-mcp-config
          fikra-claude-mcp-config-path fikra-claude-trust-arg
          fikra-claude-set-approvals-override)

;; #214 (RFC-027 §D3/§D4): Claude Code CLI adapter, agent edition.
;; Process-per-turn + session resume; JSONL lines normalize to FAEP events
;; through the SEPARABLE normalize pipeline below (fixture-testable without
;; spawning claude); the filter holds a partial-line accumulator (stdout
;; chunks are arbitrary); the sentinel is the AUTHORITATIVE turn end.

(require-module fikra/adapter)
(require-module fikra/event)
(require-module fikra/thread)

(defvar fikra-claude-process nil
  "Current claude subprocess pid (number) or nil.")

(defvar fikra-claude-line-buffer ""
  "Partial-line accumulator — stdout chunks are arbitrary; JSON objects
must not be parsed until a full newline-delimited line has arrived.")

(defvar fikra-claude-aborted nil
  "t when the current process was aborted LOCALLY — the abort path already
ended the turn as interrupted; the SIGTERM'd process's sentinel must not
end it AGAIN (double turn-end / error-overrides-interrupted, gate catch).")

(defun fikra-backend-claude-available-p ()
  "t when the claude CLI is on PATH."
  (let ((result (shell-command "command -v claude 2>/dev/null")))
    (not (string= (string-trim result) ""))))

;; #220: L2 is capability-GATED on --permission-prompt-tool — the hook that
;; routes claude's permission decisions through a tool. The installed
;; 2.1.195 surface does NOT have it (recorded 2026-08-22; --mcp-config and
;; --allowedTools do), so L2 degrades to L1 + turn-boundary review for
;; claude — the harness stays correct, only real-time mediation is lost.
(defvar fikra-claude-interactive-approvals-override nil
  "Test seam: \"on\"/\"off\" force the capability; nil = probe the CLI.")

(defvar fikra-claude-approvals-probe-cache nil
  "Cached probe result — the --help surface doesn't change mid-session.")

(defun fikra-claude-approvals-probe ()
  "t when the installed claude exposes --permission-prompt-tool."
  (cond
    ;; nil override must not reach string= (type error) — guard first.
    ((and fikra-claude-interactive-approvals-override
          (string= fikra-claude-interactive-approvals-override "on")) t)
    ((and fikra-claude-interactive-approvals-override
          (string= fikra-claude-interactive-approvals-override "off")) nil)
    (fikra-claude-approvals-probe-cache fikra-claude-approvals-probe-cache)
    (t
      (progn
        ;; grep -c counts matching lines; "0" = hook absent.
        (setq fikra-claude-approvals-probe-cache
              (not (string= (string-trim
                              (shell-command "claude --help 2>/dev/null | grep -c -- --permission-prompt-tool"))
                            "0")))
        fikra-claude-approvals-probe-cache))))

(defun fikra-claude-set-approvals-override (v)
  "Test seam: \"on\"/\"off\" force the interactive-approvals capability;
nil restores the real CLI probe. Keyless CI must pin BOTH the wiring and
the L1-degradation contract without the hook existing anywhere."
  (setq fikra-claude-interactive-approvals-override v)
  v)

(defun fikra-backend-claude-capabilities ()
  (list (list "session-resume" t)
        (list "interactive-approvals" (fikra-claude-approvals-probe))
        (list "sandbox-presets" nil)))

;; ── arg construction (fixture-testable) ─────────────────────────────
;; #220: trusted tool classes (#219 trust state, written by always-allow)
;; promote to --allowedTools — trusted classes stop costing round trips.
(defun fikra-claude-trust-arg ()
  "Comma-joined trust list for --allowedTools, or nil when empty."
  (require-module fikra/modes)
  (let ((trust (fikra/thread/fikra-thread-field "trust")))
    (if (null trust)
      nil
      (fikra-join-strings trust ","))))

(defun fikra-join-strings (parts sep)
  (if (null parts)
    ""
    (fikra-join-tail (cdr parts) sep (car parts))))

(defun fikra-join-tail (parts sep acc)
  (if (null parts)
    acc
    (fikra-join-tail (cdr parts) sep (concat acc sep (car parts)))))

(defun fikra-backend-claude-args (message resume-id)
  "Build the claude argv for one turn. RESUME-ID nil = first turn.
#219: --permission-mode comes from the EFFECTIVE runtime mode
(degradation-aware) — never hard-coded (codex-review catch: the mode
changed nothing about spawned turns). #220: trust promotes to
--allowedTools; when the installed CLI has the permission hook, the
adapter-written --mcp-config + --permission-prompt-tool ride along (the
config is written per turn by fikra-claude-write-mcp-config)."
  (require-module fikra/modes)
  (let* ((base (list "--print"
                     "--output-format" "stream-json"
                     "--verbose"
                     "--permission-mode"
                     (fikra/modes/fikra-claude-mode-arg
                       (fikra/modes/fikra-effective-mode))))
         (with-trust
           (let ((trust-arg (fikra-claude-trust-arg)))
             (if trust-arg
               (append base (list "--allowedTools" trust-arg))
               base)))
         (with-l2
           (if (fikra-claude-approvals-probe)
             (append with-trust
                     (list "--mcp-config"
                           (fikra-claude-mcp-config-path)
                           ;; claude's MCP tool naming: mcp__<server>__<tool>.
                           "--permission-prompt-tool"
                           "mcp__tmax-confirmation__permission"))
             with-trust)))
    (if (and resume-id (stringp resume-id) (> (length resume-id) 0))
      (append with-l2 (list "--resume" resume-id "-p" message))
      (append with-l2 (list "-p" message)))))

;; ── L2 wiring: the per-turn --mcp-config + token ────────────────────
;; The adapter mints the one-time token itself and writes the config
;; pointing claude at the bridge (source+token in argv — the token never
;; transits model-controlled space). Socket: the bridge resolves the
;; default daemon socket itself.
(defun fikra-claude-mcp-config-path ()
  (concat (fikra/thread/fikra-thread-root)
          "/.tmax/fikra/mcp/"
          (fikra/thread/fikra-thread-current) "-"
          (number-to-string (fikra/thread/fikra-thread-turn-count)) ".json"))

(defun fikra-claude-write-mcp-config ()
  "Mint the turn's approval token and write the --mcp-config JSON.
Returns the token (nil when the capability probe failed — L2 stays off)."
  (if (not (fikra-claude-approvals-probe))
    nil
    (let* ((scope (concat (fikra/thread/fikra-thread-current) "/"
                          (number-to-string (fikra/thread/fikra-thread-turn-count))))
           (token (confirmation-token-mint "fikra" scope))
           (path (fikra-claude-mcp-config-path)))
      (shell-command (concat "mkdir -p " (fikra/thread/fikra-thread-root) "/.tmax/fikra/mcp"))
      (write-file-content path
        (concat "{\"mcpServers\":{\"tmax-confirmation\":{"
                "\"command\":\"bun\","
                "\"args\":[\"bin/tmax-mcp-confirmation.ts\",\"fikra\",\""
                token "\"]}}}"))
      ;; Best-effort 0600 (gate note): the token authorizes ORIGINATING a
      ;; mediate, never resolving — but don't leave it world-readable.
      (shell-command (concat "chmod 600 " path))
      token)))

;; ── normalization: one JSONL line → FAEP events (pure, fixture-tested) ──
;; Returns a LIST of events (0, 1, or more) or nil for unparseable lines.
(defun fikra-backend-claude-normalize (line)
  "One JSONL line → a LIST of FAEP events (pure; fixture-tested). Nil for
unparseable or non-event lines. Flat dispatch — one branch per wire type."
  (condition-case nil
    (let ((obj (json-read-from-string line)))
      (if (null obj)
        nil
        (let ((type (fikra-afield obj "type")))
          (cond
            ((string= type "system")
              (fikra-norm-system obj))
            ((string= type "assistant")
              (fikra-norm-assistant obj))
            ((string= type "user")
              (fikra-norm-user obj))
            (t nil)))))
    (error nil)))

;; system/init → session event (the resume handle).
(defun fikra-norm-system (obj)
  (let ((sid (fikra-afield obj "session_id")))
    (if sid
      (list (list (list "kind" "session") (list "id" sid)))
      nil)))

;; assistant → text-delta / tool-call events from the content blocks.
(defun fikra-norm-assistant (obj)
  (let ((msg (fikra-afield obj "message")))
    (if (not (listp msg))
      nil
      (let ((content (fikra-afield msg "content")))
        (if (not (listp content))
          nil
          (fikra-norm-blocks content (list)))))))

;; Fold content blocks → events, accumulated in OUT (oldest-first).
(defun fikra-norm-blocks (blocks out)
  (if (null blocks)
    (reverse out)
    (let* ((block (car blocks))
           (btype (fikra-afield block "type"))
           (event
             (cond
               ((string= btype "text")
                 (let ((txt (fikra-afield block "text")))
                   (if (and txt (> (length txt) 0))
                     (list (list "kind" "text-delta") (list "text" txt))
                     nil)))
               ((string= btype "tool_use")
                 (fikra-tool-call-event block))
               (t nil))))
      (fikra-norm-blocks (cdr blocks)
        (if event (cons event out) out)))))

;; user → tool-result events.
(defun fikra-norm-user (obj)
  (let ((msg (fikra-afield obj "message")))
    (if (not (listp msg))
      nil
      (let ((content (fikra-afield msg "content")))
        (if (not (listp content))
          nil
          (fikra-norm-results content (list)))))))

(defun fikra-norm-results (blocks out)
  (if (null blocks)
    (reverse out)
    ;; Only tool_result blocks — a stray text block in a user message must
    ;; not produce a spurious tool-result (gate catch).
    (let* ((block (car blocks))
           (btype (fikra-afield block "type")))
      (if (not (string= btype "tool_result"))
        (fikra-norm-results (cdr blocks) out)
        (let* ((is-error (fikra-afield block "is_error"))
               (content-v (fikra-afield block "content")))
          (fikra-norm-results (cdr blocks)
            (cons (list (list "kind" "tool-result")
                        (list "ok" (if is-error nil t))
                        (list "summary" (if content-v content-v "")))
                  out)))))))

;; tool_use block → tool-call event with a per-tool summary.
(defun fikra-tool-call-event (block)
  (let* ((name (fikra-afield block "name"))
         (input (fikra-afield block "input"))
         (summary (fikra-tool-summary name input)))
    (list (list "kind" "tool-call")
          (list "tool" (if name name "?"))
          (list "summary" summary))))

(defun fikra-tool-summary (name input)
  (cond
    ((string= name "Bash")
      (let ((cmd (fikra-afield input "command")))
        (if cmd cmd "bash")))
    ((or (string= name "Edit") (string= name "Write") (string= name "Read"))
      (let ((p (fikra-afield input "file_path")))
        (if p p name)))
    (t (if name name "?"))))

;; alist field getter (json-read objects are ("k" v) alists).
(defun fikra-afield (obj key)
  (let ((found nil))
    (if (listp obj)
      (dolist (entry obj)
        (if (and (not found)
                 (listp entry)
                 (= (length entry) 2)
                 (string= (car entry) key))
          (setq found (car (cdr entry)))))
      nil)
    found))

;; ── line assembly: feed a raw chunk, get complete lines ────────────
;; Returns the list of COMPLETE lines carried by the chunk; keeps the
;; remainder in the accumulator. Fixture-testable without a process.
(defun fikra-backend-claude-line-events (chunk)
  "Feed CHUNK into the line accumulator; normalize every complete line and
return the concatenated FAEP events (a flat list)."
  (setq fikra-claude-line-buffer (concat fikra-claude-line-buffer chunk))
  ;; Loop while a newline exists — T-Lisp's `while` macro is unavailable, so
  ;; this is a recursion over the accumulator with a terminal check.
  (fikra-drain-lines))

(defun fikra-drain-lines ()
  (let ((nl (fikra-index-of-newline fikra-claude-line-buffer)))
    (if (null nl)
      nil
      (let ((line (substring fikra-claude-line-buffer 0 nl)))
        (setq fikra-claude-line-buffer
              (substring fikra-claude-line-buffer (+ nl 1) (length fikra-claude-line-buffer)))
        (let ((evs (fikra-backend-claude-normalize line)))
          (let ((rest (fikra-drain-lines)))
            (if evs
              (if rest (append evs rest) evs)
              rest)))))))

(defun fikra-index-of-newline (s)
  (fikra-find-nl s 0 (length s)))

(defun fikra-find-nl (s i len)
  (if (>= i len)
    nil
    (if (string= (substring s i (+ i 1)) "\n")
      i
      (fikra-find-nl s (+ i 1) len))))

;; ── process lifecycle ───────────────────────────────────────────────
(defun fikra-backend-claude-start-turn (message)
  "Spawn one turn: process-per-turn, resume the thread's session, stream
JSONL → FAEP. The sentinel is the authoritative turn end (#213).
#220: the approval token + --mcp-config are written AFTER turn-begin (the
scope names THIS turn) and BEFORE the spawn (args reference the path)."
  (let ((sid (fikra/thread/fikra-thread-session-id)))
    (setq fikra-claude-line-buffer "")
    (setq fikra-claude-aborted nil)
    (fikra/thread/fikra-thread-turn-begin)
    ;; L2: mint the turn's token + config (nil-op when the CLI lacks the
    ;; permission hook — args omit the flags too, same probe).
    (fikra-claude-write-mcp-config)
    (let ((args (fikra-backend-claude-args message sid)))
      (setq fikra-claude-process
        (make-process
          :command (cons "claude" args)
          :cwd (fikra/thread/fikra-thread-root)
          :filter "fikra-backend-claude-filter"
          :sentinel "fikra-backend-claude-sentinel"))
      fikra-claude-process)))

(defun fikra-backend-claude-filter (pid output)
  "Serialized per-process (#208): normalize complete lines from this chunk
and emit them as ONE FAEP batch (per-chunk coalescing). The first session
event records the resume handle."
  (let ((events (fikra-backend-claude-line-events output)))
    (if events
      (progn
        ;; Record the session id if this batch introduced one.
        (dolist (e events)
          (if (string= (fikra-afield e "kind") "session")
            (fikra/thread/fikra-thread-set-session-id (fikra-afield e "id"))))
        (fikra/event/fikra-event-emit-batch events)))))

(defun fikra-backend-claude-sentinel (pid exit-code)
  "AUTHORITATIVE turn end: process exit settles the thread state machine
(§D3 — checkpoint capture is #217's async follow-up, never blocks).
SKIPPED when the turn was already ended by a local abort (interrupted)."
  (setq fikra-claude-process nil)
  (setq fikra-claude-line-buffer "")
  (if (not fikra-claude-aborted)
    (fikra/thread/fikra-thread-turn-end
      (if (= exit-code 0) "completed" "error"))))

;; Test seam: reset the line accumulator (module vars are not settable
;; cross-module; #215's replay backend reuses this drain and resets it).
(defun fikra-backend-claude-reset-accumulator ()
  (setq fikra-claude-line-buffer "")
  t)

;; Test seam: point the module's process handle at an externally spawned
;; pid (module vars are not settable cross-module).
(defun fikra-backend-claude-adopt-process (pid)
  (setq fikra-claude-process pid)
  pid)

;; Test seam: reproduce the abort→sentinel sequence without a process
;; (mark-aborted, end interrupted, then fire the sentinel with exit 1).
(defun fikra-backend-claude-abort-sim ()
  (setq fikra-claude-aborted t)
  (fikra/thread/fikra-thread-turn-end "interrupted")
  (fikra-backend-claude-sentinel 0 1)
  "sim-done")

(defun fikra-backend-claude-abort ()
  (if fikra-claude-process
    (progn
      ;; Mark BEFORE signaling: the sentinel fires after exit and must skip.
      (setq fikra-claude-aborted t)
      (signal fikra-claude-process "SIGTERM")
      (setq fikra-claude-process nil)
      (fikra/thread/fikra-thread-turn-end "interrupted")
      t)
    nil))

;; Self-register
(fikra/adapter/fikra-register-backend "claude")

(provide "fikra-backend-claude")
)
