(defmodule fikra/thread
  (export fikra-thread-load-row fikra-thread-ensure-chat-buffer fikra-thread-buffer-name fikra-thread-buffer-name-of fikra-thread-field-root-of fikra-thread-set-session-id-for fikra-thread-session-id-for fikra-thread-working-dir fikra-thread-in-worktree-p fikra-thread-focus fikra-thread-new fikra-thread-archive fikra-thread-archived-p fikra-thread-switch fikra-thread-rows fikra-thread-ids fikra-thread-init fikra-thread-open fikra-thread-reopen
          fikra-thread-current fikra-thread-status fikra-thread-status-set
          fikra-thread-turn-begin fikra-thread-turn-end fikra-thread-turn-count
          fikra-thread-emit-file-changes fikra-thread-compute-changes
          fikra-thread-root fikra-thread-log-path fikra-thread-session-id
          fikra-thread-set-session-id fikra-thread-save fikra-thread-field
          fikra-thread-set-field
          fikra-thread-context-dir fikra-root-from-context
          fikra-thread-root-shell fikra-thread-shq)

;; #213 (RFC-027 §D3/§D7, Phase 1 — MINIMAL subset): one implicit "main"
;; thread per project. State machine + persistence + reopen-after-restart +
;; project-root detection. NO thread creation/list/worktrees (Phase 4).
;;
;; Thread state lives under <project-root>/.tmax/fikra/threads/<id>/:
;;   events.jsonl — the FAEP log (#212; fikra/event points at it)
;;   state.json   — backend, session-id, runtime-mode, trust, turn-count
;; The FAEP module is the only integration seam: log-set wires the log path.

;; Module deps: FAEP (#212) owns the event log; chat (#206) owns the
;; *Fikra* buffer-local keymap.
(require-module fikra/event)

(defvar fikra-threads (hashmap)
  "Thread-id → state hashmap (in-memory cache).")

(defvar fikra-current-thread-id nil
  "Focused thread id (the minimal subset has only \"main\").")

;; ── project root (#298: the CLIENT'S working context, not the daemon cwd) ─
(defun fikra-thread-root ()
  "LEGACY resolution (#298): git toplevel of the DAEMON cwd (fallback: the
cwd itself). Used ONLY for records persisted before the client-context
fix — a legacy thread keeps this resolution and is flagged legacy in the
thread list (no silent re-targeting of old threads)."
  (let ((out (string-trim (shell-command "git rev-parse --show-toplevel 2>/dev/null"))))
    (if (> (length out) 0) out (process-cwd))))

(defun process-cwd ()
  (string-trim (shell-command "pwd")))

;; No dirname primitive — slice to the last "/" (worktree.tlisp has the
;; same helper; requiring worktree here would cycle). A file directly
;; under "/" yields "/" (codex r1), never "".
(defun fikra-thread-dirname (path)
  (fikra-thread-dirname-scan path -1 0))

(defun fikra-thread-dirname-scan (path last i)
  (if (>= i (length path))
    (if (< last 0) "." (if (= last 0) "/" (substring path 0 last)))
    (fikra-thread-dirname-scan path
      (if (string= (substring path i (+ i 1)) "/") i last)
      (+ i 1))))

(defun fikra-thread-context-dir ()
  "The CLIENT'S working context dir (#298): the current buffer's FILE dir
when a file buffer is attached, else the connected client's launch dir,
else the daemon cwd (embedded editors — identical to legacy behavior).
Always a string; threaded into thread creation and persisted as
context-dir on the record."
  (let ((bf (buffer-filename)))
    (if (and (stringp bf) (> (length bf) 0))
      (fikra-thread-dirname bf)
      (let ((cld (client-launch-dir)))
        (if (and (stringp cld) (> (length cld) 0))
          cld
          (process-cwd))))))

(defun fikra-root-from-context (dir)
  "git toplevel of DIR, executing git with DIR as the process cwd (the
shell-command cwd argument — the make-process :cwd capability; no cwd
inheritance). Fallback: DIR itself."
  (let ((out (string-trim (shell-command "git rev-parse --show-toplevel 2>/dev/null" dir))))
    (if (> (length out) 0) out dir)))

(defun fikra-thread-root-shell (cmd)
  "Run CMD with the current thread's PERSISTED root as the process cwd
(#298: every consumer runs its git steps rooted at the record's root —
never the daemon cwd, never an independent re-resolution)."
  (shell-command cmd (fikra-thread-field "root")))

;; #298 (codex r4): THE shell-quoting helper for the fikra family —
;; single-quote with apostrophe escaping (split on ', join with the
;; close/escape/reopen sequence). The joiner is hex-built because
;; backslash string literals are reader-hostile (the round-22 trap).
;; Every module-level shq helper delegates here; never hand-wrap a path
;; in raw quotes.
(defvar fikra-thread-sq-join (concat "'" (hex-decode "5c") "''")
  "The shell apostrophe escape: close-quote, backslash-quote, reopen.")

(defun fikra-thread-shq (s)
  "Shell-quote S (spaces, metachars, and embedded apostrophes safe)."
  (fikra-thread-shq-scan (string-split s "'") "" t))

(defun fikra-thread-shq-scan (parts acc first)
  (if (null parts)
    (concat "'" acc "'")
    (fikra-thread-shq-scan (cdr parts)
      (concat acc (if first "" fikra-thread-sq-join) (car parts))
      nil)))

;; #221 (RFC-027 §D7): the thread's WORKING dir — the worktree path when
;; in worktree mode (backend cwd + checkpoint captures run there), the
;; local project root otherwise. State (.tmax) stays under the LOCAL root.
;; #222: PER-THREAD chat buffer — main keeps the historical *Fikra* name
;; (back-compat), other threads get *Fikra-<id>*. Concurrent threads
;; stream to separate buffers with no shared state.
(defun fikra-thread-buffer-name ()
  (let ((id (fikra-thread-current)))
    ;; nil-safe: events can render before any thread is focused.
    (if (or (null id) (string= id "main")) "*Fikra*"
      (concat "*Fikra-" id "*"))))

(defun fikra-thread-working-dir ()
  (let ((wt (fikra-thread-field "worktree")))
    (if wt wt (fikra-thread-field "root"))))

(defun fikra-thread-in-worktree-p ()
  (if (fikra-thread-field "worktree") t nil))

;; ── init / open / reopen ────────────────────────────────────────────
(defun fikra-thread-init ()
  "Detect the project root FROM THE CLIENT'S WORKING CONTEXT (#298) and
initialize (or load) the main thread. Creates .tmax/fikra/threads/main/
and points the FAEP log at it. Returns the thread id. Idempotent."
  (let* ((ctxdir (fikra-thread-context-dir))
         (root (fikra-root-from-context ctxdir)))
    (let ((state (fikra-thread-load root "main" ctxdir)))
      ;; The RECORD's root wins (a legacy record keeps its daemon-cwd root;
      ;; a post-fix record re-resolves from its persisted context) — mkdir
      ;; and the FAEP log follow the SAME source.
      (let ((dir (concat (hashmap-get state "root") "/.tmax/fikra/threads/main")))
        (file-mkdir dir)
        (editor/keymaps/keymap-mutable-set! fikra-threads "main" state)
        (setq fikra-current-thread-id "main")
        ;; Wire FAEP at the thread's log; loading resets in-memory events, so
        ;; re-point even when the thread already existed.
        (fikra/event/fikra-event-log-set (concat dir "/events.jsonl"))
        "main"))))

(defun fikra-thread-open ()
  "Open the main thread: init-or-load, create *Fikra* when absent, replay
history into it (daemon-restart reopen path), focus it."
  (fikra-thread-init)
  (fikra-thread-ensure-chat-buffer)
  ;; The buffer-local keymap is attached by fikra/chat (chat-open, after
  ;; this returns) — requiring chat here would cycle.
  (buffer-switch (fikra-thread-buffer-name))
  ;; Reopen: replay the full log into the buffer (empty log → empty buffer).
  (fikra/event/fikra-event-rebuild-fikra-buffer)
  (fikra-thread-buffer-name))

(defun fikra-thread-reopen ()
  "Alias of fikra-thread-open (the daemon-restart entry point)."
  (fikra-thread-open))

;; Load state.json for ID under ROOT; absent file → fresh state. CTXDIR is
;; the client-context dir (#298) seeded onto a FRESH record; a disk record
;; carries its own: WITH context-dir the root re-resolves from it (the
;; single source); WITHOUT (a pre-#298 record) the root keeps the LEGACY
;; daemon-cwd resolution and the record is flagged legacy — old threads are
;; never silently re-targeted.
(defun fikra-thread-load (root id ctxdir)
  (let* ((dir (concat root "/.tmax/fikra/threads/" id))
         (path (concat dir "/state.json"))
         (fresh (hashmap "id" id
                         "root" root
                         "context-dir" ctxdir
                         "legacy" nil
                         ;; nil, not "none": a fresh thread NEVER CHOSE —
                         ;; the ambient/parent selection may adopt it
                         ;; (the seeded "none" read as an explicit choice
                         ;; and the isolation reset killed fresh threads'
                         ;; backends — the workflow suites regression).
                         "backend" nil
                         "session-id" nil
                         ;; runtime-mode stays nil until set — #219's
                         ;; fikra/modes owns the default (defvar + setter
                         ;; escape hatch); seeding here would freeze it.
                         "runtime-mode" nil
                         "worktree" nil
                         "worktree-base" nil
                         "archived" nil
                         "trust" (list)
                         "status" "idle"
                         "turn-count" 0)))
    (if (file-exists-p path)
      (let* ((raw (read-file-content path))
             (parsed (if raw (json-read-from-string raw) nil)))
        (if (null parsed)
          fresh
          (let ((state fresh))
            ;; Overlay persisted fields onto fresh defaults (forward-
            ;; compatible: unknown persisted fields ignored, missing fields
            ;; keep defaults).
            (dolist (key (list "backend" "session-id" "runtime-mode" "trust" "worktree" "worktree-base" "archived" "interaction" "workflow" "turn-count" "context-dir" "approval-allow-list" "last-at" "status"))
              (let ((v (fikra-alist-get key parsed)))
                (if (not (null v))
                  (editor/keymaps/keymap-mutable-set! state key v))))
            ;; A persisted "running" is a CRASH artifact — the process died
            ;; with the daemon (#213: status is runtime-only on load).
            (if (string= (if (hashmap-get state "status") (hashmap-get state "status") "") "running")
              (editor/keymaps/keymap-mutable-set! state "status" "idle"))
            ;; #298 root resolution FROM THE RECORD. The persisted alist is
            ;; the authority (an overlaid nil would be indistinguishable
            ;; from absent): context-dir present → re-resolve; absent →
            ;; legacy daemon-cwd root, flagged. A legacy record ALSO has
            ;; its seeded context-dir CLEARED — saves then persist null,
            ;; so the first save of an old thread can never stamp today's
            ;; client context onto it and silently re-target the project
            ;; on the next load (verify-gate catch).
            (let ((persisted-ctx (fikra-alist-get "context-dir" parsed)))
              (if (and (stringp persisted-ctx) (> (length persisted-ctx) 0))
                (editor/keymaps/keymap-mutable-set! state "root"
                  (fikra-root-from-context persisted-ctx))
                (progn
                  (editor/keymaps/keymap-mutable-set! state "root" (fikra-thread-root))
                  (editor/keymaps/keymap-mutable-set! state "legacy" t)
                  (editor/keymaps/keymap-mutable-set! state "context-dir" nil))))
            state)))
      fresh)))

;; alist getter (json-read produces ("k" v) 2-list alists).
(defun fikra-alist-get (key alist)
  (let ((found nil))
    (dolist (entry alist)
      (if (and (not found)
               (listp entry)
               (= (length entry) 2)
               (string= (car entry) key))
        (setq found (car (cdr entry)))))
    found))

(defun fikra-thread-save ()
  "Persist the current thread's state.json."
  (let* ((state (fikra-thread-state)))
    (write-file-content
      (concat (fikra-thread-field "root") "/.tmax/fikra/threads/"
              (fikra-thread-field "id") "/state.json")
      (json-encode (list
                     (list "id" (fikra-thread-field "id"))
                     (list "context-dir" (fikra-thread-field "context-dir"))
                     (list "approval-allow-list" (fikra-thread-field "approval-allow-list"))
                     (list "backend" (fikra-thread-field "backend"))
                     (list "session-id" (fikra-thread-field "session-id"))
                     (list "runtime-mode" (fikra-thread-field "runtime-mode"))
                     (list "trust" (fikra-thread-field "trust"))
                     (list "worktree" (fikra-thread-field "worktree"))
                     (list "worktree-base" (fikra-thread-field "worktree-base"))
                     (list "archived" (fikra-thread-field "archived"))
                     (list "interaction" (fikra-thread-field "interaction"))
                     (list "workflow" (fikra-thread-field "workflow"))
                     (list "turn-count" (fikra-thread-field "turn-count"))
                     (list "last-at" (fikra-thread-field "last-at"))
                     (list "status" (fikra-thread-field "status")))))))

(defun fikra-thread-current ()
  "Current thread id (nil before init)."
  fikra-current-thread-id)

;; #221: focus another thread id (lazy state init happens on first
;; access — fikra-thread-state). Module defvars are not setq-able from
;; outside, hence the setter. Full thread switching machinery is #222.
;; id-scoped readers for background-thread operations (#222 gate catch):
;; read another thread's root/buffer WITHOUT changing focus.
(defun fikra-thread-field-root-of (id)
  "id's project root WITHOUT changing focus. Gate round-2: nil for an
UNKNOWN id — never substitute the focused root (a misrouted event must
not land under the wrong project)."
  (let ((state (hashmap-get fikra-threads id)))
    (if state (hashmap-get state "root") nil)))

;; #222 gate round-2: record a session id on ANOTHER thread (a background
;; turn's resume handle) without stealing focus.
(defun fikra-thread-session-id-for (id)
  "The recorded backend session id for thread ID (nil when none)."
  (let ((state (hashmap-get fikra-threads id)))
    (if state (hashmap-get state "session-id") nil)))

(defun fikra-thread-set-session-id-for (id sid)
  (let ((state (hashmap-get fikra-threads id)))
    (if state
      (progn
        (editor/keymaps/keymap-mutable-set! state "session-id" sid)
        (write-file-content
          (concat (hashmap-get state "root") "/.tmax/fikra/threads/" id "/state.json")
          (json-encode (list
                         (list "id" id)
                         (list "context-dir" (hashmap-get state "context-dir"))
                         (list "approval-allow-list" (hashmap-get state "approval-allow-list"))
                         (list "backend" (hashmap-get state "backend"))
                         (list "session-id" sid)
                         (list "runtime-mode" (hashmap-get state "runtime-mode"))
                         (list "trust" (hashmap-get state "trust"))
                         (list "worktree" (hashmap-get state "worktree"))
                         (list "worktree-base" (hashmap-get state "worktree-base"))
                         (list "archived" (hashmap-get state "archived"))
                         (list "interaction" (hashmap-get state "interaction"))
                         (list "workflow" (hashmap-get state "workflow"))
                         (list "turn-count" (hashmap-get state "turn-count"))
                         (list "last-at" (hashmap-get state "last-at"))
                         (list "status" (hashmap-get state "status")))))
        sid)
      nil)))

(defun fikra-thread-buffer-name-of (id)
  (if (or (null id) (string= id "main")) "*Fikra*"
    (concat "*Fikra-" id "*")))

(defun fikra-thread-focus (id)
  "Focus thread ID (creating its state lazily). Re-points the FAEP log —
  EVERY focus change re-wires the log pointer (gate catch: archive used to
  leave the log aimed at the archived thread). Returns the id."
  (setq fikra-current-thread-id id)
  (let ((state (fikra-thread-state)))
    (fikra/event/fikra-event-log-set
      (concat (hashmap-get state "root") "/.tmax/fikra/threads/" id "/events.jsonl"))
    ;; 8.5 (codex r45): a thread's SAVED backend follows focus — dispatch
    ;; reads the adapter's global; without this, one thread's choice bled
    ;; into every other.
    (fikra-thread-restore-backend)
    id))

;; Isolation cuts BOTH ways: a saved backend is restored; NO saved (or an
;; UNAVAILABLE) backend RESETS the adapter (r46: the previous thread's
;; choice must not bleed — and new/switch route here too, not just focus).
(defun fikra-thread-restore-backend ()
  (condition-case nil
    (progn
      (require-module fikra/adapter)
      (let ((saved (hashmap-get (fikra-thread-state) "backend")))
        (cond
          ;; An explicit SAVED choice: restore it (isolation).
          ((and saved
                (not (string= saved "none"))
                (not (string= saved ""))
                (fikra/adapter/fikra-backend-available-p saved))
            (fikra/adapter/fikra-set-backend-forced saved))
          ;; EXPLICIT none: reset the active selection (the saved field
          ;; survives — r47's active-only reset).
          ((and saved (string= saved "none"))
            (fikra/adapter/fikra-reset-backend-active))
          ;; NO field at all: the thread never chose — the AMBIENT active
          ;; selection stands (a fresh thread inherits the session's
          ;; choice; the r46 reset here is what killed the workflow
          ;; suites' replay turns).
          (t nil))))
    (error () nil)))

;; ── #222: creation / switching / archive / listing ─────────────────
(defun fikra-thread-ensure-chat-buffer ()
  "Create the current thread's chat buffer (read-only) when absent."
  (let ((name (fikra-thread-buffer-name)))
    (if (not (member name (buffer-list)))
      (progn (buffer-create name) (buffer-set-read-only t)))))

(defun fikra-thread-ids ()
  "All thread ids known for the current project root (disk listing —
a restarted editor sees old threads; the current session's threads are
on disk from their init)."
  (if (not fikra-current-thread-id) (fikra-thread-init))
  (fikra-thread-ids-scan (fikra-thread-field "root") (list)))

(defun fikra-thread-ids-scan (root acc)
  ;; ls the threads dir; registry ids not on disk (created this session,
  ;; dir exists anyway after init) are covered by the dir listing.
  (let ((out (string-trim (shell-command
            (concat "ls -1 " (fikra-shq2 (concat root "/.tmax/fikra/threads/"))
                    " 2>/dev/null || true")))))
    (if (string= out "")
      acc
      (fikra-thread-ids-collect (string-split out "\n") acc))))

(defun fikra-thread-ids-collect (lines acc)
  (if (null lines)
    acc
    (fikra-thread-ids-collect (cdr lines)
      (if (> (length (car lines)) 0) (cons (car lines) acc) acc))))

(defun fikra-thread-new ()
  "Create a NEW thread with a generated short id (fix-<n> style — the
first free number), inheriting the current thread's runtime mode. Focuses
it and opens its chat buffer. Returns the id."
  (interactive)
  ;; let*: the id binding READS root — parallel let would see an unbound
  ;; symbol (probe catch).
  ;; The AMBIENT active selection is the other inheritance source: a
  ;; seam can set the ADAPTER without any thread existing (no field to
  ;; inherit) — the child still deserves the session's choice.
  (let* ((ambient-backend (condition-case nil
                              (progn (require-module fikra/adapter)
                                     (let ((a (fikra/adapter/fikra-current-backend)))
                                       (if (or (string= a "none") (string= a "")) nil a)))
                              (error () nil)))
         (parent-backend (if fikra-current-thread-id (fikra-thread-field "backend") ambient-backend))
         (parent-mode (if fikra-current-thread-id (fikra-thread-field "runtime-mode") nil))
         (parent-ctx (if fikra-current-thread-id (fikra-thread-field "context-dir") nil))
         (parent-legacy (if fikra-current-thread-id (fikra-thread-field "legacy") nil))
         (root (progn (if (not fikra-current-thread-id) (fikra-thread-init))
                      (fikra-thread-field "root")))
         (id (fikra-thread-free-id root 1)))
    (setq fikra-current-thread-id id)
    ;; #298 (codex r1): construct the child's state DIRECTLY from the
    ;; parent record — a lazy (fikra-thread-state) here would resolve the
    ;; CURRENT context, mkdir under it, and (for a legacy parent) birth a
    ;; re-targeted child. The child inherits the parent's project.
    (let ((state (fikra-thread-load root id parent-ctx)))
      (editor/keymaps/keymap-mutable-set! fikra-threads id state)
      (editor/keymaps/keymap-mutable-set! state "id" id)
      (editor/keymaps/keymap-mutable-set! state "root" root)
      ;; A LEGACY parent (no context) births a LEGACY child on the same
      ;; root — never a re-targeted one via today's context.
      (if (and (null parent-ctx) parent-legacy)
        (progn
          (editor/keymaps/keymap-mutable-set! state "context-dir" nil)
          (editor/keymaps/keymap-mutable-set! state "legacy" t)))
      ;; Child threads inherit the parent's runtime mode (#219) AND its
      ;; backend (the r46 isolation reset otherwise blanks a fresh
      ;; thread's adapter — the workflow suites' replay turns died with
      ;; no backend the moment the labeled thread opened).
      (if parent-mode
        (editor/keymaps/keymap-mutable-set! state "runtime-mode" parent-mode))
      (if (and parent-backend
               (not (string= parent-backend "none"))
               (not (string= parent-backend "")))
        (editor/keymaps/keymap-mutable-set! state "backend" parent-backend)))
    ;; mkdir + FAEP wiring under the PARENT root (the state's own source).
    (let ((dir (concat root "/.tmax/fikra/threads/" id)))
      (file-mkdir dir)
      (fikra/event/fikra-event-log-set (concat dir "/events.jsonl")))
    (fikra-thread-ensure-chat-buffer)
    (buffer-switch (fikra-thread-buffer-name))
    (fikra-thread-save)
    ;; r46: a NEW thread starts with a clean adapter (no inheritance of
    ;; the parent's live choice — its own field decides).
    (fikra-thread-restore-backend)
    id))

(defun fikra-thread-free-id (root n)
  (let ((candidate (concat "fix-" (number-to-string n))))
    (if (or (file-exists-p (concat root "/.tmax/fikra/threads/" candidate "/state.json"))
            (file-exists-p (concat root "/.tmax/fikra/threads/" candidate "/events.jsonl")))
      (fikra-thread-free-id root (+ n 1))
      candidate)))

(defun fikra-thread-switch (id)
  "Switch focus to thread ID: state, FAEP log pointer, chat buffer, and
modeline all follow; concurrent threads keep independent state."
  (setq fikra-current-thread-id id)
  (let* ((state (fikra-thread-state))
         (dir (concat (fikra-thread-field "root") "/.tmax/fikra/threads/" id)))
    (fikra/event/fikra-event-log-set (concat dir "/events.jsonl"))
    ;; r46: switch routes through the same backend isolation as focus.
    (fikra-thread-restore-backend)
    (fikra-thread-ensure-chat-buffer)
    (buffer-switch (fikra-thread-buffer-name))
    (fikra/event/fikra-event-rebuild-fikra-buffer)
    ;; Gate catch: attach the chat + approvals buffer-local keymaps — only
    ;; chat-open used to, so a list-RET switch landed keyless. Lazy requires
    ;; (both modules require thread; cycles forbid top-level).
    (condition-case nil
      (progn
        (require-module fikra/chat)
        (fikra/chat/fikra-ensure-buffer-keymap))
      (error () nil))
    (condition-case nil
      (progn
        (require-module fikra/approvals)
        (fikra/approvals/fikra-approvals-ensure-bindings))
      (error () nil))
    (fikra-refresh-switch-lighter)
    id))

(defun fikra-refresh-switch-lighter ()
  (condition-case nil
    (funcall "fikra/chat/fikra-refresh-lighter")
    (error () nil)))

(defun fikra-thread-archive ()
  "Soft-delete the current thread: hidden from lists, logs + refs
preserved (the retention policy owns real deletion). Cannot archive main."
  (let ((id (fikra-thread-current)))
    (if (string= id "main")
      (progn (editor-set-status "Fikra: main thread cannot be archived") nil)
      (progn
        (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "archived" t)
        ;; #225 gate catch: clear the WORKFLOW label too — an archived
        ;; workflow thread must never route again.
        (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "workflow" nil)
        (fikra-thread-save)
        (editor-set-status (concat "Fikra: thread " id " archived"))
        t))))

(defun fikra-thread-archived-p (id)
  ;; Read from disk when the thread is not loaded (a restarted editor).
  (if (and (string= id (fikra-thread-current))
           (hashmap-get (fikra-thread-state) "archived"))
    t
    (string= (string-trim (shell-command
      (concat "test -f " (fikra-shq2 (fikra-thread-archived-path id))
              " && jq -r '.archived // empty' "
              (fikra-shq2 (fikra-thread-archived-path id)) " 2>/dev/null || echo no")))
      "true")))

(defun fikra-thread-archived-path (id)
  (concat (if fikra-current-thread-id (fikra-thread-field "root") (process-cwd))
          "/.tmax/fikra/threads/" id "/state.json"))

(defun fikra-thread-rows ()
  "List rows (hashmap: id/backend/mode/location/status/turns) for the
current project's NON-archived threads."
  (fikra-thread-rows-collect (fikra-thread-ids) (list)))

(defun fikra-thread-rows-collect (ids acc)
  (if (null ids)
    (reverse acc)
    (fikra-thread-rows-collect (cdr ids)
      (if (fikra-thread-archived-p (car ids))
        acc
        (cons (fikra-thread-row-for (car ids)) acc)))))

;; #298: normalize a DISK row's json alist into the hashmap shape row-for
;; reads (hashmap-get throws on alists; the current thread's registry state
;; is already a hashmap).
(defun fikra-thread-row-normalize (alist)
  (let ((row (hashmap)))
    (dolist (key (list "backend" "runtime-mode" "worktree" "status"
                       "turn-count" "context-dir" "approval-allow-list" "last-at" "status"))
      (let ((v (fikra-alist-get key alist)))
        (if (not (null v))
          (editor/keymaps/keymap-mutable-set! row key v))))
    row))

(defun fikra-thread-row-for (id)
  ;; Load that thread's state from disk (or registry when current). #298:
  ;; LEGACY rows (pre-client-context records) are flagged — the current
  ;; thread's state carries the computed flag; a disk row is legacy exactly
  ;; when its record has no context-dir.
  (let* ((current (string= id (fikra-thread-current)))
         (live (hashmap-get fikra-threads id))
         (disk (if current nil (fikra-thread-load-row id)))
         ;; LOADED threads use their LIVE registry state (a background
         ;; turn-in-progress is genuinely running); only UNLOADED rows
         ;; read disk — where "running" is a crash artifact (r46).
         (state (if current (fikra-thread-state)
                  (if live live
                    (if disk (fikra-thread-row-normalize disk) nil))))
         (get (lambda (k) (if state (hashmap-get state k) nil)))
         (legacy (if current (funcall get "legacy")
                   (if disk (null (fikra-alist-get "context-dir" disk)) nil))))
    (hashmap
      "id" id
      "backend" (funcall get "backend")
      "mode" (funcall get "runtime-mode")
      "location" (if legacy "legacy"
                   (if (funcall get "worktree") "worktree" "local"))
      "legacy" (if legacy t nil)
      ;; A non-loaded thread cannot be mid-turn: a disk row's "running"
      ;; is a crash artifact (the load path normalizes the same way).
      "status" (if (and (not current) (not live)
                        (string= (if (funcall get "status") (funcall get "status") "") "running"))
                 "idle"
                 (funcall get "status"))
      "turns" (funcall get "turn-count")
      "last-at" (funcall get "last-at"))))

(defun fikra-thread-load-row (id)
  ;; Parse another thread's state.json (registry holds only loaded threads).
  ;; Returns the RAW json alist (workflow.tlisp iterates it with dolist —
  ;; do not normalize the return type here).
  (let ((path (fikra-thread-archived-path id)))
    (if (file-exists-p path)
      (json-read-from-string (read-file-content path))
      nil)))

(defun fikra-shq2 (s)
  ;; #298 (codex r4): delegates to the family-safe quoting helper.
  (fikra-thread-shq s))

(defun fikra-thread-state ()
  "The focused thread's state; LAZY-INITIALIZES the main thread when absent
  (backends may fire turn lifecycle before an explicit init — mutating nil
  would crash; #216 hardening). #298: implicit threads resolve their root
  from the CLIENT'S working context exactly like init."
  (let ((id (if fikra-current-thread-id fikra-current-thread-id "main")))
    (let ((state (hashmap-get fikra-threads id)))
      (if state
        state
        (progn
          (setq fikra-current-thread-id id)
          (let* ((ctxdir (fikra-thread-context-dir))
                 (root (fikra-root-from-context ctxdir)))
            (let ((fresh (fikra-thread-load root id ctxdir)))
              ;; An implicit thread is a REAL thread — init's contract:
              ;; mkdir + load + FAEP log wiring, so saves and emits work.
              ;; The RECORD's root is the single source (legacy records
              ;; keep theirs).
              (let ((dir (concat (hashmap-get fresh "root") "/.tmax/fikra/threads/" id)))
                (file-mkdir dir)
                (fikra/event/fikra-event-log-set (concat dir "/events.jsonl"))
                (editor/keymaps/keymap-mutable-set! fikra-threads id fresh)
                fresh))))))))

(defun fikra-thread-field (key)
  (let ((state (fikra-thread-state)))
    (if state (hashmap-get state key) nil)))

(defun fikra-thread-set-field (key value)
  "Mutate a thread-state field (runtime mode, trust, ...). Callers save."
  (editor/keymaps/keymap-mutable-set! (fikra-thread-state) key value)
  value)

(defun fikra-thread-status ()
  "Current status; an un-initialized thread reads as idle (nil never leaks
into string= transitions — #216 gate-hardening)."
  (let ((s (fikra-thread-field "status")))
    (if s s "idle")))

(defun fikra-thread-turn-count ()
  (fikra-thread-field "turn-count"))

(defun fikra-thread-root-id ()
  (fikra-thread-field "root"))

(defun fikra-thread-log-path ()
  (concat (fikra-thread-field "root") "/.tmax/fikra/threads/"
          (fikra-thread-field "id") "/events.jsonl"))

(defun fikra-thread-session-id ()
  (fikra-thread-field "session-id"))

(defun fikra-thread-set-session-id (sid)
  "Record the backend session id (#214's adapter calls this on the first
turn's init event); persisted on save."
  (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "session-id" sid)
  (fikra-thread-save)
  sid)

;; ── state machine ───────────────────────────────────────────────────
;; idle → running → {idle | error | interrupted}
;; running → confirming → running (approval round-trip; #220 wires it)
;; Validity is CHECKED: illegal transitions error (a crashed adapter must
;; not silently corrupt thread state).
(defun fikra-thread-status-set (new-status)
  (let ((from (fikra-thread-status)))
    (if (not (fikra-transition-valid-p from new-status))
      (error (concat "fikra: illegal thread transition " from " → " new-status))
      (progn
        (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "status" new-status)
        (fikra-thread-save)
        new-status))))

(defun fikra-transition-valid-p (from to)
  (or
    ;; Any state can be reset by open (init path).
    (string= to "idle")
    (and (string= from "idle") (string= to "running"))
    (and (string= from "running")
         (or (string= to "error")
             (string= to "interrupted")
             (string= to "confirming")))
    (and (string= from "confirming")
         (or (string= to "running") (string= to "interrupted")))
    ;; Recovery: error/interrupted resume to running on the next turn.
    (and (or (string= from "error") (string= from "interrupted"))
         (string= to "running"))))

;; ── turn lifecycle (#214's adapter drives these) ───────────────────
;; fikra-thread-turn-begin: bump turn-count, set running, emit turn-start.
;; fikra-thread-turn-end: the AUTHORITATIVE end (process exit per §D3 —
;; checkpoint capture is async follow-up in #217 and never blocks the next
;; turn): emit turn-end, settle the state machine.
(defun fikra-turn-backend-name ()
  "The adapter's current backend name ('none' fallback; lazy require —
thread→adapter has no cycle but keep the lazy convention)."
  (condition-case nil
    (progn (require-module fikra/adapter) (fikra/adapter/fikra-current-backend))
    (error () (fikra-thread-field "backend"))))

(defun fikra-thread-turn-begin ()
  ;; Validate the transition FIRST — an illegal begin must not bump the
  ;; persisted turn count (checked-state hygiene, gate catch).
  (fikra-thread-status-set "running")
  (let* ((state (fikra-thread-state))
         (n (+ 1 (hashmap-get state "turn-count"))))
    (editor/keymaps/keymap-mutable-set! state "turn-count" n)
    ;; Turn-scoped diff baseline (round 4): snapshot BEFORE the turn runs so
    ;; turn-end attributes only THIS turn's changes. Nil on non-git dirs.
    ;; Two parts: the content-exact BASELINE TREE (tracked changes) and the
    ;; untracked-signature map (round 7: changes WITHIN files, not just
    ;; file filtering).
    (condition-case nil
      (let ((bdir (fikra-thread-working-dir)))
        (if (stringp bdir)
          (editor/keymaps/keymap-mutable-set! state "change-baseline-tree"
            (fikra-thread-capture-baseline-tree bdir))))
      (error () nil))
    (condition-case nil
      (editor/keymaps/keymap-mutable-set! state "change-baseline"
        (fikra-thread-snapshot-changes))
      (error () nil))
    ;; #225: the turn-start records the backend ACTUALLY driving the turn
    ;; (the adapter's current selection — a mid-thread switch changes it;
    ;; the thread field alone stays stale).
    (fikra/event/fikra-event-emit
      (list (list "kind" "turn-start")
            (list "turn" (if (numberp n) n (string-to-number (if (stringp n) n "0"))))
            (list "backend" (fikra-turn-backend-name))
            ;; Context header: the thread's runtime mode rides the turn
            ;; header (codex UI verification — "no runtime mode shown").
            (list "mode" (if (hashmap-get state "runtime-mode")
                           (hashmap-get state "runtime-mode")
                           ""))))
    ;; #217: the turn's BASELINE REF — AFTER the turn-start (r64: the
    ;; baseline checkpoint-ready used to precede it, so the replay's
    ;; bounded association saw the PREVIOUS turn's Edit first and could
    ;; attach the new baseline to it, clobbering its completion marker).
    (condition-case nil
      (progn (require-module fikra/checkpoint)
             (fikra/checkpoint/fikra-checkpoint-capture "baseline"))
      (error () nil))
    ;; Persist the bumped count (a crash before turn-end must still show
    ;; the turn happened).
    (fikra-thread-save)
    n))

;; ── turn-scoped diff surfacing (codex UI round 4: false attribution) ─
;; A BASELINE snapshot (path → "adds:dels") is captured at turn-begin onto
;; the thread record (hashmap — mutation-shared, so the sentinel's evalTlisp
;; context reads it); turn-end emits ONLY paths that are new or whose counts
;; moved since the baseline. The whole working tree is never attributed to a
;; turn again. No baseline (daemon restart mid-turn) → emit nothing.
;; Content signature for an untracked file (md5, first 10 chars) — an
;; untracked file EDITED within a turn changes its hash, so the turn-scoped
;; diff detects content changes, not just existence (codex round-5 catch).
(defun fikra-file-signature (dir path)
  (condition-case nil
    (substring (string-trim (shell-command (concat "md5 -q " (fikra-thread-shq (concat dir "/" path))))) 0 10)
    (error () "?")))

(defun fikra-thread-snapshot-changes ()
  "Untracked-file snapshot: hashmap path → md5 signature (tracked changes
  are handled by the BASELINE TREE, which is content-exact)."
  (let ((dir (fikra-thread-working-dir)))
    (if (not (stringp dir))
      nil
      (let ((snap (hashmap)))
        (dolist (line (string-split (shell-command (concat "git -C " (fikra-thread-shq dir) " ls-files --others --exclude-standard 2>/dev/null")) "\n"))
          (if (and (> (length line) 6) (not (string= (substring line 0 6) ".tmax/")))
            (editor/keymaps/keymap-mutable-set! snap line (fikra-file-signature dir line))))
        snap))))

;; Content-exact baseline for TRACKED changes (codex round 7: file filtering
;; must isolate the changes WITHIN files). `git stash create` snapshots the
;; dirty tree as a commit object WITHOUT touching the worktree; diffing
;; against it later yields exactly the turn's edits even in files that were
;; already dirty. Clean tree → empty output → baseline is HEAD.
(defun fikra-thread-capture-baseline-tree (dir)
  (let ((sha (string-trim (shell-command (concat "git -C " (fikra-thread-shq dir) " stash create 2>/dev/null")))))
    (if (> (length sha) 0) sha "HEAD")))

(defun fikra-file-change-event (path adds dels)
  (list (list "kind" "file-change")
        (list "path" path)
        (list "adds" adds)
        (list "dels" dels)))

;; DRY change computation (no emission): ((path adds dels) ...) changed
;; since the stored turn-begin baseline; nil when no baseline exists.
;; Shared by the turn-end ± rows and the SPC a d turn-scoped diff viewer.
(defun fikra-thread-compute-changes ()
  (let* ((state (fikra-thread-state))
         (baseline (hashmap-get state "change-baseline"))
         (dir (fikra-thread-working-dir)))
    (if (or (null baseline) (not (stringp dir)))
      nil
      (let* ((btree (hashmap-get state "change-baseline-tree"))
             (tree (if (and (stringp btree) (> (length btree) 0)) btree "HEAD"))
             (rows (list)))
        (dolist (line (string-split (shell-command (concat "git -C " (fikra-thread-shq dir) " diff " tree " --numstat 2>/dev/null")) "\n"))
          (let ((parts (string-split line "\t")))
            (if (= (length parts) 3)
              (let ((path (car (cdr (cdr parts)))))
                (if (not (string= (substring path 0 6) ".tmax/"))
                  (setq rows
                    (cons (list path (car parts) (car (cdr parts))) rows)))))))
        (dolist (line (string-split (shell-command (concat "git -C " (fikra-thread-shq dir) " ls-files --others --exclude-standard 2>/dev/null")) "\n"))
          (if (and (> (length line) 6)
                   (not (string= (substring line 0 6) ".tmax/"))
                   ;; nil-safe: a file ABSENT from the baseline is new —
                   ;; string= against nil errors in strict T-Lisp (round-11
                   ;; fixture catch; new untracked files never emitted ±).
                   (not (string= (or (hashmap-get baseline line) "")
                                 (fikra-file-signature dir line))))
            ;; New untracked file: adds = its line count (codex rounds 8-9:
            ;; "untracked-file counts remain unknown"), dels 0.
            (setq rows (cons (list line
                                   (string-trim (shell-command (concat "wc -l < " (fikra-thread-shq (concat dir "/" line)))))
                                   "0")
                             rows))))
        (reverse rows)))))

(defun fikra-thread-emit-file-changes ()
  "Emit file-change rows for changes SINCE the turn-begin baseline only."
  (let ((rows (condition-case nil (fikra-thread-compute-changes) (error () nil))))
    (if rows
      (fikra/event/fikra-event-emit-batch-for (fikra-thread-current)
        (mapcar (lambda (r) (fikra-file-change-event (car r) (car (cdr r)) (car (cdr (cdr r)))))
          rows))
      nil)))

(defun fikra-thread-turn-end (status)
  "STATUS: completed | error | interrupted (the turn-end event's status)."
  ;; Changed files render inside the completing turn (before the marker).
  (condition-case nil (fikra-thread-emit-file-changes) (error () nil))
  ;; Emitted via the EXPLICIT-PATH batch emitter: turn-end runs from the
  ;; process SENTINEL's evalTlisp context, where module variables setq'd in
  ;; the main session (fikra-event-log!) read as their INITIAL nil — the
  ;; pointer-based emit silently dropped every live turn-end (no
  ;; ── completed ── markers, threads stuck "running"). The -for emitter
  ;; derives the log path from the thread record (mutation-shared state),
  ;; exactly like the stream filter's events.
  (fikra/event/fikra-event-emit-batch-for (fikra-thread-current)
    (list (list (list "kind" "turn-end")
                (list "turn" (fikra-thread-field "turn-count"))
                (list "status" status))))
  ;; #223 (gate catch: the offer had NO production call site): a COMPLETED
  ;; turn in plan interaction offers the y/e/n approval. Lazy require
  ;; (plan requires thread; the cycle forbids top-level).
  (if (string= status "completed")
    (progn
      ;; #217: the COMPLETION ref (refs/fikra/<id>/<n>). Async — the
      ;; process exit is the authoritative turn end; the capture follows.
      (condition-case nil
        (progn
          (require-module fikra/checkpoint)
          (fikra/checkpoint/fikra-checkpoint-capture-async "completion"))
        (error () nil))
      (condition-case nil
        (progn
          (require-module fikra/plan)
          (fikra/plan/fikra-plan-offer-approval))
        (error () nil)))
    nil)
  ;; 8.5: the thread list's "last: Xm ago" — the activity stamp rides the
  ;; persisted state (absent on legacy records: renders as "-").
  (condition-case nil
    (editor/keymaps/keymap-mutable-set! (fikra-thread-state) "last-at" (current-time))
    (error () nil))
  ;; Map the event status onto the thread state machine.
  (fikra-thread-status-set
    (cond
      ((string= status "completed") "idle")
      ((string= status "interrupted") "interrupted")
      (t "error"))))

(provide "fikra-thread")
)
