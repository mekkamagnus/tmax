(defmodule editor/commands/buffers
  (export buffer-detail-more-recent-p buffer-detail-candidate buffer-completion-table switch-buffer-accept switch-buffer buffer-name current-buffer-name switch-to-buffer open-file revert-buffer)

;; buffers.tlisp --- Interactive buffer completion

(defun buffer-detail-more-recent-p (left right)
  (> (hashmap-get left "recency") (hashmap-get right "recency")))

(defun buffer-detail-candidate (details)
  (hashmap
    "value" (hashmap-get details "name")
    "display" (hashmap-get details "name")
    "annotation" ""
    "metadata" details))

(defun buffer-completion-table (input action)
  "Completion table for live editor buffers."
  (if (string= action "metadata")
    (hashmap "category" "buffer")
    (mapcar "buffer-detail-candidate"
      (stable-sort "buffer-detail-more-recent-p" (buffer-list-details)))))

(defun switch-buffer-accept (name)
  "Switch to existing buffer NAME or create it."
  (if (member name (buffer-list))
    (buffer-switch name)
    (progn
      (buffer-create name)
      (buffer-switch name))))

(defun switch-buffer ()
  "Switch buffers through the generic completion minibuffer."
  (completing-read
    "Switch to buffer: "
    "buffer-completion-table"
    nil
    nil
    ""
    "buffer-history"
    "switch-buffer-accept"))

;; Emacs-conventional aliases (#51 / BUG-45).
(defun buffer-name ()
  "Return the name of the current buffer (alias of buffer-current)."
  (buffer-current))

(defun current-buffer-name ()
  "Return the name of the current buffer (alias of buffer-current)."
  (buffer-current))

(defun switch-to-buffer (name)
  "Switch to the buffer named NAME (alias of buffer-switch)."
  (buffer-switch name))

(defun open-file (filename)
  "Open FILENAME (alias of find-file-open)."
  (find-file-open filename))

(defun revert-buffer ()
  "Reload the current buffer's file from disk (alias of find-file-open on buffer-filename)."
  (let ((fn (buffer-filename)))
    (if fn
      (find-file-open fn)
      (message "Buffer has no associated file"))))
)
