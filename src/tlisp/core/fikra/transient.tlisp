(defmodule fikra/transient
  (export fikra-transient-start fikra-transient-stop
          fikra-transient-running-p fikra-transient-tick
          fikra-transient-revision fikra-transient-segment
          fikra-transient-active-p fikra-transient-count
          fikra-transient-note-running fikra-transient-note-terminal
          fikra-any-thread-running-p fikra-thread-is-running-p
          fikra-transient-viewed-segment fikra-transient-viewed-segment-for
          fikra-transient-spinner-glyph)

;; #318 — the DISPLAY-LAYER REPAINT CADENCE. Fikra is event-driven
;; end-to-end; the animation layer is DAEMON-SIDE TRANSIENT STATE, kept
;; OUTSIDE the buffer/event log (a display-layer hashmap — #306's
;; mutation-shared carrier). A tick bumps a revision + spinner frame; it
;; NEVER mutates a buffer or the event log (asserted by byte-compare).
;;
;; Lifecycle: the interval runs ONLY while >= 1 thread is running
;; (started on the first running transition; stopped on the terminal
;; transition of the LAST running thread). Client connect/disconnect
;; never starts/stops it — thread state owns it.
;;
;; The tick source is a TS interval (this module's T-Lisp side owns the
;; STATE + lifecycle rules; the interval shell lives in the editor API
;; — a raw timing primitive, not editor logic).

;; thread.tlisp requires THIS module only lazily (at status-set time),
;; so this eager require is acyclic: the registry queries + the
;; buffer→thread inverse lookup resolve reliably in the daemon runtime.
(require-module fikra/thread)

(defvar fikra-transient-rev 0
  "The transient revision — rides the poll response beside bufferRevision.")
(defvar fikra-transient-ticks 0
  "Total ticks since the daemon started (test surface).")
(defvar fikra-transient-active nil
  "t while the interval is running (the lifecycle flag).")

(defun fikra-transient-count () fikra-transient-ticks)

(defun fikra-transient-active-p ()
  (if fikra-transient-active t nil))

(defun fikra-transient-running-p ()
  "t when the transient layer should render (>= 1 thread running AND the
interval live)."
  (if (and fikra-transient-active (fikra-any-thread-running-p)) t nil))

(defun fikra-transient-revision ()
  "The current transient revision (the client's second comparison)."
  fikra-transient-rev)

(defun fikra-transient-start ()
  "Start the interval (idempotent). Thread-state transitions call this on
every ->running edge; the guard makes repeats no-ops."
  (if fikra-transient-active
    nil
    (progn
      (setq fikra-transient-active t)
      (editor-transient-timer-start)
      t)))

(defun fikra-transient-stop ()
  "Stop the interval. The TS shell stop is UNCONDITIONAL (idempotent
shell-side) — a module reload resets the active defvar to nil, and the
old guarded stop leaked the live interval forever (gate r2)."
  (setq fikra-transient-active nil)
  (editor-transient-timer-stop)
  t)

;; The tick body — the interval shell calls this every 200ms. Bump the
;; revision + tick count ONLY (no buffer/event mutations).
(defun fikra-transient-tick ()
  (if (not fikra-transient-active)
    ;; An inactive tick means the interval outlived its state (module
    ;; reload) — KILL the leaked shell, not just no-op (gate r2).
    (progn (editor-transient-timer-stop) nil)
    (progn
      (setq fikra-transient-ticks (+ 1 fikra-transient-ticks))
      (setq fikra-transient-rev (+ 1 fikra-transient-rev))
      ;; Auto-stop: the terminal transition of the last running thread
      ;; may have been missed — ask the AUTHORITATIVE thread registry
      ;; (thread.tlisp owns it; this module's own bookkeeping is not a
      ;; witness — codex r1 catch 3).
      (if (not (fikra-any-thread-running-p))
        (fikra-transient-stop)
        t))))

;; The transient SEGMENT for the frame: the spinner (a rotating glyph on
;; the tick) — the daemon's frame builder includes it when the VIEWED
;; thread is running (the focused-thread rule lives in the caller: this
;; answers for ONE thread id).
(defun fikra-transient-segment (thread-id)
  "The spinner row for THREAD-ID's frame when it is running; nil for an
idle/viewed-other thread (the focused-thread rule)."
  (if (and fikra-transient-active (fikra-thread-is-running-p thread-id))
    (concat (fikra-transient-spinner-glyph)
            " working… "
            (number-to-string fikra-transient-rev))
    nil))

(defun fikra-transient-spinner-glyph ()
  ;; 4-frame rotation on the tick count.
  (let ((m (mod fikra-transient-ticks 4)))
    (cond
      ((= m 0) "|")
      ((= m 1) "/")
      ((= m 2) "—")
      (t "\\"))))

;; ── thread-state predicates — AUTHORITATIVE: thread.tlisp's registry
;; answers (status-of / any-running-p). The transition hooks below still
;; drive the START/STOP edges eagerly, but no shadow bookkeeping exists
;; to go stale (codex r1 catch 3: a missed notification must be caught
;; by the tick's registry ask, not by this module's own list).
(defun fikra-any-thread-running-p ()
  (fikra/thread/fikra-thread-any-running-p))

(defun fikra-thread-is-running-p (id)
  (string= (fikra/thread/fikra-thread-status-of id) "running"))

;; The transition hooks (thread.tlisp's status-set calls these on the
;; display-relevant edges; id is the transitioning thread).
(defun fikra-transient-note-running (id)
  (fikra-transient-start))

(defun fikra-transient-note-terminal (id)
  (if (not (fikra-any-thread-running-p))
    (fikra-transient-stop)
    nil))

;; The VIEWED thread's segment (the daemon frame builder's display row):
;; the thread whose *Fikra* buffer the CLIENT is viewing (gate r2 /
;; codex r1 catch 2: interpreter-global current is the wrong witness
;; once frames view different threads' buffers).
(defun fikra-transient-viewed-segment-for (buffer-name)
  (let ((id (fikra/thread/fikra-thread-id-of-buffer buffer-name)))
    (if id (fikra-transient-segment id) nil)))

(defun fikra-transient-viewed-segment ()
  (fikra-transient-segment (fikra/thread/fikra-thread-current)))

(provide "fikra-transient"))
