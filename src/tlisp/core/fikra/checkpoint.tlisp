(defmodule fikra/checkpoint
  (export fikra-checkpoint-capture fikra-checkpoint-capture-async
          fikra-checkpoint-ref fikra-checkpoint-disable-p
          fikra-git-fikra-p fikra-git-unborn-p
          fikra-checkpoint-command fikra-checkpoint-tail
          fikra-checkpoint-filter fikra-checkpoint-sentinel
          fikra-checkpoint-capture-with-path fikra-checkpoint-set-emit-owner
          fikra-checkpoint-set-emit-act fikra-checkpoint-emit-act-get
          fikra-checkpoint-set-emit-stage
          fikra-checkpoint-last-ref-name-get fikra-checkpoint-pair-trees)

;; #217 (RFC-027 §D6, Phase 2): non-invasive git checkpoints. Every turn
;; gets two refs (baseline/completion) built on a TEMPORARY index — the
;; user's index, HEAD, and working tree are NEVER touched.
;;
;; Capture command contract (exact, from the RFC — argv arrays via
;; make-process, no shell):
;;   GIT_INDEX_FILE=<tmp> git add -A -- .     ; fresh index = disk state
;;   git write-tree                          → tree (deletions by absence)
;;   git commit-tree <tree> [-p HEAD] -m ... → commit
;;   git update-ref refs/fikra/<t>/<n> <c>   ; the atomic commit point
;; Failure rules: pre-update-ref failure → checkpoint-error event, no ref,
;; turn state untouched. Unborn HEAD / non-git → checkpointing disabled.
;;
;; Process-based reactor: the turn sentinel (or tests) spawn capture via
;; make-process; per-thread capture chain ordering is the CALLER's choice
;; of when to spawn (#214's sentinel ends the turn, then spawns this).

(require-module fikra/event)
(require-module fikra/thread)

(defvar fikra-checkpoint-disabled nil
  "t when checkpointing is disabled for the CURRENT thread root (non-git
or unborn). The cache is keyed by root — a different root re-probes, so
one non-git thread can never poison a later git-rooted one (gate catch:
the old sticky-flag design did exactly that).")

(defvar fikra-checkpoint-disabled-root nil
  "The thread root the disable verdict was computed for.")

(defvar fikra-checkpoint-last-ref nil
  "The last successfully-captured ref (test/inspection surface).")

(defvar fikra-checkpoint-last-output nil
  "The async filter's captured output (sentinel consumes it).")

;; pid -> "<thread-id>/<turn>" stamped at SPAWN (the async identity fix).
(defvar fikra-checkpoint-emit-act nil
  "r157: the ACTION IDENTITY of the capture in flight, stamped into
checkpoint-ready events. The tool row that minted it carries the same
id, and the transcript associates marker to row by IDENTITY — not by
proximity (the 8.1 re-grade's P1: two edits in one turn mislabeled their
refs). Set by the caller around a capture, like
fikra-checkpoint-emit-owner; nil leaves the event as before.")

(defvar fikra-checkpoint-async-ids (hashmap))
(defvar fikra-checkpoint-async-suffixes (hashmap)
  "r134: pid → the spawn-stamped ref SUFFIX (an action's -aN is
allocated at spawn — concurrent captures never collide).")
(defvar fikra-checkpoint-async-kinds (hashmap)
  "PID → kind of in-flight async captures (the sentinel emits the ref for
ITS capture's kind — a single global would race between concurrent
captures; gate final-round catch).")

(defun fikra-checkpoint-disable-p ()
  "t when the current thread root cannot checkpoint (non-git or unborn).
Cached PER ROOT: a root change re-probes."
  (let ((root (fikra/thread/fikra-thread-field "root")))
    (if (and fikra-checkpoint-disabled
             (string= (if fikra-checkpoint-disabled-root fikra-checkpoint-disabled-root "") (if root root "")))
      fikra-checkpoint-disabled
      (progn
        (setq fikra-checkpoint-disabled-root root)
        (setq fikra-checkpoint-disabled
          (or (not (fikra-git-fikra-p))
              (fikra-git-unborn-p)))))))

(defun fikra-git-fikra-p ()
  "t when the thread root is inside a git work tree. #298: probed AT the
thread's persisted root (root-shell cwd), never the daemon cwd."
  (> (length (string-trim (fikra/thread/fikra-thread-root-shell
             "git rev-parse --is-inside-work-tree 2>/dev/null"))) 0))

(defun fikra-git-unborn-p ()
  "t when HEAD is unborn (no commits yet — checkpointing waits for the first).
#298: verified at the thread's persisted root."
  (string= (string-trim (fikra/thread/fikra-thread-root-shell
           "git rev-parse --verify -q HEAD >/dev/null 2>&1 && echo ok || echo unborn")) "unborn"))

;; The exact capture command sequence as ONE shell line (shell-command is
;; sync; the RFC's per-step argv contract is preserved inside it). The
;; final echo delimits the ref for parsing.
;; #298 (codex r3): every interpolated PATH is shell-quoted — project and
;; worktree roots containing spaces/metachars must not split the command.
;; Shell single-quoting with apostrophe escaping: split on ', join with
;; the close/escape/reopen sequence. The joiner is built via hex-decode —
;; backslash string literals are reader-hostile (the round-22 class).
(defun fikra-checkpoint-shq (s)
  ;; #298 (codex r4): delegates to the family-safe quoting helper.
  (fikra/thread/fikra-thread-shq s))

(defun fikra-checkpoint-command (tmp-index kind)
  "Build the capture command for KIND ('baseline'|'completion')."
  (fikra-checkpoint-command-for tmp-index (fikra-checkpoint-ref kind) kind))

;; r134: the REF is computed by the CALLER (the async path allocates the
;; action seq ONCE — deriving it again here double-allocated and the
;; event's ref named a ref that never existed).
(defun fikra-checkpoint-command-for (tmp-index ref kind)
  (concat
    ;; #221: capture runs INSIDE the thread's working dir (worktree-aware —
    ;; fikra-thread-working-dir); the tmp index stays in the LOCAL root.
    "cd " (fikra-checkpoint-shq (fikra/thread/fikra-thread-working-dir)) " && "
    "export GIT_INDEX_FILE=" (fikra-checkpoint-shq tmp-index) " ; "
    "rm -f " (fikra-checkpoint-shq tmp-index) " ; "
    "git add -A -- . >/dev/null 2>&1 && "
    "tree=$(git write-tree) && "
    "commit=$(git commit-tree $tree -p HEAD -m \"fikra checkpoint " kind "\") && "
    "git update-ref " ref " $commit && "
    "rm -f " (fikra-checkpoint-shq tmp-index) " && "
    "echo REF:$commit || echo CAPTURE-FAILED"))

;; r157: the exported setter — a cross-module defvar setq silently
;; fails (the module lesson, r134): every caller goes through this.
(defun fikra-checkpoint-set-emit-act (act)
  (setq fikra-checkpoint-emit-act act))
(defun fikra-checkpoint-emit-act-get ()
  "r158: the action identity currently stamped onto emissions — the
coverage report reads the carrier instead of threading a parameter
(the zero-arity action-checkpoint is called directly by the tests)."
  fikra-checkpoint-emit-act)

(defvar fikra-checkpoint-emit-stage nil
  "r161: the STAGE of the action being captured (\"pre\" or \"post\"),
set by the caller around the capture. A replay attaches a row's
POST-stage ref and never its pre: the pre is the revert target, and a
post that failed used to leave the pre standing in on the row.")
(defun fikra-checkpoint-set-emit-stage (stage)
  (setq fikra-checkpoint-emit-stage stage))

;; r161: the identity fields a capture event carries when the caller set
;; them — the action's act id and the capture's stage.
(defun fikra-checkpoint-stamp-fields ()
  (append
    (if fikra-checkpoint-emit-act (list (list "act" fikra-checkpoint-emit-act)) (list))
    (if fikra-checkpoint-emit-stage (list (list "stage" fikra-checkpoint-emit-stage)) (list))))

(defun fikra-checkpoint-set-emit-owner (owner)
  "r134e: callback contexts (the mediated bash's sync capture runs in
the bash sentinel) route the sync capture's event through the
explicit-path owner emitter — the pointer reads nil there."
  (setq fikra-checkpoint-emit-owner owner))

(defvar fikra-checkpoint-last-ref-name nil
  "r142: the last SUCCESSFUL sync capture's ref name (nil on failure) —
pre/post pairing callers read it right after each capture.")
(defvar fikra-checkpoint-emit-owner nil
  "r134e: set by CALLBACK contexts around a sync capture — the event
emits through the explicit-path owner emitter instead of the pointer
(the turn-end lesson).")
(defvar fikra-checkpoint-invocation-n 0
  "r134e (codex r134-final P2): a monotonic per-invocation counter —
every tmp index name is unique per CAPTURE (same-identity overlaps —
a re-park's second baseline, an async straggler — can never share a
file).")

(defun fikra-checkpoint-invocation ()
  (setq fikra-checkpoint-invocation-n (+ fikra-checkpoint-invocation-n 1))
  (number-to-string fikra-checkpoint-invocation-n))

(defvar fikra-checkpoint-action-seqs (hashmap)
  "r134 (codex r130 P1#4): per-action sequence counters, keyed
thread/turn — each mutating ACTION in a turn gets its OWN ref
(<turn>-a1, -a2, ...) instead of all overwriting the turn's bare
completion ref.")

(defun fikra-checkpoint-action-seq ()
  "The next action number for THIS thread/turn (increments)."
  (let* ((key (concat (fikra/thread/fikra-thread-field "id") "/"
                      (number-to-string (fikra/thread/fikra-thread-turn-count))))
         (n (+ 1 (or (hashmap-get fikra-checkpoint-action-seqs key) 0))))
    (keymap-mutable-set! fikra-checkpoint-action-seqs key n)
    n))

(defun fikra-checkpoint-ref (kind)
  "The refs/fikra/<thread>/<turn><suffix> ref name for this capture.
Completion refs stay bare (turn N's ground truth); baseline and REVIEW
snapshots get distinct suffixes — a review capture must never overwrite
a turn's completion checkpoint (codex r33). r134: an ACTION capture
gets <turn>-aN — two edits in one turn no longer overwrite each
other's ref."
  (concat "refs/fikra/" (fikra/thread/fikra-thread-field "id") "/"
          (fikra/thread/fikra-thread-turn-count)
          (cond
            ((string= kind "baseline") "-baseline")
            ((string= kind "review") "-review")
            ((string= kind "action") (concat "-a" (number-to-string (fikra-checkpoint-action-seq))))
            (t ""))))

(defun fikra-checkpoint-tail (output)
  "Extract the REF:<sha> marker from capture output, or nil.
string-match returns the match START INDEX — slice a fixed 40-hex window
after it (+4 skips the marker)."
  (if (not (stringp output))
    nil
    (let ((i (string-match "REF:[0-9a-f]+" output)))
      (if (or (null i) (not (numberp i)))
        nil
        (substring (match-string 0) 4 (length (match-string 0)))))))

;; ── synchronous capture (tests + explicit callers) ─────────────────
(defun fikra-checkpoint-capture (kind)
  "Capture a checkpoint of KIND for the current turn. Returns the ref's
commit sha on success; emits checkpoint-ready/checkpoint-error FAEP
events; nil when disabled or failed. Never touches turn state."
  (if (fikra-checkpoint-disable-p)
    (progn
      ;; r146 (codex): a disabled/failed capture CLEARS the name — a
      ;; stale last-ref-name paired into a revert target that never
      ;; existed.
      (setq fikra-checkpoint-last-ref-name nil)
      nil)
    ;; r134b: the ref derives ONCE (the old shape called
    ;; fikra-checkpoint-ref in BOTH the command and the event — each
    ;; allocating a fresh action seq; the event named a ref that never
    ;; existed).
    (let* ((suffix (fikra-checkpoint-suffix kind))
           (ref (concat "refs/fikra/" (fikra/thread/fikra-thread-field "id") "/"
                       (number-to-string (fikra/thread/fikra-thread-turn-count)) suffix))
           ;; r134d (codex r134c catch): the tmp index carries the FULL
           ;; identity — two threads' captures in one root (or any other
           ;; overlap) can never share an index file.
           (tmp (concat (fikra/thread/fikra-thread-field "root")
                        "/.tmax/fikra/tmp-index-" kind "-"
                        (fikra/thread/fikra-thread-field "id") "-"
                        (number-to-string (fikra/thread/fikra-thread-turn-count))
                        suffix "-" (fikra-checkpoint-invocation)))
           (out (shell-command (fikra-checkpoint-command-for tmp ref kind))))
      (let ((sha (fikra-checkpoint-tail out)))
        (setq fikra-checkpoint-last-ref sha)
        ;; r142+r146: the ref NAME for pre/post pairing callers — nil
        ;; on failure (a stale name paired a nonexistent revert target).
        (setq fikra-checkpoint-last-ref-name (if sha ref nil))

        ;; r134e (codex P2): the emit is CONTEXT-aware — the pointer
        ;; emit in normal evals (it renders); the EXPLICIT-PATH owner
        ;; emit when a CALLBACK context set fikra-checkpoint-emit-owner
        ;; (the mediated bash's sync capture runs inside the bash
        ;; sentinel, where the pointer reads nil and the event drops).
        ;; r161: ONE event, built once — the ready and the error both
        ;; carry the action's identity and the capture's stage. The
        ;; error used to be anonymous: nothing tied it to the row it
        ;; belonged to, so an action whose first capture failed still
        ;; showed an unqualified ✓.
        (let ((ev
                (if sha
                  (append (list (list "kind" "checkpoint-ready")
                                (list "ref" ref)
                                (list "sha" sha))
                          (fikra-checkpoint-stamp-fields))
                  (append (list (list "kind" "checkpoint-error")
                                (list "reason" (string-trim (substring out 0 (min 200 (length out))))))
                          (fikra-checkpoint-stamp-fields)))))
          (if fikra-checkpoint-emit-owner
            (fikra/event/fikra-event-emit-batch-for fikra-checkpoint-emit-owner (list ev))
            (fikra/event/fikra-event-emit ev)))
        sha))))

;; r155: an EXISTING tree object as a checkpoint ref (commit-tree +
;; update-ref — the same atomic commit point as a capture). The ordinary
;; bash path writes its before/after trees in the child; this only seals
;; them. TREE is validated before it can reach a shell command. Returns
;; the commit sha, or nil when checkpointing is disabled or git fails.
(defun fikra-checkpoint-ref-tree (tree ref kind)
  (if (or (fikra-checkpoint-disable-p)
          (not (stringp tree))
          (not (= (length tree) 40))
          (not (fikra-checkpoint-hex40-scan tree 0)))
    nil
    (let ((out (shell-command
                 (concat "cd " (fikra-checkpoint-shq (fikra/thread/fikra-thread-working-dir)) " && "
                         "commit=$(git commit-tree " tree " -p HEAD -m \"fikra checkpoint " kind "\") && "
                         "git update-ref " ref " $commit && echo REF:$commit || echo CAPTURE-FAILED"))))
      (fikra-checkpoint-tail out))))

(defun fikra-checkpoint-hex40-scan (s i)
  (if (>= i (length s))
    t
    (and (string-match "^[0-9a-f]$" (substring s i (+ i 1)))
         (fikra-checkpoint-hex40-scan s (+ i 1)))))

;; r155 (the codex gate's named 9-bar): an action's checkpoint PAIR from
;; two tree objects — the PRE ref (<turn>-a<k>) and the POST ref
;; (<turn>-a<k+1>), exactly the shape two captures produce, so the action
;; pair recorder and SPC a C-r treat it like any mediated action. Emits
;; the post ref's checkpoint-ready (context-aware, like a capture) and
;; names it for the pair recorder. Returns (pre-name post-name), or nil
;; — a post ref that fails to seal leaves its pre ref UNPAIRED, which is
;; never on the revert stack.
(defun fikra-checkpoint-pair-trees (pre-tree post-tree)
  (let ((pre-name (fikra-checkpoint-ref "action")))
    (let ((pre-sha (fikra-checkpoint-ref-tree pre-tree pre-name "action pre")))
      (if (not pre-sha)
        nil
        (let ((post-name (fikra-checkpoint-ref "action")))
          (let ((post-sha (fikra-checkpoint-ref-tree post-tree post-name "action post")))
            (if (not post-sha)
              nil
              (progn
                (setq fikra-checkpoint-last-ref post-sha)
                (setq fikra-checkpoint-last-ref-name post-name)
                (if fikra-checkpoint-emit-owner
                  (fikra/event/fikra-event-emit-batch-for fikra-checkpoint-emit-owner
                    (list (append (list (list "kind" "checkpoint-ready")
                                        (list "ref" post-name)
                                        (list "sha" post-sha))
                                  (if fikra-checkpoint-emit-act
                                    (list (list "act" fikra-checkpoint-emit-act))
                                    (list)))))
                  (fikra/event/fikra-event-emit
                    (append (list (list "kind" "checkpoint-ready")
                                  (list "ref" post-name)
                                  (list "sha" post-sha))
                            (if fikra-checkpoint-emit-act
                              (list (list "act" fikra-checkpoint-emit-act))
                              (list)))))
                (list pre-name post-name)))))))))

;; Test seam: capture with a PATH prepend — forces REAL git failures
;; (e.g. a write-tree stub) to verify the checkpoint-error contract.
(defun fikra-checkpoint-capture-with-path (binpath kind)
  (if (fikra-checkpoint-disable-p)
    nil
    (let* ((tmp (concat (fikra/thread/fikra-thread-field "root")
                        "/.tmax/fikra/tmp-index-" kind))
           (out (shell-command (concat "PATH=" binpath ":$PATH ; "
                                       (fikra-checkpoint-command tmp kind)))))
      (let ((sha (fikra-checkpoint-tail out)))
        (setq fikra-checkpoint-last-ref sha)
        (fikra/event/fikra-event-emit
          (if sha
            (list (list "kind" "checkpoint-ready")
                  (list "ref" (fikra-checkpoint-ref kind))
                  (list "sha" sha))
            (list (list "kind" "checkpoint-error")
                  (list "reason" (string-trim (substring out 0 (min 200 (length out))))))))
        sha))))

;; ── process-based capture (the RFC's async reactor) ────────────────
;; Spawned via make-process; the sentinel parses the tail and emits the
;; FAEP event. Used by #214's turn sentinel for completion captures.
;; r134b: the suffix for a KIND (allocating the action seq when
;; applicable) — ONE place, so a capture can never derive two refs.
(defun fikra-checkpoint-suffix (kind)
  (cond
    ((string= kind "baseline") "-baseline")
    ((string= kind "review") "-review")
    ((string= kind "action") (concat "-a" (number-to-string (fikra-checkpoint-action-seq))))
    (t "")))

(defun fikra-checkpoint-capture-async (kind)
  "Spawn the capture as its own process (async follow-up — never blocks
the next turn). Returns the pid or nil when disabled. The pid→kind map
keys the sentinel's ref name (concurrent captures cannot race)."
  (if (fikra-checkpoint-disable-p)
    nil
    ;; r65: STAMP the ref identity AT SPAWN TIME — a delayed finish must
    ;; never carry a LATER turn's identity (the sentinel used to derive
    ;; the ref from the CURRENT thread/turn when it ran; a finish after
    ;; the next turn-start emitted the wrong turn's ref and replay then
    ;; associated by proximity to the wrong edit).
    (let* ((thread-id (fikra/thread/fikra-thread-current))
           (turn-n (fikra/thread/fikra-thread-turn-count))
           ;; r134: the suffix (and the REF) is derived ONCE — the
           ;; action seq allocated here is what BOTH the git command and
           ;; the stamped event carry (a second derivation inside the
           ;; command builder double-allocated and the event named a
           ;; ref that never existed).
           (suffix (fikra-checkpoint-suffix kind))
           (ref (concat "refs/fikra/" thread-id "/" (number-to-string turn-n) suffix))
           ;; r134b (codex r134 P1): the tmp index is PER-CAPTURE — a
           ;; shared name let one capture rm -f the index another was
           ;; reading.
           (tmp (concat (fikra/thread/fikra-thread-field "root")
                        "/.tmax/fikra/tmp-index-" kind "-"
                        thread-id "-" (number-to-string turn-n) suffix "-"
                        (fikra-checkpoint-invocation)))
           (pid (make-process
                  :command (list "sh" "-c" (fikra-checkpoint-command-for tmp ref kind))
                  :cwd (fikra/thread/fikra-thread-field "root")
                  :filter "fikra/checkpoint/fikra-checkpoint-filter"
                  :sentinel "fikra/checkpoint/fikra-checkpoint-sentinel")))
      (editor/keymaps/keymap-mutable-set! fikra-checkpoint-async-kinds
        (number-to-string pid) kind)
      (editor/keymaps/keymap-mutable-set! fikra-checkpoint-async-ids
        (number-to-string pid)
        (concat thread-id "/" (number-to-string turn-n)))
      (editor/keymaps/keymap-mutable-set! fikra-checkpoint-async-suffixes
        (number-to-string pid) suffix)
      pid)))

(defvar fikra-checkpoint-outputs (hashmap)
  "r134b (codex r134 P2): pid → the capture's accumulated stdout —
PER-PID (the old single global interleaved concurrent captures and a
sentinel could adopt another process's REF sha).")

(defun fikra-checkpoint-filter (pid output)
  ;; APPEND chunks — stdout may split mid-REF: marker (gate catch: the
  ;; last-chunk-only store misreported split captures as failures).
  (let ((key (number-to-string pid)))
    (keymap-mutable-set! fikra-checkpoint-outputs key
      (concat (or (hashmap-get fikra-checkpoint-outputs key) "") output))))

(defun fikra-checkpoint-sentinel (pid exit-code)
  ;; exit-code is NOT consulted: the capture chain ends
  ;; `|| echo CAPTURE-FAILED`, so failure also exits 0 — correctness
  ;; rests on the REF: tail parse (gate final-round note).
  (let* ((key (number-to-string pid))
         (out (or (hashmap-get fikra-checkpoint-outputs key) ""))
         (kind (let ((k (hashmap-get fikra-checkpoint-async-kinds key)))
                 (if k k "completion")))
         ;; r65: the SPAWN-STAMPED identity — never the sentinel-time
         ;; current thread/turn (a delayed finish would carry a later
         ;; turn's ref; replay then misattributes by proximity).
         (stamped (hashmap-get fikra-checkpoint-async-ids key))
         ;; r134: the SPAWN-STAMPED suffix (an action's -aN was
         ;; allocated at spawn; deriving it here would collide).
         (suffix (let ((s (hashmap-get fikra-checkpoint-async-suffixes key)))
                   (if s s "")))
         ;; r134c (codex r134b catch): the OWNER thread of this capture
         ;; (the spawn stamp's id part) — the events emit through the
         ;; EXPLICIT-PATH emitter so a focus change cannot route the
         ;; checkpoint event into another thread's log (the turn-end
         ;; lesson applied here).
         (owner (let ((slash (string-match "/" (if stamped stamped "/"))))
                  (if (and slash (numberp slash) (> slash 0))
                    (substring stamped 0 slash)
                    (fikra/thread/fikra-thread-current)))))
    (let ((sha (fikra-checkpoint-tail out)))
      (setq fikra-checkpoint-last-ref sha)
      (keymap-mutable-set! fikra-checkpoint-outputs key nil)
      (editor/keymaps/keymap-mutable-set! fikra-checkpoint-async-kinds key nil)
      (editor/keymaps/keymap-mutable-set! fikra-checkpoint-async-ids key nil)
      (editor/keymaps/keymap-mutable-set! fikra-checkpoint-async-suffixes key nil)
      (fikra/event/fikra-event-emit-batch-for owner
        (list (if sha
                (list (list "kind" "checkpoint-ready")
                      (list "ref" (if stamped
                                    (concat "refs/fikra/" stamped suffix)
                                    (fikra-checkpoint-ref kind)))
                      (list "sha" sha))
                (list (list "kind" "checkpoint-error")
                      (list "reason" (string-trim (substring out 0 (min 200 (length out))))))))))))

;; r142: the last sync capture's ref name (test/pairing accessor).
(defun fikra-checkpoint-last-ref-name-get ()
  (if fikra-checkpoint-last-ref-name fikra-checkpoint-last-ref-name nil))

(provide "fikra-checkpoint")
)
