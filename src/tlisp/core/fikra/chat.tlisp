(defmodule fikra/chat
  (export fikra-chat-open fikra-chat-close fikra-turn-send
          fikra-turn-interrupt fikra-turn-status fikra-quit
          fikra-ensure-buffer-keymap fikra-refresh-lighter
          fikra-follow-link)

;; #216 (RFC-027 §UI): the chat UI as a THIN layer over the Phase-1 stack —
;; threads own state (#213), FAEP owns rendering (#212), adapters own turns
;; (#214). The old globals (fikra-message-history, fikra-turn-status-val)
;; are GONE; the modeline rides dynamic minor-mode lighters (#211).

(require-module fikra/event)
(require-module fikra/thread)
(require-module fikra/adapter)

(defvar fikra-chat-buffer-name "*Fikra*"
  "Name of the Fikra chat buffer.")

;; ── open / close ────────────────────────────────────────────────────
(defun fikra-chat-open ()
  "Open the project chat: thread init-or-load + history replay into *Fikra*
+ buffer-local keymap + lighter. The SPC a a entry point."
  ;; Mode activation is the caller's job (SPC a a starts it) — requiring
  ;; fikra/mode here would create a mode↔chat cycle.
  (fikra/thread/fikra-thread-open)
  (fikra-ensure-buffer-keymap)
  (fikra-refresh-lighter)
  fikra-chat-buffer-name)

(defun fikra-chat-close ()
  "Close the chat buffer view (thread + log preserved)."
  (buffer-switch "default"))

(defun fikra-quit ()
  (fikra-chat-close))

;; ── turn lifecycle ──────────────────────────────────────────────────
(defun fikra-turn-send (message)
  "Send MESSAGE as a new turn: FAEP user text + the backend's start-turn.
The adapter drives everything after this (turn-begin, stream, turn-end)."
  (if (string= (fikra/adapter/fikra-current-backend) "none")
    (progn
      (editor-set-status "Fikra: no backend — SPC a b to select")
      nil)
    (progn
      ;; The user's message is part of the transcript.
      (fikra/event/fikra-event-emit
        (list (list "kind" "text-delta") (list "text" (concat "You: " message))))
      (fikra-refresh-lighter)
      (fikra/adapter/fikra-backend-start-turn message))))

(defun fikra-turn-interrupt ()
  "Cancel the in-progress turn (backend abort; guard prevents double-end)."
  (fikra/adapter/fikra-backend-abort)
  (fikra-refresh-lighter))

(defun fikra-turn-status ()
  "Thread status (idle/running/confirming/interrupted/error)."
  (fikra/thread/fikra-thread-status))

;; ── modeline (#211 dynamic lighters) ────────────────────────────────
;; fikra:<backend><state> — recomputed from live state; NOT the transient
;; editor-set-status slot. #219 wires the per-FAEP-event refresh hook; for
;; now the interactive entry points (open/send/interrupt) refresh.
(defun fikra-lighter-state-char ()
  (let ((s (fikra/thread/fikra-thread-status)))
    (cond
      ((string= s "running") "◉")
      ((string= s "confirming") "?")
      ((string= s "interrupted") "◈")
      ((string= s "error") "✗")
      (t "●"))))

(defun fikra-refresh-lighter ()
  "Recompute the fikra minor-mode lighter from live state."
  (minor-mode-set-lighter "fikra"
    (concat "fikra:" (fikra/adapter/fikra-current-backend)
            (fikra-lighter-state-char))))

;; ── buffer-local keymap (#206 chain) ────────────────────────────────
(defun fikra-ensure-buffer-keymap ()
  "Attach the *Fikra* buffer-local keymap (idempotent)."
  (let ((kmap (editor/keymaps/buffer-keymap fikra-chat-buffer-name)))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "fikra-chat"))
        (editor/keymaps/keymap-set-key kmap "RET" "(fikra/chat/fikra-follow-link)")
        (editor/keymaps/keymap-set-key kmap "C-g" "(fikra/chat/fikra-turn-interrupt)")
        (editor/keymaps/buffer-set-keymap fikra-chat-buffer-name kmap))))
  t)

;; RET follows file links — paths in tool-call/file-change lines are
;; navigable (rendered by FAEP's §D2 table).
(defun fikra-follow-link ()
  "Follow the file path under cursor in *Fikra*."
  (let ((line (buffer-current-line-text)))
    (let ((path (fikra-extract-file-path line)))
      (if path
        (find-file path)
        (editor-set-status "Fikra: no file path on this line")))))

(defun fikra-file-path-in-line-p (line)
  (or (string-match-p "src/[^ \t\n]+" line)
      (string-match-p "test/[^ \t\n]+" line)))

(defun fikra-extract-file-path (line)
  (let ((m1 (string-match "src/[^\s\t\n,;)\"]+" line)))
    (if m1
      m1
      (let ((m2 (string-match "test/[^\s\t\n,;)\"]+" line)))
        m2))))

(provide "fikra-chat")
)
