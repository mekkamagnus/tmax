(defmodule fikra/diff
  (export fikra-turn-diff fikra-diff-next fikra-diff-prev fikra-diff-revert-turn
          fikra-diff-restore-turn fikra-changed-paths-since-baseline
          fikra-diff-for-paths
          fikra-diff-turn-next fikra-diff-turn-prev fikra-diff-turn-step
          fikra-revert-confirm-table fikra-revert-confirm-accept
          fikra-diff-revert-completed-accept fikra-diff-revert-completed-exec fikra-diff-revert-completed fikra-last-completed-turn fikra-turn-diff-for
          fikra-diff-turn-cmd-next fikra-diff-turn-cmd-prev fikra-diff-facelines fikra-diff-render fikra-diff-render-parts fikra-diff-render-raw)

;; SPC a d — the turn diff view (mockup 8.4's entry point). TURN-SCOPED
;; (codex round 6: the viewer must show THIS turn's patch, not the whole
;; working tree): the paths changed since the stored turn-begin baseline
;; drive the diff — `git diff HEAD -- <paths>` for tracked changes plus
;; full content for new untracked files — SHARED-FACE (git
;; --no-color + the #313 grammar helper) in a read-only
;; *Fikra-Diff* buffer.

(require-module editor/fikra/diff-face)

(defvar fikra-diff-buffer-name "*Fikra-Diff*"
  "Name of the turn-diff buffer.")

(defun fikra-turn-diff ()
  "Show the changes since the last turn's begin baseline (colored) in
*Fikra-Diff* — SPC a d."
  (interactive)
  (require-module fikra/thread)
  (let* ((state (fikra/thread/fikra-thread-field "turn-count"))
         (dir (fikra/thread/fikra-thread-working-dir))
         (rows (condition-case nil (fikra/thread/fikra-thread-compute-changes) (error () nil)))
         (paths (fikra-changed-paths-since-baseline)))
    (if (not (stringp dir))
      (editor-set-status "Fikra: no working dir for this thread")
      (if (or (null paths) (= (length paths) 0))
        ;; Empty live view but completed turns exist: open the LATEST
        ;; completed turn directly — turn navigation must be reachable
        ;; without a dirty working tree (codex r24 fix 4, live catch).
        (if (> (fikra/thread/fikra-thread-turn-count) 0)
          (fikra-turn-diff-for (fikra/thread/fikra-thread-turn-count))
          (editor-set-status "Fikra: no changes in this turn"))
        (let ((patch (fikra-diff-for-paths dir paths (fikra-baseline-tree))))
          (if (or (null patch) (string= patch ""))
            (editor-set-status "Fikra: no changes in this turn")
            (progn
              (setq fikra-diff-view-turn nil)
              ;; Mockup 8.4 letters: name-status vs the baseline tree; a
              ;; path it does not know is UNTRACKED → A.
              (setq fikra-diff-letters
                (fikra-diff-letters-scan
                  (shell-command
                    (concat "git -C " (fikra/thread/fikra-thread-shq dir)
                            " diff --name-status " (fikra-baseline-tree)
                            " 2>/dev/null"))))
              (dolist (p paths)
                (if (not (hashmap-get fikra-diff-letters p))
                  (editor/keymaps/keymap-mutable-set! fikra-diff-letters p "A")))
              (fikra-diff-render-parts
                (concat (fikra-diff-summary state rows
                          (fikra-diff-turn-tools-line state))
                        "\n")
                (fikra-diff-facelines patch)
                (concat "\n" (fikra-diff-keys-footer))))))))))

;; Summary table (mockup 8.4: file summary + totals) — colored header,
;; magenta ± rows with per-file counts, totals line.
;; ── completed-turn navigation (codex r24 fix 4: turn-to-turn nav) ────
;; The live view shows the CURRENT turn's working changes; ] and [ walk
;; COMPLETED turns via their checkpoint refs (refs/fikra/<id>/<n>-baseline
;; vs refs/fikra/<id>/<n>).
(defvar fikra-diff-view-turn nil
  "The completed turn being viewed (nil = the live current-turn view).")

(defun fikra-diff-turn-patch (n)
  "The completed turn N's patch: baseline-ref vs completion-ref."
  (let ((id (fikra/thread/fikra-thread-current)))
    (shell-command
      (concat "git -C "
              (fikra/thread/fikra-thread-shq (fikra/thread/fikra-thread-working-dir))
              " diff --no-color refs/fikra/" id "/" (number-to-string n) "-baseline"
              " refs/fikra/" id "/" (number-to-string n) " 2>/dev/null"))))

(defun fikra-turn-diff-for (n)
  "Render completed turn N's diff in the viewer — with the LIVE view's
file-summary block (r75: the completed view showed only the header, no
per-file ± rows)."
  (let ((patch (fikra-diff-turn-patch n)))
    (if (or (null patch) (string= (string-trim patch) ""))
      (editor-set-status (concat "Fikra: no captured diff for turn " (number-to-string n)))
      (progn
        (setq fikra-diff-view-turn n)
        (fikra-diff-render-parts
          (concat (fikra-diff-completed-summary n) "\n")
          (fikra-diff-facelines patch)
          (concat "\n" (fikra-diff-keys-footer)))))))

;; The numstat-derived ± rows for a COMPLETED turn (the live view builds
;; them from working state; here they come from the ref pair).
(defun fikra-diff-completed-summary (n)
  (let* ((id (fikra/thread/fikra-thread-current))
         (root (fikra/thread/fikra-thread-working-dir))
         (raw (shell-command
                (concat "git -C " (fikra/thread/fikra-thread-shq root)
                        " diff --numstat refs/fikra/" id "/" (number-to-string n) "-baseline"
                        " refs/fikra/" id "/" (number-to-string n)
                        " 2>/dev/null")))
         (rows (fikra-diff-numstat-rows (string-split raw "\n") (list))))
    (if (= (length rows) 0)
      ""
      (progn
        ;; Mockup 8.4: M/A/D/R status letters (this turn's own name-status)
        ;; + the per-turn tool tally in the header.
        (setq fikra-diff-letters
          (fikra-diff-letters-scan
            (shell-command
              (concat "git -C " (fikra/thread/fikra-thread-shq root)
                      " diff --name-status refs/fikra/" id "/" (number-to-string n) "-baseline"
                      " refs/fikra/" id "/" (number-to-string n)
                      " 2>/dev/null"))))
        (fikra-diff-summary n rows (fikra-diff-turn-tools-line n))))))

;; numstat lines ("adds\tdels\tpath") → the ((path adds dels) ...) rows the
;; summary renderer expects (r75: paths-filter's bare strings are NOT rows —
;; (cdr string) throws in the totals scan). fikra-diff-summary ends with its
;; own keys line — nothing extra appended (r76: the completed view doubled
;; the hint).
(defun fikra-diff-numstat-rows (lines acc)
  (if (null lines)
    (reverse acc)
    (fikra-diff-numstat-rows (cdr lines)
      (let ((parts (string-split (car lines) "\t")))
        (if (>= (length parts) 3)
          (cons (list (nth 2 parts)
                      (fikra-diff-numstat-count (nth 0 parts))
                      (fikra-diff-numstat-count (nth 1 parts)))
                acc)
          acc)))))

;; numstat prints "-" for BINARY files' counts — parse to 0, never throw
;; (codex r75 P1: one binary in a turn crashed the whole completed view).
(defun fikra-diff-numstat-count (s)
  (condition-case nil (string-to-number s) (error () 0)))

(defun fikra-diff-turn-step (delta)
  (let* ((count (fikra/thread/fikra-thread-turn-count))
         (from (if fikra-diff-view-turn fikra-diff-view-turn count)))
    (fikra-diff-turn-scan from delta count (+ from delta))))

;; r48: a turn with an EMPTY patch (or missing refs) is SKIPPED — the walk
;; reaches earlier turns through the gap instead of stopping dead.
(defun fikra-diff-turn-scan (from delta count target)
  (if (or (< target 1) (> target count)
          (and (= target from) (not (= from (if fikra-diff-view-turn fikra-diff-view-turn count)))))
    (editor-set-status (concat "Fikra: no further turns with captured diffs (1.."
                               (number-to-string count) ")"))
    (if (= target from)
      (editor-set-status "Fikra: no further turns with captured diffs")
      (if (> (length (string-trim (fikra-diff-turn-patch target))) 0)
        (fikra-turn-diff-for target)
        (fikra-diff-turn-scan from delta count (+ target delta))))))

;; The LAST COMPLETED turn: the count bumps at turn-START, so a
;; mid-flight turn must not be the revert target (codex r58).
(defun fikra-last-completed-turn ()
  ;; The LAST turn that ENDED COMPLETED (r60: an error/interrupted turn
  ;; leaves the count at itself but gets NO completion checkpoint — the
  ;; shortcut must not target it). Scans DOWN from the count; the count
  ;; itself counts only when the thread is at rest AND that turn
  ;; completed (a mid-flight count-N turn is running by construction).
  (require-module fikra/thread)
  (let ((n (fikra/thread/fikra-thread-field "turn-count"))
        (st (fikra/thread/fikra-thread-status)))
    (if (not (numberp n))
      0
      (let ((top (if (or (string= st "running") (string= st "confirming"))
                   (- n 1)
                   n)))
        (fikra-last-completed-scan top)))))

;; Walk down to the newest turn whose completion ref EXISTS (the
;; checkpoint IS the completion record).
(defun fikra-last-completed-scan (n)
  (cond
    ((< n 1) 0)
    ((fikra-completion-ref-exists-p n) n)
    (t (fikra-last-completed-scan (- n 1)))))

(defun fikra-completion-ref-exists-p (n)
  (string= (string-trim (shell-command
    (concat "git -C " (fikra/thread/fikra-thread-shq (fikra/thread/fikra-thread-working-dir))
            " rev-parse --verify -q refs/fikra/" (fikra/thread/fikra-thread-current)
            "/" (number-to-string n) " >/dev/null 2>&1 && echo yes || echo no")))
    "yes"))

(defun fikra-diff-turn-next () (fikra-diff-turn-step 1))
(defun fikra-diff-turn-prev () (fikra-diff-turn-step -1))

;; TOOLS is the pre-rendered "· tools: ..." segment (empty string when
;; the turn had no tool-calls) — the mockup packs it into header line 1.
(defun fikra-diff-summary (turn rows tools)
  (concat "\e[1;36m── turn " (if (numberp turn) (number-to-string turn) "?")
          " changes · " (number-to-string (length rows)) " file(s) · +"
          (number-to-string (fikra-diff-total rows 1)) " -"
          (number-to-string (fikra-diff-total rows 2)) " "
          (if (or (not tools) (string= tools "")) "" (concat "· " tools))
          "──\e[0m\n\n"
          (fikra-diff-rows rows)))

;; ── the per-turn tool tally (mockup line 1: "· tools: buffer-edit ×2,
;; bash ×1") — walk the event memory counting turn-starts; tool-calls
;; belong to the turn they follow. First-use order.
(defun fikra-diff-turn-tools-line (n)
  (let* ((counts (hashmap))
         (names (fikra-diff-tools-scan (fikra/event/fikra-event-events) 0 n counts (list))))
    (if (null names) ""
      (concat "tools: " (fikra-diff-tools-join (reverse names) counts "")))))

;; (events turn target counts order) → the ordered (name count) parts for
;; the TARGET turn. turn-start bumps the walk counter.
(defun fikra-diff-tools-scan (events turn target counts order)
  (if (null events)
    order
    (let* ((e (car events))
           (k (fikra/event/fikra-event-get-str e "kind")))
      (cond
        ((string= k "turn-start")
          (fikra-diff-tools-scan (cdr events) (+ turn 1) target counts order))
        ((and (= turn target) (string= k "tool-call"))
          (let* ((name (fikra/event/fikra-event-get-str e "tool"))
                 (cur (hashmap-get counts name)))
            (if (and cur (> cur 0))
              (progn
                (editor/keymaps/keymap-mutable-set! counts name (+ cur 1))
                (fikra-diff-tools-scan (cdr events) turn target counts order))
              (progn
                (editor/keymaps/keymap-mutable-set! counts name 1)
                (fikra-diff-tools-scan (cdr events) turn target counts
                  (cons name order))))))
        (t (fikra-diff-tools-scan (cdr events) turn target counts order))))))

;; "name ×N" segments in first-use order (the mockup: "buffer-edit ×2,
;; bash ×1").
(defun fikra-diff-tools-join (names counts acc)
  (if (null names)
    acc
    (fikra-diff-tools-join (cdr names) counts
      (concat acc (if (> (length acc) 0) ", ")
              (car names) " ×" (number-to-string (hashmap-get counts (car names)))))))

;; ── status letters (mockup 8.4 rows: "M path +5 −1", "A path +1 −0") ──
(defvar fikra-diff-letters (hashmap)
  "path → M/A/D/R for the current render (set by the view builders from
git's --name-status; a path absent here renders the legacy ± prefix).")

;; "M\tpath" lines → the path→letter hashmap (binary-safe: letter then
;; tab then the path; renames carry "R100\told\tnew" — the NEW path maps).
(defun fikra-diff-letters-scan (raw)
  (let ((m (hashmap)))
    (dolist (line (string-split raw "\n"))
      (let ((cols (string-split line "\t")))
        (if (>= (length cols) 2)
          (editor/keymaps/keymap-mutable-set! m
            (nth (- (length cols) 1) cols) (substring (car cols) 0 1)))))
    m))

;; The letter for a row path — rename tails resolve to the NEW path
;; (numstat prints "old => new"; the letters map keys on the new path).
(defun fikra-diff-letter-for (path)
  (or-with-rename (hashmap-get fikra-diff-letters path) path))

(defun or-with-rename (hit path)
  (if (and hit (> (length hit) 0))
    hit
    ;; r98 (codex r97 P2): same-directory renames print BRACE-COMPRESSED
    ;; ("src/{old => new}.txt") — decompress to the new path before the
    ;; lookup; plain "old => new" tails resolve directly.
    (let ((br (fikra-diff-strpos path "{" 0)))
      (if (>= br 0)
        (let* ((arrow (fikra-diff-strpos path " => " 0))
               (close (fikra-diff-strpos path "}" 0)))
          (if (and (>= arrow 0) (> close arrow))
            (let ((h2 (hashmap-get fikra-diff-letters
                       (concat (substring path 0 br)
                               (substring path (+ arrow 4) close)
                               (substring path (+ close 1) (length path))))))
              (if (and h2 (> (length h2) 0)) h2 nil))
            nil))
        (let ((arrow (fikra-diff-strpos path " => " 0)))
          (if (>= arrow 0)
            (let ((h2 (hashmap-get fikra-diff-letters
                       (substring path (+ arrow 4) (length path)))))
              (if (and h2 (> (length h2) 0)) h2 nil))
            nil))))))

;; First index of NEEDLE in S from I (a byte scan — string-match returns
;; the matched STRING, not a position); -1 when ABSENT (r99: 0-as-absent
;; conflated with found-at-0 — a leading brace "{old => new}/f" braced at
;; index 0 lost its letter).
(defun fikra-diff-strpos (s needle i)
  (if (> (- (length s) i) (- (length needle) 1))
    (if (string= (substring s i (+ i (length needle))) needle)
      i
      (fikra-diff-strpos s needle (+ i 1)))
    -1))

(defun fikra-diff-arrow-pos (s i)
  (fikra-diff-strpos s " => " i))

;; The mockup's footer — AFTER the patch (r97: the controls ride below
;; the content). r100: the mockup's SPC-a vocabulary leads (revert /
;; prev-turn / next-turn); the viewer's LOCAL keys follow.
(defun fikra-diff-keys-footer ()
  (concat "\n SPC a R turn diff · SPC a n next turn · [ prev turn · n/N file · r revert this turn · SPC a d live view \n"))

;; SPC a n / SPC a p (mockup 8.4's footer commands): step turns from
;; OUTSIDE the viewer too — with no completed view open, `n` opens the
;; LATEST completed turn first (the entry matches SPC a R's behavior).
(defun fikra-diff-turn-cmd (delta)
  ;; r101 (codex r100 P2): the OPEN test reads the CURRENT BUFFER, not
  ;; fikra-diff-view-turn — the defvar stays set after leaving the viewer
  ;; and the command would step from a ghost turn.
  (if (not (string= (buffer-name) fikra-diff-buffer-name))
    (let ((latest (fikra-last-completed-turn)))
      (if (> latest 0)
        (fikra-turn-diff-for latest)
        (editor-set-status "Fikra: no completed turns")))
    (fikra-diff-turn-step delta)))

(defun fikra-diff-turn-cmd-next () (interactive) (fikra-diff-turn-cmd 1))
(defun fikra-diff-turn-cmd-prev () (interactive) (fikra-diff-turn-cmd -1))

;; ROWS are ((path adds dels) ...); IDX 1 = adds column, 2 = dels.
(defun fikra-diff-total (rows idx)
  (let ((sum 0))
    (dolist (r rows)
      (let ((v (if (= idx 1) (car (cdr r)) (car (cdr (cdr r))))))
        (if (numberp v) (setq sum (+ sum v))
          (if (stringp v) (setq sum (+ sum (string-to-number v)))))))
    sum))

(defun fikra-diff-rows (rows)
  (let ((out ""))
    (dolist (r rows)
      ;; The mockup's status letter (M/A/D/R) when the render knows it;
      ;; ± for callers that did not build the letters map (legacy).
      (let ((letter (fikra-diff-letter-for (car r))))
        (setq out (concat out "\e[35m"
                          (if (and letter (> (length letter) 0)) letter "±")
                          " " (car r)
                        " +" (if (numberp (car (cdr r))) (number-to-string (car (cdr r))) (car (cdr r)))
                          " -" (if (numberp (car (cdr (cdr r)))) (number-to-string (car (cdr (cdr r)))) (car (cdr (cdr r))))
                          "\e[0m\n"))))
    out))

;; The header + patch land in the (re)created read-only buffer.
(defun fikra-diff-facelines (content)
  ;; #313 gate r1: git's colored output is NOT trusted intake —
  ;; strip ANSI, then face every line through the shared grammar
  ;; helper (context renders plain). JOIN semantics: the separator
  ;; goes BETWEEN lines (git's trailing newline must not double to
  ;; a blank); empty content renders empty.
  (let ((stripped
          ;; gate r1 PERF: skip the per-char strip entirely when no
          ;; ESC is present (the --no-color spawns have none; the
          ;; strip only guards legacy colored intake — 1317ms/225KB
          ;; superlinear otherwise).
          (if (condition-case nil (> (string-match "\e" content) -1) (error () nil))
            (editor/fikra/diff-face/diff-face-strip content)
            content)))
    (fikra-diff-join-lines
      (fikra-diff-face-scan (string-split stripped "\n") (list)))))

(defun fikra-diff-face-scan (lines acc)
  (if (null lines)
    (reverse acc)
    (fikra-diff-face-scan (cdr lines)
      (cons (editor/fikra/diff-face/diff-face-line
              (editor/fikra/diff-face/diff-classify-line (car lines))
              (car lines))
        acc))))

(defun fikra-diff-join-lines (lines)
  ;; between-lines separators only (reverse already applied by scan).
  (fikra-diff-join-scan lines ""))

(defun fikra-diff-join-scan (lines acc)
  (if (null lines)
    acc
    (fikra-diff-join-scan (cdr lines)
      (if (= (length acc) 0)
        (car lines)
        (concat acc "\n" (car lines))))))

(defun when-string (s)
  (if (and (stringp s) (> (length s) 0)) s ""))

(defun fikra-diff-render-raw (content)
  "The viewer's buffer lifecycle WITHOUT the facelines wrap —
render-parts drives this (its parts are already verbatim /
pre-faced; re-wrapping would strip the summary's own palette and
re-face it — the gate-r2 decisive finding)."
  (if (not (member fikra-diff-buffer-name (buffer-list)))
    (buffer-create fikra-diff-buffer-name))
  (buffer-switch fikra-diff-buffer-name)
  (buffer-set-read-only nil)
  (condition-case nil
    (let ((count (buffer-line-count)))
      (if (> count 1)
        (buffer-delete-range 0 0 count 0)
        (let ((l (buffer-line 0)))
          (if (> (length l) 0)
            (buffer-delete-range 0 0 0 (length l))))))
    (error () nil))
  (if (> (length content) 0)
    (buffer-append content))
  (buffer-set-read-only t)
  (editor-set-mode "normal")
  (fikra-diff-ensure-keymap)
  (editor-set-status "Fikra: turn diff"))

(defun fikra-diff-render-parts (summary patch footer)
  "gate r1+r2: the viewer's OWN summary/footer blocks pass through
VERBATIM (their palette survives — the parts bypass the facelines
wrap); only the GIT PATCH strips + faces (the callers call
facelines on the raw patch BEFORE composing)."
  (fikra-diff-render-raw
    (concat (when-string summary) (when-string patch) (when-string footer))))

(defun fikra-diff-render (content)
  (if (member fikra-diff-buffer-name (buffer-list))
    (progn
      (buffer-switch fikra-diff-buffer-name)
      (buffer-set-read-only nil)
      ;; Rewrite defensively: the cached line count can exceed the live
      ;; bounds (live catch: "Line 11 out of bounds (0-10)" killed every
      ;; turn-nav re-render — the header stayed on the previous turn).
      (condition-case nil
        (let ((count (buffer-line-count)))
          (if (> count 1) (buffer-delete-range 0 0 count 0)))
        (error ()
          (condition-case nil
            (buffer-delete-range 0 0 (- (buffer-line-count) 1) 0)
            (error () nil)))))
    (buffer-create fikra-diff-buffer-name))
  (buffer-switch fikra-diff-buffer-name)
  (buffer-set-read-only nil)
  (buffer-append (fikra-diff-facelines content))
  (buffer-set-read-only t)
  (editor-set-mode "normal")
  (fikra-diff-ensure-keymap)
  (editor-set-status "Fikra: turn diff"))

;; n/N jump between per-file patches ("diff --git" headers).
(defun fikra-diff-ensure-keymap ()
  (let ((kmap (editor/keymaps/buffer-keymap fikra-diff-buffer-name)))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "fikra-diff"))
        (editor/keymaps/keymap-set-key kmap "n" "(fikra/diff/fikra-diff-next)")
        (editor/keymaps/keymap-set-key kmap "N" "(fikra/diff/fikra-diff-prev)")
        (editor/keymaps/keymap-set-key kmap "r" "(fikra/diff/fikra-diff-revert-turn)")
        (editor/keymaps/keymap-set-key kmap "]" "(fikra/diff/fikra-diff-turn-next)")
        (editor/keymaps/keymap-set-key kmap "[" "(fikra/diff/fikra-diff-turn-prev)")
        (editor/keymaps/buffer-set-keymap fikra-diff-buffer-name kmap))))
  t)

(defun fikra-diff-jump (step)
  (let ((count (buffer-line-count)))
    (fikra-diff-scan (+ (cursor-line) step) step count)))

(defun fikra-diff-scan (line step count)
  (if (or (< line 0) (>= line count))
    (editor-set-status "Fikra: no more files")
    ;; Both section shapes are navigable: tracked patches ("diff --git")
    ;; AND new-file sections ("+++ new file:"). (codex round 11: new-file
    ;; navigation gap.)
    ;; PREFIX tests, not regexes: string-match's pattern layer mangles
    ;; backslash-escapes (a source "^\\+\\+\\+" arrives at JS as ^+++
    ;; → "nothing to repeat" — codex round-15 LIVE catch; the second
    ;; T-Lisp-regex fragility incident in this file). The STRIP is needed
    ;; because git --color prefixes section headers with SGR codes — a
    ;; plain prefix test never sees "diff --git" through them (round-16
    ;; fixture catch: n skipped colored sections).
    (if (or (string-prefix-p "diff --git" (fikra-strip-ansi (buffer-line line)))
            (string-prefix-p "+++ new file:" (buffer-line line)))
      (cursor-move line 0)
      (fikra-diff-scan (+ line step) step count))))

;; Remove ANSI CSI sequences (ESC … m) — a byte scan, no regex (see the
;; fragility notes above). O(n²) concat is fine for viewer-sized lines.
(defun fikra-strip-ansi (s)
  (fikra-sa-scan s 0 ""))

(defun fikra-sa-scan (s i out)
  (if (>= i (length s))
    out
    (if (string= (substring s i (+ i 1)) "\e")
      (fikra-sa-scan s (+ (fikra-sa-skip s (+ i 1)) 1) out)
      (fikra-sa-scan s (+ i 1) (concat out (substring s i (+ i 1)))))))

(defun fikra-sa-skip (s i)
  (if (or (>= i (length s)) (string= (substring s i (+ i 1)) "m"))
    i
    (fikra-sa-skip s (+ i 1))))

(defun fikra-diff-next () (interactive) (fikra-diff-jump 1))
(defun fikra-diff-prev () (interactive) (fikra-diff-jump -1))

;; Mockup 8.4's revert control: r restores THIS turn's touched tracked
;; paths to the baseline tree (git checkout <tree> -- paths) and deletes
;; files the turn CREATED. Destructive — requires an explicit "revert"
;; confirmation in the minibuffer.
(defun fikra-diff-revert-turn ()
  "r: in the LIVE view this reverts the current turn's working changes; in
a COMPLETED-turn view it reverts THE VIEWED TURN (r48: the binding used
to run the live revert from a history view — a genuinely dangerous
ambiguity)."
  (interactive)
  (if fikra-diff-view-turn
    (fikra-diff-revert-completed fikra-diff-view-turn)
    (fikra-diff-revert-live)))

;; Revert completed turn N: restore the BASELINE ref's version of every
;; path the turn changed (paths from the turn's own numstat), then
;; refresh the view.
;; r49: CONFIRMED first (the live revert's contract — the r48 direct
;; dispatch skipped confirmation). The pending turn rides a defvar; the
;; ACCEPT owns the work (completing-read never returns the choice).
(defvar fikra-diff-last-stash nil
  "The most recent revert-refusal stash path (nil until one exists).")

(defvar fikra-diff-pending-revert-turn nil
  "The history turn awaiting revert confirmation.")

(defun fikra-diff-revert-completed (n)
  (setq fikra-diff-pending-revert-turn n)
  (condition-case nil
    (completing-read (concat "Revert turn " (number-to-string n) "'s changes? ")
                     "fikra/diff/fikra-revert-confirm-table"
                     nil t ""
                     "fikra-revert-confirm-history"
                     "fikra/diff/fikra-diff-revert-completed-accept")
    (error () nil)))

(defun fikra-diff-revert-completed-accept (choice)
  (if (not (string= choice "revert"))
    (editor-set-status "Fikra: revert cancelled")
    (let ((n (if fikra-diff-pending-revert-turn fikra-diff-pending-revert-turn 0)))
      (setq fikra-diff-pending-revert-turn nil)
      (if (< n 1)
        (editor-set-status "Fikra: no turn selected")
        (fikra-diff-revert-completed-exec n)))))

;; r49: verified per-path restore — checkout when the baseline HAS the
;; path, REMOVE when the turn ADDED it (no baseline version exists); a
;; failed step reports, never `|| true` success.
(defun fikra-diff-revert-completed-exec (n)
  (let* ((id (fikra/thread/fikra-thread-current))
         (root (fikra/thread/fikra-thread-working-dir))
         (base (concat "refs/fikra/" id "/" (number-to-string n) "-baseline"))
         (completion (concat "refs/fikra/" id "/" (number-to-string n)))
         (paths (fikra-diff-completed-paths root id n))
         (failures (list))
         (diverged (list)))
    (if (or (null paths) (= (length paths) 0))
      (editor-set-status (concat "Fikra: turn " (number-to-string n) " has no captured changes"))
      (progn
        ;; SPEC-218: save divergent content BEFORE any restore runs —
        ;; UNIQUE filename per attempt (r51: a fixed name was overwritten
        ;; on repeated reverts) and the patch generation is VERIFIED (the
        ;; refusal message only claims a stash when one exists).
        (let ((stash-path (concat root "/.tmax/fikra/stash/revert-" id "-"
                                  (number-to-string n) "-"
                                  (number-to-string (current-time)) ".patch")))
          (shell-command (concat "mkdir -p " (fikra/thread/fikra-thread-shq
                           (concat root "/.tmax/fikra/stash"))))
          (setq fikra-diff-last-stash stash-path)
          (shell-command
            (concat "git -C " (fikra/thread/fikra-thread-shq root)
                    " diff --binary " completion " -- "
                    (fikra-join-args paths)
                    " > " (fikra/thread/fikra-thread-shq stash-path)
                    " 2>/dev/null || true")))
        (dolist (p paths)
          (let ((step (fikra-diff-restore-one root base completion p)))
            (cond
              ((string= step "ok") nil)
              ((string-prefix-p "DIV:" step)
                (setq diverged (cons (substring step 4 (length step)) diverged)))
              (t (setq failures (cons p failures))))))
        (if (> (length diverged) 0)
          (editor-set-status
            (concat "Fikra: revert REFUSED — changed since the turn: "
                    (fikra-diff-join-names (reverse diverged) "")
                    (if (and fikra-diff-last-stash (file-exists-p fikra-diff-last-stash))
                      (concat " (stash: " fikra-diff-last-stash ")")
                      " (no stash — content untracked)")))
          (if (> (length failures) 0)
            (editor-set-status (concat "Fikra: revert FAILED for: "
                                       (fikra-diff-join-names (reverse failures) "")))
            (editor-set-status (concat "Fikra: reverted turn " (number-to-string n)
                                       " (baseline restored) — SPC a d refreshes"))))))))

;; One path. Outcomes: "ok"; "DIV:<path>" (content diverged since the
;; turn — SPEC-218's guard: the current content must match the turn's
;; COMPLETION version, else the path is refused, never overwritten);
;; else the failing path. Divergent content is saved to
;; .tmax/fikra/stash/revert-<n>.patch before any restore runs.
(defun fikra-diff-restore-one (root base completion p)
  ;; SPEC-218's four-way table — computed EXPLICITLY, never inferred from
  ;; git diff --quiet alone (r51: an untracked recreation is INVISIBLE to
  ;; diff, so the quiet check passed and checkout clobbered the user's
  ;; file):
  ;;   absent-completion + absent-disk  -> clean restore (checkout base)
  ;;   absent-completion + present-disk -> DIVERGED (user recreated)
  ;;   present-completion + absent-disk -> DIVERGED (user deleted)
  ;;   present-both                    -> cmp contents (diff --quiet)
  (let ((in-base (string= (string-trim (shell-command
               (concat "git -C " (fikra/thread/fikra-thread-shq root)
                       " cat-file -e " base ":" (fikra/thread/fikra-thread-shq p)
                       " 2>/dev/null && echo yes || echo no"))) "yes"))
        (in-completion (string= (string-trim (shell-command
               (concat "git -C " (fikra/thread/fikra-thread-shq root)
                       " cat-file -e " completion ":" (fikra/thread/fikra-thread-shq p)
                       " 2>/dev/null && echo yes || echo no"))) "yes"))
        (on-disk (string= (string-trim (shell-command
               (concat "test -f " (fikra/thread/fikra-thread-shq (concat root "/" p))
                       " && echo yes || echo no"))) "yes"))
        (same-as-completion (string= (string-trim (shell-command
               (concat "git -C " (fikra/thread/fikra-thread-shq root)
                       " diff --quiet " completion " -- " (fikra/thread/fikra-thread-shq p)
                       " 2>/dev/null && echo same || echo diff"))) "same")))
    (if (not in-completion)
      ;; The turn ended WITHOUT this path (deleted or never added).
      (if on-disk
        (concat "DIV:" p)
        ;; Absent everywhere: clean restore from the baseline.
        (if (string-match "RESTORE-OK"
              (string-trim (shell-command
                (concat "git -C " (fikra/thread/fikra-thread-shq root)
                        " checkout " base " -- " (fikra/thread/fikra-thread-shq p)
                        " 2>&1 && echo RESTORE-OK || echo RESTORE-FAIL"))))
          "ok" p))
      ;; Present in the completion.
      (if (not on-disk)
        (concat "DIV:" p)
        (if (not same-as-completion)
          (concat "DIV:" p)
          (if in-base
            (if (string-match "RESTORE-OK"
                  (string-trim (shell-command
                    (concat "git -C " (fikra/thread/fikra-thread-shq root)
                            " checkout " base " -- " (fikra/thread/fikra-thread-shq p)
                            " 2>&1 && echo RESTORE-OK || echo RESTORE-FAIL"))))
              "ok" p)
            ;; In the completion but not the base: the turn ADDED it, and
            ;; the guard proved the disk matches the completion — remove.
            (if (string-match "REMOVE-OK"
                  (string-trim (shell-command
                    (concat "rm -f " (fikra/thread/fikra-thread-shq (concat root "/" p))
                            " 2>&1 && echo REMOVE-OK || echo REMOVE-FAIL"))))
              "ok" p)))))))

(defun fikra-diff-join-names (items acc)
  (if (null items)
    acc
    (fikra-diff-join-names (cdr items)
      (concat acc (if (> (length acc) 0) " ") (car items)))))

;; The turn's changed paths from ITS OWN numstat (not the live baseline).
(defun fikra-diff-completed-paths (root id n)
  (let ((raw (shell-command
    (concat "git -C " (fikra/thread/fikra-thread-shq root)
            " diff --numstat refs/fikra/" id "/" (number-to-string n) "-baseline"
            " refs/fikra/" id "/" (number-to-string n)
            " 2>/dev/null | cut -f3"))))
    (fikra-diff-paths-filter (string-split raw "\n") (list))))

(defun fikra-diff-paths-filter (lines acc)
  (if (null lines)
    (reverse acc)
    (fikra-diff-paths-filter (cdr lines)
      (if (> (length (car lines)) 0) (cons (car lines) acc) acc))))

(defun fikra-diff-revert-live ()
  (interactive)
  (require-module fikra/thread)
  (let ((paths (fikra-changed-paths-since-baseline)))
    (if (or (null paths) (= (length paths) 0))
      (editor-set-status "Fikra: nothing to revert")
      ;; completing-read, NOT read-string (round-26 live catch): read-string
      ;; is a STUB — it echoes the prompt and returns "" instantly, so the
      ;; typed "revert" could never reach the comparison. The table must be
      ;; a FUNCTION (input action) — the runtime-mode table pattern; a defvar
      ;; list failed as "Undefined function".
      ;; Round-28: the ACCEPT fn performs the revert (completing-read
      ;; never returns the choice to the caller).
      (completing-read "Revert this turn's changes? "
                       "fikra/diff/fikra-revert-confirm-table"
                       nil nil ""
                       "fikra-revert-confirm-history"
                       "fikra/diff/fikra-revert-confirm-accept"))))

;; The restore mechanism, separate from the confirmation gate (the gate is
;; read-string — interactive-only; the restore is testable/demoable).
;; #305 B: the rm branch fires ONLY for untracked files ABSENT from the
;; turn-begin baseline signature (turn-CREATED). An untracked file that
;; existed BEFORE the turn is PREEXISTING — untouched (the issue's
;; normative edge; file-kind alone could not distinguish them).
;; #305 (gate r1): restore ONE path with verified semantics. The
;; classification is BASELINE MEMBERSHIP, not the git index — a
;; turn-created file that was `git add`ed reads "tracked" to ls-files
;; but is ABSENT from the baseline tree; the old checkout silently
;; failed under 2>/dev/null and the file survived revert.
;; Preexisting = in the baseline SIGNATURE (untracked at turn-begin)
;; OR a path the BASELINE TREE carries (tracked at turn-begin — the
;; signature map only covers untracked files; gate r1 regression).
(defun fikra-diff-tree-contains (dir tree p)
  (> (length (string-trim (shell-command
         (concat "git -C " (fikra/thread/fikra-thread-shq dir)
                 " cat-file -e " tree ":" (fikra/thread/fikra-thread-shq p)
                 " 2>/dev/null && echo yes || echo no")))) 2))

(defun fikra-diff-restore-live-one (dir tree baseline p)
  (let ((in-baseline (or (and baseline (hashmap-get baseline p))
                         (fikra-diff-tree-contains dir tree p))))
    (cond
      ;; In the baseline SIGNATURE → existed pre-turn → restore its
      ;; pre-turn state: tracked-in-tree → checkout + unstage (the
      ;; checkout writes the index; `git restore --staged` unwinds a
      ;; pre-turn-unstaged file's staged shape — gate r1 catch 3).
      (in-baseline
        (progn
          ;; VERIFIED restore (codex r1: the old 2>/dev/null suppression
          ;; reported success on silent failures). -- separators before
          ;; paths (leading-dash safe); --staged uses HEAD~0-scope form.
          (let ((ck (string-trim (shell-command
                       (concat "git -C " (fikra/thread/fikra-thread-shq dir)
                               " checkout " tree " -- " (fikra/thread/fikra-thread-shq p)
                               " 2>&1 && echo RESTORE-OK || echo RESTORE-FAIL")))))
            (if (not (string-match "RESTORE-OK" ck))
              (editor-set-status (concat "Fikra: restore failed for " p))
              (shell-command (concat "git -C " (fikra/thread/fikra-thread-shq dir)
                                     " restore --staged -- " (fikra/thread/fikra-thread-shq p)
                                     " 2>/dev/null"))))))
      ;; ABSENT from the baseline (or the baseline is nil/errored —
      ;; conservative: the ± emission's nil→emit-nothing mirror, NOT
      ;; rm-everything) AND the file exists → turn-created → remove the
      ;; WORKTREE file AND any staged index entry (gate r2: an agent
      ;; `git add`ed file resurrects from the AD index state on a plain
      ;; commit — rm alone left the repo inconsistent).
      ;; Turn-created: clean the staged entry EVEN when the file is
      ;; already gone from disk (codex r1: the existence guard skipped
      ;; index cleanup), then remove the worktree file when present.
      (t
        (progn
          (shell-command (concat "git -C " (fikra/thread/fikra-thread-shq dir)
                                 " restore --staged -- " (fikra/thread/fikra-thread-shq p)
                                 " 2>/dev/null"))
          (if (file-exists-p (concat dir "/" p))
            (shell-command (concat "rm -f " (fikra/thread/fikra-thread-shq (concat dir "/" p))))))))))

(defun fikra-diff-restore-turn (paths)
  (let ((dir (fikra/thread/fikra-thread-working-dir))
        (tree (fikra-baseline-tree))
        (baseline (condition-case nil (fikra/thread/fikra-thread-field "change-baseline") (error () nil))))
    ;; nil baseline → restore NOTHING (conservative — the exported fn
    ;; must not rm on a missing baseline; gate r1 catch 2).
    (if (null baseline)
      nil
      (dolist (p paths)
        (fikra-diff-restore-live-one dir tree baseline p)))))

;; Paths changed since the stored baseline — the DRY computation shared
;; with the turn-end ± rows (fikra-thread-compute-changes → ((path a d) …)).
(defun fikra-changed-paths-since-baseline ()
  (condition-case nil
    (let ((rows (fikra/thread/fikra-thread-compute-changes)))
      (if rows
        (let ((paths (list)))
          (dolist (r rows)
            (setq paths (cons (car r) paths)))
          (reverse paths))
        nil))
    (error () nil)))

;; The turn's baseline tree (stash-create snapshot at turn-begin; HEAD
;; when the tree was clean). Diffing against it isolates the turn's OWN
;; content changes, even in files dirty before the turn (codex round 7).
(defun fikra-baseline-tree ()
  (let ((t-v (fikra/thread/fikra-thread-field "change-baseline-tree")))
    (if (and (stringp t-v) (> (length t-v) 0)) t-v "HEAD")))

;; The colored patch for PATHS: tracked diff vs the BASELINE TREE +
;; untracked file contents.
(defun fikra-diff-for-paths (dir paths tree)
  (let ((tracked (list))
        (untracked (list))
        (out ""))
    ;; Split paths: tracked (appear in git diff) vs new untracked.
    (dolist (p paths)
      (if (string= (fikra-file-kind dir p) "tracked")
        (setq tracked (cons p tracked))
        (setq untracked (cons p untracked))))
    (if (> (length tracked) 0)
      (setq out (concat out (shell-command (concat "git -C " (fikra/thread/fikra-thread-shq dir) " diff " tree " --no-color -- "
                                                  (fikra-join-args (reverse tracked)) " 2>/dev/null")))))
    ;; #305: untracked files render as NEW-FILE PATCHES (git's own
    ;; --no-index /dev/null form — empty → header only, binary → the
    ;; Binary-files line, odd names safe by argv construction), NOT
    ;; full-content blobs.
    (dolist (p (reverse untracked))
      (setq out (concat out
                        (shell-command
                          (concat "git -C " (fikra/thread/fikra-thread-shq dir)
                                  " -c core.quotepath=off diff --no-color --no-index -- /dev/null "
                                  (fikra/thread/fikra-thread-shq p)
                                  " 2>/dev/null || true"))
                        "\n")))
    out))

(defun fikra-file-kind (dir path)
  (if (> (length (string-trim (shell-command (concat "git -C " (fikra/thread/fikra-thread-shq dir) " -c core.quotepath=off ls-files -- " (fikra/thread/fikra-thread-shq path) " 2>/dev/null")))) 0)
    "tracked" "untracked"))

(defun fikra-join-args (parts)
  ;; #298 (codex r4): family-safe quoting per path (apostrophes included).
  (if (null parts) ""
    (concat (fikra/thread/fikra-thread-shq (car parts)) (if (cdr parts) (concat " " (fikra-join-args (cdr parts))) ""))))

;; Completion table as a FUNCTION (input action) — the completing-read
;; contract. Candidates: revert / cancel.
(defun fikra-revert-confirm-candidate (name annotation)
  (hashmap "value" name "display" name "annotation" annotation "metadata" (hashmap)))

(defun fikra-revert-confirm-table (input action)
  (if (string= action "metadata")
    (hashmap "category" "command")
    (list
      (fikra-revert-confirm-candidate "revert" "discard this turn's changes")
      (fikra-revert-confirm-candidate "cancel" "keep them"))))

(defvar fikra-revert-confirm-history nil
  "Minibuffer history for the revert confirmation.")

(defun fikra-revert-confirm-accept (choice)
  "Minibuffer accept handler (round-28): completing-read hands the
CHOICE here — accept DOES the work (the runtime-mode pattern; the
caller never sees the value). Restore on revert, status otherwise."
  (if (string= choice "revert")
    (progn
      (let ((paths (fikra-changed-paths-since-baseline)))
        (if (or (null paths) (= (length paths) 0))
          (editor-set-status "Fikra: nothing to revert")
          (progn
            (fikra-diff-restore-turn paths)
            (editor-set-status "Fikra: turn reverted — SPC a d to refresh")
            (fikra-turn-diff))))
      "revert")
    (progn
      (editor-set-status "Fikra: revert cancelled")
      "cancel")))

(provide "fikra-diff")
)
