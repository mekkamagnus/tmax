(defmodule editor/commands/vim-counts
  (export vim-count-active-p vim-count-add-digit vim-count-current vim-count-reset vim-count-consume
          vim-count-discard)

;; vim-counts.tlisp -- Vim count prefix state owned by T-Lisp

(defvar vim-count 0)
(defvar vim-count-active nil)

(defun vim-count-active-p ()
  "Return t when a normal-mode count prefix is active."
  vim-count-active)

(defun vim-count-add-digit (digit)
  "Add DIGIT to the active Vim count prefix."
  (progn
    (set! vim-count (+ (* vim-count 10) digit))
    (set! vim-count-active t)
    (count-set vim-count)
    (editor-set-status (concat "Count: " vim-count))
    t))

(defun vim-count-current ()
  "Return the active Vim count, or 1 when no count is active."
  (if vim-count-active vim-count 1))

(defun vim-count-reset ()
  "Clear Vim count state."
  (progn
    (set! vim-count 0)
    (set! vim-count-active nil)
    (count-reset)
    (editor-set-status "")
    nil))

(defun vim-count-discard ()
  "Clear the Vim count when one is ACTIVE, and do nothing otherwise.
Unlike vim-count-reset, a status message is cleared only when it is the
count display itself (\"Count: 3\"): a message the command that ran just
set stays. For a command that does not read the count and has run to its
end (a binding of a major mode): the count must not reach the next edit."
  (if vim-count-active
    (progn
      (set! vim-count 0)
      (set! vim-count-active nil)
      (count-reset)
      (if (string-prefix-p "Count: " (editor-status))
        (editor-set-status "")
        nil)
      t)
    nil))

(defun vim-count-consume (&optional (default 1 default-supplied-p))
  "Return the current Vim count (or DEFAULT when inactive) and clear count state."
  (let ((result (if vim-count-active vim-count default)))
    (progn
      (vim-count-reset)
      result)))
)
