(defmodule editor/commands/windows
  (export split-window-below split-window-right other-window delete-window delete-other-windows balance-windows)

;; windows.tlisp — Window management commands
;; Wraps TypeScript display primitives with editor commands and key bindings

(defun split-window-below ()
  "Split current window horizontally (top/bottom)."
  (split-window "horizontal"))

(defun split-window-right ()
  "Split current window vertically (left/right)."
  (split-window "vertical"))

(defun other-window ()
  "Cycle to next window."
  (window-next))

(defun delete-window ()
  "Close current window. Does nothing if only one window."
  (window-close))

(defun delete-other-windows ()
  "Close every window except the current one (maximize current window).
Composes window-current/window-next/window-close. No-op when only one
window remains. SPEC-067: bound under the C-w window prefix, not C-x 1."
  (let ((keep (window-current)))
    (while (> (window-count) 1)
      ;; window-close always closes the CURRENT window, so if the current
      ;; window is the one we want to keep, rotate to a sibling first.
      (when (= (window-current) keep)
        (window-next))
      (window-close))
    (message "Deleted other windows")))

(defun balance-windows ()
  "Equalize window heights and widths across all windows.
Horizontal splits (top/bottom panes) get equal row heights; vertical
splits (left/right panes) get equal column widths. No-op when only one
window exists. SPEC-084. SPEC-067: bound under the C-w window prefix
(C-w =), not C-x."
  (window-balance))

;; C-w is a which-key PREFIX only (never a terminal command). The chord
;; bindings here (C-w =) and in motions.tlisp (C-w s/v/w/q/+/-/>/<) make C-w
;; a prefix, so a bare (key-bind "C-w" ...) would be dead weight — the prefix
;; path (normal-handler.ts) intercepts C-w before binding lookup. See BUG-59.
;; SPEC-084: C-w = rebalances pane sizes (extends the C-w prefix; no C-x binding)
(key-bind "C-w =" "(balance-windows)" "normal")
)
