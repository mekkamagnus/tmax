#!/usr/bin/env bun
/**
 * @file tmaxclient
 * @description Client CLI tool for connecting to tmax server — thin shim.
 *   The implementation lives in src/client/cli.ts (runTmaxClient) so the
 *   compiled binary (#250) can run client verbs in-process; this script only
 *   remains as the bin/ entry point source runs have always used.
 */

import { runTmaxClient } from '../src/client/cli.ts';

runTmaxClient(process.argv.slice(2)).catch((error) => {
  console.error('Fatal error:', error);
  process.exit(1);
});
