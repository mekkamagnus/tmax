(defmodule editor/commands/command-line
  (export editor-dispatch-command-line)

;; command-line.tlisp — CHORE-44 Change 6 (AC6.2)
;;
;; Owns the command-mode line policy that previously lived inside the TypeScript
;; command-handler. The handler now passes the raw command-line string here and
;; this module decides what to do:
;;
;;   :%s/find/replace/flags   -> whole-buffer replace-all         (replace-find-matches + replace-apply-all)
;;   :%s/find/replace/        -> whole-buffer replace-all         (same)
;;   :s/find/replace/         -> (replace-find-matches find)
;;                               (replace-apply-all)            (whole-buffer)
;;   :dired                   -> (dired ".")
;;   :dired <dir>             -> (dired <dir>)
;;   anything else            -> (editor-execute-command-line)
;;
;; Behaviour:
;;   - :%s/find/replace/[gic] performs a NON-INTERACTIVE whole-buffer
;;     replace-all (vim :%s/.../g semantics). The prior TypeScript policy
;;     routed :%s to (query-replace), which is interactive (it prompts
;;     y/n/a/q) AND errored on an undefined `when` symbol in replace.tlisp —
;;     so :%s never actually mutated the buffer. The CHORE-44 Step 13
;;     cross-cutting playbook requires `:%s/alpha/omega/g` to change buffer
;;     text, so :%s now uses the same proven whole-buffer mechanism as :s
;;     (replace-find-matches defaults to start=0 = whole buffer, then
;;     replace-apply-all applies every match). The gic flags are accepted
;;     but, as in the original TS policy, do not change the dispatched path.
;;   - :s/find/replace/ calls replace-find-matches (whole-buffer, start=0)
;;     and immediately applies all matches.
;;   - find/replace are passed as runtime string VALUES, never embedded
;;     into source, so no quote-escaping is required.
;;
;; T-Lisp gotchas observed (see docs/learnings.md):
;;   - string-match uses JS RegExp under the hood and seeds match-string.
;;   - cond clauses take exactly (test expr); bodies wrapped in progn.
;;   - string literals must stay on a single source line.

(defun editor-dispatch-command-line (cmd-line)
  "Dispatch a raw command-mode line to the owning T-Lisp command.
CMD-LINE is the exact text the user typed after the ':' prompt
(the leading ':' is NOT included). Preserves the prior TypeScript
substitute/Dired/execute policy."
  (let ((line (if (stringp cmd-line) cmd-line "")))
    (cond
      ;; :%s/find/replace/flags  — non-interactive whole-buffer replace-all
      ;; (vim :%s/.../g semantics). Flags (gic) are accepted but do not change
      ;; the dispatched path, matching the previous TS policy. replace-find-matches
      ;; returns the match list; replace-state-init binds the replacement text;
      ;; replace-apply-all applies every match.
      ((string-match "^%s/(.+)/(.*)/([gic]*)$" line)
       (let ((find (match-string 1))
             (replace (match-string 2)))
         (undo-begin)
         (replace-state-init (or find "") (or replace "") (replace-find-matches (or find "")))
         (replace-apply-all)
         (undo-commit "substitute")))
      ;; :s/find/replace/  — whole-buffer replace, applied immediately.
      ((string-match "^s/(.+)/(.*)/?$" line)
       (let ((find (match-string 1))
             (replace (match-string 2)))
         (undo-begin)
         (replace-state-init (or find "") (or replace "") (replace-find-matches (or find "")))
         (replace-apply-all)
         (undo-commit "substitute")))
      ;; :w / :w!  — write the current buffer to its file (vim :w). The bare
      ;; command names w/q/wq are not T-Lisp symbols, so the eval fallthrough
      ;; below would error on them; handle them explicitly here.
      ((string= line "w")
       (funcall "save-buffer"))
      ((string= line "w!")
       (funcall "save-buffer" nil t))
      ;; :wa / :wsave — bulk-save every modified buffer (SPEC-072).
      ;; Uses the synchronous save-all-buffers (vim :wa semantics): the
      ;; command-mode handler resets mode to `normal` after the dispatch
      ;; returns, so an interactive completing-read prompt (mx) opened from
      ;; here cannot survive. save-some-buffers (prompting) is the M-x path.
      ;; funcall resolves the module-exported name via resolveUniqueExport
      ;; (direct symbol lookup in this module env does not see sibling
      ;; module exports).
      ((or (string= line "wa") (string= line "wsave"))
       (funcall "save-all-buffers"))
      ((or (string= line "wq") (string= line "x"))
       (progn (funcall "save-buffer") (editor-quit)))
      ((or (string= line "wq!") (string= line "x!"))
       (progn (funcall "save-buffer" nil t) (editor-quit)))
      ;; :q / :q! / :quit  — quit (discard unsaved changes for the ! form).
      ((or (string= line "q") (string= line "q!") (string= line "quit"))
       (editor-quit))
      ;; :e <file> / :edit <file> — open a file (was a TS TODO stub). #60 / BUG-49.
      ((string-match "^e[ \t]+(.+)$" line)
       (open-file (match-string 1)))
      ((string-match "^edit[ \t]+(.+)$" line)
       (open-file (match-string 1)))
      ;; :dired            — open the current directory.
      ((string= line "dired")
       (dired "."))
      ;; :dired <dir>      — open the given directory.
      ((string-match "^dired[ \t]+(.+)$" line)
       (let ((dir (match-string 1)))
         (dired (or dir "."))))
      ;; :bd / :bdelete [name] — kill a buffer (SPEC-071). With no argument
      ;; kills the current buffer; with a name kills that buffer. kill-buffer
      ;; lives in editor/commands/buffers (sibling module), so funcall resolves
      ;; the exported name. The modified-buffer save gate runs inside
      ;; kill-buffer itself (completing-read); the command-mode handler resets
      ;; to normal mode after this dispatch returns, so the prompt survives only
      ;; because completing-read flips mode to mx (the reset sees mx and leaves
      ;; it — same mechanism :%s relies on for the replace mx flow).
      ((or (string= line "bd") (string= line "bdelete"))
       (funcall "kill-buffer"))
      ((string-match "^bd[ \t]+(.+)$" line)
       (funcall "kill-buffer" (match-string 1)))
      ((string-match "^bdelete[ \t]+(.+)$" line)
       (funcall "kill-buffer" (match-string 1)))
      ;; :set et/noet (expandtab), :set ts=N (tabstop) — #144.
      ;; expand-tabs/tab-width live in editor/commands/insert-entries (module-
      ;; local), so go through the exported setters via funcall — direct setq
      ;; from this module env can't see those variables.
      ((or (string= line "set et") (string= line "set expandtab"))
       (funcall "set-expand-tabs" t))
      ((or (string= line "set noet") (string= line "set noexpandtab"))
       (funcall "set-expand-tabs" nil))
      ((string-match "^set ts=(.+)$" line)
       (funcall "set-tab-width" (string-to-number (match-string 1))))
      ;; :buffers / :ls — list open buffer names (#131). Current buffer
      ;; prefixed with %.
      ((or (string= line "buffers") (string= line "ls"))
       (let* ((bufs (buffer-list)) (current (buffer-current)))
         (message (string-join (mapcar (lambda (name) (concat (if (string= name current) "%" " ") " " name)) bufs) "  "))))
      ;; :set nu/nonu/rnu/nornu — toggle line-number display (#132)
      ((string= line "set nu") (global-line-numbers-mode t))
      ((string= line "set number") (global-line-numbers-mode t))
      ((string= line "set nonu") (global-line-numbers-mode nil))
      ((string= line "set rnu") (global-relative-line-numbers-mode t))
      ((string= line "set relativenumber") (global-relative-line-numbers-mode t))
      ((string= line "set nornu") (global-relative-line-numbers-mode nil))
      ;; :help — show help system entry points (#133).
      ((or (string= line "help") (string= line "h"))
       (message "Help: SPC h f function | SPC h m mode | SPC h v variable | SPC h k key | M-x apropos | M-x helpgrep"))
      ;; :helpgrep <pattern> — full-text search the manual (SPEC-111, #178).
      ((string-match "^helpgrep[ \t]+(.+)$" line)
       (helpgrep-run (match-string 1)))
      ((string= line "helpgrep")
       (helpgrep))
      ;; :man <topic> — render a man page in *Man* (SPEC-114, #181).
      ((string-match "^man[ \t]+(.+)$" line)
       (man-run (match-string 1)))
      ((string= line "man")
       (man))
      ;; Everything else (:q, :w, :wq, :nohl, :marks, unknown…) is handled
      ;; by the existing TS-backed editor-execute-command-line primitive,
      ;; which also clears the line and returns to normal mode.
      (t
       (editor-execute-command-line)))))

(provide "command-line")
)
