(defmodule fikra/capture
  (export fikra-capture fikra-capture-submit fikra-capture-cancel
          fikra-history-prev fikra-history-next
          fikra-capture-body fikra-capture-to-line fikra-capture-set-body fikra-capture-hint fikra-buffer-clear-all)

;; Capture buffer — org-capture inspired popup for composing messages

(defvar fikra-capture-buffer-name "*Fikra-Capture*"
  "Name of the capture buffer.")

(defvar fikra-input-history '()
  "List of previously sent messages.")

(defvar fikra-capture-ctx-label ""
  "The CALLING buffer's context label, captured before any switch.")

(defvar fikra-history-index -1
  "Current position in input history (-1 = not browsing).")

(defun fikra-capture ()
  "Open the capture composer (mockup 8.2): the To/Context header + separator
ride the top; the compose body starts at line 3; submit sends only the
body. (Mode must be active — the SPC a i binding implies it.)"
  (interactive)
  ;; The calling context FIRST — any buffer switch would make the
  ;; filename/cursor/selection read the CAPTURE buffer instead (codex r53).
  (let ((ctx (fikra-capture-context-label)))
    (if (not (member fikra-capture-buffer-name (buffer-list)))
      (buffer-create fikra-capture-buffer-name)
      nil)
    (split-window "horizontal")
    (buffer-switch fikra-capture-buffer-name)
    (setq fikra-capture-ctx-label ctx))
  (buffer-set-read-only nil)
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (let ((second-last (buffer-line (- count 2))))
        (if (> count 2)
          (progn
            (buffer-delete-range 0 0 (- count 2) (length second-last))
            (let ((l (buffer-line 0)))
              (buffer-delete-range 0 0 0 (length l))))
          (let ((l (buffer-line 0)))
            (if (> (length l) 0)
              (buffer-delete-range 0 0 0 (length l))))))))
  (cursor-move 0 0)
  (buffer-insert (concat (fikra-capture-to-line-cached) "\n"))
  (buffer-insert "--------------------------------------------------------------\n")
  (cursor-move 2 0)
  (let ((kmap (editor/keymaps/buffer-keymap fikra-capture-buffer-name)))
    (if (not kmap)
      (progn
        (setq kmap (editor/keymaps/keymap-init "fikra-capture"))
        (editor/keymaps/keymap-set-key kmap "C-c C-c" "(fikra/capture/fikra-capture-submit)")
        (editor/keymaps/keymap-set-key kmap "C-c C-k" "(fikra/capture/fikra-capture-cancel)")
        (editor/keymaps/keymap-set-key kmap "M-p" "(fikra/capture/fikra-history-prev)")
        (editor/keymaps/keymap-set-key kmap "M-n" "(fikra/capture/fikra-history-next)")
        (editor/keymaps/buffer-set-keymap fikra-capture-buffer-name kmap))))
  (editor-set-mode "insert")
  (setq fikra-history-index -1)
  (fikra-capture-hint))

;; Clear the WHOLE buffer, two in-bounds steps (the proven body-replace
;; shape): (0,0)..(count-1,0) consumes every newline but the last; then
;; the leftover last line's text. Zero-length skips its delete.
(defun fikra-buffer-clear-all ()
  (let ((count (buffer-line-count)))
    (if (> count 1)
      (progn
        (buffer-delete-range 0 0 (- count 1) 0)
        (let ((l (buffer-line 0)))
          (if (> (length l) 0)
            (buffer-delete-range 0 0 0 (length l))))))))

;; The compose BODY: everything below the two header lines.
(defun fikra-capture-body ()
  (let* ((full (buffer-text))
         (nl1 (fikra-str-index-of full 0))
         (nl2 (if nl1 (fikra-str-index-of full (+ nl1 1)) nil)))
    (if (not nl2)
      ""
      (substring full (+ nl2 1) (length full)))))

(defun fikra-str-index-of (s from)
  (if (>= from (length s))
    nil
    (if (string= (substring s from (+ from 1)) "\n")
      from
      (fikra-str-index-of s (+ from 1)))))

(defun fikra-capture-to-line-cached ()
  (require-module fikra/adapter)
  (require-module fikra/thread)
  (let ((tid (fikra/thread/fikra-thread-current)))
    (concat "To: thread " (if (and tid (> (length tid) 0)) tid "main")
            " (" (fikra/adapter/fikra-current-backend) ")"
            "   Context: " (if (> (length fikra-capture-ctx-label) 0)
                             fikra-capture-ctx-label
                             (fikra-capture-context-label)))))

;; "To: thread fix-scroll (ollama)   Context: tui-client.ts @112-124"
(defun fikra-capture-to-line ()
  (require-module fikra/adapter)
  (require-module fikra/thread)
  (let ((tid (fikra/thread/fikra-thread-current)))
    (concat "To: thread " (if (and tid (> (length tid) 0)) tid "main")
          " (" (fikra/adapter/fikra-current-backend) ")"
          "   Context: " (fikra-capture-context-label))))

(defun fikra-capture-context-label ()
  ;; The CALLING buffer's file @ the selection's line range when visual
  ;; mode was active, else the cursor line.
  ;; The selection is a LIST: (start-line start-col end-line end-col mode).
  (let ((sel (condition-case nil (visual-get-selection) (error () nil))))
    (if (and sel (> (length sel) 2))
      (concat (fikra-capture-basename (if (buffer-filename) (buffer-filename) "region"))
              "@" (number-to-string (+ (nth 0 sel) 1))
              "-" (number-to-string (+ (nth 2 sel) 1)))
      (concat (fikra-capture-basename (if (buffer-filename) (buffer-filename) "scratch"))
              "@" (number-to-string (+ (cursor-line) 1))))))

(defun fikra-capture-basename (path)
  (fikra-cap-base-scan path -1 0))

(defun fikra-cap-base-scan (path last i)
  (if (>= i (length path))
    (substring path (+ last 1) (length path))
    (fikra-cap-base-scan path
      (if (string= (substring path i (+ i 1)) "/") i last)
      (+ i 1))))

(defun fikra-capture-submit ()
  "Submit capture buffer contents as a new turn."
  ;; Read the capture buffer's text WITHOUT switching away blindly — the
  ;; "default" buffer name is a fixture artifact; the capture buffer is the
  ;; content source either way.
  (buffer-switch fikra-capture-buffer-name)
  (let* ((text (string-trim (fikra-capture-body))))
    (if (string= text "")
      (progn
        (editor-set-status "Empty message — type something first")
        (buffer-switch fikra-capture-buffer-name))
      (progn
        ;; Save to history
        (setq fikra-input-history (cons text fikra-input-history))
        ;; Clear capture buffer (the shared two-step shape)
        (buffer-set-read-only nil)
        (fikra-buffer-clear-all)
        ;; Close capture window, return to chat
        (delete-window)
        (buffer-switch (fikra/thread/fikra-thread-buffer-name))
        (editor-set-mode "normal")
        ;; Send the message
        (progn (require-module fikra/chat) (fikra/chat/fikra-turn-send text))))))

(defun fikra-capture-cancel ()
  "Discard capture buffer contents and close."
  ;; Clear capture buffer
  (buffer-switch fikra-capture-buffer-name)
  (buffer-set-read-only nil)
  (fikra-buffer-clear-all)
  ;; Close window, return to chat
  (delete-window)
  (buffer-switch (fikra/thread/fikra-thread-buffer-name))
  (editor-set-mode "normal")
  (editor-set-status "Fikra: capture cancelled"))

(defun fikra-history-prev ()
  "Insert previous message from history into the compose BODY (the
To/Context header stays)."
  (if (= (length fikra-input-history) 0)
    (editor-set-status "No history")
    (progn
      (setq fikra-history-index (min (+ fikra-history-index 1) (- (length fikra-input-history) 1)))
      (fikra-capture-set-body (nth fikra-history-index fikra-input-history))
      (fikra-capture-hint))))

(defun fikra-history-next ()
  "Insert next message from history into the compose BODY."
  (if (<= fikra-history-index 0)
    (progn
      (setq fikra-history-index -1)
      (fikra-capture-set-body "")
      (fikra-capture-hint))
    (progn
      (setq fikra-history-index (- fikra-history-index 1))
      (fikra-capture-set-body (nth fikra-history-index fikra-input-history))
      (fikra-capture-hint))))

;; Replace the body below the two header lines (header preserved).
(defun fikra-capture-set-body (text)
  ;; buffer-delete-range's line args are 0-BASED line indexes; the body
  ;; spans lines 2..count-1. Delete from line 2 to the LAST line.
  (buffer-switch fikra-capture-buffer-name)
  (buffer-set-read-only nil)
  ;; Clear the body REGION (lines 2..end) even when it is one line: move
  ;; to line 2, select to the end, delete — then insert (codex r53: the
  ;; >3 guard left a single-line body stacking recalled messages).
  ;; Delete the whole body REGION: (sl sc el ec) with el = the LAST line
  ;; (count-1, 0-based). 3+ lines: region delete; exactly 3 (one body
  ;; line): delete to the END of line 2 (col 0 → line length).
  ;; The range end is EXCLUSIVE — deleting to (last-line, 0) leaves that
  ;; line's text behind (codex r54: "first messagedraft two"). Delete
  ;; through the FINAL line's length instead.
  ;; Two in-bounds steps (a (last, len) end can sit past the buffer's
  ;; final cursor position): delete lines 2..count-2 THROUGH the second-
  ;; to-last line's length, then clear the (now single) last body line.
  ;; A delete STARTING at the end-of-buffer position is out of bounds —
  ;; a zero-length body line means there is nothing to clear (skip the
  ;; delete; only insert).
  (let ((count (buffer-line-count)))
    (if (> count 3)
      (progn
        ;; Step 1: (2,0)..(count-1,0) — a LINE-START end is always in
        ;; bounds and consumes the newlines of every body line but the
        ;; last. Step 2: the leftover last line now sits at line 2 —
        ;; clear its text.
        (buffer-delete-range 2 0 (- count 1) 0)
        (let ((l (buffer-line 2)))
          (if (> (length l) 0)
            (buffer-delete-range 2 0 2 (length l)))))
      (if (= count 3)
        (let ((l (buffer-line 2)))
          (if (> (length l) 0)
            (buffer-delete-range 2 0 2 (length l))))
        nil))
    (cursor-move 2 0)
    (buffer-insert text)))


(defun fikra-capture-hint ()
  (editor-set-status (concat "C-c C-c send   C-c C-k cancel   M-p/M-n history   "
                              (number-to-string (length fikra-input-history))
                              " msg(s) in history")))

;; Capture buffer key bindings
;; 'i' in *Fikra* opens capture
;; These bindings apply in normal mode when fikra is active

(provide "fikra-capture")
)
