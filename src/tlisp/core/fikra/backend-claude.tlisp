(defmodule fikra/backend-claude
  (export fikra-backend-claude-available-p fikra-backend-claude-capabilities
          fikra-backend-claude-start-turn fikra-backend-claude-abort
          fikra-backend-claude-normalize fikra-backend-claude-args
          fikra-backend-claude-line-events fikra-backend-claude-filter
          fikra-backend-claude-sentinel
          fikra-backend-claude-abort-sim fikra-backend-claude-adopt-process fikra-backend-claude-adopt-pid
          fikra-backend-claude-reset-accumulator fikra-afield
          fikra-claude-approvals-probe fikra-claude-write-mcp-config
          fikra-claude-mcp-config-path fikra-claude-mcp-ensure-dir
          fikra-claude-trust-arg
          fikra-claude-set-approvals-override
          fikra-claude-revoke-thread-token)

;; #214 (RFC-027 §D3/§D4): Claude Code CLI adapter, agent edition.
;; Process-per-turn + session resume; JSONL lines normalize to FAEP events
;; through the SEPARABLE normalize pipeline below (fixture-testable without
;; spawning claude); the filter holds a partial-line accumulator (stdout
;; chunks are arbitrary); the sentinel is the AUTHORITATIVE turn end.

(require-module fikra/adapter)
(require-module fikra/event)
(require-module fikra/thread)

;; #222 gate catch: PER-THREAD backend state — the module-globals bled
;; concurrent turns (a second turn reset the shared line accumulator
;; mid-stream and overwrote the process handle, so interrupt killed the
;; wrong process). Keyed by THREAD id; pid→thread resolved at dispatch.
(defvar fikra-claude-processes (hashmap)
  "thread-id → subprocess pid (number) or nil.")

(defvar fikra-claude-line-buffers (hashmap)
  "thread-id → partial-line accumulator — stdout chunks are arbitrary; JSON
objects must not be parsed until a full newline-delimited line has arrived.")

(defvar fikra-claude-aborteds (hashmap)
  "thread-id → t when that process was aborted LOCALLY — the abort path
already ended the turn as interrupted; the SIGTERM'd process's sentinel
must not end it AGAIN (double turn-end, gate catch).")

(defvar fikra-claude-pid-thread (hashmap)
  "pid → thread-id (the filter/sentinel dispatch key).")

(defvar fikra-claude-l2-armed nil
  "t when THIS turn's approval token mint succeeded — the L2 flags ride
the args only when armed (r87, codex r86 P1#2: a declined mint used to
write a nil-token config while the flags still rode, giving claude a
dead permission tool instead of the promised visible L1 degradation).")

(defvar fikra-claude-tokens (hashmap)
  "thread-id → this turn's approval token (r87: the sentinel REVOKES it
at turn-end — the bridge's token dies with the turn; multi-use WITHIN
the turn is the service's re-arm rule).")

(defun fikra-backend-claude-available-p ()
  "t when the claude CLI is on PATH."
  (let ((result (shell-command "command -v claude 2>/dev/null")))
    (not (string= (string-trim result) ""))))

;; #220: L2 is capability-GATED on --permission-prompt-tool — the hook that
;; routes claude's permission decisions through a tool. The installed
;; 2.1.195 surface does NOT have it (recorded 2026-08-22; --mcp-config and
;; --allowedTools do), so L2 degrades to L1 + turn-boundary review for
;; claude — the harness stays correct, only real-time mediation is lost.
(defvar fikra-claude-interactive-approvals-override nil
  "Test seam: \"on\"/\"off\" force the capability; nil = probe the CLI.")

(defvar fikra-claude-approvals-probe-cache nil
  "Cached probe result — the --help surface doesn't change mid-session.")

(defun fikra-claude-approvals-probe ()
  "t when the installed claude exposes --permission-prompt-tool."
  (cond
    ;; nil override must not reach string= (type error) — guard first.
    ((and fikra-claude-interactive-approvals-override
          (string= fikra-claude-interactive-approvals-override "on")) t)
    ((and fikra-claude-interactive-approvals-override
          (string= fikra-claude-interactive-approvals-override "off")) nil)
    (fikra-claude-approvals-probe-cache fikra-claude-approvals-probe-cache)
    (t
      (progn
        ;; r82 live catch: the CLI WRAPS its help text to the terminal
        ;; width — a piped (80-col) help split the flag across lines and
        ;; the grep counted 0 on a CLI that HAS the hook (L2 silently
        ;; off). Flatten newlines first (hex-built backslash: reader-
        ;; hostile literal), then grep -c; "0" = hook absent.
        (setq fikra-claude-approvals-probe-cache
              (not (string= (string-trim
                              (shell-command
                                (concat "claude --help 2>/dev/null | tr -d '"
                                        (hex-decode "5c") "n' | grep -c -- --permission-prompt-tool")))
                            "0")))
        fikra-claude-approvals-probe-cache))))

(defun fikra-claude-set-approvals-override (v)
  "Test seam: \"on\"/\"off\" force the interactive-approvals capability;
nil restores the real CLI probe. Keyless CI must pin BOTH the wiring and
the L1-degradation contract without the hook existing anywhere."
  (setq fikra-claude-interactive-approvals-override v)
  v)

(defun fikra-backend-claude-capabilities ()
  (list (list "session-resume" t)
        (list "interactive-approvals" (fikra-claude-approvals-probe))
        (list "sandbox-presets" nil)))

;; ── arg construction (fixture-testable) ─────────────────────────────
;; #220: trusted tool classes (#219 trust state, written by always-allow)
;; promote to --allowedTools — trusted classes stop costing round trips.
(defun fikra-claude-trust-arg ()
  "Comma-joined trust list for --allowedTools, or nil when empty."
  (require-module fikra/modes)
  (let ((trust (fikra/thread/fikra-thread-field "trust")))
    (if (null trust)
      nil
      (fikra-join-strings trust ","))))

(defun fikra-join-strings (parts sep)
  (if (null parts)
    ""
    (fikra-join-tail (cdr parts) sep (car parts))))

(defun fikra-join-tail (parts sep acc)
  (if (null parts)
    acc
    (fikra-join-tail (cdr parts) sep (concat acc sep (car parts)))))

(defun fikra-plan-active-p ()
  "t when the focused thread's interaction mode is plan (#223).
Nil-safe (the field is unset on default threads)."
  (require-module fikra/thread)
  (let ((mode (fikra/thread/fikra-thread-field "interaction")))
    (if (stringp mode) (string= mode "plan") nil)))

(defun fikra-backend-claude-args (message resume-id)
  "Build the claude argv for one turn. RESUME-ID nil = first turn.
#219: --permission-mode comes from the EFFECTIVE runtime mode
(degradation-aware) — never hard-coded (codex-review catch: the mode
changed nothing about spawned turns). #220: trust promotes to
--allowedTools; when the installed CLI has the permission hook, the
adapter-written --mcp-config + --permission-prompt-tool ride along (the
config is written per turn by fikra-claude-write-mcp-config)."
  (require-module fikra/modes)
  (require-module fikra/plan)
  ;; #223: a PLAN interaction turn runs READ-ONLY (native --permission-mode
  ;; plan + edit tools disallowed) — a plan turn never edits.
  (let* ((base (if (fikra-plan-active-p)
                 (append (list "--print" "--output-format" "stream-json" "--verbose"
                               "--include-partial-messages")
                         (fikra/plan/fikra-plan-claude-flags))
                 (list "--print"
                       "--output-format" "stream-json"
                       "--verbose"
                       "--include-partial-messages"
                       "--permission-mode"
                       (fikra/modes/fikra-claude-mode-arg
                         (fikra/modes/fikra-effective-mode)))))
         (with-trust
           ;; #223 gate catch: a PLAN turn never carries --allowedTools —
           ;; trust promotion could contradict the plan deny list (deny
           ;; precedence by CONSTRUCTION: the flag is simply absent).
           (if (fikra-plan-active-p)
             base
             (let ((trust-arg (fikra-claude-trust-arg)))
               (if trust-arg
                 (append base (list "--allowedTools" trust-arg))
                 base))))
         (with-l2
           (if (and (fikra-claude-approvals-probe) fikra-claude-l2-armed)
             (append with-trust
                     (list "--mcp-config"
                           (fikra-claude-mcp-config-path)
                           ;; claude's MCP tool naming: mcp__<server>__<tool>.
                           "--permission-prompt-tool"
                           "mcp__tmax-confirmation__permission"))
             with-trust)))
    ;; Mockup 8.7 (codex r25 fix 1): model-visible skills ride EVERY turn
    ;; as the system-prompt roster — user-only skills stay unlisted until
    ;; the user invokes them from the picker. Guarded: a skills failure
    ;; must never kill the turn itself.
    (let* ((roster (condition-case nil
                       (progn (require-module fikra/skills)
                              (fikra/skills/fikra-skills-model-roster))
                       (error () "")))
           (with-roster (if (> (length roster) 0)
                          (append with-l2
                                  (list "--append-system-prompt"
                                        (concat "Available file-based skills. To use one, run: Read .fikra/skills/<name>/SKILL.md and follow that file's instructions verbatim. These are NOT the Workflow tool and NOT plugins.\n" roster)))
                          with-l2)))
      (if (and resume-id (stringp resume-id) (> (length resume-id) 0))
        (append with-roster (list "--resume" resume-id "-p" message))
        (append with-roster (list "-p" message))))))

;; ── L2 wiring: the per-turn --mcp-config + token ────────────────────
;; The adapter mints the one-time token itself and writes the config
;; pointing claude at the bridge (source+token in argv — the token never
;; transits model-controlled space). Socket: the bridge resolves the
;; default daemon socket itself.
(defun fikra-claude-mcp-config-path ()
  ;; #298: the thread's PERSISTED root (the legacy daemon-cwd resolver
  ;; would split the config path from the mkdir below once client
  ;; context ≠ daemon cwd — verify-gate catch).
  (concat (fikra/thread/fikra-thread-field "root")
          "/.tmax/fikra/mcp/"
          (fikra/thread/fikra-thread-current) "-"
          (number-to-string (fikra/thread/fikra-thread-turn-count)) ".json"))

(defun fikra-claude-mcp-bridge-path ()
  "Absolute path of the L2 confirmation bridge (round-34/35): source mode
→ the repo's bin/; compiled mode → the primitive EXTRACTS the embedded
asset to ~/.cache/tmax (an external bun process cannot read $bunfs —
the virtual path was the last failure)."
  (tmax-mcp-bridge-path))

(defun fikra-claude-write-mcp-config ()
  "Mint the turn's approval token and write the --mcp-config JSON.
Returns the token (nil when the capability probe failed — L2 stays off)."
  (if (not (fikra-claude-approvals-probe))
    (progn
      (setq fikra-claude-l2-armed nil)
      nil)
    (let* ((scope (concat (fikra/thread/fikra-thread-current) "/"
                          (number-to-string (fikra/thread/fikra-thread-turn-count))))
           ;; r87: the mint is SCOPE-LIVENESS-GATED service-side (a live
           ;; running turn only — pre-mints for not-yet-started turns are
           ;; refused, so no held token can survive into the live turn).
           ;; ARMED tracks the mint here (the mint's owner) — args omit
           ;; the L2 flags when it declined.
           (token (confirmation-token-mint "fikra" scope))
           (path (fikra-claude-mcp-config-path)))
      (if (not token)
        ;; r88 (codex r87 P1): a DECLINED mint (occupied scope, not-live
        ;; turn) writes nothing and DISARMS — the args omit the L2 flags
        ;; (honest L1), never a config pointing at a dead token.
        (progn
          (setq fikra-claude-l2-armed nil)
          nil)
        (progn
      (fikra-claude-mcp-ensure-dir)
      ;; ABSOLUTE bridge path (round-34 live catch): the CLI resolves the
      ;; MCP server's args against ITS cwd (the thread working dir), so a
      ;; relative "bin/tmax-mcp-confirmation.ts" pointed at the user
      ;; project — "Available MCP tools: none" and the gate dead-ends.
      ;; Source-mode daemon runs from the tmax repo root.
      (write-file-content path
        (concat "{\"mcpServers\":{\"tmax-confirmation\":{"
                "\"command\":\"bun\","
                "\"args\":[\"" (fikra-claude-mcp-bridge-path) "\",\"fikra\",\""
                token "\"]}}}"))
      (editor/keymaps/keymap-mutable-set! fikra-claude-tokens
        (fikra/thread/fikra-thread-current) token)
      (setq fikra-claude-l2-armed t)
      ;; Best-effort 0600 (gate note): the token authorizes ORIGINATING a
      ;; mediate, never resolving — but don't leave it world-readable.
      (shell-command (concat "chmod 600 " (fikra-claude-shq path)))
      token)))))

;; #298 (codex r2/r3): shell-quoting for interpolated paths — a project
;; path containing spaces/metachars must not split the mkdir/chmod
;; commands, and embedded apostrophes must not break out (single-quote
;; with the close/escape/reopen join; the joiner is hex-built — backslash
;; literals are reader-hostile, the round-22 class).
(defun fikra-claude-shq (s)
  ;; #298 (codex r4): delegates to the family-safe quoting helper.
  (fikra/thread/fikra-thread-shq s))

;; The thread-root .tmax/fikra/mcp dir, shell-quoted (spaces-safe).
(defun fikra-claude-mcp-ensure-dir ()
  ;; #298: the thread's PERSISTED root (fikra-thread-root is the legacy
  ;; daemon-cwd resolution — wrong once client context ≠ daemon cwd).
  (shell-command
    (concat "mkdir -p "
            (fikra-claude-shq
              (concat (fikra/thread/fikra-thread-field "root") "/.tmax/fikra/mcp")))))

;; ── normalization: one JSONL line → FAEP events (pure, fixture-tested) ──
;; Returns a LIST of events (0, 1, or more) or nil for unparseable lines.
(defun fikra-backend-claude-normalize (line)
  "One JSONL line → a LIST of FAEP events (pure; fixture-tested). Nil for
unparseable or non-event lines. Flat dispatch — one branch per wire type."
  (condition-case nil
    (let ((obj (json-read-from-string line)))
      (if (null obj)
        nil
        (let ((type (fikra-afield obj "type")))
          (cond
            ((string= type "system")
              (fikra-norm-system obj))
            ((string= type "stream_event")
              (fikra-norm-stream-event obj))
            ((string= type "assistant")
              (fikra-norm-assistant obj))
            ((string= type "user")
              (fikra-norm-user obj))
            ((string= type "result")
              (fikra-norm-result obj))
            (t nil)))))
    (error nil)))

;; result → the USAGE final-count event (#319): provider-reported usage
;; (input+output tokens) persisted as a normal FAEP event — the honest
;; final `✓ N tokens` line, replay-identical from the log. No usage on
;; the result (interrupted turns) → NO event → no line (the recorded
;; absent-usage path).
(defun fikra-norm-result (obj)
  (let* ((usage (fikra-afield obj "usage"))
         (in-tok (if (listp usage) (fikra-afield usage "input_tokens") nil))
         (out-tok (if (listp usage) (fikra-afield usage "output_tokens") nil))
         (in-n (fikra-tokens-to-number in-tok))
         (out-n (fikra-tokens-to-number out-tok)))
    (if (and in-n out-n)
      (list (list (list "kind" "usage")
                  (list "tokens" (number-to-string (+ in-n out-n)))))
      nil)))

;; The CLI's usage numbers arrive as JSON numbers OR strings — accept both.
(defun fikra-tokens-to-number (v)
  (cond
    ((numberp v) v)
    ((stringp v) (string-to-number v))
    (t nil)))

;; system/init → session event (the resume handle).
(defun fikra-norm-system (obj)
  (let ((sid (fikra-afield obj "session_id")))
    (if sid
      (list (list (list "kind" "session") (list "id" sid)))
      nil)))

;; stream_event → text-delta per partial chunk. --include-partial-messages
;; (now always on) delivers content_block_delta/text_delta chunks; each
;; becomes its own text-delta so the *Fikra* buffer renders assistant text
;; AS IT STREAMS (t3code/zcode parity; codex UI verification: live
;; streaming 3/10). The complete assistant message still arrives at the
;; end — its text blocks are skipped when partial mode streamed them
;; already (see fikra-norm-blocks) so text never double-renders.
(defun fikra-norm-stream-event (obj)
  (let* ((ev (fikra-afield obj "event"))
         (etype (if (listp ev) (fikra-afield ev "type") nil))
         (delta (if (listp ev) (fikra-afield ev "delta") nil))
         (dtype (if (listp delta) (fikra-afield delta "type") nil))
         (txt (if (listp delta) (fikra-afield delta "text") nil)))
    (if (and (stringp etype) (string= etype "content_block_delta")
             (stringp dtype))
      (cond
        ;; text partials → text-delta (rendered live).
        ((and (string= dtype "text_delta") (stringp txt) (> (length txt) 0))
          (progn
            (setq fikra-claude-saw-partial t)
            (list (list (list "kind" "text-delta") (list "text" txt)))))
        ;; #319 — tool-argument partials → tool-input-delta: PERSISTED like
        ;; text partials (same volume class), rendered "" (the completed
        ;; tool-call renders the row), and the SECOND counted chunk kind
        ;; (the issue's named rule counts deltas, not completions).
        ((string= dtype "input_json_delta")
          (list (list (list "kind" "tool-input-delta"))))
        (t nil))
      nil)))

;; Set by fikra-norm-stream-event on the first live partial chunk; reset per
;; turn by fikra-backend-claude-start-turn. Truthy → the completed assistant
;; message's text blocks are skipped (they were already streamed live).
(defvar fikra-claude-saw-partial nil
  "Whether this turn streamed partial text chunks (--include-partial-messages).")

;; assistant → text-delta / tool-call events from the content blocks.
(defun fikra-norm-assistant (obj)
  (let ((msg (fikra-afield obj "message")))
    (if (not (listp msg))
      nil
      (let ((content (fikra-afield msg "content")))
        (if (not (listp content))
          nil
          (fikra-norm-blocks content (list)))))))

;; Fold content blocks → events, accumulated in OUT (oldest-first).
(defun fikra-norm-blocks (blocks out)
  (if (null blocks)
    (reverse out)
    (let* ((block (car blocks))
           (btype (fikra-afield block "type"))
           (event
             (cond
               ((string= btype "text")
                 (let ((txt (fikra-afield block "text")))
                   ;; Partial mode streams every chunk live; the completed
                   ;; message's text is then skipped (double-render guard).
                   ;; The guard is STATEFUL: replay fixtures carry complete
                   ;; messages only — no stream_events ever set the flag —
                   ;; so their text still renders.
                   (if (and txt (> (length txt) 0) (not fikra-claude-saw-partial))
                     (list (list "kind" "text-delta") (list "text" txt))
                     nil)))
               ((string= btype "tool_use")
                 (fikra-tool-call-event block))
               (t nil))))
      (fikra-norm-blocks (cdr blocks)
        (if event (cons event out) out)))))

;; user → tool-result events.
(defun fikra-norm-user (obj)
  (let ((msg (fikra-afield obj "message")))
    (if (not (listp msg))
      nil
      (let ((content (fikra-afield msg "content")))
        (if (not (listp content))
          nil
          (fikra-norm-results content (list)))))))

(defun fikra-norm-results (blocks out)
  (if (null blocks)
    (reverse out)
    ;; Only tool_result blocks — a stray text block in a user message must
    ;; not produce a spurious tool-result (gate catch).
    (let* ((block (car blocks))
           (btype (fikra-afield block "type")))
      (if (not (string= btype "tool_result"))
        (fikra-norm-results (cdr blocks) out)
        (let* ((is-error (fikra-afield block "is_error"))
               (content-v (fikra-afield block "content")))
          (fikra-norm-results (cdr blocks)
            (let ((rid (fikra-tool-id-short (fikra-afield block "tool_use_id"))))
              (cons (list (list "kind" "tool-result")
                          (list "ok" (if is-error nil t))
                          (list "tool" (hashmap-get fikra-claude-tool-names rid))
                          (list "id" rid)
                          (list "summary" (if content-v content-v "")))
                    out))))))))

;; tool_use block → tool-call event with a per-tool summary.
(defvar fikra-claude-tool-names (hashmap)
  "short-id → tool NAME — the denial row names the tool (codex round 9:
  the denied tool-result carried only the id).")
(defun fikra-tool-call-event (block)
  (let* ((name (fikra-afield block "name"))
         (input (fikra-afield block "input"))
         (summary (fikra-tool-summary name input))
         (short (fikra-tool-id-short (fikra-afield block "id"))))
    (editor/keymaps/keymap-mutable-set! fikra-claude-tool-names short
      (if name name "?"))
    (list (list "kind" "tool-call")
          (list "tool" (if name name "?"))
          (list "id" short)
          (list "summary" summary)
          ;; Inline change evidence (codex rounds 8-9: "edits are not shown
          ;; inline") — Edit/Write inputs become sign-prefixed preview lines.
          (list "preview" (fikra-tool-preview name input)))))

;; Sign-prefixed preview lines ("- old" / "+ new"), ≤3 per side, 72-char
;; capped — the renderer colors them under the tool row.
(defun fikra-tool-preview (name input)
  (cond
    ((string= name "Edit")
      (let ((old (fikra-afield input "old_string"))
            (new (fikra-afield input "new_string")))
        (if (and (stringp old) (stringp new))
          (concat (fikra-preview-lines "-" old) (fikra-preview-lines "+" new))
          "")))
    ((string= name "Write")
      (let ((c (fikra-afield input "content")))
        (if (stringp c) (fikra-preview-lines "+" c) "")))
    (t "")))

(defun fikra-preview-lines (sign text)
  (let ((lines (string-split text "\n"))
        (out "")
        (n 0))
    (dolist (l lines)
      (if (< n 3)
        (progn
          (setq out (concat out sign " "
                            (if (> (length l) 72) (concat (substring l 0 72) "…") l)
                            "\n"))
          (setq n (+ n 1)))))
    out))

;; "toolu_01XFDUDYJgAC" → "FDUDYJ" (last 6). Correlation key: the tool-result
;; carries the matching suffix so parallel calls pair with their results
;; visually (codex UI verification: calls grouped ahead of unlabeled results).
(defun fikra-tool-id-short (id)
  (if (and (stringp id) (> (length id) 6))
    (substring id (- (length id) 6) (length id))
    (if (stringp id) id "")))

(defun fikra-tool-summary (name input)
  (cond
    ((string= name "Bash")
      (let ((cmd (fikra-afield input "command")))
        (if cmd cmd "bash")))
    ((or (string= name "Edit") (string= name "Write") (string= name "Read"))
      (let ((p (fikra-afield input "file_path")))
        (if p p name)))
    (t (if name name "?"))))

;; alist field getter (json-read objects are ("k" v) alists).
(defun fikra-afield (obj key)
  (let ((found nil))
    (if (listp obj)
      (dolist (entry obj)
        (if (and (not found)
                 (listp entry)
                 (= (length entry) 2)
                 (string= (car entry) key))
          (setq found (car (cdr entry)))))
      nil)
    found))

;; ── line assembly: feed a raw chunk, get complete lines ────────────
;; Returns the list of COMPLETE lines carried by the chunk; keeps the
;; remainder in the accumulator. Fixture-testable without a process.
(defun fikra-backend-claude-line-events (chunk)
  "Feed CHUNK into the FOCUSED thread's line accumulator (test seam kept
for the existing single-thread suites)."
  (let ((id (fikra/thread/fikra-thread-current)))
    (fikra-backend-claude-line-events-for (if id id "main") chunk)))

(defun fikra-backend-claude-line-events-for (thread-id chunk)
  "Feed CHUNK into THREAD-ID's accumulator; normalize every complete line
and return the concatenated FAEP events (a flat list). Loop while a
newline exists — T-Lisp's `while` macro is unavailable, so this is a
recursion over the accumulator with a terminal check."
  (editor/keymaps/keymap-mutable-set! fikra-claude-line-buffers thread-id
    (concat (hashmap-get fikra-claude-line-buffers thread-id) chunk))
  (fikra-drain-lines-for thread-id (hashmap-get fikra-claude-line-buffers thread-id)))

(defun fikra-drain-lines-for (thread-id buf)
  (let ((nl (fikra-index-of-newline buf)))
    (if (null nl)
      (progn
        ;; Persist the leftover partial line back to THIS thread's slot.
        (editor/keymaps/keymap-mutable-set! fikra-claude-line-buffers thread-id buf)
        nil)
      (let ((line (substring buf 0 nl)))
        (setq buf (substring buf (+ nl 1) (length buf)))
        (let ((evs (fikra-backend-claude-normalize line)))
          (let ((rest (fikra-drain-lines-for thread-id buf)))
            (if evs
              (if rest (append evs rest) evs)
              rest)))))))

(defun fikra-index-of-newline (s)
  (fikra-find-nl s 0 (length s)))

(defun fikra-find-nl (s i len)
  (if (>= i len)
    nil
    (if (string= (substring s i (+ i 1)) "\n")
      i
      (fikra-find-nl s (+ i 1) len))))

;; ── process lifecycle ───────────────────────────────────────────────
(defun fikra-backend-claude-start-turn (message)
  "Spawn one turn: process-per-turn, resume the thread's session, stream
JSONL → FAEP. The sentinel is the authoritative turn end (#213).
#220: the approval token + --mcp-config are written AFTER turn-begin (the
scope names THIS turn) and BEFORE the spawn (args reference the path)."
  (let ((sid (fikra/thread/fikra-thread-session-id))
        (thread-id (fikra/thread/fikra-thread-current)))
    (editor/keymaps/keymap-mutable-set! fikra-claude-line-buffers thread-id "")
    (editor/keymaps/keymap-mutable-set! fikra-claude-aborteds thread-id nil)
    ;; Per-turn reset: the double-render guard only applies when THIS turn
    ;; actually streamed partial chunks (replay fixtures never do).
    (setq fikra-claude-saw-partial nil)
    (fikra/thread/fikra-thread-turn-begin)
    ;; L2: mint the turn's token + config (nil-op when the CLI lacks the
    ;; permission hook — args omit the flags too, same probe). r87: the
    ;; mint's success/failure arms/disarms the flags INSIDE (a declined
    ;; mint = honest L1, never a dead permission tool).
    (fikra-claude-write-mcp-config)
    (let ((args (fikra-backend-claude-args message sid)))
      (let ((pid (make-process
                   :command (cons "claude" args)
                   :cwd (fikra/thread/fikra-thread-working-dir) ; #221: worktree-aware
                   :filter "fikra-backend-claude-filter"
                   :sentinel "fikra-backend-claude-sentinel")))
        (editor/keymaps/keymap-mutable-set! fikra-claude-processes thread-id pid)
        (editor/keymaps/keymap-mutable-set! fikra-claude-pid-thread (number-to-string pid) thread-id)
        pid))))

(defun fikra-claude-drop-stale-session (thread-id events)
  (fikra-claude-drop-session-scan events (fikra/thread/fikra-thread-session-id-for thread-id) (list)))

(defun fikra-claude-drop-session-scan (events sid out)
  (if (null events)
    (reverse out)
    (let ((e (car events)))
      (fikra-claude-drop-session-scan (cdr events) sid
        (if (and (string= (fikra-afield e "kind") "session")
                 sid
                 (string= (fikra-afield e "id") sid))
          out
          (cons e out))))))

(defun fikra-backend-claude-filter (pid output)
  "Serialized per-process (#208): normalize complete lines from this chunk
and emit them as ONE FAEP batch (per-chunk coalescing). #222 gate catch:
the batch routes to the TURN'S thread (emit-batch-for) — the session-id
records on that thread, and switching focus mid-stream cannot bleed the
chunks into another thread's log."
  (let* ((thread-id (hashmap-get fikra-claude-pid-thread (number-to-string pid)))
         (events (if thread-id
                   ;; Session spam guard: the CLI re-prints its init line
                   ;; around tool rounds; a session event whose id already
                   ;; matches the thread's record is a no-op (live catch:
                   ;; one short turn logged 11k+ duplicate session events).
                   (fikra-claude-drop-stale-session
                     thread-id
                     (fikra-backend-claude-line-events-for thread-id output))
                   nil)))
    ;; Gate round-2: an UNKNOWN pid is DROPPED, never assumed focused —
    ;; a straggler chunk must not bleed into whatever the user views.
    (if (and thread-id events)
      (progn
        ;; Record the session id if this batch introduced one — ON THE
        ;; TURN'S THREAD (gate round-2: a background turn completing while
        ;; unfocused must still record its resume handle).
        (dolist (e events)
          (if (string= (fikra-afield e "kind") "session")
            (if (string= thread-id (fikra/thread/fikra-thread-current))
              (fikra/thread/fikra-thread-set-session-id (fikra-afield e "id"))
              (fikra/thread/fikra-thread-set-session-id-for thread-id (fikra-afield e "id")))))
        (fikra/event/fikra-event-emit-batch-for thread-id events)))))

(defun fikra-backend-claude-sentinel (pid exit-code)
  "AUTHORITATIVE turn end: process exit settles the thread state machine
(§D3 — checkpoint capture is #217's async follow-up, never blocks).
SKIPPED when the turn was already ended by a local abort (interrupted).
#222 gate catch: settles the PID'S thread — a background turn ending must
not mutate the focused thread's state."
  (let* ((thread-id (hashmap-get fikra-claude-pid-thread (number-to-string pid)))
         (focused (if thread-id (string= thread-id (fikra/thread/fikra-thread-current)) nil)))
    ;; Gate round-2: unknown pid → no-op (never assume focused). The
    ;; pid→thread entry stays RESIDENT after exit so late straggler chunks
    ;; still route to the right thread's accumulator.
    (if thread-id
      (progn
        (editor/keymaps/keymap-mutable-set! fikra-claude-processes thread-id nil)
        (editor/keymaps/keymap-mutable-set! fikra-claude-line-buffers thread-id ""))
      nil)
    (if (and thread-id (not (hashmap-get fikra-claude-aborteds thread-id)))
      (if focused
        ;; r88: the FOCUSED end revokes the token too (the bg helper had
        ;; it; this path bypassed it — the token outlived the turn).
        (progn
          (fikra/thread/fikra-thread-turn-end
            (if (= exit-code 0) "completed" "error"))
          (fikra-claude-revoke-thread-token thread-id))
        ;; Background thread: settle it WITHOUT stealing focus.
        (fikra-backend-claude-turn-end-bg thread-id exit-code)))))

(defun fikra-backend-claude-turn-end-bg (thread-id exit-code)
  (let ((prev (fikra/thread/fikra-thread-current)))
    (fikra/thread/fikra-thread-focus thread-id)
    (fikra/thread/fikra-thread-turn-end
      (if (= exit-code 0) "completed" "error"))
    (fikra-claude-revoke-thread-token thread-id)
    (fikra/thread/fikra-thread-focus prev)
    thread-id))

;; r88 (codex r87 P2): the token dies on EVERY turn end — the BACKGROUND
;; completion, the FOCUSED sentinel, and the ABORT all route here. The
;; token must not outlive its turn on any path. Guarded: revocation must
;; never break turn-end.
(defun fikra-claude-revoke-thread-token (thread-id)
  (condition-case nil
    (let ((tok (hashmap-get fikra-claude-tokens thread-id)))
      (if tok (confirmation-token-revoke tok))
      (editor/keymaps/keymap-mutable-set! fikra-claude-tokens thread-id nil))
    (error () nil)))

;; Test seam: reset the line accumulator (module vars are not settable
;; cross-module; #215's replay backend reuses this drain and resets it).
(defun fikra-backend-claude-reset-accumulator ()
  (editor/keymaps/keymap-mutable-set! fikra-claude-line-buffers
    (fikra/thread/fikra-thread-current) "")
  t)

;; Test seam: point the module's process handle at an externally spawned
;; pid (module vars are not settable cross-module).
(defun fikra-backend-claude-adopt-process (pid)
  (editor/keymaps/keymap-mutable-set! fikra-claude-processes
    (fikra/thread/fikra-thread-current) pid)
  pid)

;; Test seam: register pid→thread for direct filter/sentinel calls (the
;; unknown-pid DROP means tests feeding a fake pid must route it first).
(defun fikra-backend-claude-adopt-pid (pid)
  (editor/keymaps/keymap-mutable-set! fikra-claude-pid-thread
    (number-to-string pid) (fikra/thread/fikra-thread-current))
  pid)

;; Test seam: reproduce the abort→sentinel sequence without a process
;; (mark-aborted, end interrupted, then fire the sentinel with exit 1).
(defun fikra-backend-claude-abort-sim ()
  (let ((thread-id (fikra/thread/fikra-thread-current)))
    (editor/keymaps/keymap-mutable-set! fikra-claude-aborteds thread-id t)
    (fikra/thread/fikra-thread-turn-end "interrupted")
    (fikra-backend-claude-sentinel 0 1)
    "sim-done"))

(defun fikra-backend-claude-abort ()
  ;; #222: interrupts the FOCUSED thread's process (its own slot).
  (let* ((thread-id (fikra/thread/fikra-thread-current))
         (pid (hashmap-get fikra-claude-processes thread-id)))
    (if pid
      (progn
        ;; Mark BEFORE signaling: the sentinel fires after exit and must skip.
        (editor/keymaps/keymap-mutable-set! fikra-claude-aborteds thread-id t)
        (signal pid "SIGTERM")
        (editor/keymaps/keymap-mutable-set! fikra-claude-processes thread-id nil)
        (fikra/thread/fikra-thread-turn-end "interrupted")
        (fikra-claude-revoke-thread-token thread-id)
        t)
      nil)))

;; Self-register
(fikra/adapter/fikra-register-backend "claude")

(provide "fikra-backend-claude")
)
