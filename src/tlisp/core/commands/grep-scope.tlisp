(defmodule editor/commands/grep-scope
  (export grep-scope-here grep-scope-project grep-scope-accept
          grep-scope-table grep-scope-start-path grep-scope-resolve
          grep-scope-dirname)

;; #310 — the grep subsystem's user-facing scope commands (RFC-031
;; §2.3). FRESH root detection on EVERY invocation (the *project-root*
;; cache is BYPASSED — a stale cached root must not redirect the
;; search; `(project-root)` alone returns its cache, so the detection
;; primitive is called directly with an explicit start path).
(require-module editor/commands/grep)

(defvar grep-scope-pending nil
  "The resolved scope awaiting the minibuffer answer (a string), or
the symbol 'no-project (SPC p s outside a project — refused).")

(defun grep-scope-dirname (path)
  "A REAL dirname (gate r1: the old derivation kept the file's
BASENAME — a buffer visiting /other/sub/file.txt with cwd elsewhere
resolved against cwd, scoping the search to the WRONG project).
Absolute → the leading segments; relative → same, '.' when bare."
  (let ((segs (string-split path "/")))
    (grep-scope-dirname-join (reverse segs))))

(defun grep-scope-dirname-join (rev)
  ;; Skip the first (the basename); the REST is the dir. Absolute
  ;; paths: "/file.txt" splits to ("" "file.txt") → rest ("") — a
  ;; single EMPTY leading segment means the ROOT: "/". Gate r2's
  ;; finding: the old join produced "" (resolve("") = cwd — the
  ;; wrong-project class AGAIN) and the "/" special-case was dead
  ;; code (segments are "/"-free by construction, never length 1).
  (let ((rest (cdr rev)))
    (cond
      ((null rest) ".")
      ((and (= (length rest) 1) (= (length (car rest)) 0)) "/")
      (t (grep-scope-join-segs (reverse rest))))))

(defun grep-scope-join-segs (segs)
  ;; segs is REVERSED-to-absolute-order (the leading "" of an
  ;; absolute path first).
  (let ((joined (car segs)))
    (dolist (sg (cdr segs))
      (setq joined (concat joined "/" sg)))
    (if (= (length joined) 0) "." joined)))

(defun grep-scope-start-path ()
  "The detection start: the current buffer's file DIR; no file →
process.cwd() (the TS primitive resolves '.' against it)."
  (let ((fn (buffer-filename)))
    (if (and (stringp fn) (> (length fn) 0))
      (grep-scope-dirname fn)
      ".")))

(defun grep-scope-resolve (binding)
  "FRESH root detection for BINDING ('here | 'project). Returns the
scope string, or nil when 'project found no project."
  (let ((detected (project-detect-root (grep-scope-start-path))))
    (if (stringp detected)
      detected
      (if (string= binding "here")
        ;; here: no project → the start path itself.
        (grep-scope-start-path)
        nil))))

(defun grep-scope-prompt-label (backend scope)
  "The truthful pre-typed label: backend + resolved scope."
  (concat "grep (" backend ") " scope ": "))

(defun grep-scope-here ()
  "SPC s g — search from HERE: the freshly-detected project root
(cache bypassed); no project → the start path itself."
  (interactive)
  (grep-scope-open "here"))

(defun grep-scope-project ()
  "SPC p s — search the PROJECT: fresh detection; outside a project
→ the named status, no search, no buffer."
  (interactive)
  (let ((scope (grep-scope-resolve "project")))
    (if (null scope)
      (editor-set-status "not in a project — SPC s g searches from here")
      (grep-scope-open-at scope))))

(defun grep-scope-open (binding)
  ;; 'here' never returns nil (the start-path fallback); the dead
  ;; branch was removed (gate r1 minor).
  (grep-scope-open-at (grep-scope-resolve binding)))

(defun grep-scope-backend-label ()
  "The prompt's backend word: the CONFIGURED backend (auto → rg —
the only landed backend)."
  (let ((b (editor/commands/grep/grep-backend-get)))
    (if (and (stringp b) (string= b "auto"))
      "rg"
      (if (stringp b) b "rg"))))

(defun grep-scope-open-at (scope)
  ;; Backend check BEFORE the prompt via THE SUBSYSTEM'S OWN
  ;; availability matrix (valve r3: the old literal
  ;; exec-lookup-of-rg bypassed grep-backend config and detection —
  ;; a 'grep (rg)' prompt could open when the subsystem would refuse
  ;; after submit; the refusal status now fires at prompt-open time).
  (if (editor/commands/grep/grep-backend-available-p)
    (progn
      (setq grep-scope-pending scope)
      (completing-read
        (grep-scope-prompt-label (grep-scope-backend-label) scope)
        "editor/commands/grep-scope/grep-scope-table"
        nil
        nil
        ""
        "grep-scope-history"
        "editor/commands/grep-scope/grep-scope-accept"))
    nil))

(defun grep-scope-table (input action)
  ;; A free-text prompt (no candidates) — the SPEC-116 shape.
  (if (string= action "metadata")
    (hashmap "category" "plain")
    (list)))

(defun grep-scope-accept (pattern)
  "The accept handler: empty input cancels (no process, no buffer);
otherwise the #308 backend searches the RESOLVED scope. A spawn
failure after accept leaves an open results buffer untouched (the
#308 rollback owns that)."
  (let ((scope grep-scope-pending))
    (setq grep-scope-pending nil)
    (cond
      ((null scope)
        (editor-set-status "grep: no scope pending"))
      ((and (stringp pattern) (> (length pattern) 0))
        (grep-search pattern scope))
      (t
        ;; Empty input → cancel: status cleared, nothing spawned.
        (editor-set-status "")))))

(provide "grep-scope")
)
