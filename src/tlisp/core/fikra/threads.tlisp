(defmodule fikra/threads
  (export fikra-threads-list-open fikra-threads-render
          fikra-threads-selected-id fikra-threads-RET
          fikra-threads-archive-selected fikra-threads-new-thread
          fikra-threads-j fikra-threads-k
          fikra-threads-backend fikra-threads-worktree
          fikra-threads-level-of fikra-threads-last-ago)

;; #222 (RFC-027 §D7): the *Fikra-Threads* buffer — threads grouped by
;; project (zcode model), columns name/backend/mode/location(local|
;; worktree|legacy #298)/status/turns. j/Up/Down navigate (k is the
;; mockup's KILL — archive), RET switches (focus + buffer + modeline),
;; d archives (soft delete), n/t create, b picks the selected thread's
;; backend, w enters/reviews its worktree. Buffer-local keymap.

(require-module fikra/thread)

(defvar fikra-threads-buffer-name "*Fikra-Threads*")
(defvar fikra-threads-selected 0
  "Selected row index in the list buffer (0-based).")

(defun fikra-threads-list-open ()
  "Open (or refresh) the *Fikra-Threads* buffer and focus it."
  (interactive)
  (if (not (member fikra-threads-buffer-name (buffer-list)))
    (progn
      (buffer-create fikra-threads-buffer-name)
      (buffer-set-read-only t)))
  (buffer-switch fikra-threads-buffer-name)
  (fikra-threads-ensure-keymap)
  (fikra-threads-render)
  fikra-threads-buffer-name)

(defun fikra-threads-render ()
  "Re-render the list per mockup 8.5: the PROJECT header (thread count +
active worktrees), one row per thread (status dot, name, backend, T<turns>,
L<level>, worktree/main-tree, last activity), and the key-hint row."
  (let ((rows (fikra/thread/fikra-thread-rows))
        (was-ro (buffer-read-only-p)))
    (buffer-set-read-only nil)
    (let ((count (buffer-line-count)))
      (if (> count 1) (buffer-delete-range 0 0 (- count 1) 0)))
    (cursor-move 0 0)
    (buffer-insert
      (concat "PROJECT " (fikra-threads-basename (fikra-threads-project-label))
              "  ·  " (number-to-string (length rows)) " thread(s)"
              "  ·  worktrees: " (number-to-string (fikra-threads-worktree-count rows 0)) " active\n"))
    (buffer-insert "\n")
    (let ((i 0))
      (dolist (row rows)
        (buffer-insert
          (concat (if (= i fikra-threads-selected) "▶" " ")
                  (if (string= (if (hashmap-get row "status") (hashmap-get row "status") "") "running") "●" "○")
                  " "
                  (fikra-threads-pad (hashmap-get row "id") 16)
                  (fikra-threads-pad (if (hashmap-get row "backend") (hashmap-get row "backend") "-") 8)
                  "T" (fikra-threads-pad (if (hashmap-get row "turns") (hashmap-get row "turns") 0) 3)
                  ;; r102 (mockup rows 4-5): a MERGED thread shows done
                  ;; in the level column; a FIXTURE backend (replay/
                  ;; pausing — deterministic test threads) shows —.
                  (fikra-threads-pad
                    (if (hashmap-get row "merged")
                      "done"
                      (if (fikra-threads-fixture-p row)
                        "—"
                        (fikra-threads-level-of (hashmap-get row "mode")))) 5)
                  ;; #298: the legacy label must stay visible in the 8.5
                  ;; list (the rewrite regressed it — main went red).
                  ;; r103 (codex r102 P2): the merged row KEEPS its
                  ;; location (worktree ✓/main-tree); the merged marker
                  ;; rides the LAST column (mockup row 4).
                  ;; r104 (codex r103 P2): precedence — a REAL worktree
                  ;; location beats the fixture label (a merged replay
                  ;; thread keeps worktree ✓); fixture overrides only the
                  ;; plain main-tree rows (mockup row 5's shape).
                  (cond
                    ((string= (if (hashmap-get row "location") (hashmap-get row "location") "") "worktree") "worktree ✓")
                    ((fikra-threads-fixture-p row) "fixture     ")
                    ((if (hashmap-get row "legacy") t nil) "legacy      ")
                    (t "main-tree   "))
                  (cond
                    ((hashmap-get row "merged") "  merged via patch ✓")
                    ((fikra-threads-fixture-p row) "  (deterministic test thread)")
                    (t (concat "  last: " (fikra-threads-last-ago (hashmap-get row "last-at")))))
                  "\n"))
        (setq i (+ i 1))))
    (buffer-insert "\n")
    (buffer-insert " RET open  t new  b backend  w worktree  k kill\n")
    (buffer-set-read-only was-ro)
    (cursor-move 0 0)
    (cursor-move (+ 2 fikra-threads-selected) 0)))

;; A deterministic TEST backend thread (mockup row 5: replay → fixture).
(defun fikra-threads-fixture-p (row)
  (let ((b (if (hashmap-get row "backend") (hashmap-get row "backend") "")))
    (or (string= b "replay") (string= b "pausing"))))

;; The security-model level (modes.tlisp orders strictness; the L-level is
;; the mediation tier: L2 approvals, L1 auto, L0 full).
(defun fikra-threads-level-of (mode)
  (let ((m (if mode mode "")))
    (if (string= m "approval-required") "L2"
      (if (or (string= m "auto-accept-edits") (string= m "auto")) "L1"
        (if (string= m "full-access") "L0" "-")))))

(defun fikra-threads-worktree-count (rows acc)
  (if (null rows)
    acc
    (fikra-threads-worktree-count (cdr rows)
      (if (string= (if (hashmap-get (car rows) "location") (hashmap-get (car rows) "location") "") "worktree")
        (+ acc 1) acc))))

;; "last: 2m ago" — minutes since last-at (ms); legacy records lack it.
(defun fikra-threads-last-ago (last-at)
  (if (not last-at)
    "-"
    ;; Integer minutes (T-Lisp / is real division — the live list showed
    ;; "0.02m ago"); floor via the int-below trick: n - (mod n 1).
    (let* ((diff (/ (- (current-time) last-at) 60000))
           (mins (if (< diff 1) 0 (- diff (mod diff 1)))))
      (concat (number-to-string mins) "m ago"))))

;; The root's BASENAME (the mockup's "PROJECT tmax", not the full path).
(defun fikra-threads-basename (path)
  (if (or (not path) (= (length path) 0))
    "-"
    (fikra-threads-basename-scan path -1 0)))

(defun fikra-threads-basename-scan (path last i)
  (if (>= i (length path))
    (substring path (+ last 1) (length path))
    (fikra-threads-basename-scan path
      (if (string= (substring path i (+ i 1)) "/") i last)
      (+ i 1))))

(defun fikra-threads-project-label ()
  (let ((root (progn (if (not (fikra/thread/fikra-thread-current))
                       (fikra/thread/fikra-thread-init))
                     (fikra/thread/fikra-thread-field "root"))))
    (if root root "(no project)")))

(defun fikra-threads-pad (s width)
  (let ((str (if (stringp s) s (if (numberp s) (number-to-string s) "-"))))
    (if (>= (length str) width)
      str
      (concat str (fikra-threads-spaces (- width (length str)))))))

(defun fikra-threads-spaces (n)
  (if (<= n 0) "" (concat " " (fikra-threads-spaces (- n 1)))))

(defun fikra-threads-count ()
  (length (fikra/thread/fikra-thread-rows)))

(defun fikra-threads-selected-id ()
  "The thread id at the selected row (nil when the list is empty)."
  (fikra-threads-selected-id-at (fikra/thread/fikra-thread-rows) 0))

(defun fikra-threads-selected-id-at (rows i)
  (if (null rows)
    nil
    (if (= i fikra-threads-selected)
      (hashmap-get (car rows) "id")
      (fikra-threads-selected-id-at (cdr rows) (+ i 1)))))

;; ── actions (buffer-local keymap targets) ───────────────────────────
(defun fikra-threads-j () (fikra-threads-move 1))
(defun fikra-threads-k () (fikra-threads-move -1))

(defun fikra-threads-move (delta)
  (let ((n (fikra-threads-count)))
    (if (> n 0)
      (progn
        (setq fikra-threads-selected
              (max 0 (min (- n 1) (+ fikra-threads-selected delta))))
        (fikra-threads-render)))
    nil))

(defun fikra-threads-RET ()
  "Switch to the selected thread (focus + FAEP log + chat buffer +
modeline)."
  (let ((id (fikra-threads-selected-id)))
    (if id
      (progn (fikra/thread/fikra-thread-switch id) id)
      (progn (editor-set-status "Fikra: no thread selected") nil))))

(defun fikra-threads-archive-selected ()
  "Archive (soft delete) the selected thread; the list refreshes."
  (let ((id (fikra-threads-selected-id)))
    (if id
      (progn
        (fikra/thread/fikra-thread-focus id)
        (let ((r (fikra/thread/fikra-thread-archive)))
          ;; Focus back to main for the refreshed listing.
          (fikra/thread/fikra-thread-focus "main")
          (setq fikra-threads-selected 0)
          (fikra-threads-render)
          r)))))

(defun fikra-threads-new-thread ()
  "Create a new thread (inherits the current mode) and switch to it."
  (fikra/thread/fikra-thread-new))

;; b: switch the SELECTED thread's backend (focus it, open the backend
;; picker, return to the refreshed list).
(defun fikra-threads-backend ()
  "b: pick the selected thread's backend. Focus it and OPEN the picker —
  the ACCEPT does the work (sets the adapter selection AND this thread's
  persisted field); completing-read never returns the choice to us (the
  r28 lesson; the r44 catch treated it as synchronous)."
  (let ((id (fikra-threads-selected-id)))
    (if id
      (progn
        (fikra/thread/fikra-thread-focus id)
        (require-module fikra/adapter)
        (fikra-backend-prompt)
        id))))

;; w: worktree for the selected thread — local enters worktree mode, an
;; active worktree opens the 8.6 review screen.
(defun fikra-threads-worktree ()
  "w: enter/review the selected thread's worktree."
  (let ((id (fikra-threads-selected-id)))
    (if id
      (progn
        (fikra/thread/fikra-thread-focus id)
        (require-module fikra/worktree)
        (fikra/worktree/fikra-worktree-review)))))

;; ── buffer-local keymap ─────────────────────────────────────────────
(defun fikra-threads-ensure-keymap ()
  (if (not (editor/keymaps/buffer-keymap fikra-threads-buffer-name))
    (let ((kmap (editor/keymaps/keymap-init "fikra-threads")))
      (editor/keymaps/keymap-set-key kmap "j" "(fikra/threads/fikra-threads-j)")
      ;; k = KILL (the mockup); up-navigation stays on Up (j/Down/Up).
      (editor/keymaps/keymap-set-key kmap "Down" "(fikra/threads/fikra-threads-j)")
      (editor/keymaps/keymap-set-key kmap "Up" "(fikra/threads/fikra-threads-k)")
      (editor/keymaps/keymap-set-key kmap "RET" "(fikra/threads/fikra-threads-RET)")
      (editor/keymaps/keymap-set-key kmap "d" "(fikra/threads/fikra-threads-archive-selected)")
      ;; mockup 8.5 keys: k kill (the archive alias), b backend, w worktree.
      (editor/keymaps/keymap-set-key kmap "k" "(fikra/threads/fikra-threads-archive-selected)")
      (editor/keymaps/keymap-set-key kmap "n" "(fikra/threads/fikra-threads-new-thread)")
      ;; The mockup's hint row shows "t new" — bind it too.
      (editor/keymaps/keymap-set-key kmap "t" "(fikra/threads/fikra-threads-new-thread)")
      (editor/keymaps/keymap-set-key kmap "b" "(fikra/threads/fikra-threads-backend)")
      (editor/keymaps/keymap-set-key kmap "w" "(fikra/threads/fikra-threads-worktree)")
      (editor/keymaps/buffer-set-keymap fikra-threads-buffer-name kmap)))
  t)

(provide "fikra-threads")
)
