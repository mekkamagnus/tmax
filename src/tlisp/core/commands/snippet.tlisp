(defmodule editor/commands/snippet
  (export snippet-try-expand snippet-expand snippet-next-field snippet-prev-field
          snippet-exit snippet-update-mirrors snippet-help)

;; snippet.tlisp — Snippet expansion commands (#167, SPEC-101)
;; Loads snippets from ~/.config/tmax/snippets/<mode>/, expands on Tab.

(defun snippet-try-expand ()
  "Look up the word before cursor as a snippet key. Expand if found; return nil if not."
  (let ((word (word-before-cursor)))
    (if (or (null word) (string= word ""))
      nil
      (let ((snippet (snippet-lookup word (major-mode-get))))
        (if (null snippet)
          nil
          (progn
            (let ((len (length word)))
              (buffer-delete-range (cursor-line) (- (cursor-column) len) (cursor-line) (cursor-column)))
            (snippet-expand (nth 2 snippet))
            t))))))

(defun snippet-expand (body)
  "Expand a snippet template BODY at the cursor.
Parses $1/$2/${1:default}/$0 placeholders, inserts the template (with defaults
filled in), enters field-navigation state. Cursor moves to the first field."
  (let ((parsed (snippet-parse-body body)))
    (let ((expanded (nth 0 parsed))
          (field-info (nth 1 parsed)))
      (let ((start-line (cursor-line))
            (start-col (cursor-column)))
        (buffer-insert expanded)
        (snippet-start-expansion field-info start-line start-col)
        (let ((field (snippet-current-field)))
          (if field
            (cursor-move (nth 0 field) (nth 1 field))
            nil))))
    t))

(defun snippet-next-field ()
  "Move to the next placeholder field (Tab during snippet navigation).
Returns t if a field was found, nil if all fields are done."
  (snippet-update-mirrors)
  (let ((field (snippet-next-field-internal)))
    (if field
      (progn
        (cursor-move (nth 0 field) (nth 1 field))
        t)
      (progn
        (snippet-exit)
        nil))))

(defun snippet-prev-field ()
  "Move to the previous placeholder field (S-Tab during snippet navigation)."
  (let ((field (snippet-prev-field-internal)))
    (if field
      (progn
        (cursor-move (nth 0 field) (nth 1 field))
        t)
      nil)))

(defun snippet-exit ()
  "Exit snippet field navigation."
  (snippet-exit-internal))

(defun snippet-update-mirrors ()
  "Update mirror fields for the current field.
Currently a no-op stub — mirror live-update is Phase 4 secondary work (SPEC-101).
Mirror positions are tracked by SnippetManager but not synced back to the buffer
because buffer positions shift with every keystroke and the immutable buffer model
makes tracking shifts complex. This is a documented limitation."
  nil)

(defun snippet-help ()
  "Show snippet-mode help."
  (message "Snippet mode: type abbreviation + Tab to expand. Tab cycles fields."))

(provide "snippet")
)
